  <script is:inline define:vars={{ P, Y, HEDEF, R_VER, R_IVZ, etiket27 }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf0 = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
      const nf2 = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const pf = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 });
      const tl0 = (n) => '₺' + nf0.format(Math.round(n));
      const tl2 = (n) => '₺' + nf2.format(n);
      const YARI = R_IVZ.map((r) => r / 2);

      function hesap(m, dil, oranlar) {
        let kalan = m, alt = 0, kurus = 0;
        const satir = [];
        for (let i = 0; i < oranlar.length && kalan > 0; i++) {
          const w = i < dil.length ? dil[i] : Infinity;
          const d = Math.min(kalan, w);
          const k = Math.round(d * oranlar[i]);
          satir.push({ alt: alt, w: w, d: d, oran: oranlar[i], vergi: k / 100 });
          kurus += k; kalan -= d; alt += w;
        }
        return { vergi: kurus / 100, satir: satir };
      }
      function etiket(alt, w) {
        if (alt === 0) return 'İlk ' + nf0.format(w) + ' ₺';
        if (w === Infinity) return nf0.format(alt) + ' ₺ üzeri';
        return nf0.format(alt + 1) + ' – ' + nf0.format(alt + w) + ' ₺';
      }
      function row(cells, cls) {
        const tr = document.createElement('tr');
        if (cls) tr.className = cls;
        cells.forEach((t) => { const td = document.createElement('td'); td.textContent = t; tr.appendChild(td); });
        return tr;
      }

      function update() {
        const yil = $('in-yil').value;
        const p = P[yil] || P[String(Y)];
        const tahmin = yil === String(HEDEF);
        const miras = $('in-tur').value === 'miras';
        const kim = $('in-kim').value;
        const aile = $('in-kimden').value === 'aile';
        const deger = Math.max(0, +$('in-deger').value || 0);
        const borc = Math.max(0, +$('in-borc').value || 0);

        $('row-kim').hidden = !miras;
        $('row-kimden').hidden = miras;
        $('lbl-deger').textContent = miras ? 'Size düşen miras payının değeri (₺)' : 'Bağışlanan para veya malın değeri (₺)';
        $('hint-deger').textContent = miras
          ? 'Taşınmazda emlak vergi değeri; araç, altın ve diğer menkullerde ölüm günündeki piyasa değeri.'
          : 'Taşınmazda emlak vergi değeri; diğer mallarda bağış günündeki piyasa değeri.';
        $('lbl-borc').textContent = miras ? 'Payınıza düşen borç ve cenaze giderleri (₺, isteğe bağlı)' : 'Bağışlanan mala ait borçlar (₺, isteğe bağlı)';

        const ist = !miras ? p.istisna.ivazsiz : kim === 'esyalniz' ? p.istisna.esFuruYok : kim === 'diger' ? 0 : p.istisna.furuEs;
        const istAd = !miras ? 'İstisna (bağış)' : kim === 'esyalniz' ? 'İstisna (eş, çocuk yok)' : kim === 'diger' ? 'İstisna' : 'İstisna (çocuk/eş)';
        const oranlar = miras ? R_VER : aile ? YARI : R_IVZ;
        const matrah = Math.max(0, deger - borc - ist);
        const r = hesap(matrah, p.dilimler, oranlar);
        const taksit = Math.floor(Math.round(r.vergi * 100) / 6) / 100;
        const son = r.satir[r.satir.length - 1];

        $('out-label').textContent = (miras ? 'Ödenecek veraset ve intikal vergisi' : 'Ödenecek bağış (intikal) vergisi') + (tahmin ? ' · ' + yil + ' ' + etiket27 : '');
        $('out-tax').textContent = tl2(r.vergi);
        $('out-ist-label').textContent = istAd;
        $('out-ist').textContent = tl0(ist);
        $('out-matrah').textContent = tl0(matrah);
        $('out-taksit').textContent = r.vergi > 0 ? (taksit > 0 ? '6 × ' + tl2(taksit) : tl2(r.vergi)) : '—';
        $('out-oran').textContent = r.vergi > 0 && deger > 0 ? '%' + pf.format((r.vergi / deger) * 100) + ' · %' + pf.format(son.oran) : '—';
        $('out-beyan').textContent = miras ? 'ölümü izleyen 4 ay*' : matrah > 0 ? 'bağışı izleyen 1 ay' : 'beyan gerekmez';

        const notlar = [];
        if (miras && matrah === 0 && deger > 0) notlar.push('Payınız istisnanın altında: vergi çıkmaz, ancak miras için beyanname yine de verilmelidir.');
        if (!miras && matrah === 0 && deger > 0) notlar.push('Bağış istisnanın altında: vergi de beyanname de gerekmez.');
        if (miras && kim === 'diger') notlar.push('Anne, baba, kardeş ve diğer mirasçılar istisnadan yararlanamaz; vergi ilk liradan başlar.');
        if (!miras && aile) notlar.push('Anne, baba, eş veya çocuktan bağışta oranlar yarıya iner (evlatlıktan evlat edinene bağış hariç).');
        if (miras) notlar.push('* Ölüm ve mirasçı Türkiye’deyse; diğer durumlar aşağıdaki tabloda.');
        if (tahmin) notlar.push(yil + ' tutarları ' + etiket27 + '; resmî tutarlar Aralık sonunda tebliğle açıklanır.');
        $('out-note').textContent = notlar.join(' ');

        $('dokum-intro').textContent = yil + (tahmin ? ' (' + etiket27 + ')' : '') + ' tarifesi · ' +
          (miras ? 'miras (veraset yoluyla intikal) oranları' : aile ? 'anne-baba, eş, çocuktan bağış: ivazsız oranların yarısı' : 'bağış (ivazsız intikal) oranları');
        const body = $('dokum-body');
        body.replaceChildren();
        if (r.satir.length === 0) {
          const tr = row(['Matrah sıfır: istisna düşüldükten sonra vergilendirilecek tutar kalmıyor.']);
          tr.firstChild.colSpan = 4;
          body.appendChild(tr);
        } else {
          r.satir.forEach((s) => body.appendChild(row([etiket(s.alt, s.w), tl0(s.d), '%' + pf.format(s.oran), tl2(s.vergi)])));
          body.appendChild(row(['Toplam', tl0(matrah), '', tl2(r.vergi)], 'row-total'));
        }
      }

      ['in-deger', 'in-borc'].forEach((id) => $(id).addEventListener('input', update));
      ['in-yil', 'in-tur', 'in-kim', 'in-kimden'].forEach((id) => $(id).addEventListener('change', update));
      update();
    })();
  </script>

