---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import yd from '../../data/yeniden-degerleme.json';
import vv from '../../data/veraset-2026.json';

// Veraset ve intikal vergisi — 7338 s. VİVK güncel metni (mevzuat.gov.tr 1.3.7338, 2026-10-18 okundu):
// istisna md. 4/b-d-e; tarife md. 16 (ana/baba/eş/çocuktan bağışta ivazsız oranların yarısı; 7582 s. K. ile
// GVK mük. 20/D kapsamına %1); beyan süresi md. 9; değerleme md. 10 (taşınmaz = emlak vergisine esas değer);
// borç/masraf md. 12; banka tevkifatı md. 17 (%5 / %15); ödeme md. 19 (3 yıl, Mayıs + Kasım, 6 eşit taksit).
// Tutarlar data/veraset-2026.json’da (57/56/55 Seri No’lu VİVK Genel Tebliğleri, RG; KPMG + Yöntem YMM tutarlı).
// Gelecek yıl tahmini: md. 4 son fıkra (istisna + ⌊istisna × oran⌋; lira altı kesir atılır) ve md. 16/3 (dilim ×
// (1 + oran), “%5’ini aşmayan kesirler dikkate alınmaz”; Cumhurbaşkanı dilimleri yarısına kadar ±). Bu iki kural
// 2024-2026 tebliğ tutarlarını birebir üretiyor. VİVK’de MTV/harçtaki CB indirimi uygulanmadı → oran =
// tebligOrani ?? onikiAyOrt (uygulananOrani KULLANILMAZ). Vergi fonksiyonu GİB 2026 rehberindeki (Yayın No 618)
// dört örneği kuruşu kuruşuna veriyor (taksit kuruşa aşağı yuvarlanır).

const Y: number = vv.yil;
const HEDEF = Y + 1;
const tahminVar = yd.hedefYil === HEDEF; // yd verisi başka yıla dönmüşse tahmin gösterilmez
const teblig = yd.tebligOrani as number | null;
const oran: number = teblig ?? yd.onikiAyOrt;
const durum: 'teblig' | 'hesap' | 'tahmin' = teblig ? 'teblig' : yd.ekimVerisiGeldi ? 'hesap' : 'tahmin';

const MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const sonAyAdi = `${MONTHS[+yd.sonAy.slice(5) - 1]} ${yd.sonAy.slice(0, 4)}`;
const sa = (yd as { sonrakiAciklama?: string }).sonrakiAciklama;
const sonrakiTxt = sa ? `${+sa.slice(8, 10)} ${MONTHS[+sa.slice(5, 7) - 1]}` : 'Kasım başında';

const fmt = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));
const fmt2 = (n: number) =>
  new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const pct = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 }).format(n);
const nf2 = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const oranTxt = durum === 'tahmin' ? '≈%' + nf2(oran) : '%' + nf2(oran);
const etiket27 = durum === 'tahmin' ? 'tahmini' : 'hesaplanan';

// md. 16/3: kesri dilimin %5’ini aşmayan en kaba yuvarlak rakama in (2024: 8.715.300 → 8.700.000;
// 2025: 12.521.910 → 12.000.000; 2026: 7.152.930 → 7.000.000 — hepsi tebliğle aynı).
const kesirAt = (x: number) => {
  const n = Math.round(x);
  const hane = String(n).length;
  for (let k = 1; k <= hane; k++) {
    const p = 10 ** (hane - k);
    const y = Math.floor(n / p) * p;
    if (n - y <= 0.05 * n) return y;
  }
  return n;
};
// md. 4 son fıkra: artışın 1 TL’ye (eski 1 milyon lira) kadar kesri dikkate alınmaz.
const bp = Math.round(oran * 100);
const artir = (v: number) => v + Math.floor((v * bp) / 10000);

type Istisna = { furuEs: number; esFuruYok: number; ivazsiz: number; ikramiye: number };
type Param = { istisna: Istisna; dilimler: number[] };
const I: Istisna = vv.istisna;
const P: Record<string, Param> = { [String(Y)]: { istisna: I, dilimler: vv.dilimler } };
const I27: Istisna = {
  furuEs: artir(I.furuEs),
  esFuruYok: artir(I.esFuruYok),
  ivazsiz: artir(I.ivazsiz),
  ikramiye: artir(I.ikramiye),
};
const D27 = vv.dilimler.map((w) => kesirAt(w * (1 + oran / 100)));
if (tahminVar) P[String(HEDEF)] = { istisna: I27, dilimler: D27 };

const R_VER: number[] = vv.oranVeraset;
const R_IVZ: number[] = vv.oranIvazsiz;
const R_YARI = R_IVZ.map((r) => r / 2);
const kumulatif = (ws: number[]) => ws.reduce<number[]>((a, w) => [...a, (a[a.length - 1] ?? 0) + w], []);
const UST = kumulatif(vv.dilimler); // 3M, 10M, 25M, 55M
const UST27 = kumulatif(D27);

type Satir = { alt: number; w: number; d: number; oran: number; vergi: number };
function hesap(matrah: number, dilimler: number[], oranlar: number[]) {
  let kalan = matrah;
  let alt = 0;
  let kurus = 0;
  const satir: Satir[] = [];
  for (let i = 0; i < oranlar.length && kalan > 0; i++) {
    const w = i < dilimler.length ? dilimler[i] : Infinity;
    const d = Math.min(kalan, w);
    const k = Math.round(d * oranlar[i]);
    satir.push({ alt, w, d, oran: oranlar[i], vergi: k / 100 });
    kurus += k;
    kalan -= d;
    alt += w;
  }
  return { vergi: kurus / 100, satir };
}
const taksitOf = (v: number) => Math.floor(Math.round(v * 100) / 6) / 100;
const etiket = (alt: number, w: number) =>
  alt === 0 ? `İlk ${fmt(w)} ₺` : w === Infinity ? `${fmt(alt)} ₺ üzeri` : `${fmt(alt + 1)} – ${fmt(alt + w)} ₺`;

// Varsayılan örnek (FAQ ile aynı): 5.000.000 ₺ miras, tek mirasçı çocuk
const D = { deger: 5000000 };
const ex1 = hesap(D.deger - I.furuEs, vv.dilimler, R_VER);
const ex1Matrah = D.deger - I.furuEs;
const bagisOrnek = 1000000;
const exAile = hesap(bagisOrnek - I.ivazsiz, vv.dilimler, R_YARI);
const exDiger = hesap(bagisOrnek - I.ivazsiz, vv.dilimler, R_IVZ);

// Vasiyet yoksa yasal paylar (TMK md. 495, 499): eş altsoyla birlikte 1/4; çocuklar eşit.
const esCocukEsik = (n: number) => Math.floor(4 * I.furuEs * Math.min(1, n / 3));
const PAYLAR = [
  { kim: 'Eş + 1 çocuk', pay: 'eş dörtte bir, çocuk dörtte üç', esik: esCocukEsik(1) },
  { kim: 'Eş + 2 çocuk', pay: 'eş dörtte bir, çocuklar sekizde üçer', esik: esCocukEsik(2) },
  { kim: 'Eş + 3 çocuk', pay: 'eş ve çocuklar dörtte birer', esik: esCocukEsik(3) },
  { kim: 'Yalnız 1 çocuk', pay: 'tamamı', esik: I.furuEs },
  { kim: 'Yalnız 2 çocuk', pay: 'yarı yarıya', esik: 2 * I.furuEs },
  { kim: 'Eş tek mirasçıysa', pay: 'tamamı', esik: I.esFuruYok },
];

const G = vv.gecmis; // [önceki yıl, iki yıl önce]
const ISTISNA_SATIR = [
  { ad: 'Miras: çocuk/torun (evlatlık dâhil) ve eş — her biri', k: 'furuEs' as const },
  { ad: 'Miras: eş, ölenin çocuğu/torunu yoksa', k: 'esFuruYok' as const },
  { ad: 'Bağış, hibe ve diğer karşılıksız intikaller', k: 'ivazsiz' as const },
  { ad: 'Yarışma, çekiliş ve şans oyunu ikramiyeleri', k: 'ikramiye' as const },
];
const rgTarih = (s: string) => `${s.slice(8, 10)}.${s.slice(5, 7)}.${s.slice(0, 4)}`;
const indirimsiz = (vv.teblig as { uygulanmayanIndirimliOran?: number }).uygulanmayanIndirimliOran;

const faq = [
  {
    q: 'Veraset ve intikal vergisi nasıl hesaplanır? (Örnek: 5 milyon TL miras, tek çocuk)',
    a: `Her mirasçı kendi payı için ayrı vergilendirilir: payın değerinden belgeli borçlar ve cenaze giderleri düşülür, istisna çıkarılır, kalan matraha dilimli tarife uygulanır. Örnek: eşi sağ olmayan bir kişi ${Y} yılında vefat etti ve tek mirasçısı olan çocuğuna 5.000.000 TL değerinde miras kaldı. Matrah 5.000.000 − ${fmt(I.furuEs)} = ${fmt(ex1Matrah)} TL olur. Bu tutar ilk dilimde (${fmt(UST[0])} TL’ye kadar %${R_VER[0]}) kaldığı için vergi ${fmt2(ex1.vergi)} TL’dir ve 3 yıl boyunca Mayıs ve Kasım aylarında 6 eşit taksitle (taksit başına ${fmt2(taksitOf(ex1.vergi))} TL) ödenir.`,
  },
  {
    q: `${Y} yılında veraset vergisi istisnası ne kadar?`,
    a: `${Y} yılında gerçekleşen ölümlerde evlatlıklar dâhil çocuk/torun ve eşten her birinin miras payının ${fmt(I.furuEs)} TL’si vergiden istisnadır; ölenin hiç çocuğu/torunu yoksa eşin payında istisna ${fmt(I.esFuruYok)} TL’dir. Anne, baba, kardeş gibi diğer mirasçılar için miras istisnası yoktur. Bağış (hibe) ve diğer karşılıksız intikallerde istisna ${fmt(I.ivazsiz)} TL’dir. Hangi yılın tutarının uygulanacağını beyanname tarihi değil, ölüm veya bağış tarihi belirler.`,
  },
  {
    q: 'Anne-babadan çocuğa bağış (hibe) vergisi ne kadar?',
    a: `Ana, baba, eş ve çocuklardan yapılan bağışta ivazsız intikal oranlarının yarısı uygulanır: %${pct(R_YARI[0])}, %${pct(R_YARI[1])}, %${pct(R_YARI[2])}, %${pct(R_YARI[3])} ve %${pct(R_YARI[4])}. ${Y} istisnası ${fmt(I.ivazsiz)} TL’dir. Örnek: annenizden ${fmt(bagisOrnek)} TL bağış alırsanız matrah ${fmt(bagisOrnek - I.ivazsiz)} TL, vergi ${fmt2(exAile.vergi)} TL olur. Aynı bağış kardeşinizden veya bir arkadaşınızdan gelseydi tam oran uygulanır ve vergi ${fmt2(exDiger.vergi)} TL olurdu. İstisnanın altında kalan bağış için beyanname verilmez; aşan bağış, malın edinildiği tarihi izleyen 1 ay içinde beyan edilir. Evlatlıktan evlat edinene yapılan bağışta indirim uygulanmaz.`,
  },
  {
    q: 'Veraset ve intikal vergisi beyannamesi ne zaman ve nereye verilir?',
    a: 'Ölüm Türkiye’de gerçekleşmiş ve mirasçılar Türkiye’deyse beyanname ölüm tarihini izleyen 4 ay içinde, mirasçı yurt dışındaysa 6 ay içinde verilir; ölüm yurt dışında gerçekleştiyse süre 4, 6 veya 8 aydır. Beyanname, ölen kişinin son ikametgâhının bağlı olduğu vergi dairesine verilir; yurt dışındaki mirasçılar konsolosluğa verebilir. Ekine mirasçılık belgesi (noterden veya sulh hukuk mahkemesinden), taşınmazlar için belediyeden emlak vergi değeri yazısı ve indirilecek borçların belgeleri konur. Miras istisna tutarının altında kalsa bile beyanname verilmesi gerekir.',
  },
  ...(tahminVar
    ? [
        {
          q: `${HEDEF} yılında veraset vergisi istisnası ve dilimleri ne kadar olacak?`,
          a: `İstisna tutarları ve tarife dilimleri her yıl, önceki yıl için ilan edilen yeniden değerleme oranında artırılır (Veraset ve İntikal Vergisi Kanunu md. 4 ve 16). ${durum === 'tahmin' ? sonAyAdi + ' verisiyle oran yaklaşık %' + nf2(oran) : 'Oran %' + nf2(oran)}. Buna göre ${HEDEF} yılında çocuk ve eş istisnası yaklaşık ${fmt(I27.furuEs)} TL, çocuk yoksa eşin istisnası ${fmt(I27.esFuruYok)} TL, bağış istisnası ${fmt(I27.ivazsiz)} TL olur; ilk dilim yaklaşık ${fmt(UST27[0])} TL’ye çıkar. Resmî tutarlar Aralık sonunda Veraset ve İntikal Vergisi Genel Tebliği ile ilan edilir; Cumhurbaşkanı dilim tutarlarını yarısına kadar artırıp indirebilir.`,
        },
      ]
    : []),
  {
    q: 'Miras kalan ev, veraset vergisi ödenmeden satılabilir mi?',
    a: 'Mirasçılar adına tapuda tescil, vergi tahakkuk etmeden yapılabilir. Ancak taşınmazın satışı (devir ve ferağ) ya da üzerinde ipotek gibi bir hak kurulması için o taşınmaza veya satılan hisseye düşen veraset ve intikal vergisinin tamamının ödenmesi ya da teminat gösterilmesi gerekir; tapu müdürlüğü vergi dairesinden alınan ilişik kesme belgesini ister. Bankadaki mevduat için de verginin ödendiğini gösteren yazı istenir; yazı getirilmezse banka miras payından %5 vergi karşılığı keserek kalanı ödeyebilir.',
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Hesaplama Araçları', url: '/hesaplama-araclari/' },
  { name: 'Veraset ve İntikal Vergisi Hesaplama', url: '/veraset-ve-intikal-vergisi-hesaplama/' },
];

const guncel = yd.updated > vv.dogrulama ? yd.updated : vv.dogrulama;
const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Veraset ve intikal vergisi ${Y}: istisna tutarları, tarife dilimleri${tahminVar ? ` ve ${HEDEF} tahmini` : ''}`,
  description: `7338 sayılı Kanun md. 4 istisnaları ve md. 16 tarifesi (${Y}, ${vv.teblig.seriNo} Seri No’lu VİVK Genel Tebliği), ${G[G.length - 1].yil}-${G[0].yil} geçmişi${tahminVar ? ` ve yeniden değerleme oranına göre ${HEDEF} tahmini (${oranTxt})` : ''}.`,
  url: 'https://parafomo.com/veraset-ve-intikal-vergisi-hesaplama/',
  dateModified: guncel,
  creator: { '@type': 'Organization', name: 'ParaFOMO', url: 'https://parafomo.com/' },
  isBasedOn: vv._kaynak,
  license: 'https://creativecommons.org/licenses/by/4.0/',
};
const updatedLabel = new Date(guncel + 'T12:00:00').toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const title = tahminVar
  ? `Veraset ve İntikal Vergisi Hesaplama ${Y} ve ${HEDEF} Tahmini`
  : `Veraset ve İntikal Vergisi Hesaplama ${Y}: Miras ve Bağış`;
const description = `Veraset ve intikal vergisi hesaplama ${Y}: miras ve bağışta istisna (çocuk/eş ₺${fmt(I.furuEs)}), %1–30 dilimler, 6 taksit.${tahminVar ? ` ${HEDEF} istisna ve dilim tahmini.` : ''}`;
---

<BaseLayout
  title={title}
  description={description}
  faq={faq}
  breadcrumbs={breadcrumbs}
  image="/og/veraset-ve-intikal-vergisi-hesaplama.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(dataset)} />
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Hesaplayıcı · Miras ve bağış vergisi</p>
      <h1>{title}</h1>
      <p class="lede">
        Miras payınızın ya da size yapılan bağışın (hibe) değerini girin: <strong>{Y} istisnası</strong> düşülür,
        vergi <strong>dilim dilim</strong> hesaplanır; 6 taksit tutarını, beyanname süresini
        {tahminVar && <> ve <strong>{HEDEF} tahminini</strong></>} görün.
      </p>
    </header>

    <div class="kpi-row">
      <div class="kpi">
        <span class="kpi-label">Çocuk ve eş istisnası · {Y}</span>
        <span class="kpi-val">₺{fmt(I.furuEs)}</span>
        <span class="kpi-sub">her mirasçının kendi payından · çocuk yoksa eşe ₺{fmt(I.esFuruYok)}</span>
      </div>
      <div class="kpi">
        <span class="kpi-label">Bağış (hibe) istisnası · {Y}</span>
        <span class="kpi-val">₺{fmt(I.ivazsiz)}</span>
        <span class="kpi-sub">anne-baba, eş ve çocuktan bağışta oran %{pct(R_YARI[0])}’ten başlar</span>
      </div>
      {tahminVar ? (
        <div class="kpi">
          <span class="kpi-label">{HEDEF} {durum === 'tahmin' ? 'artışı tahmini' : 'artış oranı'}</span>
          <span class="kpi-val">{oranTxt}</span>
          <span class="kpi-sub">
            istisna ≈₺{fmt(I27.furuEs)} olur ·{' '}
            {durum === 'tahmin' ? `oran ${sonrakiTxt} netleşir` : durum === 'hesap' ? 'VUK tebliği Kasım sonu' : 'VİVK tebliği Aralık sonu'}
          </span>
        </div>
      ) : (
        <div class="kpi">
          <span class="kpi-label">Ödeme</span>
          <span class="kpi-val">6 taksit</span>
          <span class="kpi-sub">3 yıl boyunca her yıl Mayıs ve Kasım’da</span>
        </div>
      )}
    </div>

    <div class="calc-grid">
      <form class="calc-inputs" id="calc-form" autocomplete="off">
        <label id="row-yil" hidden={!tahminVar}>
          <span>Ölüm veya bağış yılı</span>
          <select id="in-yil">
            <option value={String(Y)} selected>{Y}</option>
            {tahminVar && <option value={String(HEDEF)}>{HEDEF} ({etiket27})</option>}
          </select>
        </label>
        <label>
          <span>İntikal türü</span>
          <select id="in-tur">
            <option value="miras" selected>Miras (veraset yoluyla)</option>
            <option value="bagis">Bağış / hibe (karşılıksız)</option>
          </select>
        </label>
        <label id="row-kim">
          <span>Ölene göre siz kimsiniz?</span>
          <select id="in-kim">
            <option value="cocuk" selected>Çocuk / torun (evlatlık dâhil)</option>
            <option value="es">Eş — ölenin çocuğu/torunu varsa</option>
            <option value="esyalniz">Eş — ölenin çocuğu/torunu yoksa</option>
            <option value="diger">Anne, baba, kardeş veya diğer (istisna yok)</option>
          </select>
        </label>
        <label id="row-kimden" hidden>
          <span>Bağışı yapan size göre kim?</span>
          <select id="in-kimden">
            <option value="aile" selected>Annem, babam, eşim veya çocuğum (oranlar yarı)</option>
            <option value="diger">Diğer: kardeş, akraba, arkadaş vb.</option>
          </select>
        </label>
        <label>
          <span id="lbl-deger">Size düşen miras payının değeri (₺)</span>
          <input type="number" id="in-deger" value={D.deger} min="0" step="10000" inputmode="numeric" />
          <em class="hint" id="hint-deger">Taşınmazda emlak vergi değeri; araç, altın ve diğer menkullerde ölüm günündeki piyasa değeri.</em>
        </label>
        <label>
          <span id="lbl-borc">Payınıza düşen borç ve cenaze giderleri (₺, isteğe bağlı)</span>
          <input type="number" id="in-borc" value="0" min="0" step="1000" inputmode="numeric" />
        </label>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label" id="out-label">Ödenecek veraset ve intikal vergisi</span>
          <span class="result-value" id="out-tax">₺{fmt2(ex1.vergi)}</span>
        </div>
        <div class="result-split">
          <div class="split-item">
            <span class="split-label" id="out-ist-label">İstisna (çocuk/eş)</span>
            <span class="split-val" id="out-ist">₺{fmt(I.furuEs)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Vergi matrahı</span>
            <span class="split-val" id="out-matrah">₺{fmt(ex1Matrah)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Taksit (6 kez, Mayıs ve Kasım)</span>
            <span class="split-val" id="out-taksit">6 × ₺{fmt2(taksitOf(ex1.vergi))}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Efektif · marjinal oran</span>
            <span class="split-val" id="out-oran">%{pct((ex1.vergi / D.deger) * 100)} · %{R_VER[0]}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Beyanname süresi</span>
            <span class="split-val" id="out-beyan">ölümü izleyen 4 ay*</span>
          </div>
        </div>
        <p class="result-note" id="out-note">* Ölüm ve mirasçı Türkiye’deyse; diğer durumlar aşağıdaki tabloda.</p>
      </div>
    </div>

    <section class="table-block" aria-labelledby="dokum-baslik">
      <h2 id="dokum-baslik">Hesap dökümü: dilim dilim vergi</h2>
      <p class="table-intro" id="dokum-intro">{Y} tarifesi · miras (veraset yoluyla intikal) oranları</p>
      <div class="table-scroll">
        <table class="rate-table">
          <thead><tr><th>Dilim</th><th>Bu dilimdeki matrah</th><th>Oran</th><th>Vergi</th></tr></thead>
          <tbody id="dokum-body">
            {ex1.satir.map((s) => (
