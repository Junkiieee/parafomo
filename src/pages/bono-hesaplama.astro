---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';

// Hazine bonosu / iskontolu tahvil (DİBS) — basit faiz konvansiyonu.
// Fiyat = Nominal / (1 + yıllık faiz × vade/365)  (Türkiye piyasa standardı: basit iskonto)
// Getiri = (Nominal / Fiyat − 1) × 365 / vade
function priceFromYield(nominal: number, annualRatePct: number, days: number) {
  const price = nominal / (1 + (annualRatePct / 100) * (days / 365));
  const gain = nominal - price;
  return { price, gain };
}
function yieldFromPrice(nominal: number, price: number, days: number) {
  const y = price > 0 ? (nominal / price - 1) * (365 / days) * 100 : 0;
  const gain = nominal - price;
  return { y, gain };
}

// Sunucuda varsayılan hesap — JS kapalıyken bile sayfa dolu (SEO + no-JS).
const D = { nominal: 100000, rate: 45, days: 175 };
const base = priceFromYield(D.nominal, D.rate, D.days);

const fmt = (n: number) =>
  new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 }).format(n);
const fmt0 = (n: number) =>
  new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));

// Aynı nominal (100.000 ₺) + 175 gün vade için faiz oranına göre alış fiyatı karşılaştırması.
const cmpNominal = 100000;
const cmpDays = 175;
const compareRows = [30, 40, 45, 50, 55].map((r) => {
  const { price, gain } = priceFromYield(cmpNominal, r, cmpDays);
  return { rate: r, price, gain };
});

const faq = [
  {
    q: 'Hazine bonosu (iskontolu tahvil) fiyatı nasıl hesaplanır?',
    a: 'İskontolu (kuponsuz) bono bugün nominal değerinin altında satılır, vade sonunda nominal değer üzerinden ödenir. Fiyat = Nominal ÷ (1 + yıllık faiz × vade gün ÷ 365) formülüyle bulunur. Örneğin 100.000 ₺ nominal, %45 yıllık faiz ve 175 gün vadede bononun bugünkü fiyatı yaklaşık 82.400 ₺ olur; aradaki fark vade sonunda kazancınızdır. ParaFOMO bono hesaplama aracı bu formülü otomatik uygular.',
  },
  {
    q: 'Bono getirisi (verim) nasıl bulunur?',
    a: 'Elinizde alış fiyatı varsa yıllık basit getiri şöyle hesaplanır: (Nominal ÷ Alış fiyatı − 1) × 365 ÷ vade gün × 100. Aracın "Fiyattan getiri" modunu seçip nominal, ödediğiniz fiyat ve kalan vadeyi girerek yıllık verimi anında görebilirsiniz. Bu, farklı fiyatlardan alınan bonoları karşılaştırmanın en doğru yoludur.',
  },
  {
    q: 'Bono ile tahvil arasındaki fark nedir?',
    a: 'Vadesi 1 yıldan (364 güne kadar) kısa olan devlet iç borçlanma senetleri "hazine bonosu", 1 yıl ve daha uzun vadeliler "devlet tahvili" olarak adlandırılır. Bonolar genelde kuponsuz/iskontoludur (bu araçtaki hesap); uzun vadeli tahviller ise dönemsel kupon ödeyebilir. İkisi de Hazine tarafından ihraç edilir ve devlet güvencesindedir.',
  },
  {
    q: 'Bono kazancından vergi (stopaj) kesilir mi?',
    a: 'Türkiye’de devlet iç borçlanma senetlerinin (DİBS) gelir vergisi stopajı zaman zaman değişir ve bazı dönemlerde gerçek kişiler için istisna/indirimli uygulanır. Bu araç kesinti öncesi (brüt) fiyat ve kazancı gösterir; güncel stopaj oranını aracı kurumunuzdan veya Hazine tebliğlerinden teyit edip net kazancı ona göre değerlendirin.',
  },
  {
    q: 'Bono almak mevduata göre mantıklı mı?',
    a: 'Bono, devlet güvencesiyle sabit bir vade-sonu getirisi kilitler; vade sonuna kadar tutarsanız faiz dalgalanmasından etkilenmezsiniz. Mevduatla kıyaslarken her ikisinin de aynı vadedeki net (vergi sonrası) getirisine bakın. Mevduat net getirisini Mevduat Faizi Hesaplama, paranızın enflasyona karşı gerçek kazancını ise Reel Faiz yazımızla değerlendirebilirsiniz.',
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Bono Hesaplama', url: '/bono-hesaplama' },
];
---

<BaseLayout
  title="Bono Hesaplama 2026 | Hazine Bonosu Fiyat ve Getiri Hesaplayıcı"
  description="Hazine bonosu (iskontolu tahvil) fiyatını ve getirisini anında hesapla: nominal, yıllık faiz ve vadeyi gir; alış fiyatı, kazanç ve yıllık verimi gör. İki yönlü hesap."
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Hesaplayıcı</p>
      <h1>Bono Hesaplama</h1>
      <p class="lede">
        <strong>Hazine bonosu / iskontolu tahvilin</strong> bugünkü alış fiyatını ve vade sonu
        kazancını hesapla. İstersen yönü çevir: elindeki <strong>fiyattan yıllık getiriyi</strong> bul.
      </p>
    </header>

    <div class="mode-row" role="group" aria-label="Hesap yönü">
      <button type="button" class="mode active" data-mode="price">Getiriden fiyat</button>
      <button type="button" class="mode" data-mode="yield">Fiyattan getiri</button>
    </div>

    <div class="calc-grid">
      <form class="calc-inputs" id="calc-form" autocomplete="off">
        <label>
          <span>Nominal değer (₺)</span>
          <input type="number" id="in-nominal" value={D.nominal} min="0" step="1000" inputmode="numeric" />
        </label>
        <label id="field-rate">
          <span>Yıllık basit faiz (%)</span>
          <input type="number" id="in-rate" value={D.rate} min="0" max="200" step="0.5" inputmode="decimal" />
        </label>
        <label id="field-price" hidden>
          <span>Alış fiyatı (₺)</span>
          <input type="number" id="in-price" value="82400" min="0" step="100" inputmode="numeric" />
        </label>
        <label>
          <span>Vade (gün)</span>
          <input type="number" id="in-days" value={D.days} min="1" max="3650" step="1" inputmode="numeric" />
        </label>
        <div class="preset-row" role="group" aria-label="Hızlı vade seçimi">
          <button type="button" class="preset" data-days="91">3 ay</button>
          <button type="button" class="preset" data-days="175">~6 ay</button>
          <button type="button" class="preset" data-days="364">~1 yıl</button>
          <button type="button" class="preset" data-days="728">2 yıl</button>
        </div>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label" id="out-main-label">Bugünkü alış fiyatı</span>
          <span class="result-value" id="out-main">₺{fmt0(base.price)}</span>
        </div>
        <div class="result-split">
          <div class="split-item">
            <span class="split-label" id="out-a-label">Nominal (vade sonu ödenen)</span>
            <span class="split-val" id="out-a">₺{fmt0(D.nominal)}</span>
          </div>
          <div class="split-item strong">
            <span class="split-label">Vade sonu kazanç (brüt)</span>
            <span class="split-val" id="out-gain">₺{fmt0(base.gain)}</span>
          </div>
        </div>
        <p class="result-note" id="out-note"></p>
      </div>
    </div>

    <p class="disclaimer">
      Bu araç yalnızca bilgilendirme amaçlıdır ve yatırım tavsiyesi değildir. Hesap, kuponsuz
      (iskontolu) hazine bonosunu ve basit faiz (piyasa iskonto) konvansiyonunu esas alır; kupon
      ödemeli tahvillerde ve farklı gün-sayım yöntemlerinde sonuç değişebilir. Gösterilen kazanç
      <strong>brüttür</strong> — güncel DİBS stopaj/vergi uygulamasını teyit ederek net kazancı değerlendirin.
    </p>

    <section class="prose-block">
      <h2>İskontolu bono fiyatı ve getirisi nasıl hesaplanır?</h2>
      <p>
        İskontolu hazine bonosu, nominal değerinin (ör. 100.000 ₺) <strong>altında</strong> satılır ve
        vade sonunda nominal değer üzerinden ödenir. Aradaki fark yatırımcının kazancıdır. Türkiye
        piyasasında yaygın <strong>basit iskonto</strong> formülü şöyledir:
      </p>
      <ul>
        <li><strong>Fiyat</strong> = Nominal ÷ (1 + yıllık faiz × vade gün ÷ 365)</li>
        <li><strong>Getiri</strong> = (Nominal ÷ Fiyat − 1) × 365 ÷ vade gün × 100</li>
      </ul>
      <p>
        Aşağıdaki tablo, <strong>100.000 ₺ nominal</strong> ve <strong>175 gün vade</strong> için yıllık
        faiz oranına göre ödeyeceğiniz fiyatı ve vade sonu kazancınızı gösterir. Faiz yükseldikçe
        bugün daha az öder, daha çok kazanırsınız:
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Yıllık faiz</th><th>Alış fiyatı</th><th>Vade sonu kazanç</th></tr>
          </thead>
          <tbody>
            {compareRows.map((r) => (
              <tr>
                <td>%{r.rate}</td>
                <td>₺{fmt0(r.price)}</td>
                <td><strong>₺{fmt0(r.gain)}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Bono mu, tahvil mi?</h2>
      <p>
        Vadesi <strong>1 yıldan kısa</strong> devlet iç borçlanma senetlerine <strong>hazine bonosu</strong>,
        <strong>1 yıl ve üzeri</strong> olanlara <strong>devlet tahvili</strong> denir. Bonolar genelde
        kuponsuz/iskontoludur (bu aracın hesabı); uzun vadeli tahviller dönemsel kupon ödeyebilir. İkisi de
        Hazine güvencesindedir. Ayrıntı için
        <a href="/blog/tahvil-nedir-devlet-tahvili-hazine-bonosu">Tahvil Nedir?</a> yazımıza bakın.
      </p>

      <h2>Aracı nasıl kullanmalısınız?</h2>
      <ul>
        <li><strong>Getiriden fiyat:</strong> Bilinen yıllık faizle bononun bugünkü fiyatını ve kazancını görün.</li>
        <li><strong>Fiyattan getiri:</strong> Ödediğiniz fiyatı girip yıllık verimi bulun — farklı tekliflerini karşılaştırmanın en doğru yolu.</li>
        <li><strong>Vergiyi unutmayın:</strong> Sonuç brüttür; güncel stopajı düşerek net kazancı değerlendirin.</li>
      </ul>
      <p class="cta-line">
        Bononun net getirisini alternatiflerle kıyasla:
        → <a href="/mevduat-faizi-hesaplama">mevduat faizi hesaplama</a> ile net mevduat getirisini,
        <a href="/blog/reel-faiz-nedir">reel faiz</a> ile enflasyona karşı gerçek kazancını,
        <a href="/bilesik-faiz-hesaplama">bileşik faiz hesaplama</a> ile uzun vadede paranın nasıl katlandığını gör.
      </p>
    </section>

    <section class="faq-block">
      <h2>Sıkça Sorulan Sorular</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <Newsletter />
  </div>

  <script is:inline>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf0 = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
      const nf2 = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 });
      let mode = 'price'; // 'price' = getiriden fiyat | 'yield' = fiyattan getiri

      function update() {
        const nominal = Math.max(0, +$('in-nominal').value || 0);
        const days = Math.min(3650, Math.max(1, +$('in-days').value || 1));

        if (mode === 'price') {
          const rate = Math.max(0, +$('in-rate').value || 0);
          const price = nominal / (1 + (rate / 100) * (days / 365));
          const gain = nominal - price;
          $('out-main-label').textContent = 'Bugünkü alış fiyatı';
          $('out-main').textContent = '₺' + nf0.format(Math.round(price));
          $('out-a-label').textContent = 'Nominal (vade sonu ödenen)';
          $('out-a').textContent = '₺' + nf0.format(Math.round(nominal));
          $('out-gain').textContent = '₺' + nf0.format(Math.round(gain));
          const totalRet = nominal > 0 ? (gain / price) * 100 : 0;
          $('out-note').textContent =
            `${days} günde toplam brüt getiri ≈ %${nf2.format(totalRet)} ` +
            `(yıllık basit %${nf2.format(rate)}).`;
        } else {
          const price = Math.max(0, +$('in-price').value || 0);
          const y = price > 0 ? (nominal / price - 1) * (365 / days) * 100 : 0;
          const gain = nominal - price;
          const totalRet = price > 0 ? (gain / price) * 100 : 0;
          $('out-main-label').textContent = 'Yıllık basit getiri';
          $('out-main').textContent = '%' + nf2.format(y);
          $('out-a-label').textContent = 'Vade sonu kazanç (brüt)';
          $('out-a').textContent = '₺' + nf0.format(Math.round(gain));
          $('out-gain').textContent = '%' + nf2.format(totalRet);
          document.querySelector('.split-item.strong .split-label').textContent = 'Vadedeki toplam getiri';
          $('out-note').textContent =
            `${days} gün vadede ödediğin ₺${nf0.format(Math.round(price))} için ` +
            `vade sonu ₺${nf0.format(Math.round(nominal))} alırsın.`;
        }

        document.querySelectorAll('.preset').forEach((b) => {
          b.classList.toggle('active', +b.dataset.days === days);
        });
      }

      function setMode(m) {
        mode = m;
        document.querySelectorAll('.mode').forEach((b) => b.classList.toggle('active', b.dataset.mode === m));
        $('field-rate').hidden = m !== 'price';
        $('field-price').hidden = m !== 'yield';
        // strong satır etiketi price modunda sabit kalsın
        if (m === 'price') document.querySelector('.split-item.strong .split-label').textContent = 'Vade sonu kazanç (brüt)';
        update();
      }

      ['in-nominal', 'in-rate', 'in-price', 'in-days'].forEach((id) => {
        $(id).addEventListener('input', update);
      });
      document.querySelectorAll('.mode').forEach((b) => {
        b.addEventListener('click', () => setMode(b.dataset.mode));
      });
      document.querySelectorAll('.preset').forEach((b) => {
        b.addEventListener('click', () => { $('in-days').value = b.dataset.days; update(); });
      });
      update();
    })();
  </script>

  <style>
    .calc-wrap { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.1rem 4rem; }
    .calc-head { text-align: center; margin-bottom: 1.4rem; }
    .eyebrow {
      text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem;
      font-weight: 700; color: var(--brand-deep); margin: 0 0 0.4rem;
    }
    .calc-head h1 { font-size: var(--step-4); margin: 0 0 0.6rem; line-height: 1.1; }
    .lede { color: var(--text-soft); font-size: var(--step-1); max-width: 620px; margin: 0 auto; }

    .mode-row { display: flex; gap: 0.4rem; justify-content: center; margin-bottom: 1rem; }
    .mode {
      font-family: var(--font-sans); font-size: 0.9rem; font-weight: 600; cursor: pointer;
      padding: 0.5rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm);
      background: var(--bg); color: var(--text-soft);
    }
    .mode:hover { border-color: var(--brand-2); }
    .mode.active { background: var(--brand-2); border-color: var(--brand-2); color: #fff; }

    .calc-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 1.4rem; box-shadow: var(--shadow-soft);
    }
    .calc-inputs { display: flex; flex-direction: column; gap: 0.9rem; margin: 0; }
    .calc-inputs label { display: flex; flex-direction: column; gap: 0.35rem; }
    .calc-inputs span { font-size: 0.85rem; font-weight: 600; color: var(--text-soft); }
    .calc-inputs input {
      font-family: var(--font-sans); font-size: 1.15rem; font-weight: 600; color: var(--text);
      padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm);
      background: var(--bg); width: 100%;
    }
    .calc-inputs input:focus { outline: none; border-color: var(--brand-2); box-shadow: 0 0 0 3px var(--brand-soft); }
    .preset-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.2rem; }
    .preset {
      font-family: var(--font-sans); font-size: 0.82rem; font-weight: 600; cursor: pointer;
      padding: 0.35rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm);
      background: var(--bg); color: var(--text-soft);
    }
    .preset:hover { border-color: var(--brand-2); }
    .preset.active { background: var(--brand-2); border-color: var(--brand-2); color: #fff; }

    .calc-results {
      display: flex; flex-direction: column; justify-content: center; gap: 1rem;
      background: var(--brand-tint); border-radius: var(--radius); padding: 1.2rem;
    }
    .result-main { display: flex; flex-direction: column; gap: 0.2rem; }
    .result-label { font-size: 0.85rem; color: var(--text-soft); font-weight: 600; }
    .result-value { font-family: var(--font-serif); font-size: clamp(1.9rem, 1.4rem + 2vw, 2.7rem); font-weight: 600; color: var(--brand-ink); line-height: 1.05; }
    .result-split { display: flex; flex-direction: column; gap: 0.55rem; }
    .split-item { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.5rem; }
    .split-item.strong { border-top: 1px solid var(--border); padding-top: 0.55rem; margin-top: 0.15rem; }
    .split-item.strong .split-val { font-size: 1.1rem; color: var(--brand-ink); }
    .split-label { font-size: 0.85rem; color: var(--text-soft); }
    .split-val { font-weight: 700; font-size: 0.98rem; }
    .result-note { font-size: 0.82rem; color: var(--brand-ink); margin: 0; font-weight: 500; }

    .disclaimer { font-size: 0.8rem; color: var(--text-muted); margin: 1.2rem 0 2.5rem; line-height: 1.5; }

    .prose-block, .faq-block { margin-top: 2.5rem; }
    .prose-block h2, .faq-block h2 { font-size: var(--step-2); margin: 0 0 0.8rem; }
    .prose-block p, .prose-block li { color: var(--text-soft); line-height: 1.7; }
    .prose-block ul { padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .prose-block h2:not(:first-child) { margin-top: 1.8rem; }
    .cta-line { background: var(--surface); padding: 0.9rem 1.1rem; border-radius: var(--radius-sm); border-left: 3px solid var(--brand-2); }

    .table-wrap { overflow-x: auto; margin: 0.4rem 0 0.6rem; }
    .prose-block table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .prose-block th, .prose-block td { text-align: left; padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--border); }
    .prose-block thead th { color: var(--text); font-weight: 700; background: var(--surface); }

    .faq-block details { border-bottom: 1px solid var(--border); padding: 0.9rem 0; }
    .faq-block summary { font-weight: 600; cursor: pointer; color: var(--text); list-style: none; }
    .faq-block summary::-webkit-details-marker { display: none; }
    .faq-block summary::after { content: '+'; float: right; color: var(--brand-2); font-weight: 700; }
    .faq-block details[open] summary::after { content: '−'; }
    .faq-block details p { color: var(--text-soft); line-height: 1.7; margin: 0.7rem 0 0; }

    @media (max-width: 600px) {
      .calc-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
