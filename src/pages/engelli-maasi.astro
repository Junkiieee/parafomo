---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import em from '../../data/emekli-memur.json';
import au from '../../data/asgari-ucret.json';
import sa from '../../data/sosyal-aylik-2026.json';
// Ocak 2027 memur zammı tahmini /memur-zammi-hesaplama ile ORTAK modülde (aynı TÜFE, aynı varsayım).
import { memurProj, remaining, knownKeys } from '../data/zam2027';

// 2022 sayılı Kanun aylıkları (yaşlı/65 yaş, engelli, 18 yaş altı engelli yakını). Kural ve güncelleme adımları
// data/sosyal-aylik-2026.json → _aciklama. Özet: aylık = Y(G × K) + Y(%5 × Y(G × K)), Y = kuruşa yarım-yukarı.
// G: 65 yaş 4.387 (Kanun md. 1); %70+ 5.253, %40–69 ve engelli yakını 3.502 (Bütçe Kanunu K cetveli md. 4 —
// Kanun md. 2’deki 4.860 / 3.240 yerine; Yönetmelik md. 9/5). %5: 5454 s. K. md. 1(e) ek ödemesi.
// Doğrulama 2026-10-18: K = 1,575512 ile 7.257,36 / 8.689,97 / 5.793,31 (ASHB broşürü) birebir; tek adımda
// ×1,05 yapmak %40–69’da 5.793,32 verip 1 kuruş sapıyor. Hesap tamsayı kuruşla yapılır (kayan nokta hatası yok).

type Tur = 'engelli' | 'agirEngelli' | 'yasli' | 'engelliYakini';
const TURLER: { key: Tur; label: string }[] = [
  { key: 'engelli', label: 'Engelli aylığı (%40–69)' },
  { key: 'agirEngelli', label: 'Engelli aylığı (%70 ve üzeri)' },
  { key: 'yasli', label: '65 yaş (yaşlı) aylığı' },
  { key: 'engelliYakini', label: '18 yaş altı engelli yakını aylığı' },
];
type Butce = { durum: string; ad: string; agirEngelli: number; engelli: number; kaynak: string };
const BUTCE = sa.butce as Record<string, Butce>;
const butceYil = (yil: number): Butce => BUTCE[String(yil)] ?? BUTCE[Object.keys(BUTCE).sort().at(-1) as string];
const gostergeler = (yil: number): Record<Tur, number> => {
  const b = butceYil(yil);
  return { yasli: sa.kanun.yasli, agirEngelli: b.agirEngelli, engelli: b.engelli, engelliYakini: b.engelli };
};
const K6 = (k: number) => Math.round(k * 1e6); // katsayı, milyonda bir (tamsayı)
const EK = sa.ekOdeme.oran; // %5
type Kalem = { g: number; taban: number; ek: number; toplam: number }; // kuruş
const hesapla = (yil: number, k6: number): Record<Tur, Kalem> => {
  const G = gostergeler(yil);
  const out = {} as Record<Tur, Kalem>;
  for (const { key } of TURLER) {
    const taban = Math.floor((G[key] * k6 + 5000) / 10000); // Y(G × K)
    const ek = Math.floor((taban * EK + 50) / 100); // Y(%5 × taban)
    out[key] = { g: G[key], taban, ek, toplam: taban + ek };
  }
  return out;
};
const kurusMap = (o: Record<string, unknown>) =>
  Object.fromEntries(TURLER.map(({ key }) => [key, Math.round((o[key] as number) * 100)])) as Record<Tur, number>;

const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const donemAd = (d: string) => (+d.slice(5, 7) <= 6 ? `Ocak–Haziran ${d.slice(0, 4)}` : `Temmuz–Aralık ${d.slice(0, 4)}`);
const ayAd = (d: string) => `${AYLAR[+d.slice(5, 7) - 1]} ${d.slice(0, 4)}`;
const tl2 = (k: number) => (k / 100).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const tl0 = (k: number) => Math.round(k / 100).toLocaleString('tr-TR');
const nf = (n: number, d = 2) => n.toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d });

// --- Dönem durumu ---------------------------------------------------------------------------------------------
// tahmin / kesin-zam: katsayı hâlâ Temmuz 2026’nınki → resmî tutar + Ocak 2027 tahmini (zam2027).
// katsayi: emekli-memur.json’a yeni dönem katsayısı girdi → yeni tutarlar formülle (ASHB duyurusu beklenirken).
// resmi: yeni dönem ASHB tutarları sosyal-aylik-2026.json → resmi’ye işlendi (eski dönem onceki’de).
const R = sa.resmi;
const kNow = em.memurKatsayi.aylikKatsayi;
const resmiDonem = K6(kNow) === K6(R.katsayi);
const final = remaining === 0;
const zam = memurProj.zam;
const mod: 'tahmin' | 'kesin-zam' | 'katsayi' | 'resmi' = !resmiDonem
  ? 'katsayi'
  : R.donem === '2026-07'
    ? final ? 'kesin-zam' : 'tahmin'
    : 'resmi';
const tahminModu = mod === 'tahmin' || mod === 'kesin-zam';
const RESMI = kurusMap(R);
const curYil = +(resmiDonem ? R.donem : em.donem).slice(0, 4);
const CUR = hesapla(curYil, K6(kNow)); // yürürlükteki katsayıyla kalem kalem (nasıl hesaplanır tablosu)
if (resmiDonem) {
  for (const { key } of TURLER) {
    if (CUR[key].toplam !== RESMI[key]) {
      console.warn(`[engelli-maasi] ${key}: formül ${CUR[key].toplam} ≠ resmî ${RESMI[key]} kuruş → data/sosyal-aylik-2026.json’u kontrol et`);
    }
  }
}
const k27 = Math.round(K6(kNow) * (1 + zam)); // tahmini Ocak 2027 katsayısı (milyonda bir)
const PROJ = hesapla(2027, k27);
// ESKI = zam öncesi dönem (resmî), YENI = zam sonrası dönem
const ESKI: Record<Tur, number> = mod === 'resmi' ? kurusMap(sa.onceki) : RESMI;
const eskiDonem = mod === 'resmi' ? sa.onceki.donem : R.donem;
const yeniDonem = tahminModu ? '2027-01' : mod === 'katsayi' ? em.donem : R.donem;
const YENI: Record<Tur, number> = tahminModu
  ? (Object.fromEntries(TURLER.map(({ key }) => [key, PROJ[key].toplam])) as Record<Tur, number>)
  : mod === 'katsayi'
    ? (Object.fromEntries(TURLER.map(({ key }) => [key, CUR[key].toplam])) as Record<Tur, number>)
    : RESMI;
const yeniKesin = !tahminModu; // kuruşu kuruşuna mı?
const eskiAd = donemAd(eskiDonem);
const yeniAy = ayAd(yeniDonem); // ör. "Ocak 2027"
const yeniEtiket = mod === 'tahmin' ? 'tahmini' : mod === 'kesin-zam' ? 'kesinleşen zamla' : mod === 'katsayi' ? 'HMB katsayısıyla' : 'resmî';
const yeniTxt = (t: Tur) => (yeniKesin ? `₺${tl2(YENI[t])}` : `≈ ₺${tl0(YENI[t])}`);
const yeniLira = (t: Tur) => (yeniKesin ? tl2(YENI[t]) : `yaklaşık ${tl0(YENI[t])}`);
const sonAy = knownKeys.length ? AYLAR[+knownKeys[knownKeys.length - 1].slice(5) - 1] : 'Temmuz';
const zamTxt = `%${nf(zam * 100)}`;
const B27 = butceYil(2027);
const KANUN = sa.kanun as Record<string, number>; // kanundaki göstergeler (tabloda "kanunda …" notu)

// --- Gelir sınırı: net asgari ücretin 1/3’ü (Kanun md. 1 ve 2). 2026: 28.075,50 / 3 = 9.358,50 (ASHB broşürü) ---
type AU = { yil: number; brut?: number | null; net?: number | null };
const netOf = (brut: number) => {
  const k = Math.round(brut * 100);
  return (k - Math.round((k * 14) / 100) - Math.round(k / 100)) / 100; // SGK %14 + işsizlik %1
};
const auNet = (y: AU) => y.net ?? netOf(y.brut as number);
const SINIR = Math.round((au.guncel.net / 3) * 100); // kuruş
const SINIR_YIL = au.guncel.yil;
const yeniAU = au.yeni as AU | null;
const SINIR_YENI = yeniAU && (yeniAU.net || yeniAU.brut) ? Math.round((auNet(yeniAU) / 3) * 100) : null;
const IKI_UC = Math.round(((au.guncel.net * 2) / 3) * 100);
if (SINIR_YIL === 2026 && SINIR !== Math.round(R.gelirSiniri * 100)) {
  console.warn(`[engelli-maasi] gelir sınırı ${SINIR} ≠ ASHB ${R.gelirSiniri * 100} kuruş`);
}

// Yıl ekleri: 2026’da / 2027’de, 2026’dan / 2027’den (son rakamın okunuşuna göre; 0 → onlar basamağı)
const YIL_DA: Record<string, string> = { 1: '’de', 2: '’de', 3: '’te', 4: '’te', 5: '’te', 6: '’da', 7: '’de', 8: '’de', 9: '’da' };
const ONLAR_DA: Record<string, string> = { 1: '’da', 2: '’de', 3: '’da', 4: '’ta', 5: '’de', 6: '’ta', 7: '’de', 8: '’de', 9: '’da' };
const yilDa = (y: number | string) => {
  const s = String(y);
  return `${s}${s.endsWith('0') ? ONLAR_DA[s.at(-2) as string] : YIL_DA[s.at(-1) as string]}`;
};
const yilDan = (y: number | string) => yilDa(y).replace(/’([dt])([ae])$/, '’$1$2n');
// "5 Ocak’ta", "5 Ağustos’ta" — bulunma eki ay adına göre
const BULUNMA = ['’ta', '’ta', '’ta', '’da', '’ta', '’da', '’da', '’ta', '’de', '’de', '’da', '’ta'];
const odemeGun = (iso: string) => `${+iso.slice(8, 10)} ${AYLAR[+iso.slice(5, 7) - 1]}${BULUNMA[+iso.slice(5, 7) - 1]}`;

const faq = [
  {
    q: 'Ocak 2027’de engelli maaşı ne kadar olacak?',
    a:
      mod === 'tahmin'
        ? `Engelli aylıkları Ocak’ta memur aylık zammı oranında artar. Temmuz–${sonAy} enflasyonuyla Ocak 2027 memur zammı tahmini ${zamTxt}; bu oranla %40–69 engelli aylığı ${tl2(ESKI.engelli)} liradan ${yeniLira('engelli')} liraya, %70 ve üzeri engelli aylığı ${tl2(ESKI.agirEngelli)} liradan ${yeniLira('agirEngelli')} liraya çıkar. Kesin tutar, Aralık enflasyonu açıklanıp Hazine ve Maliye Bakanlığı Ocak katsayısını genelgeyle duyurunca belli olur.`
        : mod === 'kesin-zam'
          ? `Ocak 2027 memur zammı ${zamTxt} olarak kesinleşti; engelli aylıkları da bu oranda artar. %40–69 engelli aylığı ${tl2(ESKI.engelli)} liradan ${yeniLira('engelli')} liraya, %70 ve üzeri engelli aylığı ${tl2(ESKI.agirEngelli)} liradan ${yeniLira('agirEngelli')} liraya çıkar. Kuruşu kuruşuna tutar, Hazine ve Maliye Bakanlığı’nın Ocak başında genelgeyle açıklayacağı memur aylık katsayısıyla hesaplanır.`
          : `${yeniAy} itibarıyla %40–69 engelli aylığı ${yeniLira('engelli')} lira, %70 ve üzeri engelli aylığı ${yeniLira('agirEngelli')} lira (${eskiAd}: ${tl2(ESKI.engelli)} ve ${tl2(ESKI.agirEngelli)} lira). Tutarlar ${mod === 'katsayi' ? 'Hazine ve Maliye Bakanlığı’nın yeni memur aylık katsayısıyla, Bakanlığın uyguladığı yöntemle hesaplandı' : 'Aile ve Sosyal Hizmetler Bakanlığı’nın açıkladığı tutarlardır'}.`,
  },
  {
    q: '65 yaş aylığı 2027’de ne kadar olacak?',
    a: tahminModu
      ? `65 yaş aylığı (yaşlı aylığı) ${eskiAd} döneminde aylık ${tl2(ESKI.yasli)} lira. Ocak 2027’de memur zammı oranında artar; ${mod === 'tahmin' ? 'tahmini' : 'kesinleşen'} ${zamTxt} zamla ${yeniLira('yasli')} liraya çıkar. 2026’da Ocak artışı Şubat ödemesine yansımıştı; Ocak 2027 artışının da Şubat ödemesiyle hesaplara geçmesi beklenir.`
      : `65 yaş aylığı ${yeniAy} itibarıyla ${yeniLira('yasli')} lira (${eskiAd}: ${tl2(ESKI.yasli)} lira). Aylık her Ocak ve Temmuz’da memur aylık zammı oranında artar.`,
  },
  {
    q: '%70 engelli maaşı ne kadar?',
    a: `%70 ve üzeri engelli olanlara (başkasının yardımı olmadan hayatını sürdüremeyecek derecede engelli olduğu sağlık kurulu raporuyla belgelenenlere) bağlanan engelli aylığı ${eskiAd} döneminde aylık ${tl2(ESKI.agirEngelli)} lira; %40–69 engellilerde ${tl2(ESKI.engelli)} lira. ${yeniAy} için ${yeniEtiket} tutar %70 ve üzeri engellilerde ${yeniLira('agirEngelli')}, %40–69 engellilerde ${yeniLira('engelli')} lira.`,
  },
  {
    q: 'Engelli maaşı almanın şartları nelerdir?',
    a: `18 yaşını doldurmuş, en az %40 engelli olduğunu sağlık kurulu raporuyla belgeleyen Türk vatandaşları başvurabilir. Herhangi bir sosyal güvenlik kurumundan gelir veya aylık almamak, zorunlu sigortalı bir işte çalışmamak ve nafaka bağlanmamış olmak gerekir. Hanede kişi başına düşen aylık gelir net asgari ücretin üçte birinden (${yilDa(SINIR_YIL)} ${tl2(SINIR)} lira) az olmalıdır. %40–69 engellilerde ayrıca talebine rağmen İŞKUR tarafından işe yerleştirilememiş olmak aranır. Başvuru ikamet edilen yerdeki Sosyal Yardımlaşma ve Dayanışma Vakfı’na ya da e-Devlet üzerinden yapılır.`,
  },
  {
    q: 'Engelli maaşı ile evde bakım maaşı aynı şey mi?',
    a: `Hayır. Engelli aylığı 2022 sayılı Kanun’la engelli kişinin kendisine (18 yaş altı çocuklarda bakımını üstlenen yakınına) bağlanır. Evde bakım yardımı ise bakıma muhtaç engellinin evde bakımı için 2828 sayılı Kanun’un ek 7. maddesiyle yapılan ayrı bir ödemedir: tutarı 10.000 gösterge ile memur aylık katsayısının çarpımıdır, gelir sınırı da farklıdır (hane kişi başı gelirin net asgari ücretin üçte ikisinden az olması). Şartlar ve tutar için evde bakım maaşı sayfamıza bakabilirsiniz.`,
  },
  {
    q: 'Engelli maaşı ve 65 yaş aylığı ne zaman yatar?',
    a: `Aylıklar her ay peşin ödenir. Aile ve Sosyal Hizmetler Bakanlığı ödemeleri ayın ilk günlerinde hesaplara yatırmaya başlar; örneğin Ocak 2026 ödemesi ${odemeGun(sa.odeme.ocak2026)}, Ağustos 2026 ödemesi ${odemeGun(sa.odeme.agustos2026)} başladı. Ocak ve Temmuz’daki katsayı artışı sonraki ayın ödemesine yansır: Temmuz 2026 farkı Ağustos aylıklarıyla birlikte ödendi.`,
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Hesaplama Araçları', url: '/hesaplama-araclari/' },
  { name: 'Engelli Maaşı ve 65 Yaş Aylığı', url: '/engelli-maasi/' },
];

const title =
  mod === 'tahmin'
    ? 'Engelli Maaşı ve 65 Yaş Aylığı Ocak 2027: Ne Kadar Olacak? (2026 Tutarları)'
    : mod === 'kesin-zam'
      ? 'Engelli Maaşı ve 65 Yaş Aylığı Ocak 2027: Kesinleşen Zamla Yeni Tutarlar'
      : `Engelli Maaşı ve 65 Yaş Aylığı ${yeniAy}: Zamlı Tutarlar`;
const h1 = tahminModu ? 'Engelli Maaşı ve 65 Yaş Aylığı (Ocak 2027)' : `Engelli Maaşı ve 65 Yaş Aylığı ${yeniAy}`;
const descUzun = tahminModu
  ? `Engelli maaşı ${eskiAd}: %40–69 ₺${tl2(ESKI.engelli)}, %70+ ₺${tl2(ESKI.agirEngelli)}; 65 yaş aylığı ₺${tl2(ESKI.yasli)}. Ocak 2027 ${yeniEtiket} tutarlar, hesaplama ve gelir şartı.`
  : `Engelli maaşı ${yeniAy}: %40–69 ₺${tl2(YENI.engelli)}, %70+ ₺${tl2(YENI.agirEngelli)}; 65 yaş aylığı ₺${tl2(YENI.yasli)}. Hesaplama yöntemi, gelir şartı ve ödeme günleri.`;
const description = descUzun.length <= 158 ? descUzun : descUzun.replace(/, hesaplama.*$|\. Hesaplama.*$/, '.');

const guncel = sa.dogrulama > em.dogrulandi ? sa.dogrulama : em.dogrulandi;
const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Engelli aylığı, 65 yaş aylığı ve engelli yakını aylığı tutarları (2022 sayılı Kanun)',
  description: `2022 sayılı Kanun aylıklarının ${eskiAd} resmî tutarları, gösterge ve katsayıya göre hesaplanışı ve ${yeniAy} ${yeniEtiket} tutarları.`,
  url: 'https://parafomo.com/engelli-maasi/',
  dateModified: guncel,
  creator: { '@type': 'Organization', name: 'ParaFOMO', url: 'https://parafomo.com/' },
  isBasedOn: [R.kaynak, sa.kanun.kaynak, butceYil(curYil).kaynak],
  license: 'https://creativecommons.org/licenses/by/4.0/',
};
const updatedLabel = new Date(guncel + 'T12:00:00').toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

// Hesaplayıcıya giden veri (kuruş)
const AYLIK = Object.fromEntries(TURLER.map(({ key }) => [key, { simdi: tahminModu ? ESKI[key] : YENI[key], yeni: YENI[key] }]));
---

<BaseLayout
  title={title}
  description={description}
  faq={faq}
  breadcrumbs={breadcrumbs}
  image="/og/engelli-maasi.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(dataset)} />
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Sosyal Yardım · 2022 Sayılı Kanun Aylıkları</p>
      <h1>{h1}</h1>
      {tahminModu ? (
        <p class="lede">
          Engelli aylığı %40–69 engellilerde <strong>₺{tl2(ESKI.engelli)}</strong>, %70 ve üzeri engellilerde
          <strong> ₺{tl2(ESKI.agirEngelli)}</strong>; 65 yaş aylığı <strong>₺{tl2(ESKI.yasli)}</strong> ({eskiAd}, Aile ve
          Sosyal Hizmetler Bakanlığı). Ocak 2027’de memur zammı kadar artacak: {mod === 'tahmin' ? 'tahmini' : 'kesinleşen'} zam
          <strong> {zamTxt}</strong>.
        </p>
      ) : (
        <p class="lede">
          {yeniAy} itibarıyla engelli aylığı %40–69 engellilerde <strong>₺{tl2(YENI.engelli)}</strong>, %70 ve üzeri
          engellilerde <strong>₺{tl2(YENI.agirEngelli)}</strong>; 65 yaş aylığı <strong>₺{tl2(YENI.yasli)}</strong>
          ({mod === 'katsayi' ? 'yeni memur aylık katsayısıyla hesaplandı' : 'Bakanlığın açıkladığı tutarlar'}).
        </p>
      )}
    </header>

    <div class="kpi-row">
      {TURLER.map(({ key, label }) => (
        <div class="kpi">
          <span class="kpi-label">{label}</span>
          <span class="kpi-val">₺{tl2(tahminModu ? ESKI[key] : YENI[key])}</span>
          <span class="kpi-sub">
            {tahminModu ? `${eskiAd} · Ocak 2027 ${yeniEtiket}: ${yeniTxt(key)}` : `${yilDan(yeniAy)} itibaren · önce ₺${tl2(ESKI[key])}`}
          </span>
        </div>
      ))}
    </div>

    <section class="table-block" id="ocak-2027">
      <h2>{tahminModu ? 'Ocak 2027’de engelli maaşı ve 65 yaş aylığı ne kadar olacak?' : `${yeniAy} zamlı tutarlar`}</h2>
      <p class="table-intro">
        {mod === 'tahmin' && (
          <>
            Aylıklar her Ocak ve Temmuz’da <strong>memur aylık zammı</strong> oranında artar. Ocak 2027 memur zammı
            Temmuz–{sonAy} enflasyonu ve kalan {remaining} ay için varsayımla <a href="/memur-zammi-hesaplama/">tahmini
            {zamTxt}</a>; tablo bu oranla hesaplandı.
          </>
        )}
        {mod === 'kesin-zam' && (
          <>
            Ocak 2027 memur zammı <a href="/memur-zammi-hesaplama/">{zamTxt} olarak kesinleşti</a>; tablo kesinleşen zam
            oranıyla hesaplandı. Resmî katsayıyı Hazine ve Maliye Bakanlığı Ocak başında genelgeyle açıklar, tutarlar
            kuruş düzeyinde ona göre netleşir.
          </>
        )}
        {mod === 'katsayi' && (
          <>
            {yeniAy} tutarları Hazine ve Maliye Bakanlığı’nın yeni memur aylık katsayısıyla
            ({nf(kNow, 6)}), Bakanlığın uyguladığı yöntemle hesaplandı. Aile ve Sosyal Hizmetler Bakanlığı tutarları
            ayrıca duyurur.
          </>
        )}
        {mod === 'resmi' && <>Tutarlar Aile ve Sosyal Hizmetler Bakanlığı’nın açıkladığı rakamlardır.</>}
      </p>
      <div class="table-scroll">
        <table class="rate-table wide">
          <thead>
            <tr><th>Aylık türü</th><th>{eskiAd}</th><th>{yeniAy} ({yeniEtiket})</th><th>Aylık artış</th></tr>
          </thead>
          <tbody>
            {TURLER.map(({ key, label }) => (
              <tr>
                <td>{label}</td>
                <td>₺{tl2(ESKI[key])}</td>
                <td><strong>{yeniTxt(key)}</strong></td>
                <td>+₺{tl0(YENI[key] - ESKI[key])}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        {tahminModu
