  <script is:inline define:vars={{ AYLIK, SINIR, YENI_KESIN: yeniKesin }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const f2 = (k) => (k / 100).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const f0 = (k) => Math.round(k / 100).toLocaleString('tr-TR');
      function update() {
        const tur = $('in-tur').value;
        const yasli = tur === 'yasli';
        $('wrap-kisi').hidden = yasli;
        $('wrap-es').hidden = !yasli;
        $('lbl-gelir').textContent = yasli ? 'Sizin ve eşinizin toplam aylık net geliri (₺)' : 'Hanenin toplam aylık net geliri (₺)';
        const gelir = Math.max(0, +$('in-gelir').value || 0);
        const kisi = yasli ? +$('in-es').value : Math.max(1, Math.round(+$('in-kisi').value || 1));
        const kb = Math.round((gelir * 100) / kisi);
        const ok = kb < SINIR;
        $('out-kb').textContent = '₺' + f2(kb);
        $('out-aylik').textContent = '₺' + f2(AYLIK[tur].simdi);
        const y = $('out-yeni');
        if (y) y.textContent = YENI_KESIN ? '₺' + f2(AYLIK[tur].yeni) : '≈ ₺' + f0(AYLIK[tur].yeni);
        const note = $('out-note');
        note.textContent = ok
          ? 'Kişi başı geliriniz sınırın altında: gelir şartını karşılıyor görünüyorsunuz. Diğer şartlara ve Vakfın incelemesine bakılır.'
          : 'Kişi başı geliriniz sınırın ' + (kb === SINIR ? 'tam üzerinde' : '₺' + f2(kb - SINIR) + ' üzerinde') + '; bu durumda aylık bağlanmaz.';
        note.classList.toggle('ok', ok);
        note.classList.toggle('no', !ok);
      }
      ['in-tur', 'in-gelir', 'in-kisi', 'in-es'].forEach((id) => {
        $(id).addEventListener('input', update);
        $(id).addEventListener('change', update);
      });
      update();
    })();
  </script>

