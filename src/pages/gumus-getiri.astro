---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import data from '../../data/gumus-getiri.json';
import gold from '../../data/altin-getiri.json';

type Period = {
  label: string; years?: number;
  gram_tl_then: number; gram_tl_now: number; return_tl_pct: number;
  oz_usd_then: number; oz_usd_now: number; return_usd_pct: number;
  gold_silver_ratio_then?: number;
};

const periods = (data.periods ?? []) as Period[];
const ytd = data.ytd as Period;
const goldPeriods = (gold.periods ?? []) as Period[];
const updated = new Date(data.updated).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const fmt = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmt0 = (n: number) => n.toLocaleString('tr-TR', { maximumFractionDigits: 0 });
const fmt1 = (n: number) => n.toLocaleString('tr-TR', { maximumFractionDigits: 1 });
const pct = (n: number) => (n > 0 ? '+' : '') + fmt1(n) + '%';
const toneOf = (n: number) => (n > 0 ? 'up' : n < 0 ? 'down' : 'flat');

const ten = periods.find((p) => p.years === 10) ?? periods[periods.length - 1];
const seed = 10000;
const gramsThen = seed / ten.gram_tl_then;
const valueNow = gramsThen * ten.gram_tl_now;

// Gümüş mü altın mı — aynı dönemlerde TL getirisi yan yana
const vs = [
  { label: 'Yıl başından beri', s: ytd.return_tl_pct, g: (gold.ytd as Period).return_tl_pct },
  ...periods.map((p) => {
    const gp = goldPeriods.find((x) => x.years === p.years);
    return gp ? { label: `Son ${p.label}`, s: p.return_tl_pct, g: gp.return_tl_pct } : null;
  }).filter((x): x is { label: string; s: number; g: number } => x !== null),
];
const silverWins = vs.filter((r) => r.s > r.g).length;
const goldTen = goldPeriods.find((x) => x.years === ten.years);
const tenWinner = goldTen && ten.return_tl_pct > goldTen.return_tl_pct ? 'gümüş' : 'altın';

const ratioNow = data.gold_silver_ratio_now;
const ratioAvg = data.gold_silver_ratio_avg;

const faqs = [
  {
    q: `Gümüş son ${ten.years} yılda ne kadar kazandırdı?`,
    a: `Gram gümüş son ${ten.years} yılda TL bazında %${fmt0(ten.return_tl_pct)}, dolar (ons) bazında %${fmt0(ten.return_usd_pct)} değer kazandı. TL getirisinin çok yüksek görünmesinin büyük kısmı Türk lirasının dolar karşısındaki değer kaybından gelir; gümüşün döviz bazlı getirisi ons fiyatındaki değişimdir.`,
  },
  {
    q: 'Gümüş mü altın mı daha çok kazandırdı?',
    a: goldTen
      ? `Son ${ten.years} yılda TL bazında gümüş %${fmt0(ten.return_tl_pct)}, gram altın %${fmt0(goldTen.return_tl_pct)} kazandırdı — bu dönemin kazananı ${tenWinner}. Tablodaki dönemlerde gümüş ${silverWins} / ${vs.length} kez öne geçti. Gümüş altından çok daha oynaktır: yükselişte daha hızlı çıkar, düşüşte daha sert iner. (Geçmiş getiri gelecek getirinin garantisi değildir.)`
      : 'Karşılaştırma için altın verisi şu an yok; altın getirisi sayfasına bakın.',
  },
  {
    q: 'Altın/gümüş oranı nedir, ne işe yarar?',
    a: `Bir ons altının kaç ons gümüş ettiğini gösterir. Bugün yaklaşık ${fmt1(ratioNow)}; son 10 yılda aylık kapanışlarda ${fmt1(data.gold_silver_ratio_min)} ile ${fmt1(data.gold_silver_ratio_max)} arasında gezdi, ortalaması ${fmt1(ratioAvg)}. Oran ortalamanın üstündeyken gümüş altına göre "ucuz", altındayken "pahalı" kabul edilir; ama bu bir al-sat sinyali değil, yalnızca göreli fiyat göstergesidir.`,
  },
  {
    q: 'Gram gümüş fiyatı nasıl hesaplanıyor, kesin mi?',
    a: 'Gram gümüş TL ≈ (ons gümüş USD ÷ 31,1035) × USD/TRY. Ons gümüş (SI=F) ve kur (USDTRY=X) Yahoo Finance aylık kapanışlarıdır. Gösterge fiyattır: kuyumcu ve banka alış-satış makası, işçilik ve KDV nedeniyle gerçek alım-satım fiyatı farklıdır — fiziki gümüşte makas altından genellikle daha geniştir.',
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Gram gümüş TL ve dolar bazında tarihsel getiri (1, 3, 5, 10 yıl)',
  description: 'Gram gümüşün yıl başından beri ve 1/3/5/10 yıllık TL ve USD (ons) getirisi, altın/gümüş oranı. Her gün güncellenir.',
  url: 'https://parafomo.com/gumus-getiri/',
  dateModified: data.updated,
  isAccessibleForFree: true,
  creator: { '@id': 'https://parafomo.com/#organization' },
  distribution: { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://parafomo.com/gumus-getiri.json' },
};
---

<BaseLayout
  title={`Gümüş Ne Kadar Kazandırdı? 1, 5, 10 Yıllık Getiri ve Gümüş mü Altın mı`}
  description={`Gram gümüş son ${ten.years} yılda TL bazında %${fmt0(ten.return_tl_pct)}, dolar bazında %${fmt0(ten.return_usd_pct)} kazandırdı. Gümüşün 1, 3, 5, 10 yıllık getirisi, altınla karşılaştırma ve altın/gümüş oranı — her gün güncel.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(datasetLd)} />

  <section class="container gr-hero">
    <span class="eyebrow"><span class="pulse"></span> Özgün veri · Gümüş getirisi</span>
    <h1>Gümüş Ne Kadar Kazandırdı?</h1>
    <p class="lede soft">
      Gram gümüşü 1, 3, 5 ve 10 yıl önce alsaydınız bugün elinizde ne olurdu? TL ve dolar (ons)
      bazında gerçek getiri, aynı dönemde altınla karşılaştırma ve altın/gümüş oranı — her gün güncel.
    </p>
    <p class="gr-upd">Son güncelleme: {updated} · Gram gümüş ≈ {fmt(data.gram_tl_now)} TL · Kaynak: Yahoo Finance</p>
  </section>

  <section class="container gr-stats">
    <div class="stat card">
      <span class={`stat-num ${ten.return_tl_pct >= 0 ? 'up' : 'down'}`}>{pct(ten.return_tl_pct)}</span>
      <span class="stat-lbl">{ten.years} yıllık getiri (TL)</span>
    </div>
    <div class="stat card">
      <span class={`stat-num ${ten.return_usd_pct >= 0 ? 'up' : 'down'}`}>{pct(ten.return_usd_pct)}</span>
      <span class="stat-lbl">{ten.years} yıllık getiri (dolar / ons)</span>
    </div>
    <div class="stat card">
      <span class={`stat-num ${ytd.return_tl_pct >= 0 ? 'up' : 'down'}`}>{pct(ytd.return_tl_pct)}</span>
      <span class="stat-lbl">Yıl başından beri (TL)</span>
    </div>
    <div class="stat card">
      <span class="stat-num">{fmt1(ratioNow)}</span>
      <span class="stat-lbl">Altın/gümüş oranı (10 yıl ort. {fmt1(ratioAvg)})</span>
    </div>
  </section>

  <section class="container gr-section">
    <h2 class="gr-h2">Gümüş getiri tablosu <span class="gr-count">gram gümüş</span></h2>
    <div class="gr-tablewrap">
      <table class="gr-table">
        <thead>
          <tr>
            <th>Dönem</th>
            <th class="r">O zaman (gram ₺)</th>
            <th class="r">Bugün (gram ₺)</th>
            <th class="r">Getiri (TL)</th>
            <th class="r">Getiri ($/ons)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="gr-co"><span class="gr-name">{ytd.label}</span></td>
            <td class="r gr-mono">{fmt(ytd.gram_tl_then)}</td>
            <td class="r gr-mono">{fmt(ytd.gram_tl_now)}</td>
            <td class="r"><span class={`gr-ret tone-${toneOf(ytd.return_tl_pct)}`}>{pct(ytd.return_tl_pct)}</span></td>
            <td class="r"><span class={`gr-ret tone-${toneOf(ytd.return_usd_pct)}`}>{pct(ytd.return_usd_pct)}</span></td>
          </tr>
          {periods.map((p) => (
            <tr>
              <td class="gr-co"><span class="gr-name">Son {p.label}</span></td>
              <td class="r gr-mono">{fmt(p.gram_tl_then)}</td>
              <td class="r gr-mono">{fmt(p.gram_tl_now)}</td>
              <td class="r"><span class={`gr-ret tone-${toneOf(p.return_tl_pct)}`}>{pct(p.return_tl_pct)}</span></td>
              <td class="r"><span class={`gr-ret tone-${toneOf(p.return_usd_pct)}`}>{pct(p.return_usd_pct)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gr-tnote">
      Gram gümüş TL ≈ (ons USD ÷ 31,1035) × USD/TRY. "Getiri (TL)" hem gümüşün küresel fiyat
      değişimini hem kur artışını içerir; "Getiri ($/ons)" döviz bazlı değer değişimidir. Göstergedir.
    </p>
  </section>

  <section class="container gr-section">
    <h2 class="gr-h2">Gümüş mü altın mı? <span class="gr-count">TL getirisi yan yana</span></h2>
    <div class="gr-tablewrap">
      <table class="gr-table">
        <thead>
          <tr>
            <th>Dönem</th>
            <th class="r">🥈 Gümüş</th>
            <th class="r">🥇 Gram altın</th>
            <th>Önde</th>
          </tr>
        </thead>
        <tbody>
          {vs.map((r) => (
            <tr>
              <td class="gr-co"><span class="gr-name">{r.label}</span></td>
              <td class="r"><span class={`gr-ret tone-${toneOf(r.s)} ${r.s > r.g ? 'is-win' : ''}`}>{pct(r.s)}</span></td>
              <td class="r"><span class={`gr-ret tone-${toneOf(r.g)} ${r.g >= r.s ? 'is-win' : ''}`}>{pct(r.g)}</span></td>
              <td class="gr-win">{r.s > r.g ? '🥈 Gümüş' : '🥇 Altın'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gr-tnote">
      Önde olan: gümüş {silverWins} / {vs.length} dönem, altın {vs.length - silverWins} / {vs.length} dönem. Altın verisi:
      <a href="/altin-getiri">altın getiri sayfası</a> (aynı kaynak ve yöntem).
    </p>
  </section>

  <section class="container gr-body">
    <h2 class="gr-h2">10.000 TL'yi {ten.years} yıl önce gümüşe koysaydınız?</h2>
    <p>
      {ten.years} yıl önce 10.000 TL ile yaklaşık <strong>{fmt0(gramsThen)} gram gümüş</strong>
      alabilirdiniz. Bugünkü gram fiyatıyla bu <strong>{fmt0(valueNow)} TL</strong> ediyor. Aynı
      dönemde gram altın %{fmt0(goldTen?.return_tl_pct ?? 0)} kazandırdı; yani 10 yıllık resimde iki
      metal birbirine yakın — fark, yolculuğun ne kadar sarsıntılı olduğunda.
    </p>
    <p>
      Gümüş hem değerli metal hem sanayi metalidir (güneş paneli, elektronik). Bu yüzden ekonomik
      büyüme beklentisine altından daha duyarlıdır ve çok daha oynaktır: dolar (ons) bazında yıl başından
      beri {pct(ytd.return_usd_pct)}, son 1 yılda {pct(periods.find((p) => p.years === 1)?.return_usd_pct ?? 0)}.
      Altın kriz anında "güvenli liman" işlevini daha istikrarlı görür; gümüş ise yükseliş dönemlerinde
      altını geride bırakıp düşüşlerde daha sert kaybetme eğilimindedir.
    </p>
    <p>
      <strong>Altın/gümüş oranı</strong> bugün {fmt1(ratioNow)}: bir ons altınla yaklaşık {fmt0(ratioNow)} ons
      gümüş alınabiliyor. Son 10 yılda bu oran {fmt1(data.gold_silver_ratio_min)} ile
      {fmt1(data.gold_silver_ratio_max)} arasında gezdi (ortalama {fmt1(ratioAvg)}). Oranın ortalamanın
      {ratioNow < ratioAvg ? ' altında olması, gümüşün altına göre 10 yıllık ortalamasından pahalı olduğunu' : ' üstünde olması, gümüşün altına göre 10 yıllık ortalamasından ucuz kaldığını'} gösterir
      — bir al-sat sinyali değil, göreli fiyat göstergesi.
    </p>
    <p>
      Altın, dolar ve borsayla birlikte karşılaştırmak için <a href="/altin-dolar-borsa">altın mı dolar
      mı borsa mı</a> sayfamıza, gram altının ayrıntılı dökümü için <a href="/altin-getiri">altın
      getirisi</a> sayfamıza, belirli bir miktarın TL karşılığı için <a href="/altin-hesaplama">altın
      hesaplama aracımıza</a> bakabilirsiniz.
    </p>
  </section>

  <section class="container gr-faq">
    <h2 class="gr-h2">Sık sorulan sorular</h2>
    {faqs.map((f) => (
      <details class="gr-fq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="container gr-note">
    <p>
      Veri kaynağı: {data.source}. Yöntem: <a href="/metodoloji">metodoloji</a>. Yalnızca bilgilendirme
      amaçlıdır; <strong>yatırım tavsiyesi değildir</strong>. Geçmiş getiri gelecekteki getirinin garantisi değildir.
    </p>
  </section>

  <div class="container"><Newsletter /></div>
</BaseLayout>

<style>
  .gr-hero { padding: clamp(1.6rem, 4vw, 2.6rem) 0 0; max-width: 720px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--step--2); font-weight: 600; color: var(--brand); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 0 rgba(22,160,133,0.5); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(22,160,133,0.5); } 70% { box-shadow: 0 0 0 6px rgba(22,160,133,0); } 100% { box-shadow: 0 0 0 0 rgba(22,160,133,0); } }
  .gr-hero h1 { font-size: var(--step-2); margin: 0.6rem 0 0.4rem; }
  .gr-hero .lede { font-size: var(--step-0); line-height: 1.55; margin: 0; }
  .gr-upd { font-size: var(--step--2); color: var(--text-muted); margin: 0.5rem 0 0; }

  .gr-stats { margin-top: clamp(1.4rem, 3.5vw, 2.2rem); display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; }
  .stat { padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .stat-num { font-size: var(--step-2); font-weight: 800; font-variant-numeric: tabular-nums; color: var(--text); line-height: 1.1; }
  .stat-num.up { color: var(--brand-deep); }
  .stat-num.down { color: var(--danger); }
  .stat-lbl { font-size: var(--step--2); color: var(--text-muted); line-height: 1.35; }

  .gr-section, .gr-body, .gr-faq { margin-top: clamp(1.8rem, 4vw, 2.8rem); }
  .gr-h2 { font-size: var(--step-1); margin: 0 0 0.9rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .gr-count { font-size: 0.66rem; font-weight: 700; color: var(--brand-deep); background: var(--brand-tint); border-radius: 999px; padding: 0.1rem 0.55rem; }

  .gr-tablewrap { border: 1px solid var(--border); border-radius: var(--radius); overflow-x: auto; background: var(--bg-card); box-shadow: var(--shadow-xs); }
  .gr-table { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  .gr-table thead th { text-align: left; font-size: var(--step--2); color: var(--text-muted); font-weight: 600; padding: 0.6rem 0.9rem; background: var(--bg-elev); border-bottom: 1px solid var(--border); }
  .gr-table th.r, .gr-table td.r { text-align: right; }
  .gr-table tbody tr { border-bottom: 1px solid var(--border-soft); }
  .gr-table tbody tr:last-child { border-bottom: none; }
  .gr-table td { padding: 0.6rem 0.9rem; vertical-align: middle; }
  .gr-name { color: var(--text); font-weight: 600; }
  .gr-mono { font-variant-numeric: tabular-nums; color: var(--text-soft); }
  .gr-ret { font-weight: 800; font-variant-numeric: tabular-nums; border-radius: 6px; padding: 0.15rem 0.5rem; font-size: var(--step--1); }
  .gr-ret.tone-up { background: var(--brand-tint); color: var(--brand-deep); }
  .gr-ret.tone-down { background: #fbe3e6; color: #a32437; }
  .gr-ret.tone-flat { background: var(--bg-elev); color: var(--text-muted); }
  .gr-ret.is-win { outline: 2px solid var(--brand); outline-offset: 1px; }
  .gr-win { font-weight: 700; color: var(--text-soft); white-space: nowrap; }
  .gr-tnote { font-size: var(--step--2); color: var(--text-muted); line-height: 1.55; margin: 0.7rem 0 0; max-width: 720px; }
  .gr-tnote a { color: var(--brand); font-weight: 600; }

  .gr-body { max-width: 720px; }
  .gr-body p { font-size: var(--step-0); line-height: 1.65; color: var(--text-soft); margin: 0 0 0.9rem; }
  .gr-body a { color: var(--brand); font-weight: 600; }

  .gr-fq { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); margin-bottom: 0.6rem; max-width: 720px; }
  .gr-fq summary { cursor: pointer; padding: 0.8rem 1rem; font-weight: 600; font-size: var(--step-0); color: var(--text); }
  .gr-fq p { padding: 0 1rem 0.9rem; margin: 0; font-size: var(--step--1); line-height: 1.6; color: var(--text-soft); }

  .gr-note { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .gr-note p { font-size: var(--step--2); line-height: 1.6; max-width: 720px; color: var(--text-muted); padding: 0.8rem 1rem; background: var(--bg-elev); border: 1px solid var(--border-soft); border-radius: var(--radius); }
  .gr-note a { color: var(--brand); }

  @media (max-width: 620px) {
    .gr-stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script define:vars={{ built: data.updated }}>
  async function checkUpdate() {
    try {
      const r = await fetch('/gumus-getiri.json?_=' + Date.now(), { cache: 'no-store' });
      const d = await r.json();
      if (d && d.updated && d.updated !== built) location.reload();
    } catch { /* yoksay */ }
  }
  setInterval(() => { if (document.visibilityState === 'visible') checkUpdate(); }, 300000);
</script>
