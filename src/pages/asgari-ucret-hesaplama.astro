---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';

import au from '../../data/asgari-ucret.json';

// Asgari ücret — tek kaynak data/asgari-ucret.json. Aralık'ta yeni yıl açıklanınca `yeni` alanı doldurulur
// (brüt ya da net yeterli): sayfa o build'de "Belli Oldu" moduna geçer — başlık, rakamlar, kesinti/işveren
// tabloları ve SSS yeni yıla göre. Hesaplar kuruş cinsinden tamsayıyla (40.874,63 ₺ gibi resmî rakamlarla birebir).
type Yil = { yil: number; brut?: number | null; net?: number | null; aciklanma?: string };
const R = au.oranlar;
const bp = (pct: number) => Math.round(pct * 100);                 // %21,75 → 2175 baz puan
const KESINTI_BP = bp(R.sgkIsci) + bp(R.issizlikIsci);             // %15 → 1500
const kurus = (tl: number) => Math.round(tl * 100);
const oranla = (tl: number, bpOran: number) => Math.round((kurus(tl) * bpOran) / 10000) / 100;
// Bordro gibi: net = brüt − yuvarla(brüt×%14) − yuvarla(brüt×%1) (2025: 26.005,50 → 22.104,67; tek çarpımla 1 kuruş sapıyordu)
const netOf = (brut: number) => Math.round(kurus(brut) - kurus(oranla(brut, bp(R.sgkIsci))) - kurus(oranla(brut, bp(R.issizlikIsci)))) / 100;
// Yalnız net açıklandıysa: net'i veren brütlerden en "yuvarlağı" (tam TL > ,50 > diğer)
const brutOf = (net: number) => {
  const c0 = Math.round((kurus(net) * 10000) / (10000 - KESINTI_BP));
  const adaylar = [];
  for (let k = c0 - 10; k <= c0 + 10; k++) if (netOf(k / 100) === net) adaylar.push(k);
  const skor = (k: number) => (k % 100 === 0 ? 0 : k % 50 === 0 ? 1 : 2);
  adaylar.sort((a, b) => skor(a) - skor(b) || Math.abs(a - c0) - Math.abs(b - c0));
  return (adaylar[0] ?? c0) / 100;
};
const tamamla = (y: Yil) => {
  const brut = y.brut ?? brutOf(y.net as number);
  const net = y.net ?? netOf(brut);
  return { yil: y.yil, brut, net, aciklanma: y.aciklanma };
};
const G = tamamla(au.guncel as Yil);                 // yürürlükteki yıl
const yeni = au.yeni ? tamamla(au.yeni as Yil) : null;
const ACIKLANDI = yeni !== null;                     // gelecek yıl açıklandı mı?
const A = yeni ?? G;                                 // sayfada öne çıkan yıl
const YIL = A.yil;
const BRUT = A.brut;
const NET = A.net;
const GUNLUK_BRUT = Math.round(kurus(BRUT) / 30) / 100;
const SAATLIK_BRUT = Math.round(kurus(BRUT) / 225) / 100;
const SGK_ISCI = oranla(BRUT, bp(R.sgkIsci));
const ISSIZLIK_ISCI = oranla(BRUT, bp(R.issizlikIsci));
const TOPLAM_KESINTI = Math.round(kurus(SGK_ISCI) + kurus(ISSIZLIK_ISCI)) / 100;
const NET_GUNLUK = NET / 30; // SGK 30 gün konvansiyonu
const ISVEREN_BP = bp(R.sgkIsveren) + bp(R.issizlikIsveren);       // 2026: %23,75
const ISVEREN = [
  { label: 'Teşviksiz (standart)', val: oranla(BRUT, 10000 + ISVEREN_BP) },
  { label: `İmalat — ${R.tesvikImalat} puan indirimli`, val: oranla(BRUT, 10000 + ISVEREN_BP - bp(R.tesvikImalat)) },
  { label: `İmalat dışı — ${R.tesvikDiger} puan indirimli`, val: oranla(BRUT, 10000 + ISVEREN_BP - bp(R.tesvikDiger)) },
];
const DESTEK = au.destek.tutar;                      // asgari ücret desteği (maliyetten düşülür)
const DESTEK_YIL = au.destek.yil;
const ARTIS = yeni ? (yeni.net / G.net - 1) * 100 : null;
const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const gun = (iso?: string) => {
  if (!iso) return '';
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${AYLAR[m - 1]} ${y}`;
};

// Sonraki asgari ücret yürürlüğü: 1 Ocak (gelecek yıl)
const target = new Date(`${G.yil + 1}-01-01T00:00:00+03:00`);
const now = new Date();
const daysToNew = Math.max(0, Math.ceil((target.getTime() - now.getTime()) / 86400000));

// Geçmiş yıllarda yeni asgari ücretin açıklandığı gün (Ocak zammı). Doğrulandı 2026-10-11:
// NTV 27.12.2023, Milliyet 25.12.2024 ("dün akşam"), Cumhuriyet/Milliyet 22-23.12.2022, EY/CNBC-e 23.12.2025.
// Tahmini rakam YAZILMAZ — yalnız açıkça "senaryo" diye etiketlenen tablo var (aşağıda).
const HISTORY = au.gecmis.map((h) => ({ yil: h.yil, tarih: h.tarih, net: h.net, artis: h.artis }));

// Açıklanmadan önce: net artış senaryoları (TAHMİN DEĞİL — "şu oranda zam gelirse" tablosu)
const SENARYO = [15, 20, 25, 30, 35].map((r) => {
  const net = G.net * (1 + r / 100);
  const brut = (net * 10000) / (10000 - KESINTI_BP);
  return { r, net, brut, isveren: (brut * (10000 + ISVEREN_BP)) / 10000 };
});

// Varsayılan: tam ay (30 gün)
const D = { days: 30 };

const fmt = (n: number) =>
  new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const fmt0 = (n: number) =>
  new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));

const faq = [
  ACIKLANDI
    ? {
        q: `${YIL} asgari ücret ne kadar oldu?`,
        a: `${YIL} asgari ücreti ${gun(A.aciklanma)} tarihinde açıklandı: aylık net ${fmt(NET)} ₺, brüt ${fmt(BRUT)} ₺ (net artış %${fmt(ARTIS as number)}). Yeni tutar 1 Ocak ${YIL}'de yürürlüğe girer; o tarihe kadar ${G.yil} tutarı (net ${fmt(G.net)} ₺) geçerlidir. Günlük brüt ${fmt(GUNLUK_BRUT)} ₺, saatlik brüt ${fmt(SAATLIK_BRUT)} ₺.`,
      }
    : {
        q: `${YIL} asgari ücret ne kadar?`,
        a: `${YIL} yılında asgari ücret aylık brüt ${fmt0(BRUT)} ₺, net (eline geçen) ${fmt(NET)} ₺'dir. Günlük brüt ${fmt0(GUNLUK_BRUT)} ₺, saatlik brüt ${fmt(SAATLIK_BRUT)} ₺'dir. Bu tutarlar 1 Ocak ${YIL}'dan 31 Aralık ${YIL}'ya kadar geçerlidir.`,
      },
  {
    q: 'Asgari ücretten ne kadar kesinti yapılıyor?',
    a: `Asgari ücret gelir vergisi ve damga vergisinden istisnadır (2022'den beri). Brüt ${fmt0(BRUT)} ₺'den yalnızca SGK işçi payı %14 (${fmt(SGK_ISCI)} ₺) ve işsizlik sigortası işçi payı %1 (${fmt(ISSIZLIK_ISCI)} ₺) kesilir; toplam kesinti ${fmt(TOPLAM_KESINTI)} ₺'dir. Böylece net ${fmt(NET)} ₺ eline geçer.`,
  },
  {
    q: 'Asgari ücretin işverene maliyeti ne kadar?',
    a: `Teşviksiz senaryoda ${YIL} asgari ücretin işverene aylık toplam maliyeti ${fmt(ISVEREN[0].val)} ₺'dir (brüt ücret + %${fmt(R.sgkIsveren)} işveren SGK primi + %${fmt0(R.issizlikIsveren)} işveren işsizlik primi). İmalat sektöründe ${R.tesvikImalat} puanlık indirimle ${fmt(ISVEREN[1].val)} ₺'ye, imalat dışında ${R.tesvikDiger} puanlık indirimle ${fmt(ISVEREN[2].val)} ₺'ye düşer. Ayrıca ${DESTEK_YIL} için aylık ${fmt0(DESTEK)} ₺ devlet asgari ücret desteği maliyetten düşülür.`,
  },
  ACIKLANDI
    ? {
        q: `${YIL} asgari ücret ne zaman açıklandı, ne zaman yürürlüğe girer?`,
        a: `${YIL} asgari ücreti Asgari Ücret Tespit Komisyonu kararıyla ${gun(A.aciklanma)} tarihinde açıklandı ve 1 Ocak ${YIL}'de yürürlüğe girer. Yeni tutarla ilk maaş Ocak ${YIL} çalışmasının karşılığı olarak ödenir (genellikle Şubat başı).`,
      }
    : {
        q: '2027 asgari ücret ne zaman açıklanacak, zam ne zaman gelecek?',
        a: `2026 için Temmuz'da (yıl ortası) ara zam yapılmadı; hükümet yılda tek zam politikasını sürdürüyor. Yeni asgari ücret, Asgari Ücret Tespit Komisyonu'nun Aralık 2026'daki toplantılarında belirlenecek ve 1 Ocak 2027'de yürürlüğe girecek. Son dört yılda yeni tutar hep 22-27 Aralık arasında açıklandı (2026 tutarı 23 Aralık 2025'te). Bugünden itibaren yürürlüğe yaklaşık ${daysToNew} gün var.`,
      },
  ...(ACIKLANDI ? [] : [{
    q: '2027 asgari ücret kaç TL olacak?',
    a: `2027 asgari ücreti henüz belli değil; resmî bir rakam yok. Tutar, Aralık 2026'da Asgari Ücret Tespit Komisyonu'nda belirlenecek. Basında çıkan rakamlar tahmindir. Geçmiş artışlar referans olabilir: 2026'da %27, 2025'te %30, 2024'te %49. Örneğin net %25 zam gelirse net asgari ücret ${fmt0(SENARYO[2].net)} ₺, brüt ${fmt0(SENARYO[2].brut)} ₺ olur (senaryo, tahmin değil). Resmî tutar açıklandığı gün bu sayfa güncellenir.`,
  }]),
  {
    q: 'Asgari Ücret Tespit Komisyonu nasıl çalışır?',
    a: `Komisyon 15 üyelidir: işçi, işveren ve hükümet (Çalışma ve Sosyal Güvenlik Bakanlığı) tarafından beşer temsilci. Toplantılar genellikle Aralık'ta 3-4 tur sürer; karar oy çokluğuyla alınır ve Resmî Gazete'de yayımlanarak 1 Ocak'ta yürürlüğe girer. Uzlaşma olmazsa karar işçi tarafının katılımı olmadan da çıkabilir.`,
  },
  {
    q: '2027 asgari ücrete ara zam olacak mı?',
    a: `Ara zam (Temmuz) resmî bir kural değil, hükümetin kararıdır. 2023'te Temmuz'da ara zam yapıldı (net 11.402 ₺); 2024, 2025 ve 2026'da yapılmadı. 2027 için açıklanmış bir ara zam kararı yok.`,
  },
  {
    q: 'Günlük ve saatlik asgari ücret ne kadar?',
    a: `${YIL} günlük brüt asgari ücret ${fmt(GUNLUK_BRUT)} ₺, saatlik brüt ${fmt(SAATLIK_BRUT)} ₺'dir. Eksik günlü (part-time / ay içi işe giriş-çıkış) çalışmada ücret, çalışılan gün sayısıyla orantılanır: net günlük yaklaşık ${fmt(NET_GUNLUK)} ₺.`,
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Asgari Ücret Hesaplama', url: '/asgari-ucret-hesaplama' },
];
---

<BaseLayout
  title={ACIKLANDI
    ? `${YIL} Asgari Ücret Belli Oldu: Net ${fmt(NET)} ₺, Brüt ${fmt0(BRUT)} ₺`
    : 'Asgari Ücret 2027 Ne Zaman Belli Olacak? 2026 Net, Brüt Hesaplama'}
  description={ACIKLANDI
    ? `${YIL} asgari ücret açıklandı: net ${fmt(NET)} ₺, brüt ${fmt(BRUT)} ₺ (%${fmt0(ARTIS as number)} artış), 1 Ocak ${YIL}'de yürürlükte. Kesinti dökümü, işveren maliyeti, kıst hesaplama.`
    : `2027 asgari ücret Aralık 2026'da belli olacak; zam senaryoları tablosu. Güncel 2026 asgari ücret: net ${fmt(G.net)} ₺, brüt ${fmt0(G.brut)} ₺; kesinti dökümü ve işveren maliyeti.`}
  faq={faq}
  breadcrumbs={breadcrumbs}
  image="/og/asgari-ucret-hesaplama.png"
>
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Hesaplayıcı · Maaş & Ücret</p>
      <h1>{ACIKLANDI ? `${YIL} Asgari Ücret Belli Oldu: Net ${fmt(NET)} ₺` : '2026 Asgari Ücret Ne Kadar? 2027 Ne Zaman Belli Olacak?'}</h1>
      <p class="lede">
        {ACIKLANDI
          ? <>1 Ocak {YIL}'den itibaren asgari ücret <strong>net {fmt(NET)} ₺</strong>, brüt {fmt(BRUT)} ₺ ({gun(A.aciklanma)} açıklandı; net artış %{fmt(ARTIS as number)}). {G.yil} tutarı (net {fmt(G.net)} ₺) 31 Aralık'a kadar geçerli.</>
          : <>2026'da asgari ücret <strong>net {fmt(NET)} ₺</strong>, brüt {fmt0(BRUT)} ₺'dir.</>}
        Aşağıda güncel <strong>kesinti dökümünü, işveren maliyetini</strong> ve çalıştığınız
        gün sayısına göre <strong>eksik günlü (kıst) asgari ücreti</strong> hesaplayın.
      </p>
    </header>

    <div class="stat-row">
      <div class="stat"><span class="stat-label">Net (aylık)</span><span class="stat-val">₺{fmt(NET)}</span></div>
      <div class="stat"><span class="stat-label">Brüt (aylık)</span><span class="stat-val">₺{fmt0(BRUT)}</span></div>
      <div class="stat"><span class="stat-label">Günlük brüt</span><span class="stat-val">₺{fmt0(GUNLUK_BRUT)}</span></div>
      <div class="stat"><span class="stat-label">Saatlik brüt</span><span class="stat-val">₺{fmt(SAATLIK_BRUT)}</span></div>
    </div>

    <div class="calc-grid">
      <form class="calc-inputs" id="calc-form" autocomplete="off">
        <label>
          <span>Çalışılan gün sayısı (ay içi)</span>
          <input type="number" id="in-days" value={D.days} min="0" max="30" step="1" inputmode="numeric" />
        </label>
        <p class="input-hint">
          Tam ay = 30 gün. Ay içinde işe giren/çıkan ya da part-time çalışanlar için gün girin.
        </p>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label">Net (çalışılan güne göre)</span>
          <span class="result-value" id="out-net">₺{fmt(NET)}</span>
        </div>
        <div class="result-split">
          <div class="split-item">
            <span class="split-label">Brüt</span>
            <span class="split-val" id="out-gross">₺{fmt(BRUT)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">SGK işçi payı (%14)</span>
            <span class="split-val" id="out-sgk">−₺{fmt(SGK_ISCI)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">İşsizlik sig. (%1)</span>
            <span class="split-val" id="out-issizlik">−₺{fmt(ISSIZLIK_ISCI)}</span>
          </div>
        </div>
        <p class="result-note" id="out-note">
          Gelir vergisi ve damga vergisi asgari ücrette istisnadır (kesinti yok).
        </p>
      </div>
    </div>

    <p class="disclaimer">
      Bu araç yalnızca bilgilendirme amaçlıdır; hukuki/mali tavsiye değildir. {YIL} için resmî tutarlar
      (brüt {fmt(BRUT)} ₺, net {fmt(NET)} ₺) esas alınmıştır{ACIKLANDI ? ` ve 1 Ocak ${YIL}'de yürürlüğe girer` : ` ve 31 Aralık ${YIL}'ya kadar geçerlidir`}. Eksik günlü hesap 30 günlük SGK konvansiyonuna göre
      orantılanır; gerçek bordro, prim gün sayısı ve yan haklara göre değişebilir.
    </p>

    <section class="table-block countdown-block">
      <h2>2027 asgari ücret ne zaman açıklanacak?</h2>
      <p class="table-intro">
        {ACIKLANDI
          ? <>Yeni asgari ücret {gun(A.aciklanma)} tarihinde açıklandı: <strong>net {fmt(NET)} ₺</strong>. Tutar
            <strong>1 Ocak {YIL}</strong>'de yürürlüğe girer.</>
          : <>2026'da yıl ortası (Temmuz) ara zam yapılmadı. Yeni asgari ücret, Asgari Ücret Tespit
            Komisyonu'nun <strong>Aralık 2026</strong> toplantılarında belirlenecek ve
            <strong>1 Ocak 2027</strong>'de yürürlüğe girecek.</>}
      </p>
      <div class="countdown">
        <span class="cd-num">{daysToNew}</span>
        <span class="cd-label">gün sonra yeni asgari ücret yürürlükte (1 Ocak 2027)</span>
      </div>
      <p class="table-intro">
        <strong>Süreç:</strong> Asgari Ücret Tespit Komisyonu işçi, işveren ve hükümetten beşer
        temsilciyle 15 üyeden oluşur. Toplantılar genellikle Aralık'ın ilk yarısında başlar, 3-4 tur
        sürer; karar oy çokluğuyla alınır, Resmî Gazete'de yayımlanır ve 1 Ocak'ta yürürlüğe girer.
        {ACIKLANDI
          ? `${YIL} rakamı ${gun(A.aciklanma)} tarihinde açıklandı.`
          : '2027 rakamı henüz açıklanmadı — basındaki tutarlar tahmindir; resmî karar gelince bu sayfa aynı gün güncellenir.'}
      </p>
      <table class="rate-table">
        <thead><tr><th>Yıl</th><th>Açıklandığı gün</th><th>Net asgari ücret</th><th>Artış</th></tr></thead>
        <tbody>
          {ACIKLANDI
            ? <tr class="current"><td>{YIL}</td><td>{gun(A.aciklanma)}</td><td>₺{fmt(NET)}</td><td>%{fmt(ARTIS as number)}</td></tr>
            : <tr class="current"><td>{G.yil + 1}</td><td>Aralık {G.yil} (bekleniyor)</td><td>—</td><td>—</td></tr>}
          {HISTORY.map((h) => (
            <tr><td>{h.yil}</td><td>{h.tarih}</td><td>₺{fmt(h.net)}</td><td>%{h.artis.toLocaleString('tr-TR')}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">
        Son dört yılda yeni tutar 22-27 Aralık arasında açıklandı. 2023'te ayrıca Temmuz'da ara zam
        yapıldı (net 11.402 ₺); 2024-2026'da ara zam yok. Asgari ücretten farklı olarak emekli ve
        memur maaşları her Ocak ve Temmuz artırılır — Ocak 2027 oranı için
        <a href="/emekli-zammi-hesaplama/">emekli zammı hesaplama</a>. Kaynak: Çalışma ve Sosyal Güvenlik
        Bakanlığı açıklamaları ve Resmî Gazete (açıklama tarihleri dönemin haberleriyle doğrulandı).
      </p>
    </section>

    {!ACIKLANDI && (
      <section class="table-block" id="senaryolar">
        <h2>2027 asgari ücret senaryoları: zam %15-35 olursa net ne olur?</h2>
        <p class="table-intro">
          Resmî rakam Aralık'ta açıklanacak; aşağıdaki tablo <strong>tahmin değil</strong>, "şu oranda net zam gelirse"
          hesabıdır. Brüt = net ÷ 0,85 (asgari ücret gelir ve damga vergisinden istisna; kesinti yalnız SGK %14 + işsizlik %1).
          İşveren maliyeti {G.yil} prim oranlarıyla (teşviksiz %{fmt(R.sgkIsveren + R.issizlikIsveren)}) hesaplandı.
        </p>
        <div class="table-scroll">
          <table class="rate-table">
            <thead><tr><th>Net zam</th><th>Net asgari ücret</th><th>Brüt</th><th>İşverene maliyet</th></tr></thead>
            <tbody>
              {SENARYO.map((x) => (
                <tr><td>%{x.r}</td><td>₺{fmt0(x.net)}</td><td>₺{fmt0(x.brut)}</td><td>₺{fmt0(x.isveren)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="table-note">Son üç yılda net artış: 2026 %27 · 2025 %30 · 2024 %49. Resmî tutar açıklandığı gün bu tablo kalkar, yerine kesin rakamlar gelir. Net asgari ücret evde bakım maaşının gelir sınırını da belirler → <a href="/evde-bakim-maasi/">evde bakım maaşı şartları</a>.</p>
      </section>
    )}

    <section class="table-block">
      <h2>Asgari ücret kesinti dökümü ({YIL})</h2>
      <table class="rate-table">
        <thead><tr><th>Kalem</th><th>Oran</th><th>Tutar (aylık)</th></tr></thead>
        <tbody>
          <tr><td>Brüt asgari ücret</td><td>—</td><td>₺{fmt(BRUT)}</td></tr>
          <tr><td>SGK primi işçi payı</td><td>%14</td><td>−₺{fmt(SGK_ISCI)}</td></tr>
          <tr><td>İşsizlik sigortası işçi payı</td><td>%1</td><td>−₺{fmt(ISSIZLIK_ISCI)}</td></tr>
          <tr><td>Gelir vergisi</td><td>İstisna</td><td>₺0,00</td></tr>
          <tr><td>Damga vergisi</td><td>İstisna</td><td>₺0,00</td></tr>
          <tr class="current"><td>Net (eline geçen)</td><td>—</td><td>₺{fmt(NET)}</td></tr>
        </tbody>
      </table>
      <p class="table-note">
        2022'den beri asgari ücret gelir ve damga vergisinden istisnadır; tek kesinti SGK + işsizlik primidir.
      </p>
    </section>

    <section class="table-block">
      <h2>Asgari ücretin işverene maliyeti ({YIL})</h2>
      <p class="table-intro">
        İşverenin ödediği toplam maliyet, brüt ücrete işveren SGK primi (%{fmt(R.sgkIsveren)}) ve işveren
        işsizlik primi (%{fmt0(R.issizlikIsveren)}) eklenerek bulunur{R.yil !== YIL ? ` (${R.yil} prim oranlarıyla)` : ''}:
      </p>
      <table class="rate-table">
        <thead><tr><th>Senaryo</th><th>Aylık toplam maliyet</th></tr></thead>
        <tbody>
          {ISVEREN.map((r, i) => (
            <tr class={i === 0 ? 'current' : ''}>
              <td>{r.label}</td>
              <td>₺{fmt(r.val)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">
        {DESTEK_YIL} için aylık {fmt0(DESTEK)} ₺ devlet asgari ücret desteği uygulandığında bu tutarlar yaklaşık
        {fmt0(DESTEK)} ₺ azalır{DESTEK_YIL !== YIL ? ` (${YIL} desteği açıklanınca güncellenir)` : ''}.
      </p>
    </section>

    <section class="prose-block">
      <h2>Net ve brüt asgari ücret arasındaki fark</h2>
      <p>
        <strong>Brüt ücret</strong>, işverenin bordroda gösterdiği toplam ücrettir;
        <strong>net ücret</strong> ise kesintiler sonrası çalışanın eline geçen tutardır.
        {YIL}'da brüt {fmt(BRUT)} ₺ olan asgari ücretten yalnızca SGK işçi payı (%14) ve
        işsizlik sigortası işçi payı (%1) kesilir — toplam {fmt(TOPLAM_KESINTI)} ₺. Asgari ücret
        gelir vergisi ve damga vergisinden muaf olduğu için net {fmt(NET)} ₺ eline geçer.
      </p>
      <h2>Eksik günlü (kıst) asgari ücret nasıl hesaplanır?</h2>
      <p>
        Ay içinde işe giren, işten ayrılan veya part-time çalışanlarda ücret, çalışılan gün
        sayısıyla orantılanır. SGK 30 günlük ay esasını kullanır: <strong>günlük brüt
        {fmt(GUNLUK_BRUT)} ₺</strong> çalışılan günle çarpılır. Örneğin 15 gün çalışan biri
        brüt {fmt0(GUNLUK_BRUT * 15)} ₺, net yaklaşık {fmt0(NET_GUNLUK * 15)} ₺ alır. Yukarıdaki
        araçta gün sayısını girerek kendi tutarınızı görebilirsiniz.
      </p>
      <p class="cta-line">
        Asgari ücret üstü bir maaş alıyorsanız <a href="/net-maas-hesaplama">net maaş hesaplama</a>
        ile brütten neti görün; enflasyona karşı korumak için <a href="/bilesik-faiz-hesaplama">bileşik
        faiz hesaplama</a> ile birikiminizi büyütün; işten ayrılıyorsanız
        <a href="/kidem-tazminati-hesaplama">kıdem tazminatı hesaplama</a> ile hak ettiğiniz
        tazminatı, kira artışınızı ise <a href="/kira-artis-orani-hesaplama">kira artış oranı
        hesaplama</a> ile öğrenin.
      </p>
    </section>

    <section class="faq-block">
      <h2>Sıkça Sorulan Sorular</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <Newsletter />
  </div>

  <script is:inline define:vars={{ GUNLUK_BRUT, NET, BRUT, SGK_ISCI, ISSIZLIK_ISCI }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const money = (n) => '₺' + nf.format(n);
      const NET_GUNLUK = NET / 30;
      const SGK_GUNLUK = SGK_ISCI / 30;
      const ISS_GUNLUK = ISSIZLIK_ISCI / 30;

      function update() {
        let days = Math.round(+$('in-days').value || 0);
        days = Math.max(0, Math.min(30, days));
        const brut = GUNLUK_BRUT * days;
        const sgk = SGK_GUNLUK * days;
        const iss = ISS_GUNLUK * days;
        const net = NET_GUNLUK * days;
        $('out-net').textContent = money(net);
        $('out-gross').textContent = money(brut);
        $('out-sgk').textContent = '−' + money(sgk);
        $('out-issizlik').textContent = '−' + money(iss);
        $('out-note').textContent = days === 30
          ? 'Gelir vergisi ve damga vergisi asgari ücrette istisnadır (kesinti yok).'
          : `${days} günlük çalışma için orantılı hesaplandı (30 günlük ay esası).`;
      }

      $('in-days').addEventListener('input', update);
      update();
    })();
  </script>

