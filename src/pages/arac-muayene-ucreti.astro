  <script is:inline define:vars={{ GR: CALC, CARPAN: carpan, EGZOZ, ORAN_YAKLASIK: approx, EST: est, HEDEF }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const tl = (n) => {
        const r = Math.round(n * 100) / 100;
        return '₺' + r.toLocaleString('tr-TR', { minimumFractionDigits: Number.isInteger(r) ? 0 : 2, maximumFractionDigits: 2 });
      };
      const dahil = (kh) => Math.round(kh * 120) / 100;
      const egz = $('in-egzoz');
      let egzTercih = egz.checked; // motosiklet/traktörden dönünce kullanıcının seçimi geri gelsin
      function update() {
        const g = GR.find((x) => x.key === $('in-grup').value) || GR[0];
        // KTK md. 35: ay kesirleri tam ay sayılır
        let ay = Math.ceil((+$('in-ay').value || 0) - 1e-9);
        ay = ay > 0 ? Math.min(ay, 240) : 0; // -0 ve negatif girişler 0 olur
        egz.disabled = !g.egzoz;
        egz.checked = g.egzoz ? egzTercih : false;
        const ucret = dahil(g.kh26);
        const gecikme = ucret * 0.05 * ay;
        const egzoz = egz.checked ? EGZOZ : 0;
        const ucret27 = dahil(Math.floor(g.kh26 * CARPAN + 1e-9));
        const gec27 = ucret27 * 0.05 * ay;
        $('out-toplam').textContent = tl(ucret + gecikme + egzoz);
        $('out-ucret').textContent = tl(ucret);
        $('lbl-gecikme').textContent = ay > 0 ? 'Gecikme bedeli (' + ay + ' ay × %5)' : 'Gecikme bedeli (zamanında)';
        $('out-gecikme').textContent = tl(gecikme);
        $('out-egzoz').textContent = egz.checked ? tl(EGZOZ) : g.egzoz ? 'yapılmayacak' : 'muaf';
        $('lbl-27').textContent = HEDEF + ' ' + EST + ' muayene ücreti' + (ay > 0 ? ' + ' + ay + ' ay gecikme' : '');
        $('out-27').textContent = ORAN_YAKLASIK + tl(ucret27 + gec27);
      }
      ['in-grup', 'in-ay'].forEach((id) => {
        $(id).addEventListener('input', update);
        $(id).addEventListener('change', update);
      });
      egz.addEventListener('change', () => {
        if (!egz.disabled) egzTercih = egz.checked;
        update();
      });
      update();
    })();
  </script>

