---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import data from '../../data/dolar-getiri.json';
import gold from '../../data/altin-getiri.json';

type Period = {
  label: string; years?: number;
  usdtry_then: number; usdtry_now: number; return_tl_pct: number;
};

const periods = (data.periods ?? []) as Period[];
const ytd = data.ytd as Period;
const updated = new Date(data.updated).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const fmt = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmt0 = (n: number) => n.toLocaleString('tr-TR', { maximumFractionDigits: 0 });
const pct = (n: number) => (n > 0 ? '+' : '') + n.toLocaleString('tr-TR', { maximumFractionDigits: 1 }) + '%';
const toneOf = (n: number) => (n > 0 ? 'up' : n < 0 ? 'down' : 'flat');

const ten = periods.find((p) => p.years === 10) ?? periods[periods.length - 1];
// "10.000 TL'yi dolara çevirseydin" — en uzun dönem üzerinden
const seed = 10000;
const usdThen = seed / ten.usdtry_then;
const valueNow = usdThen * ten.usdtry_now;

// Altın ile kıyas (aynı dönem, TL bazında) — kümeyi bağlar, özgün içgörü
const goldTen = (gold.periods ?? []).find((p: any) => p.years === ten.years);
const goldRetTl = goldTen ? goldTen.return_tl_pct : null;
const goldMultiple = goldTen ? (1 + goldTen.return_tl_pct / 100) / (1 + ten.return_tl_pct / 100) : null;

const faqs = [
  {
    q: `Dolar son ${ten.years} yılda TL bazında ne kadar kazandırdı?`,
    a: `USD/TRY kuru son ${ten.years} yılda yaklaşık ${fmt(ten.usdtry_then)}'den ${fmt(ten.usdtry_now)}'ye çıktı; yani doları elde tutan biri TL bazında %${fmt(ten.return_tl_pct)} kazandı. Ancak bu "kazanç" gerçek bir zenginleşme değil, büyük ölçüde Türk lirasının değer kaybının aynadaki yansımasıdır: dolar bazında 1 dolar hâlâ 1 dolardır.`,
  },
  {
    q: 'Dolar tutmak gerçekten kazandırıyor mu, yoksa TL mi eriyor?',
    a: 'İkisi aynı olgunun iki yüzü. Dolar/TL yükseldiğinde, doları olan kişinin TL cinsinden serveti artar — ama alım gücü olarak dolar sabit kalır, asıl olan TL\'nin erimesidir. Bu yüzden dolar, Türkiye\'de bir "yatırım" olmaktan çok enflasyona ve kur riskine karşı bir korunma (hedge) aracıdır. Gerçek getiri için doların kendi enflasyonundan (ABD TÜFE) arındırılması gerekir.',
  },
  {
    q: `10.000 TL'yi ${ten.years} yıl önce dolara çevirseydim bugün ne olurdu?`,
    a: `${ten.years} yıl önce 10.000 TL ile yaklaşık ${fmt(usdThen)} dolar alınabilirdi. Bugünkü kurla bu ${fmt0(valueNow)} TL eder. Aynı 10.000 TL'yi yastık altında TL olarak tutsaydınız bugün yine 10.000 TL olurdu — ama alım gücü büyük ölçüde erimiş olurdu. (Geçmiş getiri gelecek getirinin garantisi değildir.)`,
  },
  {
    q: 'Dolar mı altın mı daha çok kazandırdı?',
    a: goldRetTl !== null
      ? `Son ${ten.years} yılda gram altın TL bazında %${fmt0(goldRetTl)}, dolar ise %${fmt0(ten.return_tl_pct)} kazandırdı. Yani altın aynı dönemde doları TL bazında yaklaşık ${fmt(goldMultiple as number)} katına çıkardı; çünkü altın hem kur artışından hem de ons altının küresel yükselişinden faydalandı, dolar ise yalnızca kur etkisini taşır. Detaylı karşılaştırma için altın getirisi sayfamıza bakabilirsiniz.`
      : `Altın ve dolar getirilerini altın getirisi sayfamızda aynı dönem için karşılaştırdık.`,
  },
  {
    q: 'Bu rakamlar kesin işlem kuru mu?',
    a: 'Hayır, göstergedir. USD/TRY için Yahoo Finance aylık kapanış verisi kullanılır. Bankalar ve döviz bürolarının alış-satış makası, anlık piyasa hareketleri ve komisyonlar nedeniyle gerçek işlem kuru biraz farklı olabilir. Güncel dolar endeksi ve kur bağlamı için dolar endeksi (DXY) sayfamıza bakın.',
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title={`Dolar Ne Kadar Kazandırdı? 1, 5, 10 Yıllık Getiri (TL Bazında)`}
  description={`Doları elde tutmak son ${ten.years} yılda TL bazında %${fmt0(ten.return_tl_pct)} kazandırdı. USD/TRY'nin 1, 3, 5, 10 yıllık ve yıl başından beri getirisi tek tabloda — altınla karşılaştırmalı, her gün güncel.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <section class="container gr-hero">
    <span class="eyebrow"><span class="pulse"></span> Özgün veri · Dolar getirisi</span>
    <h1>Dolar Ne Kadar Kazandırdı?</h1>
    <p class="lede soft">
      Doları 1, 3, 5 ve 10 yıl önce alsaydınız bugün TL bazında ne olurdu? USD/TRY'nin gerçek
      geçmiş getirisi — altınla karşılaştırmalı, tek tabloda, her gün güncel.
    </p>
    <p class="gr-upd">Son güncelleme: {updated} · USD/TRY ≈ {fmt(data.usdtry_now)}</p>
  </section>

  <section class="container gr-stats">
    <div class="stat card">
      <span class="stat-num up">{pct(ten.return_tl_pct)}</span>
      <span class="stat-lbl">{ten.years} yıllık getiri (TL)</span>
    </div>
    <div class="stat card">
      <span class={`stat-num ${ytd.return_tl_pct >= 0 ? 'up' : 'down'}`}>{pct(ytd.return_tl_pct)}</span>
      <span class="stat-lbl">Yıl başından beri (TL)</span>
    </div>
    <div class="stat card">
      <span class="stat-num">{fmt(data.usdtry_now)} ₺</span>
      <span class="stat-lbl">Güncel USD/TRY (gösterge)</span>
    </div>
    <div class="stat card">
      <span class="stat-num">{fmt0(valueNow)} ₺</span>
      <span class="stat-lbl">{ten.years} yıl önce dolara çevrilen 10.000 ₺</span>
    </div>
  </section>

  <section class="container gr-section">
    <h2 class="gr-h2">Dolar getiri tablosu <span class="gr-count">USD/TRY</span></h2>
    <div class="gr-tablewrap">
      <table class="gr-table">
        <thead>
          <tr>
            <th>Dönem</th>
            <th class="r">O zaman (USD/TRY)</th>
            <th class="r">Bugün (USD/TRY)</th>
            <th class="r">Getiri (TL)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="gr-co"><span class="gr-name">{ytd.label}</span></td>
            <td class="r gr-mono">{fmt(ytd.usdtry_then)}</td>
            <td class="r gr-mono">{fmt(ytd.usdtry_now)}</td>
            <td class="r"><span class={`gr-ret tone-${toneOf(ytd.return_tl_pct)}`}>{pct(ytd.return_tl_pct)}</span></td>
          </tr>
          {periods.map((p) => (
            <tr>
              <td class="gr-co"><span class="gr-name">Son {p.label}</span></td>
              <td class="r gr-mono">{fmt(p.usdtry_then)}</td>
              <td class="r gr-mono">{fmt(p.usdtry_now)}</td>
              <td class="r"><span class={`gr-ret tone-${toneOf(p.return_tl_pct)}`}>{pct(p.return_tl_pct)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gr-tnote">
      "Getiri (TL)", doları elde tutup bugün TL'ye çevirmenin nominal kazancıdır — büyük ölçüde
      TL'nin değer kaybını yansıtır, dolar bazında 1 dolar yine 1 dolardır. Göstergedir.
    </p>
  </section>

  <section class="container gr-body">
    <h2 class="gr-h2">10.000 TL'yi {ten.years} yıl önce dolara çevirseydiniz?</h2>
    <p>
      {ten.years} yıl önce 10.000 TL ile yaklaşık <strong>{fmt(usdThen)} dolar</strong>
      alabilirdiniz. Bugünkü kurla bu <strong>{fmt0(valueNow)} TL</strong> ediyor. Aynı 10.000 TL'yi
      nakit TL olarak tutsaydınız bugün yine 10.000 TL olurdu — ama alım gücü çoktan erimişti.
      Doların buradaki işlevi "zengin etmek" değil, <strong>TL'nin erimesine ve kur riskine karşı
      alım gücünü korumaktır.</strong>
    </p>
    {goldRetTl !== null && (
      <p>
        Yine de dikkat: aynı {ten.years} yılda <strong>gram altın TL bazında %{fmt0(goldRetTl)}</strong>
        kazandırırken dolar %{fmt0(ten.return_tl_pct)} kazandırdı — yani <strong>altın, doları TL bazında
        yaklaşık {fmt(goldMultiple as number)} katına çıkardı.</strong> Bunun nedeni, altının hem kur
        artışından hem de ons altının küresel yükselişinden faydalanması; dolar ise yalnızca kur
        etkisini taşır. Bu yüzden uzun vadede altın, saf dövize kıyasla daha güçlü bir enflasyon
        koruması olmuştur.
      </p>
    )}
    <p>
      Dolar/TL'yi neyin hareket ettirdiğini ve dolar endeksinin (DXY) TL üzerindeki etkisini
      <a href="/dolar-endeksi">dolar endeksi sayfamızda</a>, altının aynı dönemdeki getirisini
      <a href="/altin-getiri">altın getirisi sayfamızda</a> bulabilirsiniz. Altın mı dolar mı
      sorusunu ise <a href="/blog/altin-mi-dolar-mi">bu yazıda</a> ayrıntılı karşılaştırdık; döviz
      hesabıyla nasıl dolar tutulacağını <a href="/blog/doviz-hesabi-nedir">döviz hesabı rehberimizde</a>
      anlattık.
    </p>
  </section>

  <section class="container gr-faq">
    <h2 class="gr-h2">Sık sorulan sorular</h2>
    {faqs.map((f) => (
      <details class="gr-fq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="container gr-note">
    <p>
      Veri kaynağı: {data.source}. Yalnızca bilgilendirme amaçlıdır; <strong>yatırım tavsiyesi
      değildir</strong>. Geçmiş getiri gelecekteki getirinin garantisi değildir.
    </p>
  </section>

  <div class="container"><Newsletter /></div>
</BaseLayout>

<style>
  .gr-hero { padding: clamp(1.6rem, 4vw, 2.6rem) 0 0; max-width: 720px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--step--2); font-weight: 600; color: var(--brand); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 0 rgba(22,160,133,0.5); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(22,160,133,0.5); } 70% { box-shadow: 0 0 0 6px rgba(22,160,133,0); } 100% { box-shadow: 0 0 0 0 rgba(22,160,133,0); } }
  .gr-hero h1 { font-size: var(--step-2); margin: 0.6rem 0 0.4rem; }
  .gr-hero .lede { font-size: var(--step-0); line-height: 1.55; margin: 0; }
  .gr-upd { font-size: var(--step--2); color: var(--text-muted); margin: 0.5rem 0 0; }

  .gr-stats { margin-top: clamp(1.4rem, 3.5vw, 2.2rem); display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; }
  .stat { padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .stat-num { font-size: var(--step-2); font-weight: 800; font-variant-numeric: tabular-nums; color: var(--text); line-height: 1.1; }
  .stat-num.up { color: var(--brand-deep); }
  .stat-num.down { color: var(--danger); }
  .stat-lbl { font-size: var(--step--2); color: var(--text-muted); line-height: 1.35; }

  .gr-section, .gr-body, .gr-faq { margin-top: clamp(1.8rem, 4vw, 2.8rem); }
  .gr-h2 { font-size: var(--step-1); margin: 0 0 0.9rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .gr-count { font-size: 0.66rem; font-weight: 700; color: var(--brand-deep); background: var(--brand-tint); border-radius: 999px; padding: 0.1rem 0.55rem; }

  .gr-tablewrap { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-card); box-shadow: var(--shadow-xs); }
  .gr-table { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  .gr-table thead th { text-align: left; font-size: var(--step--2); color: var(--text-muted); font-weight: 600; padding: 0.6rem 0.9rem; background: var(--bg-elev); border-bottom: 1px solid var(--border); }
  .gr-table th.r, .gr-table td.r { text-align: right; }
  .gr-table tbody tr { border-bottom: 1px solid var(--border-soft); }
  .gr-table tbody tr:last-child { border-bottom: none; }
  .gr-table td { padding: 0.6rem 0.9rem; vertical-align: middle; }
  .gr-name { color: var(--text); font-weight: 600; }
  .gr-mono { font-variant-numeric: tabular-nums; color: var(--text-soft); }
  .gr-ret { font-weight: 800; font-variant-numeric: tabular-nums; border-radius: 6px; padding: 0.15rem 0.5rem; font-size: var(--step--1); }
  .gr-ret.tone-up { background: var(--brand-tint); color: var(--brand-deep); }
  .gr-ret.tone-down { background: #fbe3e6; color: #a32437; }
  .gr-ret.tone-flat { background: var(--bg-elev); color: var(--text-muted); }
  .gr-tnote { font-size: var(--step--2); color: var(--text-muted); line-height: 1.55; margin: 0.7rem 0 0; max-width: 720px; }

  .gr-body { max-width: 720px; }
  .gr-body p { font-size: var(--step-0); line-height: 1.65; color: var(--text-soft); margin: 0 0 0.9rem; }
  .gr-body a { color: var(--brand); font-weight: 600; }

  .gr-fq { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); margin-bottom: 0.6rem; max-width: 720px; }
  .gr-fq summary { cursor: pointer; padding: 0.8rem 1rem; font-weight: 600; font-size: var(--step-0); color: var(--text); }
  .gr-fq p { padding: 0 1rem 0.9rem; margin: 0; font-size: var(--step--1); line-height: 1.6; color: var(--text-soft); }

  .gr-note { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .gr-note p { font-size: var(--step--2); line-height: 1.6; max-width: 720px; color: var(--text-muted); padding: 0.8rem 1rem; background: var(--bg-elev); border: 1px solid var(--border-soft); border-radius: var(--radius); }

  @media (max-width: 620px) {
    .gr-stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script define:vars={{ built: data.updated }}>
  async function checkUpdate() {
    try {
      const r = await fetch('/dolar-getiri.json?_=' + Date.now(), { cache: 'no-store' });
      const d = await r.json();
      if (d && d.updated && d.updated !== built) location.reload();
    } catch { /* yoksay */ }
  }
  setInterval(() => { if (document.visibilityState === 'visible') checkUpdate(); }, 300000);
</script>
