  <script is:inline define:vars={{ C: { oran: HARC, asgari: ASGARI, g: G, g27: G27, yab: YAB, kMin: KMIN, kMax: KMAX } }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
      const money = (n) => '₺' + nf.format(Math.round(n));
      const harcOf = (b) => (b > 0 ? Math.max(C.asgari, Math.floor(b / 10) * 10 * C.oran) : 0);
      function update() {
        const price = Math.max(0, +$('in-price').value || 0);
        const evd = Math.max(0, +$('in-evd').value || 0);
        const kRaw = parseFloat(String($('in-k').value).replace(',', '.'));
        const k = kRaw > 0 ? Math.min(C.kMax, Math.max(C.kMin, kRaw)) : C.kMax;
        const kClamped = kRaw > 0 && k !== kRaw;
        const who = $('in-who').value;
        const kredi = $('in-kredi').checked;
        const yab = $('in-yab').checked;
        const base = Math.max(price, evd);
        const h = harcOf(base);
        let a = h;
        let s = h;
        if (who === 'alici') { a = 2 * h; s = 0; }
        else if (who === 'satici') { a = 0; s = 2 * h; }
        const n = base > 0 ? (kredi ? 2 : 1) : 0;
        const y = base > 0 && yab ? 1 : 0;
        const ds = Math.round(k * C.g) * n + y * C.yab;
        const ds27 = Math.round(k * C.g27) * n + y * Math.round((C.yab * C.g27) / C.g);
        $('out-total').textContent = money(2 * h + ds);
        $('out-alici').textContent = money(a);
        $('out-satici').textContent = money(s);
        $('out-ds').textContent = money(ds);
        $('out-base').textContent = money(Math.floor(base / 10) * 10);
        $('out-ds27').textContent = money(ds27);
        const notes = [];
        if (kClamped) notes.push('Yöresel katsayı yasal aralık olan 0,30–3,00’e çekildi (' + k.toFixed(2).replace('.', ',') + ').');
        if (evd > price) notes.push('Satış bedeli emlak vergisi değerinin altında; harç vergi değeri üzerinden hesaplandı.');
        if (who !== 'ayri') notes.push('Bu paylaşım taraflar arasındaki anlaşmadır; vergi dairesi karşısında her taraf kendi binde 20’sinden sorumludur (VUK md. 8).');
        if (kredi) notes.push('Konut kredisi ipoteği harçtan muaftır; ipotek için ikinci bir döner sermaye işlem ücreti eklendi.');
        if (!notes.length) notes.push('Döner sermayeye KDV dahildir ve işlemi talep edenden alınır.');
        $('out-note').textContent = notes.join(' ');
      }
      ['in-price', 'in-evd', 'in-k', 'in-who', 'in-kredi', 'in-yab'].forEach((id) => {
        $(id).addEventListener('input', update);
        $(id).addEventListener('change', update);
      });
      update();
    })();
  </script>

