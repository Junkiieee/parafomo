---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import tuik from '../../data/tuik-enflasyon-2026.json';

type Release = { covers: string; date: string };
const releases = tuik.releases as Release[];
const releaseTime = tuik.releaseTime as string;

const MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const DOW_TR = ['Pazar', 'Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi'];
const pad = (n: number) => String(n).padStart(2, '0');

const today = new Date();
today.setHours(0, 0, 0, 0);
const todayKey = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;

const rows = releases.map((r) => {
  const dt = new Date(r.date + 'T00:00:00');
  const isPast = r.date < todayKey;
  const daysUntil = Math.round((dt.getTime() - today.getTime()) / 86400000);
  return {
    ...r,
    isPast,
    daysUntil,
    dowLabel: DOW_TR[dt.getDay()],
    dayLabel: `${dt.getDate()} ${MONTHS[dt.getMonth()]} ${dt.getFullYear()}`,
  };
});

const next = rows.find((r) => !r.isPast);
const nextCountdownText =
  next == null ? '' : next.daysUntil === 0 ? 'bugün' : next.daysUntil === 1 ? 'yarın' : `${next.daysUntil} gün sonra`;

const updated = today.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

// FAQ schema — "ne zaman" niyetini hedefler
const faq = [
  {
    q: 'Enflasyon (TÜFE) ne zaman açıklanacak?',
    a: next
      ? `${next.covers} dönemine ait TÜFE (enflasyon) verisi ${next.dayLabel} günü (${nextCountdownText}), saat TSİ ${releaseTime}'da TÜİK tarafından açıklanacak. TÜİK enflasyon verisini genellikle ilgili ayı takip eden ayın başında (~3'ü) yayımlar.`
      : '2026 enflasyon yayım takvimi tamamlandı. 2027 tarihleri TÜİK Ulusal Veri Yayımlama Takvimi ile açıklandığında bu sayfaya eklenecek.',
  },
  {
    q: 'TÜİK enflasyon verisini saat kaçta açıklıyor?',
    a: `TÜİK, TÜFE (Tüketici Fiyat Endeksi) haber bültenini yayım günü sabahı saat ${releaseTime} (TSİ) itibarıyla resmi sitesinde yayımlar. Aynı saatte Yİ-ÜFE (üretici fiyatları) verisi de açıklanır.`,
  },
  {
    q: 'Enflasyon her ayın kaçında açıklanıyor?',
    a: 'Enflasyon verisi genellikle her ayın ilk günlerinde, çoğunlukla 3’ünde açıklanır. Bu tarih hafta sonuna ya da resmi tatile denk gelirse yayım, sonraki ilk iş gününe kayar. Kesin tarihler her yıl başında TÜİK’in Ulusal Veri Yayımlama Takvimi ile önceden ilan edilir.',
  },
  {
    q: 'TÜFE ile Yİ-ÜFE arasındaki fark nedir?',
    a: 'TÜFE (Tüketici Fiyat Endeksi) hanelerin satın aldığı mal ve hizmet sepetindeki fiyat değişimini — yani vatandaşın hissettiği enflasyonu — ölçer. Yİ-ÜFE (Yurt İçi Üretici Fiyat Endeksi) ise üreticilerin fiyatlarındaki değişimi ölçer ve gelecekteki tüketici enflasyonuna dair öncü sinyal verir. İkisi aynı gün açıklanır.',
  },
  {
    q: 'Enflasyon verisi piyasaları nasıl etkiler?',
    a: 'Beklentiden yüksek enflasyon, TCMB’nin faizi daha uzun süre yüksek tutacağı beklentisini güçlendirir; bu TL mevduatını cazip kılarken kredi maliyetini artırır. Beklentiden düşük enflasyon ise faiz indirimi ihtimalini öne çeker. Veri ayrıca memur/emekli maaş zamları ve kira artış oranı gibi birçok kalemi doğrudan belirlediği için geniş kesimi ilgilendirir.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Enflasyon Ne Zaman Açıklanacak? 2026 TÜİK TÜFE Takvimi"
  description="2026 TÜİK enflasyon (TÜFE) açıklama takvimi: her ayın verisi hangi gün ve saat kaçta açıklanacak. Bir sonraki enflasyon verisine kaç gün kaldığını gör."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="container fk-hero">
    <span class="eyebrow"><span class="pulse"></span> Canlı Takvim</span>
    <h1>Enflasyon Ne Zaman Açıklanacak? 2026 Takvimi</h1>
    <p class="lede soft">
      TÜİK'in 2026 yılında her ay TÜFE (enflasyon) verisini hangi gün ve saatte açıkladığı —
      resmi Ulusal Veri Yayımlama Takvimi'nden, tek sayfada geri sayımla.
    </p>

    {next && (
      <div class="fk-next">
        <div class="fk-next-count">
          <span class="fk-next-num">{next.daysUntil}</span>
          <span class="fk-next-unit">gün</span>
        </div>
        <div class="fk-next-body">
          <span class="fk-next-label">Sıradaki enflasyon verisi</span>
          <span class="fk-next-date">{next.dowLabel}, {next.dayLabel}</span>
          <span class="fk-next-time">TSİ {releaseTime} · {next.covers} TÜFE</span>
        </div>
      </div>
    )}
    <p class="fk-upd">Son güncelleme: {updated} · Kaynak: TÜİK Ulusal Veri Yayımlama Takvimi</p>
  </section>

  <section class="container fk-section">
    <div class="fk-shead">
      <h2>2026 TÜFE Açıklama Tarihleri</h2>
      <span class="fk-shead-count">{releases.length} veri</span>
    </div>

    <div class="fk-table">
      {rows.map((r) => (
        <div class:list={['fk-row', { past: r.isPast, next: next != null && r.date === next.date }]}>
          <span class="fk-cell-date">
            <strong>{r.dayLabel}</strong>
            <small>{r.dowLabel} · {r.covers} enflasyonu</small>
          </span>
          <span class="fk-cell-time">TSİ {releaseTime}</span>
          <span class="fk-cell-status">
            {r.isPast ? 'açıklandı' : next != null && r.date === next.date ? nextCountdownText : `${r.daysUntil} gün`}
          </span>
        </div>
      ))}
    </div>
    <p class="fk-fine">
      TÜFE (enflasyon) verisi ilgili ayı takip eden ayın başında, çoğunlukla ayın 3'ünde saat
      TSİ {releaseTime}'da açıklanır; tarih hafta sonu veya tatile denk gelirse sonraki iş gününe kayar.
      Aynı saatte Yİ-ÜFE (üretici fiyatları) da yayımlanır. Kesin tarihler için tuik.gov.tr'yi kontrol edin.
    </p>
  </section>

  <section class="container fk-info">
    <h2>Enflasyon Verisi Nedir, Neden Takip Edilir?</h2>
    <p>
      Enflasyon, genel fiyat düzeyindeki artışı — yani paranın alım gücündeki erimeyi — ölçer.
      Türkiye'de bu veriyi <strong>TÜİK (Türkiye İstatistik Kurumu)</strong> her ay
      <strong>TÜFE (Tüketici Fiyat Endeksi)</strong> haber bülteniyle yayımlar. Aylık ve yıllık
      enflasyon oranı; faiz kararlarını, maaş ve kira zamlarını, döviz ve altın talebini doğrudan
      etkilediği için milyonlarca hane ve yatırımcı bu tarihi yakından izler.
    </p>
    <p>
      <strong>Enflasyon beklentiden yüksek gelirse:</strong> TCMB'nin faizi yüksek tutacağı
      beklentisi güçlenir; TL mevduatı cazipleşir, krediler pahalı kalır.
      <strong>Beklentiden düşük gelirse:</strong> faiz indirimi ihtimali öne çıkar, borsa ve
      faize duyarlı varlıklar olumlu tepki verebilir.
    </p>
    <p>
      <strong>TCMB kararıyla ilişki:</strong> Enflasyon verisi, Merkez Bankası'nın Para Politikası
      Kurulu (PPK) faiz kararlarının en önemli girdisidir. İki takvimi yan yana izlemek, faiz ve
      kur yönü için daha sağlıklı bir çerçeve verir.
    </p>
    <div class="fk-links">
      <a href="/blog/tufe-enflasyon-verisi-nasil-okunur">TÜİK Enflasyon Verisi Nasıl Okunur? →</a>
      <a href="/blog/tufe-sepeti-nedir-enflasyon-nasil-hesaplanir">TÜFE Sepeti Nedir? Enflasyon Nasıl Hesaplanır? →</a>
      <a href="/blog/enflasyondan-nasil-korunur">Enflasyondan Korunmak İçin Para Nereye Yatırılır? →</a>
      <a href="/blog/reel-faiz-nedir">Reel Faiz Nedir? Enflasyona Göre Gerçek Getiri →</a>
      <a href="/kira-artis-orani-hesaplama">Kira artış oranı hesaplama (güncel yasal tavan) →</a>
      <a href="/tcmb-faiz-takvimi">TCMB (Merkez Bankası) faiz kararı takvimi 2026 →</a>
      <a href="/ekonomik-takvim">Tüm ekonomik takvim (TCMB, Fed, TÜİK) →</a>
    </div>
  </section>

  <section class="container fk-faq">
    <h2>Sık Sorulan Sorular</h2>
    {faq.map((f) => (
      <details class="fk-faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="container fk-note">
    <p>
      Bu sayfa yalnızca bilgilendirme amaçlıdır; yatırım tavsiyesi değildir. Yayım tarihleri TÜİK
      tarafından önceden ilan edilir ancak nadiren güncellenebilir; kesin tarih ve saatler için
      tuik.gov.tr adresini kontrol edin.
    </p>
  </section>

  <div class="container"><Newsletter /></div>
</BaseLayout>

<style>
  .fk-hero { padding: clamp(1.6rem, 4vw, 2.6rem) 0 0; max-width: 720px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--step--2); font-weight: 600; color: var(--brand); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 0 rgba(22,160,133,0.5); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(22,160,133,0.5); } 70% { box-shadow: 0 0 0 6px rgba(22,160,133,0); } 100% { box-shadow: 0 0 0 0 rgba(22,160,133,0); } }
  .fk-hero h1 { font-size: var(--step-2); margin: 0.6rem 0 0.4rem; }
  .fk-hero .lede { font-size: var(--step-0); line-height: 1.5; margin: 0 0 0.9rem; }
  .fk-upd { font-size: var(--step--2); color: var(--text-muted); margin: 0.7rem 0 0; }

  /* Next-release countdown */
  .fk-next {
    display: flex; align-items: center; gap: 1rem;
    background: var(--brand-tint); border: 1px solid var(--brand-light); border-radius: var(--radius);
    padding: 0.9rem 1.1rem; max-width: 460px;
  }
  .fk-next-count {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: var(--bg-card); border: 1px solid var(--brand-light); border-radius: var(--radius);
    padding: 0.4rem 0.9rem; min-width: 72px;
  }
  .fk-next-num { font-size: var(--step-2); font-weight: 800; color: var(--brand-deep); line-height: 1; font-variant-numeric: tabular-nums; }
  .fk-next-unit { font-size: var(--step--2); color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .fk-next-body { display: flex; flex-direction: column; gap: 0.15rem; }
  .fk-next-label { font-size: var(--step--2); font-weight: 700; color: var(--brand-deep); text-transform: uppercase; letter-spacing: 0.05em; }
  .fk-next-date { font-size: var(--step-0); font-weight: 700; color: var(--text); }
  .fk-next-time { font-size: var(--step--2); color: var(--text-muted); }

  .fk-section { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .fk-shead { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.7rem; }
  .fk-shead h2 { font-size: var(--step-1); margin: 0; }
  .fk-shead-count { font-size: 0.66rem; font-weight: 700; color: var(--brand-deep); background: var(--brand-tint); border-radius: 999px; padding: 0.1rem 0.55rem; }

  .fk-table { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-card); box-shadow: var(--shadow-xs); max-width: 700px; }
  .fk-row {
    display: grid; grid-template-columns: 1fr auto auto; align-items: center;
    gap: 0.5rem 1rem; padding: 0.7rem 1rem; border-bottom: 1px solid var(--border-soft);
  }
  .fk-row:last-child { border-bottom: none; }
  .fk-row.past { opacity: 0.5; }
  .fk-row.next { background: var(--brand-tint); border-left: 3px solid var(--brand-deep); }
  .fk-cell-date { display: flex; flex-direction: column; gap: 0.1rem; }
  .fk-cell-date strong { font-size: var(--step-0); color: var(--text); }
  .fk-cell-date small { font-size: var(--step--2); color: var(--text-muted); }
  .fk-cell-time { font-size: var(--step--1); font-weight: 700; color: var(--text-soft); font-variant-numeric: tabular-nums; }
  .fk-cell-status { font-size: var(--step--2); font-weight: 700; color: var(--text-muted); text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .fk-row.next .fk-cell-status { color: var(--brand-deep); }

  .fk-fine { font-size: var(--step--2); color: var(--text-muted); line-height: 1.6; margin: 0.8rem 0 0; max-width: 640px; }

  .fk-info { margin-top: clamp(1.6rem, 4vw, 2.6rem); max-width: 700px; padding: 1.2rem 1.4rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-xs); }
  .fk-info h2 { font-size: var(--step-1); margin: 0 0 0.7rem; }
  .fk-info p { font-size: var(--step--1); color: var(--text-soft); line-height: 1.65; margin: 0 0 0.7rem; }
  .fk-info strong { color: var(--text); }
  .fk-links { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.6rem; }
  .fk-links a { font-size: var(--step--1); color: var(--brand-deep); font-weight: 600; text-decoration: none; }
  .fk-links a:hover { text-decoration: underline; }

  .fk-faq { margin-top: clamp(1.6rem, 4vw, 2.6rem); max-width: 700px; }
  .fk-faq h2 { font-size: var(--step-1); margin: 0 0 0.7rem; }
  .fk-faq-item { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); padding: 0.7rem 1rem; margin-bottom: 0.6rem; }
  .fk-faq-item summary { cursor: pointer; font-size: var(--step--1); font-weight: 600; color: var(--text); user-select: none; }
  .fk-faq-item p { font-size: var(--step--1); color: var(--text-soft); line-height: 1.6; margin: 0.6rem 0 0; }

  .fk-note { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .fk-note p { font-size: var(--step--2); line-height: 1.6; max-width: 640px; color: var(--text-muted); padding: 0.8rem 1rem; background: var(--bg-elev); border: 1px solid var(--border-soft); border-radius: var(--radius); }

  @media (max-width: 560px) {
    .fk-row { grid-template-columns: 1fr auto; row-gap: 0.3rem; }
    .fk-cell-time { grid-column: 2; text-align: right; }
    .fk-cell-status { grid-column: 2; }
  }
</style>
