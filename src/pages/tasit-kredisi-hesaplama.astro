  <script
    is:inline
    define:vars={{
      TAX,
      TERMS,
      AMOUNTS_G,
      AMOUNTS_Y,
      KURAL: {
        genel: KURAL.genel.map((k) => ({ upTo: k.upTo === Infinity ? 1e15 : k.upTo, ltv: k.ltv, months: k.months })),
        yerli: KURAL.yerli.map((k) => ({ upTo: k.upTo === Infinity ? 1e15 : k.upTo, ltv: k.ltv, months: k.months })),
      },
    }}
  >
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
      const money = (n) => '₺' + nf.format(Math.round(n));
      const pct = (n) => n.toLocaleString('tr-TR', { maximumFractionDigits: 2 });
      const TAXF = 1 + TAX.kkdf + TAX.bsmv;
      const kademe = (k, v) => k.find((x) => v <= x.upTo);
      const vadeTavani = (k, a) => k.reduce((m, x) => (x.ltv > 0 && a <= x.ltv * x.upTo + 0.5 ? Math.max(m, x.months) : m), 0);

      function loan(P, ratePct, n) {
        const i = (ratePct / 100) * TAXF;
        const pay = i === 0 ? P / n : (P * i) / (1 - Math.pow(1 + i, -n));
        const total = pay * n;
        const cost = total - P;
        const interest = cost / TAXF;
        return { pay, total, cost, interest, kkdf: interest * TAX.kkdf, bsmv: interest * TAX.bsmv, i };
      }

      function buildSchedule(P, l, n) {
        const body = $('schedule-body');
        let bal = P;
        const rows = [];
        const showAll = n <= 18;
        for (let m = 1; m <= n; m++) {
          const interest = bal * (l.i / TAXF);
          const tax = interest * (TAXF - 1);
          let principal = l.pay - interest - tax;
          if (m === n) principal = bal;
          bal = Math.max(0, bal - principal);
          if (showAll || m <= 6 || m > n - 3) {
            rows.push(`<tr><td>${m}</td><td>${money(l.pay)}</td><td>${money(principal)}</td><td>${money(interest)}</td><td>${money(tax)}</td><td>${money(bal)}</td></tr>`);
          } else if (m === 7) {
            rows.push(`<tr class="ellipsis"><td colspan="6">… ${n - 9} ara taksit …</td></tr>`);
          }
        }
        body.innerHTML = rows.join('');
      }

      function buildGrid(id, k, amounts, rate) {
        document.querySelector('#' + id + ' tbody').innerHTML = amounts.map((a) => {
          const cap = vadeTavani(k, a);
          return `<tr><td>${money(a)}</td>${TERMS.map((m) => `<td>${m <= cap ? money(loan(a, rate, m).pay) : `<span class="na">BDDK: en fazla ${cap} ay</span>`}</td>`).join('')}</tr>`;
        }).join('');
      }

      function update() {
        const V = Math.max(0, +$('in-value').value || 0);
        const kasko = Math.max(0, +$('in-kasko').value || 0);
        const BV = kasko > 0 ? kasko : V;                 // BDDK’nın esas aldığı değer
        const down = Math.min(V, Math.max(0, +$('in-down').value || 0));
        const P = V - down;
        const rate = Math.max(0, +$('in-rate').value || 0);
        const n = Math.max(1, Math.min(120, Math.round(+$('in-months').value || 1)));
        const sel = document.querySelector('input[name="kural"]:checked');
        const K = KURAL[sel ? sel.value : 'genel'];
        const l = loan(P, rate, n);
        $('out-pay').textContent = money(l.pay);
        $('out-loan').textContent = money(P);
        $('out-ltv').textContent = BV > 0 ? '%' + pct((P / BV) * 100) : '—';
        $('out-total').textContent = money(l.total);
        $('out-interest').textContent = money(l.interest);
        $('out-kkdf').textContent = money(l.kkdf);
        $('out-bsmv').textContent = money(l.bsmv);
        $('out-cost').textContent = money(l.cost);

        const k = kademe(K, BV);
        const maxLoan = k.ltv * BV;
        const aracTanim = kasko > 0 ? `kasko değeri ${money(BV)} olan araçta` : `${money(BV)} değerindeki araçta`;
        const msgs = [];
        if (k.ltv === 0) {
          msgs.push(`BDDK sınırı: değeri ${money(K[K.length - 2].upTo)} üzerindeki araçlara taşıt kredisi kullandırılamaz.`);
        } else {
          if (P > maxLoan + 0.5) msgs.push(`BDDK sınırı: ${aracTanim} kredi en fazla %${Math.round(k.ltv * 100)} (${money(maxLoan)}) olabilir; peşinat en az ${money(V - maxLoan)} olmalı.`);
          if (n > k.months) msgs.push(`BDDK sınırı: bu değerdeki araçta vade en fazla ${k.months} ay.`);
        }
        const w = $('out-warn');
        w.hidden = msgs.length === 0;
        w.textContent = msgs.join('\n');
        $('out-limit').textContent = BV === 0
          ? 'BDDK sınırını görmek için araç fiyatını girin.'
          : k.ltv === 0
            ? 'BDDK: bu değerdeki araca taşıt kredisi kullandırılamaz.'
            : `Bu araç için BDDK sınırı: en fazla ${money(maxLoan)} kredi (%${Math.round(k.ltv * 100)}), en fazla ${k.months} ay vade.`;

        document.querySelectorAll('.preset').forEach((b) => b.classList.toggle('active', +b.dataset.months === n));
        buildSchedule(P, l, n);
        buildGrid('grid-g', KURAL.genel, AMOUNTS_G, rate);
        buildGrid('grid-y', KURAL.yerli, AMOUNTS_Y, rate);
        document.querySelectorAll('.grid-rate').forEach((e) => { e.textContent = '%' + pct(rate); });
      }

      ['in-value', 'in-kasko', 'in-down', 'in-rate', 'in-months'].forEach((id) => $(id).addEventListener('input', update));
      document.querySelectorAll('input[name="kural"]').forEach((r) => r.addEventListener('change', update));
      document.querySelectorAll('.preset').forEach((b) =>
        b.addEventListener('click', () => { $('in-months').value = b.dataset.months; update(); })
      );
      update();
    })();
  </script>

