---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import faiz from '../../data/faiz-oranlari.json';

// Varsayılan faiz = TCMB haftalık ağırlıklı ortalama taşıt kredisi faizi (EVDS TP.KTF11, scripts/evds-rates.py —
// her hafta otomatik). TCMB yıllık bileşik yayımlar → aylık = (1+E)^(1/12) − 1 (kredi.tasit.aylik).
// Vergiler (2026-10-18 doğrulandı): taşıt kredisi tüketici kredisidir → KKDF %15 (GİB KKDF oran tablosu, 2010/974 BKK),
// BSMV %15 (7345 sayılı CK, RG 7.7.2023); ICBC Turkey taşıt kredisi ürün bilgi formu (22.04.2026) aynı iki oranı yazar.
// Taksit matematiği /ihtiyac-kredisi-hesaplama ile birebir aynı: vergili aylık faiz = akdi faiz × (1 + 0,15 + 0,15).
// BDDK sınırları (bddk.org.tr "Resmî Gazetede yayımlanmayan Kurul kararları" listesi 2026-10-18 kontrol edildi;
// 11158'den sonra yeni taşıt kararı yok):
//  • Genel — 21.02.2022 tarihli 10099 sayılı Kurul Kararı: nihai fatura değeri ≤400 bin %70/48 ay, ≤800 bin %50/36,
//    ≤1,2 mn %30/24, ≤2 mn %20/12, üzeri %0. Garanti BBVA, İş Bankası (2026) ve Akbank (2025) aynı tabloyu uygular.
//  • Yerli elektrikli — 06.03.2025 tarihli 11158 sayılı Kurul Kararı: yalnız 5520 s. KVK geçici 12. md. kapsamındaki
//    mükelleflerin ürettiği elektrikli taşıtlar (Togg): ≤2,5 mn %70/48, ≤5 mn %50/36, ≤6,5 mn %30/24, ≤7,5 mn %20/12, üzeri %0.
//  • Kredi/değer oranı binek araç taşıt kredilerine uygulanır (taşıt teminatlı krediler hariç). İkinci elde değer = kasko
//    değeri (Bankaların Kredi İşlemlerine İlişkin Yönetmelik md. 12/2, RG 21.12.2023); bankalar vade kademesini de buna göre uygular.
// Ücretler: TCMB 2020/7 sayılı Tebliğ md. 10 — tahsis ücreti ≤ anaparanın binde 5'i; rehin/ekspertizde yalnız üçüncü kişi ücreti.
// 6502 sayılı Kanun: md. 24 cayma 14 gün · md. 25 sabit faiz · md. 27 erken ödeme (tazminat yok) · md. 29 sigorta.
const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const trDate = (iso: string) => { const [y, m, d] = iso.split('-').map(Number); return `${d} ${AYLAR[m - 1]} ${y}`; };
const HAFTA = trDate(faiz.hafta);
const KR = faiz.kredi;
const T = KR.tasit;
const TAX = { kkdf: 0.15, bsmv: 0.15 };
const TAXF = 1 + TAX.kkdf + TAX.bsmv;

type Kademe = { upTo: number; ltv: number; months: number; label: string };
const KURAL: Record<'genel' | 'yerli', Kademe[]> = {
  genel: [
    { upTo: 400000, ltv: 0.7, months: 48, label: '400.000 ₺ ve altı' },
    { upTo: 800000, ltv: 0.5, months: 36, label: '400.000 – 800.000 ₺' },
    { upTo: 1200000, ltv: 0.3, months: 24, label: '800.000 – 1.200.000 ₺' },
    { upTo: 2000000, ltv: 0.2, months: 12, label: '1.200.000 – 2.000.000 ₺' },
    { upTo: Infinity, ltv: 0, months: 0, label: '2.000.000 ₺ üzeri' },
  ],
  yerli: [
    { upTo: 2500000, ltv: 0.7, months: 48, label: '2.500.000 ₺ ve altı' },
    { upTo: 5000000, ltv: 0.5, months: 36, label: '2.500.000 – 5.000.000 ₺' },
    { upTo: 6500000, ltv: 0.3, months: 24, label: '5.000.000 – 6.500.000 ₺' },
    { upTo: 7500000, ltv: 0.2, months: 12, label: '6.500.000 – 7.500.000 ₺' },
    { upTo: Infinity, ltv: 0, months: 0, label: '7.500.000 ₺ üzeri' },
  ],
};
const kademe = (k: Kademe[], value: number) => k.find((x) => value <= x.upTo)!;
// Bir kredi tutarı, BDDK oranlarına uyan en elverişli araç değeriyle en fazla kaç ay vadeli olabilir (0 = hiç olamaz)?
const vadeTavani = (k: Kademe[], amount: number) =>
  k.reduce((m, x) => (x.ltv > 0 && amount <= x.ltv * x.upTo + 0.5 ? Math.max(m, x.months) : m), 0);
const enYuksekKredi = (k: Kademe[]) => Math.max(...k.filter((x) => x.ltv > 0).map((x) => Math.round(x.ltv * x.upTo)));
const MAX_G = enYuksekKredi(KURAL.genel);
const MAX_Y = enYuksekKredi(KURAL.yerli);

const D = { value: 800000, down: 400000, rate: T.aylik, months: 36 };
const LOAN = D.value - D.down;

// Eşit taksit (anüite), vergili faizle: taksit = P·i / (1 − (1+i)^−n), i = r × 1,30 (ihtiyaç kredisi sayfasıyla aynı)
function loan(P: number, ratePct: number, n: number) {
  const i = (ratePct / 100) * TAXF;
  const pay = i === 0 ? P / n : (P * i) / (1 - Math.pow(1 + i, -n));
  const total = pay * n;
  const cost = total - P;                       // faiz + KKDF + BSMV
  const interest = cost / TAXF;                 // yalnız faiz
  return { pay, total, cost, interest, kkdf: interest * TAX.kkdf, bsmv: interest * TAX.bsmv };
}
const base = loan(LOAN, D.rate, D.months);
const baseK = kademe(KURAL.genel, D.value);

const fmt = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));
const pct = (n: number) => n.toLocaleString('tr-TR', { maximumFractionDigits: 2 });

// Taksit tabloları — BDDK'nın hiçbir araç değerinde izin vermediği vade hücresi boş kalır.
const TERMS = [12, 24, 36, 48];
const AMOUNTS_G = [100000, 200000, 300000, 400000];
const AMOUNTS_Y = [500000, 1000000, 2000000];
const gridRows = (k: Kademe[], amounts: number[]) =>
  amounts.map((a) => {
    const cap = vadeTavani(k, a);
    return { a, cap, cells: TERMS.map((m) => (m <= cap ? loan(a, D.rate, m).pay : null)) };
  });
const gridG = gridRows(KURAL.genel, AMOUNTS_G);
const gridY = gridRows(KURAL.yerli, AMOUNTS_Y);
const ex400 = loan(400000, D.rate, 36);

// Son 52 haftanın en düşük / en yüksek taşıt kredisi ortalaması (aynı veri dosyasından)
const S = faiz.seri.filter((x) => typeof x.tasit === 'number');
const lo = S.reduce((a, b) => (b.tasit < a.tasit ? b : a));
const hi = S.reduce((a, b) => (b.tasit > a.tasit ? b : a));

const SRC = {
  bddkGenel: 'https://www.bddk.org.tr/Mevzuat/DokumanGetir/1099',
  bddkYerli: 'https://www.bddk.org.tr/Mevzuat/DokumanGetir/1278',
  krediYon: 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=40520&MevzuatTur=7&MevzuatTertip=5',
  k6502: 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=6502&MevzuatTur=1&MevzuatTertip=5',
  ucretTeblig: 'https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=34343&MevzuatTur=9&MevzuatTertip=5',
  gibKkdf: 'https://cdn.gib.gov.tr/api/gibportal-file/file/getFileResources?objectKey=arsiv%2Fyardim-kaynaklar%2Fyararli-bilgiler%2Fkkdf-oranlari.pdf',
  tcmb: 'https://www.tcmb.gov.tr/wps/wcm/connect/TR/TCMB+TR/Main+Menu/Istatistikler/Faiz+Istatistikleri/Haftalik/Kredi+Faiz+Oranlari/',
};

const faq = [
  {
    q: 'Taşıt kredisi faiz oranları ne kadar?',
    a: `TCMB’nin ${HAFTA} haftası verisine göre bankaların yeni kullandırdığı taşıt kredilerinde ağırlıklı ortalama faiz yıllık %${pct(T.yillikBilesik)}; bu, aylık yaklaşık %${pct(T.aylik)} faize karşılık gelir. Ortalama, tüm bankaların hacimle ağırlıklandırılmış oranıdır ve haftadan haftaya belirgin değişebilir (son ${S.length} haftada yıllık %${pct(lo.tasit)} ile %${pct(hi.tasit)} arasında). Kampanyalı ve bankaya özel oranlar farklı olabilir; hesaplayıcının varsayılan faizi her hafta bu veriyle otomatik güncellenir.`,
  },
  {
    q: 'Taşıt kredisi taksiti nasıl hesaplanır?',
    a: `Taşıt kredisi bir tüketici kredisidir; bankalar faizin üzerine %15 KKDF ve %15 BSMV ekler. Taksit bu vergili faizle eşit taksit (anüite) formülüyle bulunur: vergili aylık faiz = akdi faiz × 1,30; taksit = kredi × vergili faiz ÷ (1 − (1 + vergili faiz)⁻ⁿ). Aylık %${pct(D.rate)} faizle 400.000 ₺ krediyi 36 ay vadede kullanırsanız aylık taksit yaklaşık ${fmt(ex400.pay)} ₺, toplam geri ödeme ${fmt(ex400.total)} ₺ olur.`,
  },
  {
    q: 'Taşıt kredisiyle aracın yüzde kaçı finanse edilebilir?',
    a: `Azami oranı BDDK belirler ve oran aracın nihai fatura değerine (ikinci elde kasko değerine) göre kademelidir: 400.000 ₺ ve altında %70, 400.000–800.000 ₺ arası %50, 800.000–1.200.000 ₺ arası %30, 1.200.000–2.000.000 ₺ arası %20; değeri 2.000.000 ₺ üzerindeki binek araçlara taşıt kredisi kullandırılamaz (21 Şubat 2022 tarihli ve 10099 sayılı Kurul Kararı). Bu yüzden genel kurallarla bir binek araç için çekilebilecek taşıt kredisi en fazla ${fmt(MAX_G)} ₺ olur. Yerli üretim elektrikli otomobillerde (ör. Togg) aynı oranlar 2,5 / 5 / 6,5 / 7,5 milyon ₺ kademelerine göre uygulanır (6 Mart 2025 tarihli ve 11158 sayılı Kurul Kararı).`,
  },
  {
    q: 'Taşıt kredisi en fazla kaç ay vadeli çekilebilir?',
    a: 'Azami vade kredi tutarına değil aracın değerine (sıfırda nihai fatura, ikinci elde kasko değeri) bağlıdır: 400.000 ₺ ve altındaki araçlarda 48 ay, 400.000–800.000 ₺ arasında 36 ay, 800.000–1.200.000 ₺ arasında 24 ay, 1.200.000–2.000.000 ₺ arasında 12 ay. Yerli üretim elektrikli otomobillerde aynı vadeler 2,5 milyon, 5 milyon, 6,5 milyon ve 7,5 milyon ₺ kademelerine göre uygulanır. Banka gelirinize ve kredi notunuza göre daha kısa vade önerebilir.',
  },
  {
    q: 'İkinci el araç kredisi nasıl hesaplanır?',
    a: 'İkinci el binek araçlarda BDDK oranları satış fiyatına değil aracın kasko değerine uygulanır (Bankaların Kredi İşlemlerine İlişkin Yönetmelik md. 12); kademeler sıfır araçlarla aynıdır. Örneğin kasko değeri 800.000 ₺ olan araca en fazla 400.000 ₺ kredi, en fazla 36 ay vadeyle kullanılabilir. Satış fiyatı kasko değerinden yüksekse aradaki fark peşinata eklenir. Bankalar ayrıca araç yaşına üst sınır koyar ve ekspertiz isteyebilir.',
  },
  {
    q: 'Taşıt kredisini erken kapatırsam ceza öder miyim?',
    a: 'Hayır. 6502 sayılı Tüketicinin Korunması Hakkında Kanun’un 27. maddesine göre tüketici kredisini kısmen ya da tamamen erken ödeyebilirsiniz; banka erken ödenen tutara göre faiz ve diğer maliyetlerden indirim yapmak zorundadır. Bu maddede erken ödeme tazminatı öngörülmez; %1–2’lik tazminat yalnızca sabit faizli konut kredilerinde (md. 37) söz konusudur. Borç kapandığında araç üzerindeki rehin kaldırılır.',
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Kredi Hesaplama', url: '/kredi-hesaplama/' },
  { name: 'Taşıt Kredisi Hesaplama', url: '/tasit-kredisi-hesaplama/' },
];
---

<BaseLayout
  title="Taşıt Kredisi Hesaplama 2026 | Güncel Faiz, Peşinat ve Vade Sınırı"
  description={`Taşıt kredisi hesaplama: TCMB ortalama faizi aylık %${pct(T.aylik)} (${HAFTA}). Sıfır ve ikinci el araçta KKDF-BSMV dahil taksit, peşinat ve BDDK vade sınırı.`}
  faq={faq}
  breadcrumbs={breadcrumbs}
  image="/og/tasit-kredisi-hesaplama.png"
>
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Hesaplayıcı · Taşıt Kredisi</p>
      <h1>Taşıt Kredisi Hesaplama</h1>
      <p class="lede">
        Araç fiyatını, peşinatı, aylık faizi ve vadeyi girin; <strong>KKDF ve BSMV dahil aylık taksitinizi</strong>,
        toplam geri ödemeyi ve ödeme planını görün. Sıfır ve ikinci el araç kredisinde BDDK’nın kredi oranı ve
        vade sınırlarını da kontrol eder.
      </p>
    </header>

    <div class="calc-grid">
      <form class="calc-inputs" id="calc-form" autocomplete="off">
        <label>
          <span>Araç fiyatı (₺) <small>sıfırda nihai fatura tutarı</small></span>
          <input type="number" id="in-value" value={D.value} min="0" step="10000" inputmode="numeric" />
        </label>
        <label>
          <span>İkinci elde kasko değeri (₺) <small>sıfır araçta boş bırakın</small></span>
          <input type="number" id="in-kasko" min="0" step="10000" inputmode="numeric" placeholder="Sıfır araç" />
        </label>
        <label>
          <span>Peşinat (₺)</span>
          <input type="number" id="in-down" value={D.down} min="0" step="10000" inputmode="numeric" />
        </label>
        <label>
          <span>Aylık faiz oranı (%) <small>vergiler hariç, bankanın ilanı</small></span>
          <input type="number" id="in-rate" value={D.rate} min="0" max="15" step="0.01" inputmode="decimal" />
        </label>
        <label>
          <span>Vade (ay)</span>
          <input type="number" id="in-months" value={D.months} min="1" max="48" step="1" inputmode="numeric" />
        </label>
        <div class="preset-row" role="group" aria-label="Hızlı vade seçimi">
          {TERMS.map((m) => <button type="button" class="preset" data-months={m}>{m} ay</button>)}
        </div>
        <fieldset class="mode-toggle">
          <legend>BDDK kademesi</legend>
          <label class="radio">
            <input type="radio" name="kural" value="genel" checked />
            <span>Genel: benzinli, dizel, hibrit, ithal elektrikli</span>
          </label>
          <label class="radio">
            <input type="radio" name="kural" value="yerli" />
            <span>Yerli üretim elektrikli (ör. Togg)</span>
          </label>
        </fieldset>
        <p class="vade-warn" id="out-warn" hidden></p>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label">Aylık taksit (KKDF + BSMV dahil)</span>
          <span class="result-value" id="out-pay">₺{fmt(base.pay)}</span>
        </div>
        <div class="result-split">
          <div class="split-item">
            <span class="split-label">Kredi tutarı</span>
            <span class="split-val" id="out-loan">₺{fmt(LOAN)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Kredi / araç değeri</span>
            <span class="split-val" id="out-ltv">%{pct((LOAN / D.value) * 100)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Toplam geri ödeme</span>
            <span class="split-val" id="out-total">₺{fmt(base.total)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Toplam faiz</span>
            <span class="split-val" id="out-interest">₺{fmt(base.interest)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">KKDF (%15)</span>
            <span class="split-val" id="out-kkdf">₺{fmt(base.kkdf)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">BSMV (%15)</span>
            <span class="split-val" id="out-bsmv">₺{fmt(base.bsmv)}</span>
          </div>
          <div class="split-item strong">
            <span class="split-label">Kredinin toplam maliyeti</span>
            <span class="split-val" id="out-cost">₺{fmt(base.cost)}</span>
          </div>
        </div>
        <p class="limit-line" id="out-limit">Bu araç için BDDK sınırı: en fazla ₺{fmt(baseK.ltv * D.value)} kredi (%{Math.round(baseK.ltv * 100)}), en fazla {baseK.months} ay vade.</p>
        <p class="result-note">Varsayılan aylık %{pct(D.rate)}: TCMB ortalama taşıt kredisi faizi ({HAFTA} haftası, yıllık %{pct(T.yillikBilesik)}). Bankanızın ilan ettiği aylık faizi girerek değiştirin.</p>
      </div>
    </div>

    <p class="disclaimer">
      Bu araç yalnızca bilgilendirme amaçlıdır, kredi teklifi veya finansal tavsiye değildir. Hesap, ilan edilen
      aylık faizin üzerine %15 KKDF ve %15 BSMV ekler; banka ayrıca kredi tahsis ücreti, rehin masrafı ve kasko
      gibi kalemler isteyebilir. TCMB ortalamasının vergileri içerip içermediği metaveride belirtilmez; en doğru
      sonuç için bankanızın ilan ettiği aylık faizi girin ve sözleşme öncesi bilgi formundaki toplam maliyeti esas
      alın. BDDK kontrolü yasal üst sınırları gösterir; bankanın kendi kredi politikası daha sıkı olabilir.
    </p>

    <section class="table-block" id="bddk-sinirlari">
      <h2>Taşıt kredisi BDDK sınırları: aracın yüzde kaçına kredi çıkar?</h2>
      <p class="table-intro">
        Kredi tutarı ve vade, aracın <strong>nihai fatura değerine</strong> (ikinci elde <strong>kasko değerine</strong>)
        göre sınırlanır. Tablolar, tüketicilere binek araç alımı için kullandırılan taşıt kredilerine aittir
        (taşıt teminatlı krediler hariç).
      </p>
      <h3>Genel kural: benzinli, dizel, hibrit ve ithal elektrikli araçlar</h3>
      <div class="table-scroll">
        <table class="rate-table">
          <thead><tr><th>Araç değeri</th><th>Azami kredi oranı</th><th>Azami vade</th><th>Kademe tavanında en fazla kredi</th></tr></thead>
          <tbody>
            {KURAL.genel.map((k) => (
              <tr>
                <td>{k.label}</td>
                <td>%{Math.round(k.ltv * 100)}</td>
                <td>{k.months ? `${k.months} ay` : '—'}</td>
                <td>{k.ltv ? `₺${fmt(k.ltv * k.upTo)}` : 'Kredi kullandırılamaz'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        BDDK’nın 21 Şubat 2022 tarihli ve 10099 sayılı Kurul Kararı
        (<a href={SRC.bddkGenel} rel="nofollow noopener" target="_blank">karar metni</a>). Bu sınırlarla bir binek
        araç için kullanılabilecek taşıt kredisi en fazla <strong>{fmt(MAX_G)} ₺</strong> olur (800.000 ₺ değerindeki
        araçta %50 ya da 2.000.000 ₺ değerindeki araçta %20).
      </p>

      <h3>Yerli üretim elektrikli otomobiller (ör. Togg)</h3>
      <div class="table-scroll">
        <table class="rate-table">
          <thead><tr><th>Araç değeri</th><th>Azami kredi oranı</th><th>Azami vade</th><th>Kademe tavanında en fazla kredi</th></tr></thead>
          <tbody>
            {KURAL.yerli.map((k) => (
              <tr>
                <td>{k.label}</td>
                <td>%{Math.round(k.ltv * 100)}</td>
                <td>{k.months ? `${k.months} ay` : '—'}</td>
                <td>{k.ltv ? `₺${fmt(k.ltv * k.upTo)}` : 'Kredi kullandırılamaz'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        BDDK’nın 6 Mart 2025 tarihli ve 11158 sayılı Kurul Kararı
        (<a href={SRC.bddkYerli} rel="nofollow noopener" target="_blank">karar metni</a>). Yalnızca 5520 sayılı Kurumlar
        Vergisi Kanunu’nun geçici 12. maddesi kapsamındaki, yani proje bazlı teşvikle Türkiye’de geliştirdiği elektrikli
        taşıtı Türkiye’de üreten şirketlerin araçlarına uygulanır. İthal elektrikliler ve hibritler genel kurala tabidir.
      </p>
    </section>

    <section class="table-block">
      <h2>100 bin – 2 milyon TL taşıt kredisi taksiti</h2>
      <p class="table-intro">
        Aylık <strong class="grid-rate">%{pct(D.rate)}</strong> faiz, KKDF ve BSMV dahil aylık taksit (yukarıdaki faiz
        değişince tablolar da güncellenir). Vade sınırı aracın değerine bağlıdır; “BDDK: en fazla … ay” yazan hücrede
        o tutar, BDDK oranlarına uyan hiçbir araç değerinde o vadeyle kullanılamaz.
      </p>
      <h3>Genel kural</h3>
      <div class="table-scroll">
