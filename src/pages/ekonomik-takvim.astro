---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import data from '../../data/economic-calendar.json';
import fixed from '../../data/tr-fixed-events.json';

type CalEvent = {
  date: string; time?: string; region: string; impact: string; title: string; hook?: string; source?: string;
};

const allEvents: CalEvent[] = data.events as CalEvent[];
const fixedEvents: CalEvent[] = (fixed.events as CalEvent[]) ?? [];

// Merge: fixed events that aren't already in allEvents by date+title
const fixedTitles = new Set(allEvents.map(e => `${e.date}|${e.title}`));
const extraFixed = fixedEvents.filter(e => !fixedTitles.has(`${e.date}|${e.title}`));
const events = [...allEvents, ...extraFixed];

const updated = new Date(data.updated).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

const MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const DOW_TR = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'];
const pad = (n: number) => String(n).padStart(2, '0');

const today = new Date();
const todayKey = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;

// Region → display
const REGION_LABEL: Record<string, string> = {
  TR: 'TÜRKİYE', USD: 'ABD', EUR: 'EURO', GBP: 'İNGİLTERE', JPY: 'JAPONYA',
  CNY: 'ÇİN', CAD: 'KANADA', AUD: 'AVUSTRALYA', CHF: 'İSVİÇRE',
};
const REGION_FLAG: Record<string, string> = {
  TR: '🇹🇷', USD: '🇺🇸', EUR: '🇪🇺', GBP: '🇬🇧', JPY: '🇯🇵',
  CNY: '🇨🇳', CAD: '🇨🇦', AUD: '🇦🇺', CHF: '🇨🇭',
};

// Group events by date, sorted
type DayGroup = { key: string; dateLabel: string; dow: string; isToday: boolean; isPast: boolean; isWeekend: boolean; events: CalEvent[] };
const byDate = new Map<string, CalEvent[]>();
for (const e of events) {
  if (!byDate.has(e.date)) byDate.set(e.date, []);
  byDate.get(e.date)!.push(e);
}
const sortedDays: DayGroup[] = [...byDate.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([key, evs]) => {
    const dt = new Date(key + 'T00:00:00');
    const dow = (dt.getDay() + 6) % 7;
    return {
      key,
      dateLabel: `${dt.getDate()} ${MONTHS[dt.getMonth()]} ${dt.getFullYear()}`,
      dow: DOW_TR[dow],
      isToday: key === todayKey,
      isPast: key < todayKey,
      isWeekend: dow >= 5,
      events: evs.sort((a, b) => {
        // TR events first, then by impact (High first), then by time
        if (a.region === 'TR' && b.region !== 'TR') return -1;
        if (a.region !== 'TR' && b.region === 'TR') return 1;
        if (a.impact === 'High' && b.impact !== 'High') return -1;
        if (a.impact !== 'High' && b.impact === 'High') return 1;
        return (a.time ?? '').localeCompare(b.time ?? '');
      }),
    };
  });

// Upcoming events (next 14 days) for hero
const upcoming = sortedDays.filter(d => !d.isPast || d.isToday).slice(0, 10);
const past = sortedDays.filter(d => d.isPast && !d.isToday);

// Next TR event
const nextTR = sortedDays.find(d => !d.isPast && d.events.some(e => e.region === 'TR'));
const nextTREvent = nextTR?.events.find(e => e.region === 'TR');
---

<BaseLayout
  title="Ekonomik Takvim 2026 — Türkiye ve Dünya"
  description="FED, TCMB, TÜİK ve dünya merkez bankası kararları. Türkiye ekonomik takvimi: faiz kararları, enflasyon verileri, NFP ve PMI duyuruları. Her gün güncellenir."
>
  <section class="container ec-hero">
    <span class="eyebrow"><span class="pulse"></span> Canlı Takvim</span>
    <h1>Ekonomik Takvim</h1>
    <p class="lede soft">FED faiz kararları, TCMB toplantıları, TÜİK enflasyon verileri ve dünya merkez bankalarının duyuruları — tek sayfada.</p>
    {nextTREvent && (
      <div class="next-event-banner">
        <span class="neb-label">Sıradaki TR etkinliği</span>
        <span class="neb-title">{REGION_FLAG['TR']} {nextTREvent.title}</span>
        <span class="neb-date">{nextTR!.dateLabel}</span>
      </div>
    )}
    <p class="ha-upd">Son güncelleme: {updated} · Kaynak: ForexFactory + TCMB + TÜİK</p>
  </section>

  {/* Açıklama: Neden önemli */}
  <section class="container ec-explainer">
    <div class="ec-exp-grid">
      <div class="ec-exp-item">
        <span class="ec-exp-icon">📊</span>
        <div>
          <strong>Faiz kararları neden önemli?</strong>
          <p>FED ve TCMB faiz kararları, dolar/TL kuru, borsalar ve mevduat faizlerini doğrudan etkiler.</p>
        </div>
      </div>
      <div class="ec-exp-item">
        <span class="ec-exp-icon">📈</span>
        <div>
          <strong>NFP verisi nedir?</strong>
          <p>ABD'nin aylık istihdam raporu (Non-Farm Payrolls) — küresel piyasalar bu veriyi bekler.</p>
        </div>
      </div>
      <div class="ec-exp-item">
        <span class="ec-exp-icon">🇹🇷</span>
        <div>
          <strong>TÜİK enflasyon tarihleri</strong>
          <p>Her ayın ~3'ünde açıklanan TÜFE verisi: sepet kompozisyonu ve yıllık değişim.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Yaklaşan etkinlikler */}
  <section class="container ec-section">
    <div class="ha-shead">
      <h2>Yaklaşan Etkinlikler</h2>
      <span class="ha-shead-count">{upcoming.reduce((s, d) => s + d.events.length, 0)}</span>
    </div>

    <div class="cal-legend">
      <span><i class="impact-dot high"></i> Yüksek Etki</span>
      <span><i class="impact-dot medium"></i> Orta Etki</span>
      <span class="legend-sep">|</span>
      <span><i class="flag-dot">🇹🇷</i> Türkiye</span>
      <span><i class="flag-dot">🇺🇸</i> ABD (FED/NFP)</span>
    </div>

    <div class="cal-table">
      {upcoming.map((day) => (
        <div class:list={['cal-day', { today: day.isToday, weekend: day.isWeekend }]}>
          <div class="cal-day-header">
            <span class="cal-day-num">{day.dow} {day.events[0] ? new Date(day.key + 'T00:00:00').getDate() : ''}</span>
            <span class="cal-day-label">{day.dateLabel}</span>
            {day.isToday && <span class="cal-today-badge">bugün</span>}
          </div>
          <ul class="cal-ev-list">
            {day.events.map((ev) => (
              <li class:list={['cal-ev-row', { 'is-tr': ev.region === 'TR' }]}>
                <span class:list={['impact-pill', ev.impact === 'High' ? 'high' : 'medium']}>
                  {ev.impact === 'High' ? '▲' : '●'}
                </span>
                <span class="ev-flag">{REGION_FLAG[ev.region] ?? '🌍'}</span>
                <div class="ev-body">
                  <span class="ev-title">{ev.title}</span>
                  {ev.hook && <span class="ev-hook">{ev.hook}</span>}
                </div>
                {ev.time && <span class="ev-time">{ev.time}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {/* FED Açıklaması */}
  <section class="container ec-info-box">
    <h2>FED Faiz Kararı Nedir?</h2>
    <p>
      FED (Federal Reserve), ABD'nin merkez bankasıdır. Yılda 8 kez toplanan FOMC (Federal Open Market Committee),
      politika faizini belirler. Bu faiz kararı; Türkiye dahil tüm gelişmekte olan piyasaları, dolar kurunu
      ve borsa endekslerini doğrudan etkiler.
    </p>
    <p>
      <strong>Yatırımcılar için önemi:</strong> FED faiz artırırsa dolar güçlenir, altın ve gelişen piyasalar
      genellikle baskılanır. Faiz düşürürse tam tersi olabilir. Bu nedenle karardan önceki haftalar
      piyasalarda yüksek volatilite görülür.
    </p>
    <p>
      <strong>Türkiye'ye etkisi:</strong> FED kararları TL/USD kuru üzerinden mevduatı, ihracatçıları ve
      borçlu şirketleri etkiler. TCMB de kararlarında küresel para politikasını gözetir.
    </p>
    <p>
      → <a href="/tcmb-faiz-takvimi">TCMB Faiz Kararı Takvimi 2026 (PPK tarihleri + geri sayım)</a>
      &nbsp;·&nbsp;
      <a href="/fed-faiz-takvimi">Fed Faiz Kararı Takvimi 2026 (tüm tarihler + geri sayım)</a>
      &nbsp;·&nbsp;
      <a href="/blog/fed-faiz-karari-nedir-etkisi">FED Faiz Kararı Nedir? Türkiye'ye etkileri</a>
      &nbsp;·&nbsp;
      <a href="/blog/fomc-toplanti-tutanaklari-nedir">FOMC Toplantı Tutanakları Nedir?</a>
    </p>
  </section>

  {/* Geçmiş etkinlikler */}
  {past.length > 0 && (
    <section class="container ec-section">
      <details class="past-details">
        <summary>Geçmiş etkinlikler ({past.reduce((s, d) => s + d.events.length, 0)} etkinlik)</summary>
        <div class="cal-table past-table">
          {past.reverse().map((day) => (
            <div class="cal-day is-past">
              <div class="cal-day-header">
                <span class="cal-day-num">{day.dow}</span>
                <span class="cal-day-label">{day.dateLabel}</span>
              </div>
              <ul class="cal-ev-list">
                {day.events.map((ev) => (
                  <li class="cal-ev-row past-ev">
                    <span class:list={['impact-pill', ev.impact === 'High' ? 'high' : 'medium', 'muted']}>
                      {ev.impact === 'High' ? '▲' : '●'}
                    </span>
                    <span class="ev-flag">{REGION_FLAG[ev.region] ?? '🌍'}</span>
                    <div class="ev-body">
                      <span class="ev-title">{ev.title}</span>
                    </div>
                    {ev.time && <span class="ev-time">{ev.time}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
    </section>
  )}

  <section class="container ec-note">
    <p>
      Veriler ForexFactory, TCMB ve TÜİK kaynaklarından derlenerek her gün güncellenir.
      Yalnızca bilgilendirme amaçlıdır; yatırım tavsiyesi değildir.
      Kesin tarih ve saatler için ilgili kurumların resmi sitelerini kontrol edin.
    </p>
  </section>

  <div class="container"><Newsletter /></div>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .ec-hero { padding: clamp(1.6rem, 4vw, 2.6rem) 0 0; max-width: 720px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--step--2); font-weight: 600; color: var(--brand); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 0 rgba(22,160,133,0.5); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(22,160,133,0.5); } 70% { box-shadow: 0 0 0 6px rgba(22,160,133,0); } 100% { box-shadow: 0 0 0 0 rgba(22,160,133,0); } }
  .ec-hero h1 { font-size: var(--step-2); margin: 0.6rem 0 0.4rem; }
  .ec-hero .lede { font-size: var(--step-0); line-height: 1.5; margin: 0 0 0.8rem; }
  .ha-upd { font-size: var(--step--2); color: var(--text-muted); margin: 0.5rem 0 0; }

  /* ---------- Next event banner ---------- */
  .next-event-banner {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.8rem;
    background: var(--brand-tint); border: 1px solid var(--brand-light); border-radius: var(--radius);
    padding: 0.55rem 0.9rem; margin-bottom: 0.7rem;
  }
  .neb-label { font-size: var(--step--2); font-weight: 700; color: var(--brand-deep); text-transform: uppercase; letter-spacing: 0.05em; }
  .neb-title { font-size: var(--step--1); font-weight: 600; color: var(--text); }
  .neb-date { font-size: var(--step--2); color: var(--text-muted); background: var(--bg-card); border: 1px solid var(--border); border-radius: 999px; padding: 0.1rem 0.55rem; }

  /* ---------- Explainer grid ---------- */
  .ec-explainer { margin-top: clamp(1.2rem, 3vw, 2rem); }
  .ec-exp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.9rem; }
  .ec-exp-item {
    display: flex; gap: 0.7rem; align-items: flex-start;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 0.8rem 1rem;
  }
  .ec-exp-icon { font-size: 1.4rem; line-height: 1; flex-shrink: 0; }
  .ec-exp-item strong { font-size: var(--step--1); display: block; margin-bottom: 0.25rem; }
  .ec-exp-item p { font-size: var(--step--2); color: var(--text-muted); margin: 0; line-height: 1.5; }

  /* ---------- Section ---------- */
  .ec-section { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .ha-shead { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
  .ha-shead h2 { font-size: var(--step-1); margin: 0; }
  .ha-shead-count { font-size: 0.66rem; font-weight: 700; color: var(--brand-deep); background: var(--brand-tint); border-radius: 999px; padding: 0.1rem 0.55rem; }

  /* ---------- Legend ---------- */
  .cal-legend { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; margin-bottom: 0.9rem; font-size: var(--step--2); color: var(--text-muted); align-items: center; }
  .cal-legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .impact-dot { display: inline-block; width: 9px; height: 9px; border-radius: 3px; }
  .impact-dot.high { background: #e74c3c; }
  .impact-dot.medium { background: #d8982f; }
  .flag-dot { font-size: 0.85rem; line-height: 1; }
  .legend-sep { color: var(--border); }

  /* ---------- Cal table ---------- */
  .cal-table { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-card); box-shadow: var(--shadow-xs); max-width: 700px; }

  .cal-day { border-bottom: 1px solid var(--border-soft); }
  .cal-day:last-child { border-bottom: none; }
  .cal-day.today { background: var(--brand-tint); border-left: 3px solid var(--brand-deep); }
  .cal-day.weekend { background: var(--bg-elev); }
  .cal-day.is-past { opacity: 0.7; }

  .cal-day-header {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.9rem 0.3rem;
    border-bottom: 1px solid var(--border-soft);
    background: rgba(0,0,0,0.02);
  }
  .cal-day-num { font-size: var(--step--2); font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .cal-day-label { font-size: var(--step--1); font-weight: 600; color: var(--text); }
  .cal-today-badge { font-size: 0.56rem; font-weight: 700; color: #fff; background: var(--brand-deep); border-radius: 999px; padding: 0.05rem 0.4rem; text-transform: uppercase; letter-spacing: 0.05em; }

  /* ---------- Event rows ---------- */
  .cal-ev-list { list-style: none; margin: 0; padding: 0; }
  .cal-ev-row {
    display: grid;
    grid-template-columns: 20px 22px 1fr auto;
    align-items: start;
    gap: 0.4rem 0.5rem;
    padding: 0.45rem 0.9rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .cal-ev-row:last-child { border-bottom: none; }
  .cal-ev-row.is-tr { background: rgba(22,160,133,0.04); }

  .impact-pill { font-size: 0.65rem; font-weight: 800; line-height: 1; padding-top: 0.25rem; }
  .impact-pill.high { color: #e74c3c; }
  .impact-pill.medium { color: #d8982f; }
  .impact-pill.muted { opacity: 0.5; }

  .ev-flag { font-size: 1rem; line-height: 1.4; }
  .ev-body { display: flex; flex-direction: column; gap: 0.1rem; }
  .ev-title { font-size: var(--step--1); font-weight: 600; color: var(--text); line-height: 1.3; }
  .ev-hook { font-size: var(--step--2); color: var(--text-muted); line-height: 1.4; font-style: italic; }
  .ev-time { font-size: 0.65rem; font-weight: 700; color: var(--text-muted); background: var(--bg-elev); border: 1px solid var(--border-soft); border-radius: 4px; padding: 0.1rem 0.35rem; white-space: nowrap; align-self: start; margin-top: 0.15rem; font-variant-numeric: tabular-nums; }

  .past-ev .ev-title { color: var(--text-muted); }

  /* ---------- Info box ---------- */
  .ec-info-box {
    margin-top: clamp(1.6rem, 4vw, 2.6rem);
    max-width: 700px;
    padding: 1.2rem 1.4rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-xs);
  }
  .ec-info-box h2 { font-size: var(--step-1); margin: 0 0 0.7rem; }
  .ec-info-box p { font-size: var(--step--1); color: var(--text-soft); line-height: 1.65; margin: 0 0 0.7rem; }
  .ec-info-box p:last-child { margin-bottom: 0; }
  .ec-info-box strong { color: var(--text); }

  /* ---------- Past details ---------- */
  .past-details { max-width: 700px; }
  .past-details summary {
    cursor: pointer; font-size: var(--step--1); color: var(--text-muted); font-weight: 600;
    padding: 0.5rem 0; user-select: none;
  }
  .past-details summary:hover { color: var(--text); }
  .past-table { margin-top: 0.8rem; }

  /* ---------- Note ---------- */
  .ec-note { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .ec-note p { font-size: var(--step--2); line-height: 1.6; max-width: 640px; color: var(--text-muted); padding: 0.8rem 1rem; background: var(--bg-elev); border: 1px solid var(--border-soft); border-radius: var(--radius); }

  @media (max-width: 560px) {
    .cal-ev-row { grid-template-columns: 20px 20px 1fr; }
    .ev-time { grid-column: 3; justify-self: end; }
    .ec-exp-grid { grid-template-columns: 1fr; }
  }
</style>
