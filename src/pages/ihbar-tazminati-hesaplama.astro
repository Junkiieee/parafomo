---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';

// İhbar süreleri: 4857 sayılı İş Kanunu md.17 (2/4/6/8 hafta; sözleşmeyle artırılabilir, azaltılamaz).
// İhbar tazminatı = bildirim süresine ait ücret; giydirilmiş brüt ücret esas alınır. SGK primi kesilmez;
// ücret gibi gelir vergisi (kümülatif matraha göre) + binde 7,59 damga vergisi kesilir.
const DAMGA = 0.00759;
const SURELER = [
  { ad: '6 aydan az', hafta: 2 },
  { ad: '6 ay – 1,5 yıl', hafta: 4 },
  { ad: '1,5 – 3 yıl', hafta: 6 },
  { ad: '3 yıldan fazla', hafta: 8 },
];

const fmt = (n: number) =>
  new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const fmt0 = (n: number) =>
  new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));

const hesap = (aylik: number, hafta: number, gvOran: number) => {
  const brut = (aylik / 30) * hafta * 7;
  const gv = brut * gvOran;
  const dv = brut * DAMGA;
  return { brut, gv, dv, net: brut - gv - dv };
};

const DEFAULT_W = 50000;
const d0 = hesap(DEFAULT_W, 8, 0.15);
const UCRETLER = [33030, 50000, 75000, 100000, 150000];

const faq = [
  {
    q: 'İhbar tazminatı nasıl hesaplanır?',
    a: `İhbar tazminatı = günlük giydirilmiş brüt ücret × ihbar süresi (gün). Günlük ücret aylık brütün 30’a bölünmesiyle bulunur; ihbar süresi kıdeme göre 2, 4, 6 veya 8 haftadır (14, 28, 42, 56 gün). Örnek: ${fmt0(DEFAULT_W)} ₺ brüt ücretli, 3 yıldan uzun çalışmış işçi için ${fmt0(DEFAULT_W)} / 30 × 56 = ${fmt(d0.brut)} ₺ brüt ihbar tazminatı.`,
  },
  {
    q: 'İhbar süreleri ne kadar? (2026)',
    a: 'İş Kanunu md.17’ye göre: işi 6 aydan az sürmüş işçi için 2 hafta, 6 ay – 1,5 yıl için 4 hafta, 1,5 – 3 yıl için 6 hafta, 3 yıldan fazla için 8 hafta. Bu süreler asgaridir; iş sözleşmesiyle artırılabilir.',
  },
  {
    q: 'İhbar tazminatından hangi kesintiler yapılır?',
    a: 'İhbar tazminatından SGK primi kesilmez. Ücret gibi gelir vergisi (yıl içindeki kümülatif matrahınıza göre %15-40) ve binde 7,59 damga vergisi kesilir. Bu yüzden ihbar tazminatının neti, yalnız damga vergisi kesilen kıdem tazminatına göre daha düşüktür.',
  },
  {
    q: 'İstifa eden işçi ihbar tazminatı alır mı?',
    a: 'Hayır. İhbar tazminatını sözleşmeyi bildirim süresine uymadan fesheden taraf öder. İşveren önelsiz çıkarırsa işçiye öder; istifa eden işçi bildirim süresine uymazsa işverene ihbar tazminatı ödemek zorunda kalabilir. Haklı nedenle (md.24/25) derhal fesihte ihbar tazminatı doğmaz.',
  },
  {
    q: 'İhbar süresinde iş arama izni var mı?',
    a: 'Evet. İş Kanunu md.27’ye göre bildirim süresi içinde işveren işçiye günde en az 2 saat ücretli iş arama izni vermek zorundadır; işçi isterse bu izinleri toplu kullanabilir. İzin verilmezse ya da izin süresinde çalıştırılırsa bu sürelerin ücreti ayrıca ödenir.',
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Hesaplama Araçları', url: '/hesaplama-araclari/' },
  { name: 'İhbar Tazminatı Hesaplama', url: '/ihbar-tazminati-hesaplama/' },
];
---

<BaseLayout
  image="/og/ihbar-tazminati-hesaplama.png"
  title="İhbar Tazminatı Hesaplama 2026: Süreler, Brüt ve Net Tutar"
  description="İhbar tazminatı hesaplama 2026: kıdeme göre 2, 4, 6 veya 8 hafta (İş Kanunu md.17). Brüt maaşını gir; brüt tazminatı, gelir ve damga vergisini, neti gör."
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Hesaplayıcı · Çalışan hakları</p>
      <h1>İhbar Tazminatı Hesaplama (2026)</h1>
      <p class="lede">
        İhbar tazminatı, çalışma sürenize göre <strong>2, 4, 6 veya 8 haftalık brüt ücret</strong>
        tutarındadır. Brüt maaşınızı ve kıdeminizi girin; <strong>brüt tazminatı, kesintileri ve
        net</strong> tutarı görün.
      </p>
    </header>

    <div class="calc-grid">
      <form class="calc-inputs" id="calc-form" autocomplete="off">
        <label>
          <span>Aylık giydirilmiş brüt ücret (₺)</span>
          <input type="number" id="in-w" value={DEFAULT_W} min="0" step="1000" inputmode="numeric" />
        </label>
        <label>
          <span>Çalışma süresi</span>
          <select id="in-s">
            {SURELER.map((s, i) => (
              <option value={s.hafta} selected={i === 3}>{s.ad} → {s.hafta} hafta</option>
            ))}
          </select>
        </label>
        <label>
          <span>Gelir vergisi dilimi (yıl içi kümülatif matrahınıza göre)</span>
          <select id="in-gv">
            <option value="0.15" selected>%15</option>
            <option value="0.20">%20</option>
            <option value="0.27">%27</option>
            <option value="0.35">%35</option>
            <option value="0.40">%40</option>
          </select>
        </label>
        <p class="input-hint">
          Giydirilmiş ücret: çıplak brüt + düzenli ödenen yol, yemek, prim, ikramiye gibi para ve parayla
          ölçülebilen haklar. Dilim için <a href="/vergi-dilimi-hesaplama/">vergi dilimi hesaplama</a>.
        </p>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label">Net ihbar tazminatı</span>
          <span class="result-value" id="out-net">₺{fmt(d0.net)}</span>
        </div>
        <div class="result-split">
          <div class="split-item">
            <span class="split-label">Brüt ihbar tazminatı</span>
            <span class="split-val" id="out-brut">₺{fmt(d0.brut)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Gelir vergisi</span>
            <span class="split-val" id="out-gv">₺{fmt(d0.gv)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Damga vergisi (binde 7,59)</span>
            <span class="split-val" id="out-dv">₺{fmt(d0.dv)}</span>
          </div>
        </div>
        <p class="result-note" id="out-note">56 gün × günlük brüt ₺{fmt(DEFAULT_W / 30)}</p>
      </div>
    </div>

    <p class="disclaimer">
      Bu araç yalnızca bilgilendirme amaçlıdır; hukuki tavsiye değildir. Yasal asgari ihbar süreleri
      (4857 sayılı İş Kanunu md.17) esas alınmıştır; sözleşmenizde daha uzun süre varsa o geçerlidir.
      Gelir vergisi seçtiğiniz dilimin tek oranıyla yaklaşık hesaplanır; tazminat iki dilime yayılabilir.
      · Kaynak: 4857 sayılı İş Kanunu (mevzuat.gov.tr).
    </p>

    <section class="table-block">
      <h2>İhbar süreleri tablosu (İş Kanunu md.17)</h2>
      <table class="rate-table">
        <thead><tr><th>Çalışma süresi</th><th>İhbar süresi</th><th>Gün</th></tr></thead>
        <tbody>
          {SURELER.map((s) => (
            <tr><td>{s.ad}</td><td>{s.hafta} hafta</td><td>{s.hafta * 7} gün</td></tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">
        Kaynak: <a href="https://www.mevzuat.gov.tr/mevzuatmetin/1.5.4857.pdf" rel="noopener">4857 sayılı
        İş Kanunu md.17</a>. Süreler asgaridir, sözleşmeyle artırılabilir.
      </p>
    </section>

    <section class="table-block">
      <h2>Brüt maaşa göre ihbar tazminatı (brüt, 2026)</h2>
      <table class="rate-table">
        <thead><tr><th>Brüt ücret</th>{SURELER.map((s) => <th>{s.hafta} hafta</th>)}</tr></thead>
        <tbody>
          {UCRETLER.map((w) => (
            <tr>
              <td>₺{fmt0(w)}</td>
              {SURELER.map((s) => <td>₺{fmt0(hesap(w, s.hafta, 0).brut)}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">
        33.030 ₺ = 2026 brüt asgari ücret. Neti bulmak için gelir vergisi (dilime göre) ve binde 7,59
        damga vergisi düşülür; SGK primi kesilmez.
      </p>
    </section>

    <section class="prose-block">
      <h2>İhbar tazminatı ile kıdem tazminatı farkı</h2>
      <p>
        Kıdem tazminatı çalışılan her yıl için bir aylık ücrettir, tavanla sınırlıdır ve yalnız damga
        vergisi kesilir. İhbar tazminatı ise bildirim süresine uyulmadan yapılan fesihte doğar, tavanı
        yoktur ve gelir vergisi de kesilir. İşveren tarafından önelsiz çıkarılan ve en az 1 yıl çalışan
        işçi çoğu durumda ikisini birlikte alır.
      </p>
      <p class="cta-line">
        İlgili araçlar: <a href="/kidem-tazminati-hesaplama/">kıdem tazminatı hesaplama</a> (Ocak 2027
        tavan tahmini), işten çıkış sonrası <a href="/issizlik-maasi-hesaplama/">işsizlik maaşı
        hesaplama</a>, <a href="/net-maas-hesaplama/">net maaş hesaplama</a>.
      </p>
    </section>

    <section class="faq-block">
      <h2>Sıkça Sorulan Sorular</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p set:html={f.a} />
        </details>
      ))}
    </section>

    <Newsletter />
  </div>

  <script is:inline define:vars={{ DAMGA }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      function update() {
        const w = Math.max(0, +$('in-w').value || 0);
        const h = +$('in-s').value;
        const r = +$('in-gv').value;
        const brut = (w / 30) * h * 7;
        const gv = brut * r;
        const dv = brut * DAMGA;
        $('out-net').textContent = '₺' + nf.format(brut - gv - dv);
        $('out-brut').textContent = '₺' + nf.format(brut);
        $('out-gv').textContent = '₺' + nf.format(gv);
        $('out-dv').textContent = '₺' + nf.format(dv);
        $('out-note').textContent = h * 7 + ' gün × günlük brüt ₺' + nf.format(w / 30);
      }
      $('in-w').addEventListener('input', update);
      ['in-s', 'in-gv'].forEach((id) => $(id).addEventListener('change', update));
      update();
    })();
  </script>

  <style>
    .calc-wrap { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.1rem 4rem; }
    .calc-head { text-align: center; margin-bottom: 1.6rem; }
    .eyebrow {
      text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem;
      font-weight: 700; color: var(--brand-deep); margin: 0 0 0.4rem;
    }
    .calc-head h1 { font-size: var(--step-4); margin: 0 0 0.6rem; line-height: 1.1; }
    .lede { color: var(--text-soft); font-size: var(--step-1); max-width: 640px; margin: 0 auto; }

    .calc-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 1.4rem; box-shadow: var(--shadow-soft);
    }
    .calc-inputs { display: flex; flex-direction: column; gap: 0.7rem; margin: 0; }
    .calc-inputs label { display: flex; flex-direction: column; gap: 0.35rem; }
    .calc-inputs span { font-size: 0.85rem; font-weight: 600; color: var(--text-soft); }
    .calc-inputs input, .calc-inputs select {
      font-family: var(--font-sans); font-size: 1.15rem; font-weight: 600; color: var(--text);
      padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm);
      background: var(--bg); width: 100%;
    }
    .calc-inputs input:focus, .calc-inputs select:focus {
      outline: none; border-color: var(--brand-2); box-shadow: 0 0 0 3px var(--brand-soft);
    }
    .input-hint { font-size: 0.78rem; color: var(--text-muted); margin: 0; line-height: 1.5; }

    .calc-results {
      display: flex; flex-direction: column; justify-content: center; gap: 0.9rem;
      background: var(--brand-tint); border-radius: var(--radius); padding: 1.2rem;
    }
    .result-main { display: flex; flex-direction: column; gap: 0.2rem; }
    .result-label { font-size: 0.85rem; color: var(--text-soft); font-weight: 600; }
    .result-value { font-family: var(--font-serif); font-size: clamp(1.9rem, 1.4rem + 2vw, 2.7rem); font-weight: 600; color: var(--brand-ink); line-height: 1.05; }
    .result-split { display: flex; flex-direction: column; gap: 0.55rem; }
    .split-item { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.5rem; }
    .split-label { font-size: 0.85rem; color: var(--text-soft); }
    .split-val { font-weight: 700; font-size: 0.95rem; }
    .result-note { font-size: 0.8rem; color: var(--brand-ink); margin: 0; font-weight: 500; }

    .disclaimer { font-size: 0.8rem; color: var(--text-muted); margin: 1.2rem 0 2.5rem; line-height: 1.5; }

    .table-block { margin-top: 2.5rem; overflow-x: auto; }
    .table-block h2 { font-size: var(--step-2); margin: 0 0 0.6rem; }
    .rate-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .rate-table th, .rate-table td { text-align: left; padding: 0.55rem 0.5rem; border-bottom: 1px solid var(--border); }
    .rate-table th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
    .table-note { font-size: 0.82rem; color: var(--text-muted); margin: 0.7rem 0 0; }

    .prose-block, .faq-block { margin-top: 2.5rem; }
    .prose-block h2, .faq-block h2 { font-size: var(--step-2); margin: 0 0 0.8rem; }
    .prose-block p { color: var(--text-soft); line-height: 1.7; }
    .cta-line { background: var(--surface); padding: 0.9rem 1.1rem; border-radius: var(--radius-sm); border-left: 3px solid var(--brand-2); }

    .faq-block details { border-bottom: 1px solid var(--border); padding: 0.9rem 0; }
    .faq-block summary { font-weight: 600; cursor: pointer; color: var(--text); list-style: none; }
    .faq-block summary::-webkit-details-marker { display: none; }
    .faq-block summary::after { content: '+'; float: right; color: var(--brand-2); font-weight: 700; }
    .faq-block details[open] summary::after { content: '−'; }
    .faq-block details p { color: var(--text-soft); line-height: 1.7; margin: 0.7rem 0 0; }

    @media (max-width: 600px) {
      .calc-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
