---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const channels = [
  { n: 'YouTube', h: SITE.social.youtube, d: 'Kısa veri videoları (Shorts)' },
  { n: 'Instagram', h: SITE.social.instagram, d: 'Reels ve günlük altın/BIST kartları' },
  { n: 'Telegram', h: SITE.social.telegram, d: 'Yeni yazılar ve günlük veri kartları' },
  { n: 'X (Twitter)', h: SITE.social.x, d: '@parafomo' },
].filter((c) => c.h);
---

<BaseLayout
  title="İletişim"
  description="ParaFOMO ile iletişim: hata bildirimi, düzeltme talebi, öneri ve iş birliği için e-posta ve sosyal medya hesapları."
  breadcrumbs={[{ name: 'Ana sayfa', url: '/' }, { name: 'İletişim', url: '/iletisim/' }]}
>
  <article class="container doc prose">
    <span class="eyebrow">İletişim</span>
    <h1>Bize ulaş</h1>
    <p class="lede soft">Hata mı gördün, bir verinin kaynağını mı merak ediyorsun, ya da eklememizi istediğin bir hesaplayıcı mı var?</p>

    <div class="mail card">
      <span class="muted">E-posta</span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <p class="soft">Düzeltme taleplerinde ilgili sayfanın linkini ve doğru bilginin kaynağını eklersen daha hızlı ilerleriz.</p>
    </div>

    <h2>Sosyal medya</h2>
    <ul class="ch">
      {channels.map((c) => (
        <li><a href={c.h} rel="me noopener" target="_blank">{c.n}</a> <span class="muted">— {c.d}</span></li>
      ))}
    </ul>

    <h2>Bilmen gerekenler</h2>
    <ul>
      <li>Kişisel yatırım tavsiyesi veremiyoruz; "şu hisseyi alayım mı" sorularına yanıt veremeyiz.</li>
      <li>Portföy takip hesabınla ilgili veri silme talebi için: <a href="/veri-silme/">veri silme</a>.</li>
      <li>Kurallarımız: <a href="/editoryal-politika/">editoryal politika</a> · veri kaynakları: <a href="/metodoloji/">metodoloji</a> · <a href="/gizlilik/">gizlilik</a>.</li>
    </ul>
  </article>
</BaseLayout>

<style>
  .doc { padding-top: 3rem; max-width: var(--maxw-prose); }
  .doc h1 { font-size: var(--step-3); margin: 0.6rem 0 0.8rem; }
  .doc .lede { font-size: var(--step-1); line-height: 1.5; }
  .doc h2 { font-size: var(--step-1); margin-top: 2.2rem; }
  .mail { padding: 1.4rem 1.6rem; margin: 1.8rem 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .mail a { font-size: var(--step-1); font-weight: 700; color: var(--brand-deep); }
  .mail p { margin: 0.3rem 0 0; font-size: var(--step--1); }
  .ch { padding-left: 1.1rem; }
</style>
