---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import altin from '../../data/altin-fiyat.json';

// Fiyat verisi — data/altin-fiyat.json (scripts/altin-fiyat.py, günlük rebuild'de tazelenir).
const items = altin.kalemler as {
  key: string; label: string; gram: number; ayar: string; alis: number | null; satis: number | null;
}[];

// Güncellenme etiketi (ISO → tr-TR)
const upd = new Date(altin.guncellenme);
const updLabel = upd.toLocaleDateString('tr-TR', {
  day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit',
});

// Hesaplayıcı için kullanılacak takı/altın türleri (ons/gram-has hariç ana takılar önde)
const CALC_KEYS = ['gram-altin', 'ceyrek-altin', 'yarim-altin', 'tam-altin', 'ata-altin', 'cumhuriyet-altini'];
const calcItems = CALC_KEYS.map((k) => items.find((i) => i.key === k)).filter(Boolean) as typeof items;

// Sunucuda varsayılan hesap (JS kapalıyken de dolu görünsün): 1 çeyrek
const def = calcItems.find((i) => i.key === 'ceyrek-altin') || calcItems[0];
const defAdet = 1;

const fmt = (n: number) =>
  new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));

// Gram karşılığı referans tablosu (statik gerçek — "çeyrek altın kaç gram" niyeti)
const gramTable = [
  { ad: 'Gram altın', gram: '1 gram', ayar: '24 ayar (995)' },
  { ad: 'Çeyrek altın', gram: '1,75 gram', ayar: '22 ayar' },
  { ad: 'Yarım altın', gram: '3,5 gram', ayar: '22 ayar' },
  { ad: 'Tam (ziynet) altın', gram: '7 gram', ayar: '22 ayar' },
  { ad: 'Ata / Cumhuriyet altını', gram: '≈7,2 gram', ayar: '22 ayar' },
  { ad: 'Ons altın', gram: '31,1035 gram', ayar: '24 ayar' },
];

const faq = [
  {
    q: 'Çeyrek altın kaç gram, kaç TL eder?',
    a: `Çeyrek altın 1,75 gram ağırlığında ve 22 ayardır. ${updLabel} itibarıyla bir çeyrek altının bozdurma (alış) değeri yaklaşık ${fmt(items.find((i) => i.key === 'ceyrek-altin')?.alis || 0)} ₺, almak için (satış) yaklaşık ${fmt(items.find((i) => i.key === 'ceyrek-altin')?.satis || 0)} ₺'dir. Fiyatlar gün içinde değişir; yukarıdaki hesaplayıcı en güncel değerle çalışır.`,
  },
  {
    q: 'Gram altın ile çeyrek altının farkı nedir?',
    a: 'Gram altın genellikle 24 ayar (saf, 995-999 milyem) ve tam olarak 1 gramdır. Çeyrek, yarım, tam ve ata altınlar ise 22 ayardır (916 milyem) ve içlerinde başka metal karışımı bulunur. Bu yüzden 1,75 gram çeyrek altın, 1,75 gram gram-altından biraz daha ucuzdur; ayrıca ziynet altınlarında darphane/işçilik payı fiyata yansır.',
  },
  {
    q: 'Altınımı bozdurunca elime ne kadar geçer?',
    a: 'Bozdururken kuyumcunun "alış" fiyatı geçerlidir; altın alırken ödediğiniz "satış" fiyatının biraz altındadır. Aradaki farka makas denir. Bu araçta her tür için hem alış (bozdurma) hem satış (alım) değerini görebilirsiniz — "ne kadar eder" sorusunda alış fiyatını esas alın.',
  },
  {
    q: 'Gram altın fiyatı neye göre belirlenir?',
    a: 'Gram altın fiyatı, uluslararası ons altın fiyatı (USD) ile dolar/TL kurunun çarpımından türetilir: kabaca gram fiyatı = (ons fiyatı ÷ 31,1035) × USD/TL. Bu yüzden hem küresel altın hareketi hem de kurdaki değişim TL cinsinden gram altını etkiler.',
  },
  {
    q: 'Altın yatırımı için gram mı, ziynet (çeyrek/tam) mı daha mantıklı?',
    a: 'Yatırım amacıyla genelde gram/has altın tercih edilir çünkü ziynet altınlarındaki işçilik payı (makas) alım-satımda küçük bir kayıp yaratır. Fiziksel altın yerine saklama ve makas derdi olmadan altına yatırım yapmak isteyenler için altın fonu bir alternatiftir.',
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Altın Hesaplama', url: '/altin-hesaplama' },
];
---

<BaseLayout
  title={`Altın Hesaplama ${new Date().getFullYear()} | Gram, Çeyrek, Tam Altın Güncel Fiyat ve Değer`}
  description={`Güncel altın fiyatları ve hesaplayıcı: gram, çeyrek, yarım, tam ve ata altının kaç TL ettiğini anında hesaplayın. Çeyrek altın kaç gram, bozdurunca ne kadar eder? ${updLabel} verisiyle.`}
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Hesaplayıcı · Güncel Altın</p>
      <h1>Altın Hesaplama</h1>
      <p class="lede">
        Elindeki <strong>gram, çeyrek, yarım, tam veya ata altının</strong> bugün kaç TL ettiğini
        anında hesapla. Fiyatlar <strong>{updLabel}</strong> itibarıyla; her gün güncellenir.
      </p>
    </header>

    <div class="calc-grid">
      <form class="calc-inputs" id="calc-form" autocomplete="off">
        <label>
          <span>Altın türü</span>
          <select id="in-type">
            {calcItems.map((i) => (
              <option value={i.key} selected={i.key === def.key}>{i.label}</option>
            ))}
          </select>
        </label>
        <label>
          <span>Adet</span>
          <input type="number" id="in-adet" value={defAdet} min="0" step="1" inputmode="numeric" />
        </label>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label">Bozdurma değeri (alış) <em class="hint">— elinize geçen</em></span>
          <span class="result-value" id="out-alis">₺{fmt((def.alis || 0) * defAdet)}</span>
        </div>
        <div class="result-split">
          <div class="split-item">
            <span class="split-label">Almak için (satış)</span>
            <span class="split-val" id="out-satis">₺{fmt((def.satis || 0) * defAdet)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Toplam ağırlık</span>
            <span class="split-val" id="out-gram">{def.gram.toString().replace('.', ',')} gr</span>
          </div>
        </div>
        <p class="result-note" id="out-note">Fiyatlar göstergedir; kuyumcuya göre küçük farklar olabilir.</p>
      </div>
    </div>

    <div class="updated-strip">
      <span class="dot"></span>
      <span>Fiyatlar son güncelleme: <strong>{updLabel}</strong> · Kaynak: piyasa verisi (gösterge). Sadece güncel fiyatları görmek için → <a href="/altin-fiyatlari">altın fiyatları bugün</a>.</span>
    </div>

    <section class="table-block">
      <h2>Güncel altın fiyatları</h2>
      <table class="rate-table">
        <thead><tr><th>Altın türü</th><th>Alış (₺)</th><th>Satış (₺)</th><th class="hide-sm">Ayar</th></tr></thead>
        <tbody>
          {items.filter((i) => i.key !== 'ons').map((i) => (
            <tr>
              <td>{i.label}</td>
              <td>{i.alis ? fmt(i.alis) : '—'}</td>
              <td>{i.satis ? fmt(i.satis) : '—'}</td>
              <td class="hide-sm">{i.ayar}</td>
            </tr>
          ))}
          {items.filter((i) => i.key === 'ons').map((i) => (
            <tr>
              <td>{i.label}</td>
              <td>${i.alis ? fmt(i.alis) : '—'}</td>
              <td>${i.satis ? fmt(i.satis) : '—'}</td>
              <td class="hide-sm">{i.ayar}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">Alış = kuyumcunun sizden aldığı (bozdurma) fiyat; Satış = size sattığı fiyat. Aradaki farka <strong>makas</strong> denir.</p>
    </section>

    <section class="table-block">
      <h2>Çeyrek altın kaç gram? (ağırlık karşılıkları)</h2>
      <table class="rate-table">
        <thead><tr><th>Altın</th><th>Ağırlık</th><th class="hide-sm">Ayar</th></tr></thead>
        <tbody>
          {gramTable.map((r) => (
            <tr><td>{r.ad}</td><td>{r.gram}</td><td class="hide-sm">{r.ayar}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">Ziynet altınları (çeyrek/yarım/tam/ata) 22 ayardır; gram ve has altın 24 ayardır.</p>
    </section>

    <section class="prose-block">
      <h2>Altın değeri nasıl hesaplanır?</h2>
      <p>
        Bir altının TL değeri, <strong>ağırlığı × ayar saflığı × gram altın fiyatı</strong> ile
        bulunur. Örneğin çeyrek altın 1,75 gram ve 22 ayardır (916 milyem); değeri yaklaşık
        1,75 × 0,916 × gram-has-altın fiyatına denk gelir. Piyasada çeyrek/tam gibi ziynet altınlarına
        ayrıca küçük bir <strong>darphane/işçilik payı</strong> eklenir, bu yüzden yukarıdaki tabloda
        gerçek piyasa alış-satış fiyatlarını kullanıyoruz.
      </p>
      <h2>Bozdurunca ne kadar eder?</h2>
      <p>
        Altınınızı bozdururken kuyumcunun <strong>alış</strong> fiyatı geçerlidir; bu, altın alırken
        ödediğiniz <strong>satış</strong> fiyatının biraz altındadır. Aradaki farka <strong>makas</strong>
        denir ve alım-satımda küçük bir maliyettir. "Elime ne geçer?" sorusunda hesaplayıcıdaki
        <em>bozdurma (alış)</em> değerini esas alın.
      </p>
      <h2>Gram altın fiyatı neye bağlı?</h2>
      <p>
        TL cinsinden gram altın fiyatı iki şeyden türer: <strong>uluslararası ons altın fiyatı (USD)</strong>
        ve <strong>dolar/TL kuru.</strong> Kabaca: gram fiyatı = (ons ÷ 31,1035) × USD/TL. Bu yüzden altın
        hem küresel bir hareket yaptığında hem de kur değiştiğinde TL bazında fiyatı oynar.
      </p>
      <p class="cta-line">
        Daha derine inmek için →
        <a href="/blog/altin-cesitleri-gram-ceyrek-ons-ziynet">Altın çeşitleri: gram, çeyrek, ons, ziynet</a>,
        <a href="/blog/altin-fonu-nedir-gram-altindan-farki">altın fonu nedir (gram altından farkı)</a> ve
        <a href="/blog/altin-mi-dolar-mi">altın mı dolar mı?</a> yazılarımıza göz atın.
      </p>
    </section>

    <section class="faq-block">
      <h2>Sıkça Sorulan Sorular</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <Newsletter />
  </div>

  <script is:inline define:vars={{ items }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
      const byKey = {};
      items.forEach((i) => (byKey[i.key] = i));

      function update() {
        const it = byKey[$('in-type').value];
        if (!it) return;
        const adet = Math.max(0, +$('in-adet').value || 0);
        const alis = (it.alis || 0) * adet;
        const satis = (it.satis || 0) * adet;
        $('out-alis').textContent = '₺' + nf.format(Math.round(alis));
        $('out-satis').textContent = '₺' + nf.format(Math.round(satis));
        const gram = (it.gram * adet).toLocaleString('tr-TR', { maximumFractionDigits: 2 });
        $('out-gram').textContent = gram + ' gr';
        $('out-note').textContent = adet > 1
          ? `${adet} adet ${it.label.toLowerCase()} bozdurulunca yaklaşık ₺${nf.format(Math.round(alis))} eder.`
          : 'Fiyatlar göstergedir; kuyumcuya göre küçük farklar olabilir.';
      }

      $('in-type').addEventListener('change', update);
      $('in-adet').addEventListener('input', update);
      update();
    })();
  </script>

  <style>
    .calc-wrap { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.1rem 4rem; }
    .calc-head { text-align: center; margin-bottom: 2rem; }
    .eyebrow {
      text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem;
      font-weight: 700; color: var(--brand-deep); margin: 0 0 0.4rem;
    }
    .calc-head h1 { font-size: var(--step-4); margin: 0 0 0.6rem; line-height: 1.1; }
    .lede { color: var(--text-soft); font-size: var(--step-1); max-width: 620px; margin: 0 auto; }

    .calc-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 1.4rem; box-shadow: var(--shadow-soft);
    }
    .calc-inputs { display: flex; flex-direction: column; gap: 0.9rem; margin: 0; }
    .calc-inputs label { display: flex; flex-direction: column; gap: 0.35rem; }
    .calc-inputs span { font-size: 0.85rem; font-weight: 600; color: var(--text-soft); }
    .calc-inputs input, .calc-inputs select {
      font-family: var(--font-sans); font-size: 1.15rem; font-weight: 600; color: var(--text);
      padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm);
      background: var(--bg); width: 100%;
    }
    .calc-inputs input:focus, .calc-inputs select:focus { outline: none; border-color: var(--brand-2); box-shadow: 0 0 0 3px var(--brand-soft); }

    .calc-results {
      display: flex; flex-direction: column; justify-content: center; gap: 1rem;
      background: var(--brand-tint); border-radius: var(--radius); padding: 1.2rem;
    }
    .result-main { display: flex; flex-direction: column; gap: 0.2rem; }
    .result-label { font-size: 0.85rem; color: var(--text-soft); font-weight: 600; }
    .result-label .hint { font-weight: 500; font-style: normal; color: var(--text-muted); font-size: 0.78rem; }
    .result-value { font-family: var(--font-serif); font-size: clamp(1.9rem, 1.4rem + 2vw, 2.7rem); font-weight: 600; color: var(--brand-ink); line-height: 1.05; }
    .result-split { display: flex; flex-direction: column; gap: 0.55rem; }
    .split-item { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.5rem; }
    .split-label { font-size: 0.85rem; color: var(--text-soft); }
    .split-val { font-weight: 700; font-size: 0.98rem; }
    .result-note { font-size: 0.82rem; color: var(--brand-ink); margin: 0; font-weight: 500; }

    .updated-strip {
      display: flex; align-items: center; gap: 0.55rem; margin: 1rem 0 0;
      background: var(--surface); border-left: 3px solid var(--brand-2);
      border-radius: var(--radius-sm); padding: 0.65rem 0.9rem; font-size: 0.82rem; color: var(--text-soft);
    }
    .updated-strip .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--brand-2); flex: none; }

    .table-block { margin-top: 2.5rem; }
    .table-block h2 { font-size: var(--step-2); margin: 0 0 0.8rem; }
    .rate-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
    .rate-table th, .rate-table td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid var(--border); }
    .rate-table th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
    .table-note { font-size: 0.82rem; color: var(--text-muted); margin: 0.7rem 0 0; }

    .prose-block, .faq-block { margin-top: 2.5rem; }
    .prose-block h2, .faq-block h2 { font-size: var(--step-2); margin: 0 0 0.8rem; }
    .prose-block p, .prose-block li { color: var(--text-soft); line-height: 1.7; }
    .prose-block h2:not(:first-child) { margin-top: 1.8rem; }
    .cta-line { background: var(--surface); padding: 0.9rem 1.1rem; border-radius: var(--radius-sm); border-left: 3px solid var(--brand-2); }

    .faq-block details { border-bottom: 1px solid var(--border); padding: 0.9rem 0; }
    .faq-block summary { font-weight: 600; cursor: pointer; color: var(--text); list-style: none; }
    .faq-block summary::-webkit-details-marker { display: none; }
    .faq-block summary::after { content: '+'; float: right; color: var(--brand-2); font-weight: 700; }
    .faq-block details[open] summary::after { content: '−'; }
    .faq-block details p { color: var(--text-soft); line-height: 1.7; margin: 0.7rem 0 0; }

    @media (max-width: 600px) {
      .calc-grid { grid-template-columns: 1fr; }
      .hide-sm { display: none; }
    }
  </style>
</BaseLayout>
