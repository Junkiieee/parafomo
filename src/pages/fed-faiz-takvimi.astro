---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import fomc from '../../data/fomc-2026.json';

type Result = { decision: 'hold' | 'cut' | 'hike'; bp: number; lower: number; upper: number; vote?: string; source: string };
type Meeting = { range: string; decisionDate: string; tsiTime: string; dotPlot: boolean; result?: Result };
const meetings = fomc.meetings as Meeting[];
const meetings2027 = (fomc.meetings2027 ?? []) as Meeting[];

const MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const DOW_TR = ['Pazar', 'Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi'];
const pad = (n: number) => String(n).padStart(2, '0');

const today = new Date();
today.setHours(0, 0, 0, 0);
const todayKey = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;

const rows = meetings.map((m) => {
  const dt = new Date(m.decisionDate + 'T00:00:00');
  const isPast = m.decisionDate < todayKey;
  const daysUntil = Math.round((dt.getTime() - today.getTime()) / 86400000);
  return {
    ...m,
    isPast,
    daysUntil,
    dowLabel: DOW_TR[dt.getDay()],
    dayLabel: `${dt.getDate()} ${MONTHS[dt.getMonth()]} ${dt.getFullYear()}`,
  };
});

const rows2027 = meetings2027.map((m) => {
  const dt = new Date(m.decisionDate + 'T00:00:00');
  return { ...m, dowLabel: DOW_TR[dt.getDay()] };
});

const next = rows.find((r) => !r.isPast);
const nf = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const band = (lo: number, hi: number) => `%${nf(lo)}–${nf(hi)}`;
// Son açıklanan karar → güncel faiz bandı (karar gecesi scripts/policy-decisions.py doldurur)
const decided = rows.filter((r) => r.result);
const last = decided[decided.length - 1];
const cur = last?.result ?? { lower: fomc.previous.lower, upper: fomc.previous.upper };
const curBand = band(cur.lower, cur.upper);
const decisionText = (res: Result) =>
  res.decision === 'hold'
    ? `${band(res.lower, res.upper)} bandında sabit`
    : `${Math.abs(res.bp)} baz puan ${res.decision === 'cut' ? 'indirim' : 'artış'} → ${band(res.lower, res.upper)}`;
const decisionShort = (res: Result) =>
  res.decision === 'hold' ? `Sabit · ${band(res.lower, res.upper)}` : `${res.bp > 0 ? '+' : '−'}${Math.abs(res.bp)} bp → ${band(res.lower, res.upper)}`;
const statusText = (r: (typeof rows)[number]) =>
  r.isPast ? 'açıklanıyor' : next != null && r.decisionDate === next.decisionDate ? nextCountdownText : `${r.daysUntil} gün`;
const changes = decided.filter((r) => r.result!.decision !== 'hold');
const nextCountdownText =
  next == null ? '' : next.daysUntil === 0 ? 'bugün' : next.daysUntil === 1 ? 'yarın' : `${next.daysUntil} gün sonra`;

const updated = today.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

// FAQ schema — "ne zaman" niyetini hedefler
const faq = [
  {
    q: 'Fed faiz kararı ne zaman açıklanacak?',
    a: next
      ? `2026'daki bir sonraki Fed (FOMC) faiz kararı ${next.dayLabel} günü (${nextCountdownText}), TSİ ${next.tsiTime} civarında açıklanacak. Karar, iki günlük toplantının ikinci günü duyurulur.`
      : '2026 FOMC takvimi tamamlandı. 2027 tarihleri Fed tarafından açıklandığında bu sayfaya eklenecek.',
  },
  ...(last
    ? [
        {
          q: 'Fed faizi şu an yüzde kaç?',
          a: `Fed'in politika faizi (federal funds hedef bandı) şu an ${curBand}. Son karar ${last.dayLabel} tarihli FOMC toplantısında alındı: faiz ${decisionText(last.result!)}${last.result!.vote ? ` (oylama ${last.result!.vote})` : ''}.`,
        },
        {
          q: 'Fed son faiz kararı ne oldu?',
          a: `Fed ${last.dayLabel} tarihli toplantıda faizi ${decisionText(last.result!)} olarak açıkladı. 2026'da şimdiye kadar ${decided.length} karar açıklandı; ${changes.length === 0 ? 'hiçbirinde faiz değişmedi' : changes.map((c) => `${c.dayLabel} (${decisionShort(c.result!)})`).join(', ') + ' dışındaki toplantılarda faiz sabit tutuldu'}.`,
        },
      ]
    : []),
  ...(rows2027.length
    ? [
        {
          q: 'Fed 2027 toplantı tarihleri ne zaman?',
          a: `Fed'in 2027 ön takvimine göre FOMC faiz kararları şu tarihlerde açıklanacak: ${rows2027.map((r) => r.range.split('-')[1]).join(', ')}. Dot plot içeren toplantılar Mart, Haziran, Eylül ve Aralık. Tarihler her toplantıda kesinleşir.`,
        },
      ]
    : []),
  {
    q: 'FOMC yılda kaç kez toplanır?',
    a: 'FOMC (Federal Açık Piyasa Komitesi) yılda 8 kez, yaklaşık altı haftada bir toplanır. Her toplantı iki gün sürer ve faiz kararı ikinci günün sonunda açıklanır.',
  },
  {
    q: 'Dot plot (nokta grafiği) hangi toplantılarda açıklanır?',
    a: 'Ekonomik projeksiyonlar özeti (SEP) ve üyelerin faiz beklentilerini gösteren dot plot, yılda 4 kez — Mart, Haziran, Eylül ve Aralık toplantılarında — yayımlanır. Bu toplantılar piyasalar için genelde daha kritiktir.',
  },
  {
    q: 'Fed faiz kararı Türkiye’yi nasıl etkiler?',
    a: 'Fed faizi artırırsa dolar küresel olarak güçlenir; TL dahil gelişmekte olan piyasa para birimleri baskılanır, dolar/TL yukarı yönlü baskı görür. Faiz indirimi ya da güvercin ton tersi etki yapar. Karardan önceki günlerde piyasalarda volatilite artar.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`Fed Faiz Kararı Takvimi 2026-2027: FOMC Tarihleri ve Kararlar (${curBand})`}
  description={`Fed faizi ${curBand}${last ? ` (son karar ${last.dayLabel}: ${decisionText(last.result!)})` : ''}. 2026 FOMC toplantı tarihleri ve kararları, TSİ saatleri, dot plot günleri ve 2027 Fed takvimi.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="container fk-hero">
    <span class="eyebrow"><span class="pulse"></span> Canlı Takvim</span>
    <h1>Fed Faiz Kararı Takvimi 2026</h1>
    <p class="lede soft">
      ABD Merkez Bankası'nın (FOMC) 2026 yılındaki tüm faiz kararı tarihleri, Türkiye saatiyle (TSİ)
      açıklama saatleri, her toplantının kararı, dot plot günleri ve 2027 takvimi — tek sayfada.
    </p>

    {last && (
      <div class="fk-rate">
        <span class="fk-rate-label">Güncel Fed faizi (hedef bant)</span>
        <span class="fk-rate-num">{curBand}</span>
        <span class="fk-rate-sub">Son karar {last.dayLabel}: {decisionText(last.result!)}{last.result!.vote && ` · oylama ${last.result!.vote}`}</span>
      </div>
    )}

    {next && (
      <div class="fk-next">
        <div class="fk-next-count">
          <span class="fk-next-num">{next.daysUntil}</span>
          <span class="fk-next-unit">gün</span>
        </div>
        <div class="fk-next-body">
          <span class="fk-next-label">Sıradaki Fed faiz kararı</span>
          <span class="fk-next-date">{next.dowLabel}, {next.dayLabel}</span>
          <span class="fk-next-time">TSİ {next.tsiTime} · {next.dotPlot ? 'Dot plot + projeksiyonlar var' : 'Projeksiyon yok'}</span>
        </div>
      </div>
    )}
    <p class="fk-upd">Son güncelleme: {updated} · Kaynak: Federal Reserve resmi FOMC takvimi</p>
  </section>

  <section class="container fk-section">
    <div class="fk-shead">
      <h2>2026 FOMC Toplantı Tarihleri ve Kararları</h2>
      <span class="fk-shead-count">{meetings.length} toplantı</span>
    </div>

    <div class="fk-legend">
      <span><i class="dot brand"></i> Dot plot + ekonomik projeksiyon (SEP) günü</span>
      <span><i class="dot muted"></i> Standart karar</span>
    </div>

    <div class="fk-table">
      {rows.map((r) => (
        <div class:list={['fk-row', { past: r.isPast, next: next != null && r.decisionDate === next.decisionDate }]}>
          <span class="fk-cell-date">
            <strong>{r.range}</strong>
            <small>{r.dowLabel} kararı</small>
          </span>
          <span class="fk-cell-time">TSİ {r.tsiTime}</span>
          <span class:list={['fk-cell-tag', { on: r.dotPlot }]}>
            {r.dotPlot ? '● Dot plot' : '—'}
          </span>
          <span class:list={['fk-cell-status', r.result && `dec-${r.result.decision}`]}>
            {r.result ? <a href={r.result.source} rel="nofollow noopener" target="_blank">{decisionShort(r.result)}</a> : statusText(r)}
          </span>
        </div>
      ))}
    </div>
    <p class="fk-fine">
      Karar, iki günlük toplantının ikinci günü açıklanır. Saatler ABD saatiyle 14:00'e denk gelir;
      TSİ değeri yaz/kış saati farkına göre 21:00 veya 22:00'dir. Kesin saat için Fed'in resmi sitesini kontrol edin.
    </p>
  </section>

  {rows2027.length > 0 && (
    <section class="container fk-section">
      <div class="fk-shead">
        <h2>Fed 2027 Toplantı Takvimi</h2>
        <span class="fk-shead-count">{rows2027.length} toplantı · ön takvim</span>
      </div>
      <div class="fk-table">
        {rows2027.map((r) => (
          <div class="fk-row">
            <span class="fk-cell-date">
              <strong>{r.range} 2027</strong>
              <small>{r.dowLabel} kararı</small>
            </span>
            <span class="fk-cell-time">TSİ {r.tsiTime}</span>
            <span class:list={['fk-cell-tag', { on: r.dotPlot }]}>{r.dotPlot ? '● Dot plot' : '—'}</span>
            <span class="fk-cell-status">—</span>
          </div>
        ))}
      </div>
      <p class="fk-fine">{fomc.note2027}</p>
    </section>
  )}

  <section class="container fk-info">
    <h2>Fed Faiz Kararı Nedir, Neden Takip Edilir?</h2>
    <p>
      Fed (Federal Reserve), ABD'nin merkez bankasıdır. Faiz kararlarını yılda 8 kez toplanan
      <strong> FOMC</strong> (Federal Açık Piyasa Komitesi) verir. Politika faizi (federal funds rate)
      küresel likiditeyi belirlediği için karar; dolar endeksini, altını, borsaları ve TL dahil tüm
      gelişmekte olan piyasa para birimlerini doğrudan etkiler.
    </p>
    <p>
      <strong>Kritik toplantılar:</strong> Mart, Haziran, Eylül ve Aralık toplantılarında Fed, üyelerin
      faiz beklentilerini gösteren <strong>dot plot</strong>'u ve ekonomik projeksiyonları (SEP) da yayımlar.
      Bu dört toplantı, piyasa yönü açısından genellikle diğerlerinden daha belirleyicidir.
    </p>
    <p>
      <strong>Türk yatırımcı için:</strong> Fed faiz artırırsa dolar güçlenir, TL ve altın baskılanabilir;
      indirim ya da güvercin ton tersi etki yapar. Karar öncesi günlerde volatilite artar — bu yüzden
      takvimi önceden bilmek pozisyon yönetiminde avantaj sağlar.
    </p>
    <div class="fk-links">
      <a href="/blog/fed-faiz-karari-nedir-etkisi">Fed Faiz Kararı Nedir? Türkiye'ye Etkileri →</a>
      <a href="/blog/fed-faiz-karari-ne-olur-beklentiler">Fed Faiz Kararı Ne Olur? Beklentileri Okuma →</a>
      <a href="/blog/fed-faiz-karari-sonrasi-piyasa-tepkisi">Fed Kararı Sonrası Piyasa Tepkisi →</a>
      <a href="/blog/fomc-toplanti-tutanaklari-nedir">FOMC Toplantı Tutanakları Nedir? →</a>
      <a href="/tcmb-faiz-takvimi">TCMB (Merkez Bankası) faiz kararı takvimi 2026 →</a>
      <a href="/ekonomik-takvim">Tüm ekonomik takvim (TCMB, NFP, TÜİK) →</a>
    </div>
  </section>

  <section class="container fk-faq">
    <h2>Sık Sorulan Sorular</h2>
    {faq.map((f) => (
      <details class="fk-faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="container fk-note">
    <p>
      Bu sayfa yalnızca bilgilendirme amaçlıdır; yatırım tavsiyesi değildir. FOMC tarihleri Fed tarafından
      önceden ilan edilir ancak nadiren güncellenebilir; kesin tarih ve saatler için federalreserve.gov adresini kontrol edin.
    </p>
  </section>

  <div class="container"><Newsletter /></div>
</BaseLayout>

<style>
  .fk-hero { padding: clamp(1.6rem, 4vw, 2.6rem) 0 0; max-width: 720px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--step--2); font-weight: 600; color: var(--brand); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 0 rgba(22,160,133,0.5); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(22,160,133,0.5); } 70% { box-shadow: 0 0 0 6px rgba(22,160,133,0); } 100% { box-shadow: 0 0 0 0 rgba(22,160,133,0); } }
  .fk-hero h1 { font-size: var(--step-2); margin: 0.6rem 0 0.4rem; }
  .fk-hero .lede { font-size: var(--step-0); line-height: 1.5; margin: 0 0 0.9rem; }
  .fk-upd { font-size: var(--step--2); color: var(--text-muted); margin: 0.7rem 0 0; }

  /* Next-decision countdown */
  .fk-next {
    display: flex; align-items: center; gap: 1rem;
    background: var(--brand-tint); border: 1px solid var(--brand-light); border-radius: var(--radius);
    padding: 0.9rem 1.1rem; max-width: 460px;
  }
  .fk-next-count {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: var(--bg-card); border: 1px solid var(--brand-light); border-radius: var(--radius);
    padding: 0.4rem 0.9rem; min-width: 72px;
  }
  .fk-next-num { font-size: var(--step-2); font-weight: 800; color: var(--brand-deep); line-height: 1; font-variant-numeric: tabular-nums; }
  .fk-next-unit { font-size: var(--step--2); color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .fk-next-body { display: flex; flex-direction: column; gap: 0.15rem; }
  .fk-next-label { font-size: var(--step--2); font-weight: 700; color: var(--brand-deep); text-transform: uppercase; letter-spacing: 0.05em; }
  .fk-next-date { font-size: var(--step-0); font-weight: 700; color: var(--text); }
  .fk-next-time { font-size: var(--step--2); color: var(--text-muted); }

  .fk-section { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .fk-shead { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.7rem; }
  .fk-shead h2 { font-size: var(--step-1); margin: 0; }
  .fk-shead-count { font-size: 0.66rem; font-weight: 700; color: var(--brand-deep); background: var(--brand-tint); border-radius: 999px; padding: 0.1rem 0.55rem; }

  .fk-legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin-bottom: 0.9rem; font-size: var(--step--2); color: var(--text-muted); }
  .fk-legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; }
  .dot.brand { background: var(--brand); }
  .dot.muted { background: var(--border); }

  .fk-table { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-card); box-shadow: var(--shadow-xs); max-width: 700px; }
  .fk-row {
    display: grid; grid-template-columns: 1fr auto auto auto; align-items: center;
    gap: 0.5rem 1rem; padding: 0.7rem 1rem; border-bottom: 1px solid var(--border-soft);
  }
  .fk-row:last-child { border-bottom: none; }
  .fk-row.past .fk-cell-date, .fk-row.past .fk-cell-time, .fk-row.past .fk-cell-tag { opacity: 0.55; }
  .fk-cell-status a { color: inherit; text-decoration: none; }
  .fk-cell-status a:hover { text-decoration: underline; }
  .fk-cell-status.dec-cut { color: var(--brand-deep); }
  .fk-cell-status.dec-hike { color: #c0392b; }
  .fk-cell-status.dec-hold { color: var(--text-soft); }
  .fk-rate { display: flex; flex-direction: column; gap: 0.15rem; margin: 0 0 0.9rem; padding: 0.8rem 1.1rem; max-width: 460px; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-xs); }
  .fk-rate-label { font-size: var(--step--2); font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .fk-rate-num { font-size: var(--step-3); font-weight: 800; color: var(--text); line-height: 1.05; font-variant-numeric: tabular-nums; }
  .fk-rate-sub { font-size: var(--step--1); color: var(--text-soft); }
  .fk-row.next { background: var(--brand-tint); border-left: 3px solid var(--brand-deep); }
  .fk-cell-date { display: flex; flex-direction: column; gap: 0.1rem; }
  .fk-cell-date strong { font-size: var(--step-0); color: var(--text); }
  .fk-cell-date small { font-size: var(--step--2); color: var(--text-muted); }
  .fk-cell-time { font-size: var(--step--1); font-weight: 700; color: var(--text-soft); font-variant-numeric: tabular-nums; }
  .fk-cell-tag { font-size: var(--step--2); color: var(--text-muted); white-space: nowrap; }
  .fk-cell-tag.on { color: var(--brand-deep); font-weight: 700; }
  .fk-cell-status { font-size: var(--step--2); font-weight: 700; color: var(--text-muted); text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .fk-row.next .fk-cell-status { color: var(--brand-deep); }

  .fk-fine { font-size: var(--step--2); color: var(--text-muted); line-height: 1.6; margin: 0.8rem 0 0; max-width: 640px; }

  .fk-info { margin-top: clamp(1.6rem, 4vw, 2.6rem); max-width: 700px; padding: 1.2rem 1.4rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-xs); }
  .fk-info h2 { font-size: var(--step-1); margin: 0 0 0.7rem; }
  .fk-info p { font-size: var(--step--1); color: var(--text-soft); line-height: 1.65; margin: 0 0 0.7rem; }
  .fk-info strong { color: var(--text); }
  .fk-links { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.6rem; }
  .fk-links a { font-size: var(--step--1); color: var(--brand-deep); font-weight: 600; text-decoration: none; }
  .fk-links a:hover { text-decoration: underline; }

  .fk-faq { margin-top: clamp(1.6rem, 4vw, 2.6rem); max-width: 700px; }
  .fk-faq h2 { font-size: var(--step-1); margin: 0 0 0.7rem; }
  .fk-faq-item { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); padding: 0.7rem 1rem; margin-bottom: 0.6rem; }
  .fk-faq-item summary { cursor: pointer; font-size: var(--step--1); font-weight: 600; color: var(--text); user-select: none; }
  .fk-faq-item p { font-size: var(--step--1); color: var(--text-soft); line-height: 1.6; margin: 0.6rem 0 0; }

  .fk-note { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .fk-note p { font-size: var(--step--2); line-height: 1.6; max-width: 640px; color: var(--text-muted); padding: 0.8rem 1rem; background: var(--bg-elev); border: 1px solid var(--border-soft); border-radius: var(--radius); }

  @media (max-width: 560px) {
    .fk-row { grid-template-columns: 1fr auto; row-gap: 0.3rem; }
    .fk-cell-time { grid-column: 2; text-align: right; }
    .fk-cell-tag { grid-column: 1; }
    .fk-cell-status { grid-column: 2; }
  }
</style>
