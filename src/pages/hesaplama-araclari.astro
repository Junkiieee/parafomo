---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ALTIN_SPECS } from '../data/altin-specs';

// Araç merkezi: tüm hesaplayıcı ve veri sayfaları tek yerde — iç link otoritesini araçlarda toplar.
// Liste TEK kaynaktan: src/data/tools.ts (blog yazılarının "Bu konuda hesapla" kutusu da oradan beslenir).
import { GRUPLAR as G2 } from '../data/tools';
const GRUPLAR: { baslik: string; araclar: [string, string, string][] }[] = G2.map((g) => ({
  baslik: g.baslik,
  araclar: g.araclar.map((t) => [t.href, t.ad, t.aciklama] as [string, string, string]),
}));

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Hesaplama Araçları', url: '/hesaplama-araclari/' },
];
---

<BaseLayout
  title="Hesaplama Araçları | Faiz, Kredi, Maaş, Vergi ve Altın Hesaplayıcıları"
  description="ParaFOMO'nun ücretsiz finans hesaplama araçları tek sayfada: faiz, kredi, mevduat, net maaş, kıdem tazminatı, emekli zammı, vergi, KDV, MTV, emlak vergisi, altın ve getiri hesaplayıcıları."
  breadcrumbs={breadcrumbs}
>
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Ücretsiz · Kayıt gerektirmez</p>
      <h1>Hesaplama Araçları</h1>
      <p class="lede">Para kararlarında ihtiyaç duyduğun hesaplayıcı ve güncel veri sayfaları — her biri resmî kaynaklı
        oranlarla ve tarihli.</p>
    </header>

    {GRUPLAR.map((g) => (
      <section class="grp">
        <h2>{g.baslik}</h2>
        <ul class="grid">
          {g.araclar.map(([href, ad, ac]) => (
            <li><a href={href}><strong>{ad}</strong><span>{ac}</span></a></li>
          ))}
        </ul>
      </section>
    ))}

    <section class="grp">
      <h2>Altın türlerine göre fiyat</h2>
      <p class="chips">
        {ALTIN_SPECS.map((s) => <a href={`/altin-fiyatlari/${s.slug}/`}>{s.ad}</a>)}
      </p>
    </section>
  </div>

  <style>
    .wrap { max-width: 980px; margin: 0 auto; padding: 2.5rem 1.1rem 4rem; }
    .head { text-align: center; margin-bottom: 1.8rem; }
    .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; font-weight: 700; color: var(--brand-deep); margin: 0 0 0.4rem; }
    .head h1 { font-size: var(--step-4); margin: 0 0 0.6rem; line-height: 1.1; }
    .lede { color: var(--text-soft); font-size: var(--step-1); max-width: 640px; margin: 0 auto; }
    .grp { margin-top: 2rem; }
    .grp h2 { font-size: var(--step-2); margin: 0 0 0.8rem; }
    .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.7rem; }
    .grid a { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.9rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); text-decoration: none; color: var(--text); height: 100%; }
    .grid a:hover { border-color: var(--brand-2); box-shadow: var(--shadow-soft); }
    .grid span { font-size: 0.85rem; color: var(--text-soft); }
    .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .chips a { padding: 0.4rem 0.8rem; border: 1px solid var(--border); border-radius: 999px; font-size: 0.88rem; text-decoration: none; color: var(--text); background: var(--bg-card); }
    .chips a:hover { border-color: var(--brand-2); }
  </style>
</BaseLayout>
