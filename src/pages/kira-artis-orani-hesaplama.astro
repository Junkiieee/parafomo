---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import kira from '../../data/kira-artis-2026.json';

// Güncel yasal tavan (12 aylık TÜFE ortalaması) — data dosyasından, aylık güncellenir.
const RATE = kira.guncelOran; // %
const AY = kira.guncelAy;

// Sunucuda varsayılan hesap — JS kapalıyken bile sayfa dolu görünsün (SEO + no-JS).
const D = { rent: 20000 };
const newRent = D.rent * (1 + RATE / 100);
const monthlyDiff = newRent - D.rent;

const fmt = (n: number) =>
  new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));

// Sıradaki TÜİK açıklamasına geri sayım (build-time)
const next = new Date(kira.sonrakiAciklama + 'T10:00:00+03:00');
const now = new Date();
const daysToNext = Math.max(0, Math.ceil((next.getTime() - now.getTime()) / 86400000));
const nextLabel = next.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

const faq = [
  {
    q: 'Kira artış oranı nasıl hesaplanır?',
    a: `Konut ve çatılı iş yeri kiralarında yasal artış tavanı, bir önceki kira yılındaki 12 aylık TÜFE (tüketici enflasyonu) ortalamasıdır. Yeni kira = mevcut kira × (1 + oran/100). Örneğin ${AY} için geçerli oran %${RATE.toString().replace('.', ',')} olduğundan, 20.000 ₺ kira en fazla ${fmt(20000 * (1 + RATE / 100))} ₺'ye çıkarılabilir.`,
  },
  {
    q: 'Kira artış oranı %25 ile sınırlı değil mi?',
    a: 'Hayır, artık değil. Konutlarda 11 Haziran 2022–1 Temmuz 2024 arasında geçerli olan %25 kira artış tavanı 2 Temmuz 2024 itibarıyla sona erdi. O tarihten sonra yenilenen konut kira sözleşmelerinde tavan yeniden 12 aylık TÜFE ortalamasıdır. İş yerlerinde %25 sınırı hiçbir zaman uygulanmadı.',
  },
  {
    q: 'Ev sahibi 12 aylık TÜFE ortalamasından fazla zam yapabilir mi?',
    a: 'Kural olarak hayır. Türk Borçlar Kanunu madde 344, kira artışının bir önceki kira yılındaki 12 aylık TÜFE ortalamasını aşamayacağını söyler. Taraflar sözleşmeye daha yüksek bir oran yazsa bile bu geçersizdir; kiracı fazlasını ödemek zorunda değildir. Ancak 5 yılını dolduran kiralarda ev sahibi mahkemeye başvurarak "hak ve nesafet" (rayiç bedel) uyarlaması isteyebilir.',
  },
  {
    q: '5 yıldır aynı evde oturuyorum, artış oranı yine TÜFE ile mi sınırlı?',
    a: '5 yıl boyunca yıllık artış yine 12 aylık TÜFE ortalamasıyla sınırlıdır. 5 yılı dolduran kira ilişkilerinde ise ev sahibi dava açarak kirayı emsal/rayiç bedele göre uyarlatabilir; bu durumda hâkim TÜFE tavanına bağlı kalmadan güncel piyasa kirasını dikkate alabilir.',
  },
  {
    q: 'Kira artış oranı ne zaman güncellenir?',
    a: `Oran her ay değişir çünkü 12 aylık TÜFE ortalaması TÜİK'in aylık enflasyon açıklamasıyla güncellenir. TÜİK enflasyonu her ayın başında (genelde ~3'ünde, saat 10:00) açıklar. Sıradaki açıklama ${nextLabel} tarihinde. Sözleşme yenilenme ayınızda geçerli olan oranı esas almalısınız.`,
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Kira Artış Oranı Hesaplama', url: '/kira-artis-orani-hesaplama' },
];
---

<BaseLayout
  title={`Kira Artış Oranı Hesaplama ${AY} | Yasal Zam Tavanı %${RATE.toString().replace('.', ',')}`}
  description={`Güncel kira artış oranı hesaplama aracı. ${AY} için yasal zam tavanı (12 aylık TÜFE ortalaması) %${RATE.toString().replace('.', ',')}. Mevcut kiranızı girin, yeni yasal kiranızı anında görün.`}
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Hesaplayıcı · {AY}</p>
      <h1>Kira Artış Oranı Hesaplama</h1>
      <p class="lede">
        <strong>{AY}</strong> için geçerli yasal kira zammı tavanı (12 aylık TÜFE ortalaması)
        <strong>%{RATE.toString().replace('.', ',')}</strong>. Mevcut aylık kiranızı girin,
        yasal olarak çıkabileceğiniz <strong>en yüksek yeni kirayı</strong> anında görün.
      </p>
    </header>

    <div class="calc-grid">
      <form class="calc-inputs" id="calc-form" autocomplete="off">
        <label>
          <span>Mevcut aylık kira (₺)</span>
          <input type="number" id="in-rent" value={D.rent} min="0" step="500" inputmode="numeric" />
        </label>
        <label>
          <span>Artış oranı (%) <em class="hint">— {AY} yasal tavan</em></span>
          <input type="number" id="in-rate" value={RATE} min="0" max="200" step="0.01" inputmode="decimal" />
        </label>
        <button type="button" id="reset-rate" class="reset-btn">Yasal tavana sıfırla (%{RATE.toString().replace('.', ',')})</button>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label">Yeni aylık kira (yasal üst sınır)</span>
          <span class="result-value" id="out-new">₺{fmt(newRent)}</span>
        </div>
        <div class="result-split">
          <div class="split-item">
            <span class="split-label">Aylık artış tutarı</span>
            <span class="split-val" id="out-monthly">₺{fmt(monthlyDiff)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Yıllık ek maliyet</span>
            <span class="split-val" id="out-yearly">₺{fmt(monthlyDiff * 12)}</span>
          </div>
        </div>
        <p class="result-note" id="out-note"></p>
      </div>
    </div>

    <div class="countdown-strip">
      <span class="cd-num">{daysToNext}</span>
      <span class="cd-text">gün sonra ({nextLabel}) TÜİK yeni enflasyonu açıklıyor → oran güncellenecek.
        <a href="/enflasyon-takvimi">Tüm enflasyon takvimi →</a></span>
    </div>

    <p class="disclaimer">
      Bu araç yalnızca bilgilendirme amaçlıdır, hukuki tavsiye değildir. Hesaplama, açıklanan
      12 aylık TÜFE ortalamasına ve girdiğiniz orana dayanır. Somut uyuşmazlıklarda sözleşme
      hükümleri ve güncel mevzuat için bir hukuk danışmanına başvurun.
    </p>

    <section class="table-block">
      <h2>Aylara göre kira artış oranı (12 aylık TÜFE ortalaması)</h2>
      <table class="rate-table">
        <thead><tr><th>Ay</th><th>Yasal zam tavanı</th></tr></thead>
        <tbody>
          {kira.gecmis.map((r: { ay: string; oran: number }, i: number) => (
            <tr class={i === 0 ? 'current' : ''}>
              <td>{r.ay}{i === 0 ? ' (güncel)' : ''}</td>
              <td>%{r.oran.toString().replace('.', ',')}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">Oran her ay, TÜİK'in yeni enflasyon açıklamasıyla güncellenir. Trend: son aylarda kademeli düşüş.</p>
    </section>

    <section class="prose-block">
      <h2>Kira artış oranı nasıl belirlenir?</h2>
      <p>
        Türkiye'de konut ve çatılı iş yeri kiralarında yıllık artışın yasal tavanı,
        <strong>Türk Borçlar Kanunu madde 344</strong> uyarınca bir önceki kira yılındaki
        <strong>12 aylık TÜFE (tüketici fiyat endeksi) ortalamasıdır.</strong> Bu oran her ay
        değişir: TÜİK enflasyonu açıkladıkça 12 aylık ortalama güncellenir. Sözleşmenizin
        yenilendiği ayda geçerli olan oranı esas almanız gerekir.
      </p>
      <h2>%25 tavanı hâlâ geçerli mi?</h2>
      <p>
        Hayır. Konutlarda 11 Haziran 2022'de getirilen <strong>%25 kira artış sınırı 2 Temmuz
        2024'te sona erdi.</strong> O tarihten sonra yenilenen konut sözleşmelerinde tavan
        yeniden 12 aylık TÜFE ortalamasıdır. İş yerlerinde %25 sınırı zaten hiç uygulanmadı.
      </p>
      <h2>Ev sahibi daha fazla zam isterse ne olur?</h2>
      <p>
        Sözleşmede daha yüksek bir oran yazsa bile, TÜFE ortalamasını aşan kısım geçersizdir;
        kiracı fazlasını ödemek zorunda değildir. Tek istisna: <strong>5 yılını dolduran</strong>
        kira ilişkilerinde ev sahibi mahkemeye başvurarak kirayı rayiç (emsal) bedele göre
        uyarlatabilir — bu durumda hâkim TÜFE tavanıyla bağlı olmayabilir.
      </p>
      <p class="cta-line">
        Kira zammının bağlı olduğu enflasyon verisini derinlemesine anlamak için →
        <a href="/blog/tufe-enflasyon-verisi-nasil-okunur">TÜİK enflasyon verisi nasıl okunur?</a>
        ve <a href="/blog/tufe-sepeti-nedir">TÜFE sepeti nedir?</a> yazılarımıza,
        enflasyonun ne zaman açıklanacağı için <a href="/enflasyon-takvimi">enflasyon takvimi</a>
        sayfamıza göz atın.
      </p>
    </section>

    <section class="faq-block">
      <h2>Sıkça Sorulan Sorular</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <Newsletter />
  </div>

  <script is:inline define:vars={{ RATE, AY }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
      const rateStr = String(RATE).replace('.', ',');

      function update() {
        const rent = Math.max(0, +$('in-rent').value || 0);
        const rate = Math.max(0, +$('in-rate').value || 0);
        const newRent = rent * (1 + rate / 100);
        const monthly = newRent - rent;
        $('out-new').textContent = '₺' + nf.format(Math.round(newRent));
        $('out-monthly').textContent = '₺' + nf.format(Math.round(monthly));
        $('out-yearly').textContent = '₺' + nf.format(Math.round(monthly * 12));
        const over = rate - RATE > 0.001;
        $('out-note').textContent = over
          ? `Girdiğin oran %${nf.format(rate)}, ${AY} yasal tavanı %${rateStr}'in üzerinde — tavanı aşan kısım kiracı için bağlayıcı değildir.`
          : `Bu, ${AY} için yasal üst sınırdır. Ev sahibi bundan fazlasını talep edemez.`;
      }

      $('in-rent').addEventListener('input', update);
      $('in-rate').addEventListener('input', update);
      $('reset-rate').addEventListener('click', () => { $('in-rate').value = RATE; update(); });
      update();
    })();
  </script>

  <style>
    .calc-wrap { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.1rem 4rem; }
    .calc-head { text-align: center; margin-bottom: 2rem; }
    .eyebrow {
      text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem;
      font-weight: 700; color: var(--brand-deep); margin: 0 0 0.4rem;
    }
    .calc-head h1 { font-size: var(--step-4); margin: 0 0 0.6rem; line-height: 1.1; }
    .lede { color: var(--text-soft); font-size: var(--step-1); max-width: 620px; margin: 0 auto; }

    .calc-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 1.4rem; box-shadow: var(--shadow-soft);
    }
    .calc-inputs { display: flex; flex-direction: column; gap: 0.9rem; margin: 0; }
    .calc-inputs label { display: flex; flex-direction: column; gap: 0.35rem; }
    .calc-inputs span { font-size: 0.85rem; font-weight: 600; color: var(--text-soft); }
    .calc-inputs .hint { font-weight: 500; font-style: normal; color: var(--text-muted); font-size: 0.78rem; }
    .calc-inputs input {
      font-family: var(--font-sans); font-size: 1.15rem; font-weight: 600; color: var(--text);
      padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm);
      background: var(--bg); width: 100%;
    }
    .calc-inputs input:focus { outline: none; border-color: var(--brand-2); box-shadow: 0 0 0 3px var(--brand-soft); }
    .reset-btn {
      align-self: flex-start; font-size: 0.78rem; font-weight: 600; color: var(--brand-deep);
      background: var(--brand-tint); border: 1px solid var(--border); border-radius: var(--radius-sm);
      padding: 0.4rem 0.7rem; cursor: pointer;
    }
    .reset-btn:hover { background: var(--brand-soft); }

    .calc-results {
      display: flex; flex-direction: column; justify-content: center; gap: 1rem;
      background: var(--brand-tint); border-radius: var(--radius); padding: 1.2rem;
    }
    .result-main { display: flex; flex-direction: column; gap: 0.2rem; }
    .result-label { font-size: 0.85rem; color: var(--text-soft); font-weight: 600; }
    .result-value { font-family: var(--font-serif); font-size: clamp(1.9rem, 1.4rem + 2vw, 2.7rem); font-weight: 600; color: var(--brand-ink); line-height: 1.05; }
    .result-split { display: flex; flex-direction: column; gap: 0.55rem; }
    .split-item { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.5rem; }
    .split-label { font-size: 0.85rem; color: var(--text-soft); }
    .split-val { font-weight: 700; font-size: 0.98rem; }
    .result-note { font-size: 0.82rem; color: var(--brand-ink); margin: 0; font-weight: 500; }

    .countdown-strip {
      display: flex; align-items: center; gap: 0.7rem; margin: 1.4rem 0 0;
      background: var(--surface); border-left: 3px solid var(--brand-2);
      border-radius: var(--radius-sm); padding: 0.8rem 1rem;
    }
    .cd-num { font-family: var(--font-serif); font-size: 1.8rem; font-weight: 700; color: var(--brand-ink); line-height: 1; }
    .cd-text { font-size: 0.85rem; color: var(--text-soft); line-height: 1.4; }

    .disclaimer { font-size: 0.8rem; color: var(--text-muted); margin: 1.2rem 0 2.5rem; line-height: 1.5; }

    .table-block { margin-top: 2.5rem; }
    .table-block h2 { font-size: var(--step-2); margin: 0 0 0.8rem; }
    .rate-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
    .rate-table th, .rate-table td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid var(--border); }
    .rate-table th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
    .rate-table tr.current td { font-weight: 700; color: var(--brand-ink); }
    .table-note { font-size: 0.82rem; color: var(--text-muted); margin: 0.7rem 0 0; }

    .prose-block, .faq-block { margin-top: 2.5rem; }
    .prose-block h2, .faq-block h2 { font-size: var(--step-2); margin: 0 0 0.8rem; }
    .prose-block p, .prose-block li { color: var(--text-soft); line-height: 1.7; }
    .prose-block h2:not(:first-child) { margin-top: 1.8rem; }
    .cta-line { background: var(--surface); padding: 0.9rem 1.1rem; border-radius: var(--radius-sm); border-left: 3px solid var(--brand-2); }

    .faq-block details { border-bottom: 1px solid var(--border); padding: 0.9rem 0; }
    .faq-block summary { font-weight: 600; cursor: pointer; color: var(--text); list-style: none; }
    .faq-block summary::-webkit-details-marker { display: none; }
    .faq-block summary::after { content: '+'; float: right; color: var(--brand-2); font-weight: 700; }
    .faq-block details[open] summary::after { content: '−'; }
    .faq-block details p { color: var(--text-soft); line-height: 1.7; margin: 0.7rem 0 0; }

    @media (max-width: 600px) {
      .calc-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
