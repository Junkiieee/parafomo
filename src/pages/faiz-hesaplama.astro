---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';

// "faiz hesaplama" (Trends ≈500, "mevduat faizi" = 100) — genel faiz niyeti: basit / bileşik, gün-ay-yıl,
// isteğe bağlı vergi kesintisi. Mevduat stopajının vadeye göre resmî oranları /mevduat-faizi-hesaplama'da.
const D = { anapara: 100000, oran: 40, sure: 12, birim: 'ay' as 'gun' | 'ay' | 'yil', yontem: 'basit' as 'basit' | 'aylik' | 'yillik', kesinti: 0 };

function yil(sure: number, birim: string) {
  return birim === 'gun' ? sure / 365 : birim === 'ay' ? sure / 12 : sure;
}
function hesap(anapara: number, oranPct: number, sure: number, birim: string, yontem: string, kesintiPct: number) {
  const r = oranPct / 100;
  const t = yil(sure, birim);
  let brut: number;
  if (yontem === 'aylik') brut = anapara * (Math.pow(1 + r / 12, t * 12) - 1);
  else if (yontem === 'yillik') brut = anapara * (Math.pow(1 + r, t) - 1);
  else brut = anapara * r * t;
  const kesinti = brut * (kesintiPct / 100);
  const net = brut - kesinti;
  return { brut, kesinti, net, toplam: anapara + net };
}
const base = hesap(D.anapara, D.oran, D.sure, D.birim, D.yontem, D.kesinti);
const fmt = (n: number) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const pct = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 }).format(n);

// Aylık ↔ yıllık dönüşüm tablosu (bileşik)
const donusum = [2, 2.5, 3, 3.5, 4, 5].map((m) => ({ aylik: m, basit: m * 12, bilesik: (Math.pow(1 + m / 100, 12) - 1) * 100 }));

const faq = [
  { q: 'Faiz nasıl hesaplanır?', a: `Basit faizde: Faiz = Anapara × Yıllık oran × Süre (yıl). Süre gün ise gün/365, ay ise ay/12 ile yıla çevrilir. Örneğin ${fmt(D.anapara)} ₺ için yıllık %${D.oran} faizle 12 ayda ${fmt(base.brut)} ₺ faiz işler. Bileşik faizde ise her dönem kazanılan faiz anaparaya eklenir ve sonraki dönem ona da faiz işler: Toplam = Anapara × (1 + oran/dönem)^(dönem sayısı).` },
  { q: 'Basit faiz ile bileşik faiz arasındaki fark nedir?', a: 'Basit faizde faiz yalnızca ana paraya işler; bileşik faizde biriken faize de faiz işler. Kısa vadede fark küçüktür, vade uzadıkça ve oran yükseldikçe büyür. Vadeli mevduat tek vadede basit faizle çalışır; vade sonunda faizi anaparaya ekleyip yenilerseniz fiilen bileşik getiri elde edersiniz.' },
  { q: 'Günlük faiz nasıl hesaplanır?', a: 'Günlük faiz = Anapara × Yıllık oran ÷ 365. Örneğin 100.000 ₺ için yıllık %40 faizin günlük karşılığı 100.000 × 0,40 ÷ 365 ≈ 109,59 ₺\'dir. Türkiye\'de TL mevduatta yıl genellikle 365 gün kabul edilir.' },
  { q: 'Aylık faiz yıllığa nasıl çevrilir?', a: 'Basit yaklaşımla aylık oran 12 ile çarpılır (%3 → %36). Faizin her ay anaparaya eklendiği bileşik hesapta ise yıllık oran = (1 + aylık oran)^12 − 1 olur: aylık %3, yıllık bileşik %42,58 eder. Kredi kartı ve kredi faizleri aylık verildiği için gerçek yıllık maliyet bileşik formülle bulunur.' },
  { q: 'Faiz getirisinden vergi kesilir mi?', a: 'TL mevduat faizinden vadeye göre değişen oranlarda stopaj kesilir; güncel oranlar ve net getiri için mevduat faizi hesaplama aracımızı kullanın. Bu genel araçta "vergi kesintisi" alanına oranı kendiniz girerek net tutarı görebilirsiniz.' },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Faiz Hesaplama', url: '/faiz-hesaplama/' },
];
---

<BaseLayout
  title="Faiz Hesaplama 2026 | Basit ve Bileşik Faiz, Günlük-Aylık-Yıllık Faiz Hesabı"
  description="Faiz hesaplama: anapara, faiz oranı ve süreyi (gün, ay, yıl) girin; basit veya bileşik faiz, stopaj sonrası net getiri ve vade sonu toplamı anında."
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Hesaplayıcı · Faiz</p>
      <h1>Faiz Hesaplama</h1>
      <p class="lede">Anaparayı, yıllık faiz oranını ve süreyi girin; <strong>faiz tutarını ve vade sonu toplamı</strong>
        basit ya da bileşik yöntemle anında görün.</p>
    </header>

    <div class="calc-grid">
      <form class="calc-inputs" id="f" autocomplete="off">
        <label><span>Anapara (₺)</span><input type="number" id="in-p" value={D.anapara} min="0" step="1000" inputmode="decimal" /></label>
        <label><span>Yıllık faiz oranı (%)</span><input type="number" id="in-r" value={D.oran} min="0" step="0.5" inputmode="decimal" /></label>
        <div class="row2">
          <label><span>Süre</span><input type="number" id="in-t" value={D.sure} min="0" step="1" inputmode="numeric" /></label>
          <label><span>Birim</span>
            <select id="in-u"><option value="gun">Gün</option><option value="ay" selected>Ay</option><option value="yil">Yıl</option></select>
          </label>
        </div>
        <label><span>Yöntem</span>
          <select id="in-m">
            <option value="basit" selected>Basit faiz</option>
            <option value="aylik">Bileşik — aylık faiz ekleme</option>
            <option value="yillik">Bileşik — yıllık faiz ekleme</option>
          </select>
        </label>
        <label><span>Vergi / stopaj kesintisi (%) — isteğe bağlı</span><input type="number" id="in-k" value={D.kesinti} min="0" max="100" step="0.5" inputmode="decimal" /></label>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label">Vade sonu toplam</span>
          <span class="result-value" id="o-top">₺{fmt(base.toplam)}</span>
        </div>
        <div class="result-split">
          <div class="split-item"><span class="split-label">Brüt faiz</span><span class="split-val" id="o-b">₺{fmt(base.brut)}</span></div>
          <div class="split-item"><span class="split-label">Kesinti</span><span class="split-val" id="o-k">−₺{fmt(base.kesinti)}</span></div>
          <div class="split-item"><span class="split-label">Net faiz</span><span class="split-val" id="o-n">₺{fmt(base.net)}</span></div>
          <div class="split-item"><span class="split-label">Günlük faiz (basit)</span><span class="split-val" id="o-g">₺{fmt((D.anapara * D.oran) / 100 / 365)}</span></div>
        </div>
      </div>
    </div>

    <section class="table-block">
      <h2>Süreye göre faiz (<span id="q-lbl">basit</span>)</h2>
      <table class="rate-table">
        <thead><tr><th>Süre</th><th>Brüt faiz</th><th>Net faiz</th><th>Toplam</th></tr></thead>
        <tbody id="q-body">
          {[1, 3, 6, 12, 24, 36].map((ay) => {
            const h = hesap(D.anapara, D.oran, ay, 'ay', D.yontem, D.kesinti);
            return <tr><td>{ay} ay</td><td>₺{fmt(h.brut)}</td><td>₺{fmt(h.net)}</td><td>₺{fmt(h.toplam)}</td></tr>;
          })}
        </tbody>
      </table>
    </section>

    <section class="table-block">
      <h2>Aylık faizi yıllığa çevirme</h2>
      <table class="rate-table">
        <thead><tr><th>Aylık faiz</th><th>Yıllık (basit, ×12)</th><th>Yıllık bileşik</th></tr></thead>
        <tbody>
          {donusum.map((d) => <tr><td>%{pct(d.aylik)}</td><td>%{pct(d.basit)}</td><td>%{pct(d.bilesik)}</td></tr>)}
        </tbody>
      </table>
      <p class="table-note">Bileşik: (1 + aylık oran)^12 − 1. Kredi ve kredi kartı faizleri aylık verildiğinden gerçek yıllık maliyet bu sütundur.</p>
    </section>

    <section class="prose-block">
      <h2>Faiz hesaplama formülleri</h2>
      <p><strong>Basit faiz:</strong> Faiz = Anapara × Oran × Süre. Süre yıl cinsindendir: 90 gün için 90/365, 6 ay için 6/12.
        Vadeli mevduat bir vade boyunca bu yöntemle çalışır.</p>
      <p><strong>Bileşik faiz:</strong> Toplam = Anapara × (1 + Oran/n)^(n × Süre); n yıldaki faiz ekleme sayısıdır
        (aylık 12, yıllık 1). Faiz anaparaya eklenip yeniden faiz kazandıkça getiri hızlanır — uzun vadeli birikimin
        motoru budur. Ayrıntılı senaryo ve düzenli katkı için <a href="/bilesik-faiz-hesaplama/">bileşik faiz hesaplama</a>.</p>
      <p class="cta-line">
        Bankada net getiri ve güncel stopaj → <a href="/mevduat-faizi-hesaplama/">mevduat faizi hesaplama</a> ·
        kredi taksiti ve toplam faiz → <a href="/kredi-hesaplama/">kredi hesaplama</a>,
        <a href="/konut-kredisi-hesaplama/">konut kredisi hesaplama</a> ·
        faizin enflasyona karşı durumu → <a href="/enflasyon-takvimi/">enflasyon takvimi</a>.
      </p>
    </section>

    <section class="faq-block">
      <h2>Sıkça Sorulan Sorular</h2>
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
    <p class="disclaimer">Bu araç bilgilendirme amaçlıdır; banka ve ürünlere göre gün sayımı, vergi ve masraflar farklılık gösterebilir.</p>
    <Newsletter />
  </div>

  <script is:inline>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const m = (n) => '₺' + nf.format(n);
      const yil = (s, u) => (u === 'gun' ? s / 365 : u === 'ay' ? s / 12 : s);
      function hesap(p, rp, s, u, y, kp) {
        const r = rp / 100, t = yil(s, u);
        const b = y === 'aylik' ? p * (Math.pow(1 + r / 12, t * 12) - 1) : y === 'yillik' ? p * (Math.pow(1 + r, t) - 1) : p * r * t;
        const k = b * (kp / 100);
        return { b, k, n: b - k, top: p + b - k };
      }
      const LBL = { basit: 'basit', aylik: 'bileşik, aylık', yillik: 'bileşik, yıllık' };
      function up() {
        const p = Math.max(0, +$('in-p').value || 0), r = Math.max(0, +$('in-r').value || 0);
        const t = Math.max(0, +$('in-t').value || 0), u = $('in-u').value, y = $('in-m').value;
        const k = Math.min(100, Math.max(0, +$('in-k').value || 0));
        const h = hesap(p, r, t, u, y, k);
        $('o-top').textContent = m(h.top); $('o-b').textContent = m(h.b);
        $('o-k').textContent = '−' + m(h.k); $('o-n').textContent = m(h.n);
        $('o-g').textContent = m((p * r) / 100 / 365);
        $('q-lbl').textContent = LBL[y];
        $('q-body').innerHTML = [1, 3, 6, 12, 24, 36].map((a) => {
          const q = hesap(p, r, a, 'ay', y, k);
          return `<tr><td>${a} ay</td><td>${m(q.b)}</td><td>${m(q.n)}</td><td>${m(q.top)}</td></tr>`;
        }).join('');
      }
      ['in-p', 'in-r', 'in-t', 'in-k'].forEach((id) => $(id).addEventListener('input', up));
      ['in-u', 'in-m'].forEach((id) => $(id).addEventListener('change', up));
    })();
  </script>

  <style>
    .calc-wrap { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.1rem 4rem; }
    .calc-head { text-align: center; margin-bottom: 2rem; }
    .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; font-weight: 700; color: var(--brand-deep); margin: 0 0 0.4rem; }
    .calc-head h1 { font-size: var(--step-4); margin: 0 0 0.6rem; line-height: 1.1; }
    .lede { color: var(--text-soft); font-size: var(--step-1); max-width: 620px; margin: 0 auto; }
    .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.4rem; box-shadow: var(--shadow-soft); }
    .calc-inputs { display: flex; flex-direction: column; gap: 0.9rem; margin: 0; }
    .calc-inputs label { display: flex; flex-direction: column; gap: 0.35rem; }
    .calc-inputs label > span { font-size: 0.85rem; font-weight: 600; color: var(--text-soft); }
    .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    .calc-inputs input, .calc-inputs select { font-family: var(--font-sans); font-size: 1.15rem; font-weight: 600; color: var(--text); padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg); width: 100%; }
    .calc-inputs input:focus, .calc-inputs select:focus { outline: none; border-color: var(--brand-2); box-shadow: 0 0 0 3px var(--brand-soft); }
    .calc-results { display: flex; flex-direction: column; justify-content: center; gap: 1rem; background: var(--brand-tint); border-radius: var(--radius); padding: 1.2rem; }
    .result-main { display: flex; flex-direction: column; gap: 0.2rem; }
    .result-label { font-size: 0.85rem; color: var(--text-soft); font-weight: 600; }
    .result-value { font-family: var(--font-serif); font-size: clamp(1.9rem, 1.4rem + 2vw, 2.7rem); font-weight: 600; color: var(--brand-ink); line-height: 1.05; }
    .result-split { display: flex; flex-direction: column; gap: 0.55rem; }
    .split-item { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.5rem; }
    .split-label { font-size: 0.85rem; color: var(--text-soft); }
    .split-val { font-weight: 700; font-size: 0.98rem; }
    .table-block { margin-top: 2.5rem; }
    .table-block h2, .prose-block h2, .faq-block h2 { font-size: var(--step-2); margin: 0 0 0.7rem; }
    .rate-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .rate-table :global(th), .rate-table :global(td) { text-align: left; padding: 0.55rem 0.5rem; border-bottom: 1px solid var(--border); }
    .rate-table :global(th) { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
    .table-note { font-size: 0.82rem; color: var(--text-muted); margin: 0.7rem 0 0; }
    .prose-block, .faq-block { margin-top: 2.5rem; }
    .prose-block p { color: var(--text-soft); line-height: 1.7; }
    .cta-line { background: var(--surface); padding: 0.9rem 1.1rem; border-radius: var(--radius-sm); border-left: 3px solid var(--brand-2); }
    .faq-block details { border-bottom: 1px solid var(--border); padding: 0.9rem 0; }
    .faq-block summary { font-weight: 600; cursor: pointer; color: var(--text); list-style: none; }
    .faq-block summary::-webkit-details-marker { display: none; }
    .faq-block summary::after { content: '+'; float: right; color: var(--brand-2); font-weight: 700; }
    .faq-block details[open] summary::after { content: '−'; }
    .faq-block details p { color: var(--text-soft); line-height: 1.7; margin: 0.7rem 0 0; }
    .disclaimer { font-size: 0.8rem; color: var(--text-muted); margin: 2rem 0; line-height: 1.5; }
    @media (max-width: 600px) { .calc-grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
