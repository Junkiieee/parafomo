    .faq-block details p { color: var(--text-soft); line-height: 1.7; margin: 0.7rem 0 0; }
    .source-block ul { margin: 0; padding-left: 1.1rem; }
    .source-block li { font-size: 0.85rem; color: var(--text-soft); line-height: 1.6; margin-bottom: 0.35rem; }

    @media (max-width: 680px) {
