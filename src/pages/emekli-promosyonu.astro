---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import P from '../../data/emekli-promosyon.json';
import em from '../../data/emekli-memur.json';

const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const tr = (iso: string) => {
  const d = new Date(iso + 'T12:00:00Z');
  return `${d.getUTCDate()} ${AYLAR[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
};
const fmt = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));
const kontrol = new Date(P.kontrol + 'T12:00:00Z');
const ayYil = `${AYLAR[kontrol.getUTCMonth()]} ${kontrol.getUTCFullYear()}`;
const today = new Date().toISOString().slice(0, 10);

type Banka = (typeof P.bankalar)[number];
const aktif = (b: Banka) => !b.bitis || b.bitis >= today;
const toplam = (b: Banka, i: number) => (b.nakit[i] ?? 0) + (b.ek ? b.ek[i] : 0);
const UST = 3; // 20.000 ₺ ve üzeri dilimi
const bankalar = [...P.bankalar].sort((a, b) =>
  Number(aktif(b)) - Number(aktif(a)) || (b.nakit[UST] ?? 0) - (a.nakit[UST] ?? 0) || toplam(b, UST) - toplam(a, UST));
const aktifler = bankalar.filter(aktif);
const enNakit = aktifler.reduce((m, b) => ((b.nakit[UST] ?? 0) > (m.nakit[UST] ?? 0) ? b : m), aktifler[0]);
const enToplam = aktifler.reduce((m, b) => (toplam(b, UST) > toplam(m, UST) ? b : m), aktifler[0]);
const kamuUst = Math.max(...aktifler.filter((b) => b.tur === 'kamu').map((b) => b.nakit[UST] ?? 0));
const taban = em.enDusukEmekliAyligi.tutar;
const sure = (b: Banka) => (b.bitis ? `${b.baslangic ? tr(b.baslangic) + ' – ' : ''}${tr(b.bitis)}` : b.baslangic ? `${tr(b.baslangic)} itibarıyla, bitiş yazılı değil` : 'süre yazılı değil');

const faq = [
  {
    q: `En yüksek emekli promosyonu hangi bankada (${ayYil})?`,
    a: `Bankaların resmi sayfalarına göre (${tr(P.kontrol)} kontrolü) 20.000 ₺ ve üzeri aylıkta en yüksek koşulsuz nakit promosyon ${fmt(enNakit.nakit[UST] ?? 0)} ₺ (${enNakit.banka}). Fatura talimatı, kart harcaması gibi ek koşullarla en yüksek toplam ${fmt(toplam(enToplam, UST))} ₺ (${enToplam.banka}). Kamu bankaları (Ziraat, Halkbank) en üst dilimde ${fmt(kamuUst)} ₺ ödüyor ve ürün koşulu aramıyor. Bu bir sıralamadır, tavsiye değildir; ek ödüllerin şartlarını bankanın sayfasından okuyun.`,
  },
  {
    q: 'Emekli promosyonu kaç yıllık ödenir?',
    a: 'Promosyon, maaşınızı 3 yıl boyunca aynı bankadan alma taahhüdü karşılığında 3 yıllık tutar olarak peşin ödenir. Taahhüt süresi promosyonun hesaba geçtiği gün başlar.',
  },
  {
    q: 'Maaşımı başka bankaya taşırsam promosyonu iade eder miyim?',
    a: 'Evet. Yapı Kredi, Akbank, Garanti BBVA ve DenizBank sözleşme metinlerine göre 3 yıl dolmadan maaş başka bankaya taşınırsa ya da aylık kesilirse, ödenen promosyonun kalan süreye düşen kısmı kıst esasıyla (gün hesabıyla) yazılı bildirim gerekmeden geri alınır. Vefat halinde iade istenmez (Akbank, Garanti BBVA). Ek ödüllerde ürün iptal edilirse o ürünün ödülü de geri alınabilir.',
  },
  {
    q: 'Emekli promosyonu ne zaman yatar?',
    a: 'Taahhüt verildikten sonra ilk emekli maaşı yeni bankaya yatınca ödenir: Akbank, Garanti BBVA ve QNB 3 iş günü, DenizBank 2 iş günü içinde ödediğini yazıyor. Ek ödüller koşul gerçekleştikten sonra (çoğunlukla sonraki ay) yüklenir.',
  },
  {
    q: 'Hangi promosyon dilimindeyim?',
    a: `Dilim, bankanın kendi tanımına göre aylık tutarınızdır (çoğu banka net aylık, Halkbank brüt maaş diyor; haciz ve nafaka kesintisi düşülebilir). Birden fazla aylık alıyorsanız aynı bankada toplanır. Temmuz 2026'dan beri en düşük SSK/Bağ-Kur emekli aylığı ${fmt(taban)} ₺ olduğu için tam aylık alan emekliler genellikle 20.000 ₺ ve üzeri dilime girer; alt dilimler çoğunlukla hisseli dul-yetim aylıkları içindir.`,
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'En Düşük Emekli Maaşı', url: '/en-dusuk-emekli-maasi/' },
  { name: 'Emekli Promosyonu', url: '/emekli-promosyonu/' },
];
---

<BaseLayout
  title={`Emekli Promosyonu ${ayYil}: Banka Banka Güncel Tutarlar`}
  description={`Emekli promosyonu ${ayYil}: en yüksek koşulsuz nakit ${fmt(enNakit.nakit[UST] ?? 0)} ₺ (${enNakit.banka}), ek ödüllerle ${fmt(toplam(enToplam, UST))} ₺'ye kadar. ${P.bankalar.length} bankanın resmi tutarları ve hesaplama.`}
  faq={faq}
  breadcrumbs={breadcrumbs}
  image="/og/emekli-promosyonu.png"
>
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Emekli · Maaş Promosyonu</p>
      <h1>Emekli Promosyonu {ayYil}: Banka Banka Tutarlar</h1>
      <p class="lede">
        20.000 ₺ ve üzeri aylıkta koşulsuz nakit promosyon <strong>{fmt(kamuUst)} – {fmt(enNakit.nakit[UST] ?? 0)} ₺</strong>,
        fatura talimatı ve kart harcaması gibi ek koşullarla <strong>{fmt(toplam(enToplam, UST))} ₺</strong>'ye kadar.
        Tutarlar yalnız bankaların kendi sayfalarından alındı · son kontrol {tr(P.kontrol)}.
      </p>
    </header>

    <div class="stats">
      <div class="stat"><span class="k">En yüksek koşulsuz nakit</span><span class="v">₺{fmt(enNakit.nakit[UST] ?? 0)}</span><span class="s">{enNakit.banka} · 20.000 ₺+ aylık</span></div>
      <div class="stat"><span class="k">Ek ödüllerle en yüksek toplam</span><span class="v">₺{fmt(toplam(enToplam, UST))}</span><span class="s">{enToplam.banka} · koşullar sağlanırsa</span></div>
      <div class="stat"><span class="k">Kamu bankaları (ürün koşulsuz)</span><span class="v">₺{fmt(kamuUst)}</span><span class="s">Ziraat, Halkbank · 20.000 ₺+ aylık</span></div>
    </div>

    <section class="table-block">
      <h2>Maaşına göre promosyon hesaplama</h2>
      <div class="calc-grid">
        <form class="calc-inputs" autocomplete="off">
          <label>
            <span>Aylık emekli maaşı (₺)</span>
            <input id="in-maas" type="number" inputmode="numeric" min="0" step="100" value={taban} />
          </label>
          <p class="hint">Birden fazla aylık alıyorsan toplamını yaz. Varsayılan: en düşük emekli aylığı ({fmt(taban)} ₺).</p>
        </form>
        <div class="calc-results" aria-live="polite">
          <div class="result-main">
            <span class="result-label">Dilimin</span>
            <span class="result-value small" id="out-dilim">{P.dilimler[UST]}</span>
          </div>
          <p class="result-note">Koşulsuz nakit en yüksek: <strong id="out-best"></strong></p>
        </div>
      </div>
      <table class="rate-table">
        <thead><tr><th>Banka</th><th>Koşulsuz nakit</th><th>Ek ödül (en fazla)</th><th>Toplam</th></tr></thead>
        <tbody id="calc-body"></tbody>
      </table>
      <p class="table-note">Ek ödül; fatura talimatı, kredi kartı harcaması, hesap/kredi/sigorta gibi koşullara bağlıdır ve tamamı her müşteriye uymayabilir.</p>
    </section>

    <section class="table-block">
      <h2>Banka banka emekli promosyonu tablosu</h2>
      <div class="table-scroll">
        <table class="rate-table wide">
          <thead>
            <tr><th>Banka</th>{P.dilimler.map((d) => <th>{d}</th>)}<th>Kampanya süresi</th></tr>
          </thead>
          <tbody>
            {bankalar.map((b) => (
              <tr class={aktif(b) ? '' : 'expired'}>
                <td><a href={b.url} rel="nofollow noopener" target="_blank">{b.banka}</a><small>{b.tur === 'kamu' ? 'kamu' : 'özel'} · {b.maas}</small></td>
                {b.nakit.map((n, i) => (
                  <td>{n == null ? '—' : `₺${fmt(n)}`}{b.ek && <small>+ ₺{fmt(b.ek[i])} ek</small>}</td>
                ))}
                <td><small>{aktif(b) ? sure(b) : `süresi doldu (${tr(b.bitis!)}) — yeni kampanya kontrol ediliyor`}</small></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Kaynak: her bankanın resmi emekli promosyonu sayfası (banka adına tıkla), kontrol {tr(P.kontrol)}. Sıra: 20.000 ₺+ dilimindeki
        koşulsuz nakit tutar. Resmi sayfasında güncel nakit tutar bulamadığımız bankalar (VakıfBank, İş Bankası) tabloya alınmadı.
        Halkbank tutarı brüt maaşa göre; 10.000 ₺ altında yalnız ölüm aylığı alanlara 5.000 ₺. Kampanyalar sık değişir;
        başvurmadan önce bankanın güncel koşullarını okuyun.
      </p>
    </section>

    <section class="prose-block">
      <h2>Emekli promosyonu nasıl alınır?</h2>
      <p>
        Promosyon, SGK ile bankalar arasındaki protokole göre ödenir: maaşınızı 3 yıl boyunca o bankadan alacağınızı
        taahhüt edersiniz, banka da 3 yıllık promosyonu peşin öder. Kamu bankalarının tutarları (5.000 – 12.000 ₺), Akbank'ın
        sayfasında "SGK promosyonu" diye ayrı gösterilen dilimlerle aynıdır; özel bankalar bunun üstüne kendi ek nakdini ve
        koşullu ödüllerini ekler.
      </p>
      <ol>
        <li><strong>Bankayı seçin ve dilime bakın.</strong> Dilimi bankanın tanımladığı aylık belirler; birden fazla aylık aynı bankada toplanır.</li>
        <li><strong>Maaşı taşıyın.</strong> Taşıma başvurusu yeni bankanın mobil uygulaması, şubesi ya da e-Devlet üzerinden yapılır.</li>
        <li><strong>Promosyon taahhütnamesini onaylayın.</strong> Ek ödül istiyorsanız ürün başvurularını (kart, fatura talimatı) kampanya süresi içinde yapın.</li>
        <li><strong>İlk maaş yatınca promosyon gelir.</strong> Bankalar 2-3 iş günü içinde öder; ek ödüller koşul gerçekleşince yüklenir.</li>
      </ol>
      <h2>Erken ayrılırsanız: kıst iade</h2>
      <p>
        3 yıl dolmadan maaşınızı başka bankaya taşırsanız, ödenen promosyonun kalan süreye düşen kısmı kıst esasıyla geri
        alınır. Örneğin 15.000 ₺ promosyon alıp 18. ayda ayrılan emekliden yaklaşık yarısı (≈7.500 ₺) istenir. Yeni bankanın
        promosyonu bu iadeyi karşılıyorsa taşıma hâlâ mantıklı olabilir; iki tutarı karşılaştırın.
      </p>
      <p class="cta-line">
        Taban aylık ve ödeme günleri → <a href="/en-dusuk-emekli-maasi/">en düşük emekli maaşı</a>.
        Ocak 2027'de maaşın ne olacak → <a href="/emekli-zammi-hesaplama/">emekli zammı hesaplama</a>.
        Bayramdan önce ek ödeme → <a href="/bayram-ikramiyesi/">bayram ikramiyesi</a>.
      </p>
    </section>

    <section class="faq-block">
      <h2>Sıkça Sorulan Sorular</h2>
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>

    <Newsletter />
  </div>

  <script is:inline define:vars={{ BANKS: aktifler.map((b) => ({ ad: b.banka, url: b.url, nakit: b.nakit, ek: b.ek })), ALT: P.dilimAlt, DILIM: P.dilimler }}>
    (function () {
      const nf0 = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
      const tl = (n) => '₺' + nf0.format(n);
      const inp = document.getElementById('in-maas');
      const body = document.getElementById('calc-body');
      const upd = () => {
        const m = Math.max(0, +inp.value || 0);
        let i = 0;
        ALT.forEach((a, k) => { if (m >= a) i = k; });
        document.getElementById('out-dilim').textContent = DILIM[i];
        const rows = BANKS.map((b) => ({ b, n: b.nakit[i], e: b.ek ? b.ek[i] : 0 }))
          .filter((r) => r.n != null)
          .sort((x, y) => y.n - x.n || (y.n + y.e) - (x.n + x.e));
        document.getElementById('out-best').textContent = rows.length ? tl(rows[0].n) + ' (' + rows[0].b.ad + ')' : '—';
        body.innerHTML = rows.map((r) => '<tr><td>' + r.b.ad + '</td><td>' + tl(r.n) + '</td><td>' + (r.e ? '+' + tl(r.e) : '—') +
          '</td><td><strong>' + tl(r.n + r.e) + '</strong></td></tr>').join('');
      };
      inp.addEventListener('input', upd);
      upd();
    })();
  </script>

  <style>
    .calc-wrap { max-width: 860px; margin: 0 auto; padding: 2.5rem 1.1rem 4rem; }
    .calc-head { text-align: center; margin-bottom: 1.6rem; }
    .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; font-weight: 700; color: var(--brand-deep); margin: 0 0 0.4rem; }
    .calc-head h1 { font-size: var(--step-4); margin: 0 0 0.6rem; line-height: 1.1; }
    .lede { color: var(--text-soft); font-size: var(--step-1); max-width: 660px; margin: 0 auto; }
    .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
    .stat { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; display: flex; flex-direction: column; gap: 0.2rem; box-shadow: var(--shadow-soft); }
    .stat .k { font-size: 0.8rem; color: var(--text-soft); font-weight: 600; }
    .stat .v { font-family: var(--font-serif); font-size: 1.9rem; font-weight: 600; color: var(--brand-ink); line-height: 1.1; font-variant-numeric: tabular-nums; }
    .stat .s { font-size: 0.78rem; color: var(--text-muted); }
    .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.4rem; box-shadow: var(--shadow-soft); margin-bottom: 1rem; }
    .calc-inputs { display: flex; flex-direction: column; justify-content: center; gap: 0.6rem; margin: 0; }
    .calc-inputs label { display: flex; flex-direction: column; gap: 0.35rem; }
    .calc-inputs span { font-size: 0.85rem; font-weight: 600; color: var(--text-soft); }
    .calc-inputs input { font-family: var(--font-sans); font-size: 1.05rem; font-weight: 600; color: var(--text); padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg); width: 100%; }
    .hint { font-size: 0.8rem; color: var(--text-muted); margin: 0; }
    .calc-results { display: flex; flex-direction: column; justify-content: center; gap: 0.6rem; background: var(--brand-tint); border-radius: var(--radius); padding: 1.2rem; }
    .result-label { font-size: 0.85rem; color: var(--text-soft); font-weight: 600; display: block; }
    .result-value { font-family: var(--font-serif); font-size: clamp(1.4rem, 1.1rem + 1.4vw, 1.9rem); font-weight: 600; color: var(--brand-ink); line-height: 1.1; }
    .result-note { font-size: 0.9rem; color: var(--brand-ink); margin: 0; }
    .table-block { margin-top: 2.5rem; }
    .table-block h2 { font-size: var(--step-2); margin: 0 0 0.8rem; }
    .table-scroll { overflow-x: auto; }
    .rate-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
    .rate-table th, .rate-table td { text-align: left; padding: 0.55rem 0.5rem; border-bottom: 1px solid var(--border); vertical-align: top; }
    .rate-table th { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
    .rate-table td small { display: block; font-size: 0.74rem; color: var(--text-muted); }
    .rate-table.wide { min-width: 680px; }
    .rate-table tr.expired td { opacity: 0.55; }
    .table-note { font-size: 0.82rem; color: var(--text-muted); margin: 0.7rem 0 0; line-height: 1.5; }
    .prose-block, .faq-block { margin-top: 2.5rem; }
    .prose-block h2, .faq-block h2 { font-size: var(--step-2); margin: 1.6rem 0 0.8rem; }
    .prose-block p, .prose-block li { color: var(--text-soft); line-height: 1.7; }
    .cta-line { background: var(--surface); padding: 0.9rem 1.1rem; border-radius: var(--radius-sm); border-left: 3px solid var(--brand-2); }
    .faq-block details { border-bottom: 1px solid var(--border); padding: 0.9rem 0; }
    .faq-block summary { font-weight: 600; cursor: pointer; color: var(--text); list-style: none; }
    .faq-block summary::-webkit-details-marker { display: none; }
    .faq-block summary::after { content: '+'; float: right; color: var(--brand-2); font-weight: 700; }
    .faq-block details[open] summary::after { content: '−'; }
    .faq-block details p { color: var(--text-soft); line-height: 1.7; margin: 0.7rem 0 0; }
    @media (max-width: 680px) { .stats, .calc-grid { grid-template-columns: 1fr; } .rate-table { font-size: 0.85rem; } }
  </style>
</BaseLayout>
