  <script
    is:inline
    define:vars={{
      D: { ilk: T.ilk, ikinci: T.ikinciAylik, ucuncu: T.ucuncuAylik, max: MAXAY, ilkAy: ILKAY, kapsam: dy.kapsamBaslangic, ssr: BUGUN },
    }}
  >
    (function () {
      const $ = (id) => document.getElementById(id);
      const AY = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
      const nf0 = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
      const tl = (n) => nf0.format(n) + ' TL';
      const idxAd = (i) => AY[i % 12] + ' ' + Math.floor(i / 12);
      const tarihAd = (d) => d.getDate() + ' ' + AY[d.getMonth()] + ' ' + d.getFullYear();
      const pad = (n) => String(n).padStart(2, '0');
      const iso = (d) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
      const parse = (v) => {
        const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v || '');
        return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null;
      };
      const inSira = $('in-sira');
      const inDogum = $('in-dogum');
      const inBas = $('in-basvuru');
      const set = (id, v) => { $(id).textContent = v; };

      // Sayfa derlendiği günün tarihi duruyorsa (form geri yüklenmediyse) bugüne çek
      if (inDogum.value === D.ssr && inBas.value === D.ssr) {
        const t = iso(new Date());
        inDogum.value = t;
        inBas.value = t;
      }

      function bos(msg) {
        set('out-toplam', '0 TL');
        set('out-sekil', '—');
        set('out-sayi', '—');
        set('out-bas', '—');
        set('out-son', '—');
        set('out-ilk', '—');
        set('out-note', msg);
        $('yil-wrap').hidden = true;
      }

      function update() {
        const sira = inSira.value;
        const ilkMi = sira === '1';
        $('lbl-bas').textContent = ilkMi ? 'Başvuru ayı' : 'Hak başlangıcı (başvuru ayı)';
        $('lbl-son').textContent = ilkMi ? 'Son başvuru tarihi' : 'Son ödeme ayı (çocuğun 60. ayı)';
        const b = parse(inDogum.value);
        if (!b) return bos('Doğum tarihini girin.');
        if (inDogum.value < D.kapsam) {
          return bos('1 Ocak 2025’ten önce doğan çocuklar için bu doğum yardımı ödenmez; eski sistemde başvuru süresi 1 Haziran 2025’te doldu.');
        }
        let a = parse(inBas.value);
        let erken = false;
        if (!a || a < b) { a = b; erken = !!parse(inBas.value); }
        const bIdx = b.getFullYear() * 12 + b.getMonth();
        const aIdx = a.getFullYear() * 12 + a.getMonth();
        const not = [];
        if (erken) not.push('Başvuru doğumdan önce yapılamaz; hesap doğum tarihine göre yapıldı.');

        if (ilkMi) {
          const son = new Date(b.getFullYear(), b.getMonth() + D.ilkAy, b.getDate());
          $('yil-wrap').hidden = true;
          if (a > son) {
            set('out-toplam', '0 TL');
            set('out-sekil', 'Tek seferlik ' + tl(D.ilk));
            set('out-sayi', '—');
            set('out-bas', idxAd(aIdx));
            set('out-son', tarihAd(son));
            set('out-ilk', '—');
            not.push('İlk çocuk için başvuru süresi doğumdan sonraki ' + D.ilkAy + ' aydır; bu tarihte süre dolmuş olur.');
          } else {
            set('out-toplam', tl(D.ilk));
            set('out-sekil', 'Tek seferlik');
            set('out-sayi', '1 ödeme');
            set('out-bas', idxAd(aIdx));
            set('out-son', tarihAd(son));
            set('out-ilk', idxAd(aIdx + 1) + ' son haftası');
            not.push('İlk çocuk için ' + tl(D.ilk) + ' bir kez ödenir. Para 6 ay içinde çekilmezse iade edilir; çocuk 12. ayını doldurmadan yeniden başvurulabilir.');
          }
          set('out-note', not.join(' '));
          return;
        }

        const aylik = sira === '2' ? D.ikinci : D.ucuncu;
        const sonIdx = bIdx + D.max - 1;
        const besYas = new Date(b.getFullYear() + 5, b.getMonth(), b.getDate());
        const n = a < besYas ? Math.max(0, Math.min(D.max, sonIdx - aIdx + 1)) : 0;
        set('out-toplam', tl(n * aylik));
        set('out-sekil', 'Aylık ' + tl(aylik));
        set('out-sayi', n + ' ay');
        set('out-bas', n ? idxAd(aIdx) : '—');
        set('out-son', idxAd(sonIdx));
        set('out-ilk', n ? idxAd(aIdx + 1) + ' son haftası' : '—');
        if (!n) {
          not.push('Çocuk 5 yaşını doldurduğu için (son başvuru ' + tarihAd(besYas) + ' öncesi) bu tarihte ödeme alınamaz.');
        } else if (n === D.max) {
          not.push('Doğum ayında başvurduğunuz için ' + D.max + ' ödemenin tamamını alırsınız. Son başvuru: ' + tarihAd(besYas) + ' (5. yaş günü) öncesi.');
        } else {
          const kayip = D.max - n;
          not.push('Başvuru doğumdan ' + kayip + ' ay sonra yapıldığı için ' + kayip + ' aylık ödeme (' + tl(kayip * aylik) + ') kaybedilir; yardım geçmişe dönük ödenmez.');
        }
        set('out-note', not.join(' '));

        const satir = [];
        for (let i = aIdx; n && i <= sonIdx; i++) {
          const y = Math.floor(i / 12);
          const r = satir.find((s) => s[0] === y);
          if (r) r[1]++;
          else satir.push([y, 1]);
        }
        $('out-yil').innerHTML = satir.map((s) => '<tr><td>' + s[0] + '</td><td>' + s[1] + ' ay</td><td>' + tl(s[1] * aylik) + '</td></tr>').join('');
        $('yil-wrap').hidden = !n;
      }

      [inSira, inDogum, inBas].forEach((el) => el.addEventListener('input', update));
      update();
    })();
  </script>

