---
import BaseLayout from '../layouts/BaseLayout.astro';
import { existsSync as __exists } from 'node:fs';
import { join as __join } from 'node:path';
const hasEngelli = __exists(__join(process.cwd(), 'src', 'pages', 'engelli-maasi.astro'));
import Newsletter from '../components/Newsletter.astro';
import yd from '../../data/yeniden-degerleme.json';
import dy from '../../data/dogum-yardimi-2026.json';

// Doğum yardımı — 633 sayılı KHK ek md. 4 (7546 s. K. md. 14 ile değişik, RG 30.03.2025/32857) ve Doğum Yardımı
// Yönetmeliği (CB Kararı 9721, RG 10.04.2025/32866); mevzuat.gov.tr güncel metinleri 2026-10-18’de okundu.
// Yönetmelik: md. 5 şartlar, md. 6 başvuru süresi (ilk çocuk 12 ay, diğerleri 5 yaş), md. 7 (15 gün), md. 8 çocuk
// sırası, md. 9 (başvuru ayından itibaren ödenir; tutarlar), md. 10 itiraz (30 gün), md. 11 kesilme / 6 ay çekilmeme /
// 60. ay dahil sonlandırma. Ödeme günü: ASHB SSS (“onay tarihini takip eden ayın son haftası”, Halkbank) + aylık duyurular.
// TUTARLAR KANUNDA SABİT: otomatik endeks yok. Cumhurbaşkanı VUK yeniden değerleme oranını GEÇMEMEK üzere artırabilir
// (zorunlu değil; 2026’da kullanılmadı — ASHB 30.09.2026 duyurusu tutarları aynen veriyor). Bu yüzden gelecek yıl için
// tahmin değil yalnızca yasal TAVAN gösterilir: tutar × (1 + (tebligOrani ?? onikiAyOrt)), kuruşa aşağı.
// Takvim hesabı: doğum ayı çocuğun 1. ayı sayılır → son hak ayı = doğum ayı + 59 (en fazla 60 ödeme, “60 ay” ile uyumlu).

const Y: number = dy.yil;
const HEDEF = Y + 1;
const T = dy.tutar;
const MAXAY: number = dy.azamiAy;
const ILKAY: number = dy.ilkCocukBasvuruAy;
const max2 = T.ikinciAylik * MAXAY;
const max3 = T.ucuncuAylik * MAXAY;

// Gelecek yıl tavanı (yalnızca üst sınır)
const tavanVar = yd.hedefYil === HEDEF;
const teblig = yd.tebligOrani as number | null;
const oran: number = teblig ?? yd.onikiAyOrt;
const durum: 'teblig' | 'hesap' | 'tahmin' = teblig ? 'teblig' : yd.ekimVerisiGeldi ? 'hesap' : 'tahmin';
const bp = Math.round(oran * 100);
const tavanla = (v: number) => Math.floor((v * (10000 + bp)) / 100) / 100; // kuruşa aşağı: oranı aşmaz
const TV = { ilk: tavanla(T.ilk), ikinci: tavanla(T.ikinciAylik), ucuncu: tavanla(T.ucuncuAylik) };
const ydBuYil = (yd.gecmis as { uygulamaYili: number; oran: number }[]).find((g) => g.uygulamaYili === Y)?.oran;
const approx = durum === 'tahmin' ? '≈' : '';

const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const GUN = ['Pazar', 'Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi'];
const fmt = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));
const fmt2 = (n: number) =>
  new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const nf2 = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const tl = (n: number) => `${fmt(n)} TL`;
const trTarih = (iso: string, gun = false) => {
  const d = new Date(iso + 'T12:00:00Z');
  return `${d.getUTCDate()} ${AYLAR[d.getUTCMonth()]} ${d.getUTCFullYear()}${gun ? ' ' + GUN[d.getUTCDay()] : ''}`;
};
const ayAdi = (k: string) => `${AYLAR[+k.slice(5, 7) - 1]} ${k.slice(0, 4)}`;
const idxAd = (i: number) => `${AYLAR[i % 12]} ${Math.floor(i / 12)}`;
const oranTxt = (durum === 'tahmin' ? '≈%' : '%') + nf2(oran);
const sonAyAdi = ayAdi(yd.sonAy);
const sa = (yd as { sonrakiAciklama?: string }).sonrakiAciklama;
const sonrakiTxt = sa ? `${+sa.slice(8, 10)} ${AYLAR[+sa.slice(5, 7) - 1]}` : 'Kasım başında';
const oranAciklama =
  durum === 'tahmin'
    ? `${sonAyAdi} verisiyle tahmini ${oranTxt}; oran ${sonrakiTxt} günü netleşir`
    : durum === 'hesap'
      ? `kesinleşen ${oranTxt}; VUK tebliği Kasım sonunda`
      : `VUK tebliğindeki ${oranTxt}`;

// Ödeme tarihleri (ASHB aylık duyuruları)
type Odeme = { ay: string; tarih: string; not?: string };
const OD = dy.odemeler as Odeme[];
const sonOdeme = OD[OD.length - 1];
const gunler = OD.map((o) => +o.tarih.slice(8, 10));
const minGun = Math.min(...gunler);
const maxGun = Math.max(...gunler);
const ST = dy.istatistik;
const EM = dy.emzirme;
const IZ = dy.izin;
const ES = dy.eski;
const dogrulamaTxt = trTarih(dy.dogrulama);

// Hesaplayıcı varsayılanı: bugün doğan ikinci çocuk, doğum ayında başvuru (JS tarayıcıda bugüne göre yeniden hesaplar)
const pad = (n: number) => String(n).padStart(2, '0');
const trSimdi = new Date(Date.now() + 3 * 3600 * 1000);
const BUGUN = `${trSimdi.getUTCFullYear()}-${pad(trSimdi.getUTCMonth() + 1)}-${pad(trSimdi.getUTCDate())}`;
const bugunIdx = trSimdi.getUTCFullYear() * 12 + trSimdi.getUTCMonth();
const sonIdx0 = bugunIdx + MAXAY - 1;
const yil0: [number, number][] = [];
for (let i = bugunIdx; i <= sonIdx0; i++) {
  const yy = Math.floor(i / 12);
  const r = yil0.find((x) => x[0] === yy);
  if (r) r[1]++;
  else yil0.push([yy, 1]);
}

const faq = [
  {
    q: `Doğum yardımı ne kadar ${Y}?`,
    a: `${Y}’da doğum yardımı, 1 Ocak 2025 ve sonrasında doğan çocuklar için ilk çocukta tek seferlik ${tl(T.ilk)}, ikinci çocukta aylık ${tl(T.ikinciAylik)}, üçüncü ve sonraki her çocukta aylık ${tl(T.ucuncuAylik)}. Aylık ödemeler başvuru ayından çocuk 5 yaşını tamamlayana kadar, en fazla ${MAXAY} ay sürer; doğum ayında başvurulursa ikinci çocukta toplam ${tl(max2)}, üçüncü ve sonraki çocukta ${tl(max3)} eder. Tutarlar 2025’teki düzenlemeden bu yana değişmedi.`,
  },
  {
    q: 'Doğum yardımı ne zaman yatar?',
    a: `Başvuru onaylandıktan sonra ilk ödeme, onay tarihini izleyen ayın son haftasında yapılır; aylık ödemeler de her ayın son haftasında Halkbank aracılığıyla hesaba geçer. ${Y}’da ödemeler ayın ${minGun}. ile ${maxGun}. günleri arasında yatırıldı; son olarak ${ayAdi(sonOdeme.ay)} ödemesi ${trTarih(sonOdeme.tarih, true)} günü yattı. Ödemenin yatıp yatmadığını e-Devlet’te ve “İlk Öğretmenim Ailem” uygulamasında görebilirsiniz.`,
  },
  {
    q: 'İkinci çocuk doğum yardımı ne kadar?',
    a: `İkinci çocuk için başvurunun yapıldığı aydan itibaren çocuk 5 yaşını tamamlayana kadar (60. ay dahil) her ay ${tl(T.ikinciAylik)} ödenir. Doğduğu ay başvurursanız ${MAXAY} ödemeyle toplam ${tl(max2)} alırsınız; geç kalınan her ay bir aylık ödeme kaybı demektir. Sıra annenin daha önce canlı doğurduğu çocuklara göre belirlenir: ilk çocuğunuz 2025’ten önce doğduysa yeni bebeğiniz ikinci çocuk sayılır.`,
  },
  {
    q: 'Doğum yardımı başvurusu nasıl yapılır?',
    a: `Bebeğin nüfus kaydı tamamlandıktan sonra e-Devlet’te Aile ve Sosyal Hizmetler Bakanlığı’nın “Doğum Yardımı Başvuru” hizmetinden ya da “İlk Öğretmenim Ailem” mobil uygulamasından başvurulur. Anne Türk vatandaşıysa başvuruyu anne ya da anne adına baba yapar; anne yabancı uyrukluysa veya vefat etmişse Türk vatandaşı baba ya da çocuğun kanuni temsilcisi başvurur. Başvuru en geç ${dy.sonucGun} gün içinde sonuçlanır. Süre ilk çocukta doğumdan sonraki ${ILKAY} ay, diğer çocuklarda 5 yaşın dolmasına kadardır. e-Devlet kullanamayanlar il müdürlüklerinden ve sosyal hizmet merkezlerinden destek alabilir.`,
  },
  {
    q: 'Doğum yardımı şartları neler, gelir sınırı var mı?',
    a: 'Çocuğun 1 Ocak 2025 veya sonrasında canlı doğmuş olması, anne ya da babanın (veya ikisinin) Türk vatandaşı olması, Türkiye’de ikamet edilmesi ve usulüne uygun başvuru yapılması gerekir; çocuk başvuru tarihinde sağ ve Türk vatandaşı olmalıdır. Gelir sınırı, muhtaçlık, çalışma ya da SGK prim şartı yoktur; resmî nikâh da aranmaz. Yardım vergi ve kesintiye tabi değildir, borç için haczedilemez. 2025’ten önce doğan çocuklar için bu yardım ödenmez.',
  },
  ...(tavanVar
    ? [
        {
          q: `${HEDEF}’de doğum yardımı artacak mı?`,
          a: `Şimdilik bir artış kararı yok. Tutarlar kanunda sabit yazılıdır ve kendiliğinden artmaz; Cumhurbaşkanı bunları yeniden değerleme oranını geçmemek üzere artırmaya yetkilidir ama bu zorunlu değildir: ${Y}’da yetki kullanılmadı. ${HEDEF} için oranın tamamı uygulanırsa (${oranAciklama}) üst sınır ilk çocukta ${approx}${fmt2(TV.ilk)} TL, ikinci çocukta aylık ${approx}${fmt2(TV.ikinci)} TL, üçüncü ve sonraki çocukta aylık ${approx}${fmt2(TV.ucuncu)} TL olur. Bu bir tahmin değil, yasal tavandır.`,
        },
      ]
    : []),
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Hesaplama Araçları', url: '/hesaplama-araclari/' },
  { name: `Doğum Yardımı ${Y}`, url: '/dogum-yardimi/' },
];

const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Doğum yardımı tutarları ve ödeme tarihleri ${Y}`,
  description: `Aile ve Sosyal Hizmetler Bakanlığı doğum yardımı: çocuk sırasına göre tutarlar (ilk çocuk ${tl(T.ilk)} tek seferlik, ikinci çocuk aylık ${tl(T.ikinciAylik)}, üçüncü ve sonraki aylık ${tl(T.ucuncuAylik)}), en fazla ${MAXAY} aylık süre, ${Y} aylık ödeme tarihleri ve yeniden değerleme oranına göre ${HEDEF} yasal artış tavanı.`,
  url: 'https://parafomo.com/dogum-yardimi/',
  dateModified: dy.dogrulama,
  creator: { '@type': 'Organization', name: 'ParaFOMO', url: 'https://parafomo.com/' },
  isBasedOn: 'https://www.mevzuat.gov.tr/MevzuatMetin/21.5.9721.pdf',
  license: 'https://creativecommons.org/licenses/by/4.0/',
};
---

<BaseLayout
  title={`Doğum Yardımı ${Y} Ne Kadar? Ne Zaman Yatar, Hesaplama`}
  description={`Doğum yardımı ${Y}: ilk çocuğa ${tl(T.ilk)}, ikinci çocuğa aylık ${tl(T.ikinciAylik)}, üçüncüye aylık ${tl(T.ucuncuAylik)} (${MAXAY} ay). Ne zaman yatar, şartlar, başvuru, hesaplama.`}
  faq={faq}
  breadcrumbs={breadcrumbs}
  image="/og/dogum-yardimi.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(dataset)} />
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Aile · Sosyal Destek</p>
      <h1>Doğum Yardımı {Y}: Ne Kadar, Ne Zaman Yatar?</h1>
      <p class="lede">
        1 Ocak 2025 ve sonrasında doğan çocuklar için Aile ve Sosyal Hizmetler Bakanlığı ilk çocukta
        <strong>tek seferlik {tl(T.ilk)}</strong>, ikinci çocukta <strong>aylık {tl(T.ikinciAylik)}</strong>, üçüncü ve
        sonraki çocuklarda <strong>aylık {tl(T.ucuncuAylik)}</strong> öder. Aylık ödemeler çocuk 5 yaşını tamamlayana
        kadar, en fazla {MAXAY} ay sürer.
      </p>
    </header>

    <div class="kpi-row">
      <div class="kpi">
        <span class="kpi-label">1. çocuk</span>
        <span class="kpi-val">{tl(T.ilk)}</span>
        <span class="kpi-sub">tek seferlik · doğumdan sonraki {ILKAY} ay içinde başvuru</span>
      </div>
      <div class="kpi">
        <span class="kpi-label">2. çocuk</span>
        <span class="kpi-val">{tl(T.ikinciAylik)}<small>/ay</small></span>
        <span class="kpi-sub">{MAXAY} aya kadar · en fazla {tl(max2)}</span>
      </div>
      <div class="kpi">
        <span class="kpi-label">3. ve sonraki çocuk</span>
        <span class="kpi-val">{tl(T.ucuncuAylik)}<small>/ay</small></span>
        <span class="kpi-sub">{MAXAY} aya kadar · en fazla {tl(max3)}</span>
      </div>
    </div>

    <section class="table-block" id="hesaplama">
      <h2>Doğum yardımı hesaplama</h2>
      <p class="table-intro">
        Çocuğun sırasını, doğum tarihini ve başvuru tarihini girin; alacağınız toplam yardımı ve ödeme takvimini görün.
        Bebek henüz doğmadıysa beklenen doğum tarihini yazabilirsiniz.
      </p>
      <div class="calc-grid">
        <form class="calc-inputs" autocomplete="off" onsubmit="return false">
          <label>
            <span>Bebek kaçıncı çocuğunuz?</span>
            <select id="in-sira">
              <option value="1">1. çocuk (ilk çocuk)</option>
              <option value="2" selected>2. çocuk</option>
              <option value="3">3. veya sonraki çocuk</option>
            </select>
            <em class="hint">Annenin daha önce canlı doğurduğu tüm çocuklar sayılır; 2025’ten önce doğanlar da.</em>
          </label>
          <label>
            <span>Doğum tarihi (veya beklenen)</span>
            <input type="date" id="in-dogum" value={BUGUN} min={dy.kapsamBaslangic} required />
          </label>
          <label>
            <span>Başvuru tarihi</span>
            <input type="date" id="in-basvuru" value={BUGUN} min={dy.kapsamBaslangic} required />
            <em class="hint">Başvuru nüfus kaydından sonra yapılabilir. Aylık yardım başvuru ayından başlar: geç kalınan
              her ay bir ödeme kaybıdır.</em>
          </label>
        </form>

        <div class="calc-results" aria-live="polite">
          <div class="result-main">
            <span class="result-label">Toplam doğum yardımı</span>
            <span class="result-value" id="out-toplam">{tl(max2)}</span>
          </div>
          <div class="result-split">
            <div class="split-item">
              <span class="split-label">Ödeme şekli</span>
              <span class="split-val" id="out-sekil">Aylık {tl(T.ikinciAylik)}</span>
            </div>
            <div class="split-item">
              <span class="split-label">Ödeme sayısı</span>
              <span class="split-val" id="out-sayi">{MAXAY} ay</span>
            </div>
            <div class="split-item">
              <span class="split-label" id="lbl-bas">Hak başlangıcı (başvuru ayı)</span>
              <span class="split-val" id="out-bas">{idxAd(bugunIdx)}</span>
            </div>
            <div class="split-item">
              <span class="split-label" id="lbl-son">Son ödeme ayı (çocuğun 60. ayı)</span>
              <span class="split-val" id="out-son">{idxAd(sonIdx0)}</span>
            </div>
            <div class="split-item">
              <span class="split-label">İlk yatış (onay aynı ay çıkarsa)</span>
              <span class="split-val" id="out-ilk">{idxAd(bugunIdx + 1)} son haftası</span>
            </div>
          </div>
          <p class="result-note" id="out-note">
            Başvuru için son tarih: çocuğun 5 yaşını doldurduğu gün. Doğum ayında başvurduğunuz için {MAXAY} ödemenin
            tamamını alırsınız.
          </p>
        </div>
      </div>

      <div id="yil-wrap">
        <h3>Yıllara göre hak edilen tutar</h3>
        <div class="table-wrap">
          <table class="rate-table">
            <thead><tr><th>Yıl</th><th>Ay sayısı</th><th>Tutar</th></tr></thead>
            <tbody id="out-yil">
              {yil0.map(([yy, n]) => <tr><td>{yy}</td><td>{n} ay</td><td>{tl(n * T.ikinciAylik)}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
      <p class="disclaimer">
        Hesap, doğum ayını çocuğun 1. ayı sayar ve Bakanlık’ın yayımladığı kuralları uygular (yardım başvuru ayından
        itibaren, 60. ay dahil). Kesin hak sahipliğini ve ödeme planını e-Devlet ile “İlk Öğretmenim Ailem” uygulaması
        gösterir. Son kontrol: {dogrulamaTxt}.
      </p>
    </section>

    <section class="table-block">
      <h2>Doğum yardımı tutarları {Y}</h2>
      <p class="table-intro">
        Tutarlar 633 sayılı Kanun Hükmünde Kararname’nin ek 4. maddesinde ve Doğum Yardımı Yönetmeliği’nde yazılıdır;
        2025’ten bu yana değişmedi. Ödeme vergi ve kesintiye tabi değildir, haczedilemez.
      </p>
      <div class="table-wrap">
        <table class="rate-table">
          <thead><tr><th>Çocuk sırası</th><th>{Y} tutarı</th><th>Süre</th><th>En fazla toplam</th><th>Başvuru süresi</th></tr></thead>
          <tbody>
            <tr><td>1. çocuk</td><td><strong>{tl(T.ilk)}</strong><span class="row-note">tek seferlik</span></td><td>—</td><td>{tl(T.ilk)}</td><td>Doğumdan sonraki {ILKAY} ay</td></tr>
            <tr><td>2. çocuk</td><td><strong>{tl(T.ikinciAylik)}</strong><span class="row-note">her ay</span></td><td>Başvuru ayından 60. aya kadar</td><td>{tl(max2)}</td><td>5 yaşını doldurana kadar</td></tr>
            <tr><td>3. ve sonraki</td><td><strong>{tl(T.ucuncuAylik)}</strong><span class="row-note">her ay, her çocuk için</span></td><td>Başvuru ayından 60. aya kadar</td><td>{tl(max3)}</td><td>5 yaşını doldurana kadar</td></tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">
        “En fazla toplam” doğum ayında başvuru içindir. İkiz ve üçüzlerde her bebek için ayrı başvuru yapılır, sıra
        nüfus kayıt sırasına göre belirlenir: 2025’ten önce doğmuş bir çocuğu olan anne ikiz doğurursa bebeklerden biri
        ikinci, diğeri üçüncü çocuk sayılır ve aylık toplam {tl(T.ikinciAylik + T.ucuncuAylik)} ödenir.
      </p>
    </section>

    <section class="table-block">
      <h2>Doğum yardımı ne zaman yatar? {Y} ödeme tarihleri</h2>
      <p class="table-intro">
        Başvuru onaylanınca ilk ödeme, onay tarihini izleyen ayın son haftasında yapılır. Aylık ödemeler her ayın son
        haftasında Halkbank aracılığıyla annenin hesabına yatar; Bakanlık her ayın ödeme gününü ayrıca duyurur.
      </p>
      <div class="table-wrap">
        <table class="rate-table">
          <thead><tr><th>Ödeme dönemi</th><th>Hesaplara yattığı gün</th></tr></thead>
          <tbody>
            {[...OD].reverse().map((o) => (
              <tr><td>{ayAdi(o.ay)}</td><td>{trTarih(o.tarih, true)}{o.not && <span class="row-note">{o.not}</span>}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Kaynak: Aile ve Sosyal Hizmetler Bakanlığı aylık ödeme duyuruları. {Y}’da ödemeler ayın {minGun}. ile {maxGun}.
        günleri arasında yattı. Hesaba geçen tutar 6 ay boyunca hiç çekilmezse Bakanlık’a iade edilir: ilk çocuk
        ödemesi için çocuk 12. ayını doldurmadan yeniden başvurulabilir; aylık yardım kesilir ve yeni başvuruyla başvuru
        ayından itibaren yeniden başlar.
      </p>
    </section>

    <section class="prose-block">
      <h2>Doğum yardımını kim öder, kimler alabilir?</h2>
      <p>
        Doğum yardımını SGK değil, <strong>Aile ve Sosyal Hizmetler Bakanlığı</strong> öder. Kaynak genel bütçeden
        Sosyal Yardımlaşma ve Dayanışmayı Teşvik Fonu’na aktarılır ve yardım muhtaçlık şartı aranmadan bu fondan
        ödenir. Hak sahibi kural olarak annedir; anne yabancı uyrukluysa, vefat etmişse, Türkiye’de oturmuyorsa ya da
        velayet tek başına babadaysa yardım Türk vatandaşı babaya ödenir. Bakanlık’ın 30 Eylül {Y} açıklamasına göre
        bugüne kadar {fmt(ST.cocuk)} çocuk yardımdan yararlandı, {fmt(ST.duzenli)} çocuk için her ay düzenli ödeme
        yapılıyor ve {fmt(ST.anne)} anneye toplam {nf2(ST.milyarTL).replace(/,?0+$/, '')} milyar TL ödendi.
      </p>
      <p>Yönetmeliğe göre şu şartların birlikte sağlanması yeterlidir:</p>
      <ul>
        <li>Çocuğun <strong>1 Ocak 2025 veya sonrasında canlı doğmuş</strong> olması; çocuk başvuru tarihinde sağ ve Türk vatandaşı olmalı.</li>
        <li><strong>Annenin, babanın ya da ikisinin de Türk vatandaşı</strong> olması (çifte vatandaşlar da yararlanır).</li>
        <li>Hak sahibinin ve çocuğun <strong>Türkiye’de ikamet etmesi</strong>; nüfus kayıtlarında geçerli bir Türkiye adresi bulunmalı.</li>
        <li>e-Devlet ya da Bakanlık’ın belirlediği kanallardan <strong>usulüne uygun başvuru</strong> yapılması.</li>
      </ul>
      <p>
        Gelir sınırı, çalışma ya da SGK prim şartı yoktur; yönetmelikte aşı veya sağlık kontrolü şartı da yer almaz.
        Resmî nikâh aranmaz. Mavi kart sahipleri Türk vatandaşı olmadıkları için başvuramaz, ancak Türk vatandaşı olan
        diğer ebeveyn şartları sağlıyorsa o başvurabilir.
      </p>

      <h2>Çocuk sırası nasıl belirlenir?</h2>
      <p>
        Tutarı belirleyen, annenin daha önce sağ olarak doğurduğu çocuk sayısıdır. <strong>2025’ten önce doğan
        çocuklar da sayılır</strong>; nüfusa kaydedildikten sonra vefat eden çocuklar da sıraya dahildir. Türk vatandaşı
        olmayan annenin Türk vatandaşı babadan olmayan çocukları sayılmaz. Evlat edinilen çocuklarda sıra evlat edinme
        tarihine göre belirlenir. Kurumunuzdan ya da toplu iş sözleşmesiyle ayrıca doğum yardımı aldıysanız bu tutar
        Bakanlık’ın yardımından düşülmez.
      </p>

      <h2>Doğum yardımı başvurusu adım adım</h2>
      <ol>
        <li>Bebeğin nüfus kaydının tamamlanmasını bekleyin; başvuru ancak bundan sonra açılır.</li>
        <li>
          e-Devlet’te <a href="https://www.turkiye.gov.tr/ashb-dogum-yardimi-8663" rel="noopener">Aile ve Sosyal
          Hizmetler Bakanlığı · Doğum Yardımı Başvuru</a> hizmetine girin ya da “İlk Öğretmenim Ailem” mobil
          uygulamasını kullanın.
        </li>
        <li>Anne, baba, bebek ve varsa diğer çocukların T.C. kimlik numaralarını girip doğruluk beyanını onaylayın.</li>
        <li>
          Başvuru en geç {dy.sonucGun} gün içinde sonuçlanır. Ret gerekçesi e-Devlet’te görünür; itiraz da sistem
          üzerinden yapılır ve {dy.itirazGun} gün içinde il müdürlüğünce sonuçlandırılır.
        </li>
        <li>Onaydan sonra ilk ödeme, onayı izleyen ayın son haftasında Halkbank’a yatar.</li>
      </ol>
      <p>
        Süreler: ilk çocukta doğumdan sonraki {ILKAY} ay, ikinci ve sonraki çocuklarda çocuk 5 yaşını doldurana kadar.
        Anne yabancı uyrukluysa başvuruyu yapan baba, istenen belgeleri 15 gün içinde il müdürlüğüne teslim eder.
        e-Devlet kullanamayanlar Aile ve Sosyal Hizmetler il müdürlüklerinden ve sosyal hizmet merkezlerinden destek
        alabilir. Çocuğun vefatı, yurt dışına taşınma, vatandaşlıktan çıkma ya da çocuğun kurum bakımına alınması
        hâlinde yardım izleyen aydan kesilir; bu durumları 1 ay içinde bildirmek gerekir.
      </p>

      <h2>2025’te ne değişti, {Y}’da ne var?</h2>
      <p>
        2024 sonuna kadar doğan çocuklar için doğum yardımı tek seferlikti: ilk çocukta {tl(ES.ilk)}, ikincide
        {tl(ES.ikinci)}, üçüncü ve sonrakilerde {tl(ES.ucuncu)}. Mart 2025’te 7546 sayılı Kanun ile 633 sayılı KHK’nin
        ek 4. maddesi değişti ve 1 Ocak 2025’ten itibaren doğan çocuklar için bugünkü sistem kuruldu; uygulama esasları
        10 Nisan 2025’te yayımlanan Doğum Yardımı Yönetmeliği ile belirlendi. 2025 öncesi doğan çocuklar için eski
        tutarlara başvuru süresi {trTarih(ES.basvuruSonTarih)} tarihinde doldu.
      </p>
      <p>
        {Y}’da tutarlar değişmedi. Doğumla ilgili asıl değişiklik izin sürelerinde oldu: {IZ.kanun} sayılı Kanun’la
        (Resmî Gazete {trTarih(IZ.rgTarih)}) doğum sonrası analık izni 8 haftadan {IZ.dogumSonrasiHafta} haftaya çıktı,
        toplam süre {IZ.analikHafta} hafta oldu; özel sektörde babalık izni 5 günden {IZ.babalikGun} güne uzadı. Bu
        düzenleme doğum yardımı tutarlarını etkilemedi.
      </p>
    </section>

    {tavanVar && (
