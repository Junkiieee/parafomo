---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import altin from '../../data/altin-fiyat.json';
import { ALTIN_SPECS, DARPHANE_TABLO, HMB_KAYNAK, hasGram } from '../data/altin-specs';

// "altın kaç gram" ailesi (Trends ≈1100, "mevduat faizi" = 100) — ağırlık niyeti; fiyat sayfalarından ayrı.
// Ağırlıklar HMB resmî tablosu (src/data/altin-specs.ts); değer = saf altın × has altın alış (günlük veri).
type Kalem = { key: string; alis: number | null; satis: number | null };
const items = altin.kalemler as Kalem[];
const has = items.find((i) => i.key === 'gram-has-altin');
const hasAlis = has?.alis || 0;

const upd = new Date(altin.guncellenme);
const dateLabel = upd.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Istanbul' });
const fmt0 = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));
const g3 = (n: number) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 3, maximumFractionDigits: 3 }).format(n);
const MILYEM22 = 916;

const turler = ALTIN_SPECS.filter((s) => s.grup !== 'ons' && items.some((i) => i.key === s.key));

const faq = [
  { q: 'Çeyrek altın kaç gram?', a: 'Piyasada satılan çeyrek altın Cumhuriyet ziynet çeyreğidir ve 1,754 gramdır. Cumhuriyet sikke çeyreği ise 1,804 gramdır. İkisi de 22 ayardır; ziynet çeyrekte yaklaşık 1,607 gram, sikke çeyrekte 1,652 gram saf altın bulunur.' },
  { q: 'Yarım altın kaç gram?', a: 'Ziynet yarım altın 3,508 gram, sikke yarım altın 3,608 gramdır (22 ayar).' },
  { q: 'Tam altın kaç gram?', a: 'Tam (ziynet birlik) altın 7,016 gramdır. Cumhuriyet altını / Ata altın olarak bilinen birlik sikke ise 7,216 gramdır. İkisi de 22 ayardır.' },
  { q: 'Cumhuriyet altını kaç gram?', a: 'Birlik Cumhuriyet altın sikkesi (halk arasında Ata Lira) 7,216 gram ve 22 ayardır. İçinde yaklaşık 6,610 gram saf altın vardır.' },
  { q: 'Gremse (iki buçukluk) altın kaç gram?', a: 'İki buçukluk (gremse) sikke 18,040 gram, ziynet iki buçukluk 17,540 gramdır. Beşlik ise sikkede 36,080, ziynette 35,080 gramdır.' },
  { q: 'Bir ons altın kaç gram?', a: 'Altın fiyatlamasında kullanılan troy ons 31,1035 gramdır.' },
  { q: '22 ayar altında ne kadar saf altın var?', a: '22 ayar, 24 parçanın 22\'si altın demektir: yaklaşık %91,6 (916 milyem). Yani 10 gram 22 ayar altında yaklaşık 9,16 gram saf altın bulunur. 18 ayar %75, 14 ayar yaklaşık %58,5 saf altın içerir.' },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Altın Fiyatları', url: '/altin-fiyatlari/' },
  { name: 'Altın Kaç Gram?', url: '/altin-kac-gram/' },
];
---

<BaseLayout
  title="Altın Kaç Gram? Çeyrek, Yarım, Tam, Cumhuriyet ve Gremse Altın Ağırlıkları (Resmî Tablo)"
  description="Çeyrek altın 1,754 g, yarım 3,508 g, tam 7,016 g, Cumhuriyet (Ata) altını 7,216 g. Ziynet ve sikke altınların resmî ağırlığı, saf altın miktarı ve bugünkü değeri."
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Resmî Tablo · Darphane Ağırlıkları</p>
      <h1>Altın Kaç Gram?</h1>
      <p class="lede">
        <strong>Çeyrek altın 1,754 gram</strong>, yarım 3,508 gram, tam 7,016 gram;
        <strong>Cumhuriyet (Ata) altını 7,216 gram</strong>. Hepsi 22 ayardır. Aşağıda sikke ve ziynet
        altınların resmî ağırlıkları, içlerindeki saf altın ve {dateLabel} itibarıyla değerleri var.
      </p>
    </header>

    <section class="table-block">
      <h2>Cumhuriyet altınları: sikke ve ziynet ağırlıkları</h2>
      <table class="rate-table">
        <thead><tr><th>Çeşit</th><th>Ziynet (g)</th><th>Sikke (g)</th><th class="hide-sm">Saf altın — ziynet / sikke</th></tr></thead>
        <tbody>
          {DARPHANE_TABLO.map((r) => (
            <tr>
              <td>{r.cesit}</td>
              <td><strong>{g3(r.ziynet)}</strong></td>
              <td>{g3(r.sikke)}</td>
              <td class="hide-sm">{g3((r.ziynet * MILYEM22) / 1000)} / {g3((r.sikke * MILYEM22) / 1000)} g</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">
        Kaynak: <a href={HMB_KAYNAK} rel="nofollow noopener" target="_blank">T.C. Hazine ve Maliye Bakanlığı — Sorularla Cumhuriyet Altını</a>.
        Cumhuriyet ve Reşad altınlarının tümü 22 ayardır; saf altın 916 milyemle hesaplanmıştır.
        Kuyumcuda "çeyrek, yarım, tam" denince genellikle <strong>ziynet</strong>, "Ata / Cumhuriyet altını" denince
        <strong>birlik sikke</strong> kastedilir.
      </p>
    </section>

    <section class="table-block">
      <h2>Altın türlerine göre ağırlık, saf altın ve bugünkü değer</h2>
      <table class="rate-table">
        <thead><tr><th>Tür</th><th>Ağırlık</th><th class="hide-sm">Ayar</th><th>Saf altın</th><th>Has değeri*</th></tr></thead>
        <tbody>
          {turler.map((s) => (
            <tr>
              <td><a href={`/altin-fiyatlari/${s.slug}/`}>{s.ad}</a></td>
              <td>{g3(s.gram)} g</td>
              <td class="hide-sm">{s.ayar}</td>
              <td>{g3(hasGram(s))} g</td>
              <td>₺{fmt0(hasGram(s) * hasAlis)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="table-note">*Has değeri = içindeki saf altın × has altın alış fiyatı (₺{fmt0(hasAlis)}/g, {dateLabel}).
        Kuyumcu satış fiyatı buna işçilik/darphane payı ve marj ekler — türlerin güncel alış-satış fiyatı için
        isme tıklayın.</p>
    </section>

    <section class="prose-block">
      <h2>Ayar ve milyem: 22 ayar ne demek?</h2>
      <p>
        Ayar, altının 24 parçasından kaçının saf altın olduğunu gösterir. <strong>24 ayar</strong> saf altındır
        (gram altın 995, has altın 999,9 milyem). <strong>22 ayar</strong> = 22/24 ≈ %91,6 altın (916 milyem);
        çeyrek, yarım, tam, Cumhuriyet altını ve bilezik bu ayardadır. <strong>18 ayar</strong> %75 (750 milyem),
        <strong>14 ayar</strong> yaklaşık %58,5 (585 milyem) altın içerir. Aynı ağırlıkta düşük ayarlı altın daha
        az saf altın içerdiği için daha ucuzdur.
      </p>
      <h2>Ziynet ile sikke arasındaki fark</h2>
      <p>
        Cumhuriyet altınları iki grupta basılır. <strong>Sikke</strong> altınlar ziynete göre daha küçük çaplı ama
        daha kalın ve ağırdır (birlik 7,216 g'a karşı 7,016 g). Sikkenin bir yüzünde "Türkiye Cumhuriyeti" ve 1923,
        ziynette kaligrafik yazı bulunur. Ağırlık farkı fiyata yansır: aynı çeşitte sikke ziynetten biraz pahalıdır.
      </p>
      <p class="cta-line">
        Elindeki altının toplam değerini hesapla → <a href="/altin-hesaplama/">altın hesaplama</a> ·
        güncel fiyatlar → <a href="/altin-fiyatlari/">altın fiyatları bugün</a> ·
        uzun vadede altın ne kazandırdı → <a href="/altin-getiri/">altın getirisi</a>.
      </p>
    </section>

    <section class="faq-block">
      <h2>Sıkça Sorulan Sorular</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
    <Newsletter />
  </div>

  <style>
    .wrap { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.1rem 4rem; }
    .head { text-align: center; margin-bottom: 1.6rem; }
    .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; font-weight: 700; color: var(--brand-deep); margin: 0 0 0.4rem; }
    .head h1 { font-size: var(--step-4); margin: 0 0 0.6rem; line-height: 1.1; }
    .lede { color: var(--text-soft); font-size: var(--step-1); max-width: 660px; margin: 0 auto; }
    .table-block { margin-top: 2.2rem; }
    .table-block h2, .prose-block h2, .faq-block h2 { font-size: var(--step-2); margin: 0 0 0.7rem; }
    .rate-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .rate-table th, .rate-table td { text-align: left; padding: 0.55rem 0.5rem; border-bottom: 1px solid var(--border); }
    .rate-table th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
    .table-note { font-size: 0.85rem; color: var(--text-muted); margin: 0.7rem 0 0; line-height: 1.6; }
    .prose-block, .faq-block { margin-top: 2.4rem; }
    .prose-block p { color: var(--text-soft); line-height: 1.7; }
    .prose-block h2:not(:first-child) { margin-top: 1.8rem; }
    .cta-line { background: var(--surface); padding: 0.9rem 1.1rem; border-radius: var(--radius-sm); border-left: 3px solid var(--brand-2); }
    .faq-block details { border-bottom: 1px solid var(--border); padding: 0.9rem 0; }
    .faq-block summary { font-weight: 600; cursor: pointer; color: var(--text); list-style: none; }
    .faq-block summary::-webkit-details-marker { display: none; }
    .faq-block summary::after { content: '+'; float: right; color: var(--brand-2); font-weight: 700; }
    .faq-block details[open] summary::after { content: '−'; }
    .faq-block details p { color: var(--text-soft); line-height: 1.7; margin: 0.7rem 0 0; }
    @media (max-width: 640px) { .hide-sm { display: none; } }
  </style>
</BaseLayout>
