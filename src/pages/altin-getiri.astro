---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import data from '../../data/altin-getiri.json';

type Period = {
  label: string; years?: number;
  gram_tl_then: number; gram_tl_now: number; return_tl_pct: number;
  oz_usd_then: number; oz_usd_now: number; return_usd_pct: number;
};

const periods = (data.periods ?? []) as Period[];
const ytd = data.ytd as Period;
const updated = new Date(data.updated).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const fmt = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmt0 = (n: number) => n.toLocaleString('tr-TR', { maximumFractionDigits: 0 });
const pct = (n: number) => (n > 0 ? '+' : '') + n.toLocaleString('tr-TR', { maximumFractionDigits: 1 }) + '%';
const toneOf = (n: number) => (n > 0 ? 'up' : n < 0 ? 'down' : 'flat');

const ten = periods.find((p) => p.years === 10) ?? periods[periods.length - 1];
// "10.000 TL koysaydın" — en uzun dönem üzerinden
const seed = 10000;
const gramsThen = seed / ten.gram_tl_then;
const valueNow = gramsThen * ten.gram_tl_now;

const faqs = [
  {
    q: `Altın son ${ten.years} yılda ne kadar kazandırdı?`,
    a: `Gram altın son ${ten.years} yılda TL bazında %${fmt(ten.return_tl_pct)}, dolar (ons) bazında ise %${fmt(ten.return_usd_pct)} değer kazandı. TL getirisinin çok daha yüksek görünmesinin nedeni, aynı dönemde Türk lirasının dolar karşısında büyük değer kaybetmesidir; altının "gerçek" (döviz bazlı) getirisi ons fiyatındaki değişimdir.`,
  },
  {
    q: 'Neden TL getirisi dolar getirisinden bu kadar yüksek?',
    a: 'Türkiye\'de altın fiyatı iki bileşenden oluşur: ons altının dolar fiyatı ve dolar/TL kuru. Gram altın TL ≈ (ons USD ÷ 31,1035) × USD/TRY. TL değer kaybettikçe aynı miktar altın daha çok TL eder. Bu yüzden TL getirisi hem altının küresel yükselişini hem de kur artışını içerir; enflasyona karşı korunma etkisi de buradan gelir.',
  },
  {
    q: '10.000 TL\'yi altına koysaydım bugün ne olurdu?',
    a: `${ten.years} yıl önce 10.000 TL ile yaklaşık ${fmt(gramsThen)} gram altın alınabilirdi. Bugünkü gram fiyatıyla bu ${fmt0(valueNow)} TL eder. Yani sadece altında tutmak, aynı parayı yastık altında TL olarak tutmaya kıyasla alım gücünü büyük ölçüde korurdu. (Geçmiş getiri gelecek getirinin garantisi değildir.)`,
  },
  {
    q: 'Bu rakamlar kesin işlem fiyatı mı?',
    a: 'Hayır, göstergedir. Ons altın (GC=F) ve USD/TRY için Yahoo Finance verisi kullanılır; gram fiyatı bu ikisinden hesaplanır. Kuyumcu alış-satış makası, işçilik ve anlık piyasa farkları nedeniyle gerçek alım-satım fiyatı biraz farklı olabilir. Güncel kuyumcu fiyatları için altın fiyatları sayfamıza bakın.',
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title={`Altın Ne Kadar Kazandırdı? 1, 5, 10 Yıllık Getiri (TL ve Dolar)`}
  description={`Gram altın son ${ten.years} yılda TL bazında %${fmt0(ten.return_tl_pct)}, dolar bazında %${fmt0(ten.return_usd_pct)} kazandırdı. Altının 1, 3, 5, 10 yıllık ve yıl başından beri getirisi tek tabloda — her gün güncel.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <section class="container gr-hero">
    <span class="eyebrow"><span class="pulse"></span> Özgün veri · Altın getirisi</span>
    <h1>Altın Ne Kadar Kazandırdı?</h1>
    <p class="lede soft">
      Gram altını 1, 3, 5 ve 10 yıl önce alsaydınız bugün elinizde ne olurdu? Hem TL hem dolar
      (ons) bazında gerçek getiri — enflasyon ve kur etkisini ayırarak, tek tabloda, her gün güncel.
    </p>
    <p class="gr-upd">Son güncelleme: {updated} · Gram altın ≈ {fmt0(data.gram_tl_now)} TL</p>
  </section>

  <section class="container gr-stats">
    <div class="stat card">
      <span class="stat-num up">{pct(ten.return_tl_pct)}</span>
      <span class="stat-lbl">{ten.years} yıllık getiri (TL)</span>
    </div>
    <div class="stat card">
      <span class={`stat-num ${ten.return_usd_pct >= 0 ? 'up' : 'down'}`}>{pct(ten.return_usd_pct)}</span>
      <span class="stat-lbl">{ten.years} yıllık getiri (dolar / ons)</span>
    </div>
    <div class="stat card">
      <span class={`stat-num ${ytd.return_tl_pct >= 0 ? 'up' : 'down'}`}>{pct(ytd.return_tl_pct)}</span>
      <span class="stat-lbl">Yıl başından beri (TL)</span>
    </div>
    <div class="stat card">
      <span class="stat-num">{fmt0(data.gram_tl_now)} ₺</span>
      <span class="stat-lbl">Güncel gram altın (gösterge)</span>
    </div>
  </section>

  <section class="container gr-section">
    <h2 class="gr-h2">Altın getiri tablosu <span class="gr-count">gram altın</span></h2>
    <div class="gr-tablewrap">
      <table class="gr-table">
        <thead>
          <tr>
            <th>Dönem</th>
            <th class="r">O zaman (gram ₺)</th>
            <th class="r">Bugün (gram ₺)</th>
            <th class="r">Getiri (TL)</th>
            <th class="r">Getiri ($/ons)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="gr-co"><span class="gr-name">{ytd.label}</span></td>
            <td class="r gr-mono">{fmt0(ytd.gram_tl_then)}</td>
            <td class="r gr-mono">{fmt0(ytd.gram_tl_now)}</td>
            <td class="r"><span class={`gr-ret tone-${toneOf(ytd.return_tl_pct)}`}>{pct(ytd.return_tl_pct)}</span></td>
            <td class="r"><span class={`gr-ret tone-${toneOf(ytd.return_usd_pct)}`}>{pct(ytd.return_usd_pct)}</span></td>
          </tr>
          {periods.map((p) => (
            <tr>
              <td class="gr-co"><span class="gr-name">Son {p.label}</span></td>
              <td class="r gr-mono">{fmt0(p.gram_tl_then)}</td>
              <td class="r gr-mono">{fmt0(p.gram_tl_now)}</td>
              <td class="r"><span class={`gr-ret tone-${toneOf(p.return_tl_pct)}`}>{pct(p.return_tl_pct)}</span></td>
              <td class="r"><span class={`gr-ret tone-${toneOf(p.return_usd_pct)}`}>{pct(p.return_usd_pct)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gr-tnote">
      Gram altın TL ≈ (ons USD ÷ 31,1035) × USD/TRY. "Getiri (TL)" hem altının küresel yükselişini
      hem kur artışını içerir; "Getiri ($/ons)" altının döviz bazlı gerçek değer değişimidir. Göstergedir.
    </p>
  </section>

  <section class="container gr-body">
    <h2 class="gr-h2">10.000 TL'yi {ten.years} yıl önce altına koysaydınız?</h2>
    <p>
      {ten.years} yıl önce 10.000 TL ile yaklaşık <strong>{fmt(gramsThen)} gram altın</strong>
      alabilirdiniz. Bugünkü gram fiyatıyla bu <strong>{fmt0(valueNow)} TL</strong> ediyor. Aynı
      10.000 TL'yi yastık altında nakit tutsaydınız, bugün yine 10.000 TL olurdu — ama alım gücü
      çoktan erimiş olurdu. Altının buradaki asıl işlevi "zengin etmek" değil, <strong>enflasyona ve
      kur kaybına karşı alım gücünü korumaktır.</strong>
    </p>
    <p>
      Dikkat edilmesi gereken nokta şu: TL bazında %{fmt0(ten.return_tl_pct)} gibi devasa bir getiri
      görünse de, bunun büyük kısmı Türk lirasının değer kaybından gelir. Altının <strong>dolar (ons)
      bazındaki getirisi %{fmt0(ten.return_usd_pct)}</strong> — yani küresel olarak altın da yükseldi,
      ama TL'deki rakam kadar değil. Bu ayrımı görmek, "altın her zaman kazandırır" algısını daha
      gerçekçi bir çerçeveye oturtur: altın sizi enflasyondan korur, ama getirinin çoğu çoğu zaman
      kur etkisidir.
    </p>
    <p>
      Farklı altın türlerinin (gram, çeyrek, ata, ziynet) makası ve işçilik farkı için
      <a href="/blog/altin-cesitleri-farki">altın çeşitleri rehberimize</a>, güncel kuyumcu
      fiyatları için <a href="/altin-fiyatlari">altın fiyatları sayfamıza</a>, belirli bir gram/adet
      için TL karşılığını hesaplamak içinse <a href="/altin-hesaplama">altın hesaplama aracımıza</a>
      bakabilirsiniz. Aynı dönemde <a href="/dolar-getiri">doların</a> ve
      <a href="/bist-getiri">borsanın (BIST 100)</a> TL bazında ne kadar kazandırdığını
      karşılaştırmalı olarak inceleyebilir, altın mı dolar mı sorusunu ise
      <a href="/blog/altin-mi-dolar-mi">bu yazıda</a> ayrıntılı ele aldığımızı görebilirsiniz.
    </p>
  </section>

  <section class="container gr-faq">
    <h2 class="gr-h2">Sık sorulan sorular</h2>
    {faqs.map((f) => (
      <details class="gr-fq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="container gr-note">
    <p>
      Veri kaynağı: {data.source}. Yalnızca bilgilendirme amaçlıdır; <strong>yatırım tavsiyesi
      değildir</strong>. Geçmiş getiri gelecekteki getirinin garantisi değildir.
    </p>
  </section>

  <div class="container"><Newsletter /></div>
</BaseLayout>

<style>
  .gr-hero { padding: clamp(1.6rem, 4vw, 2.6rem) 0 0; max-width: 720px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--step--2); font-weight: 600; color: var(--brand); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 0 rgba(22,160,133,0.5); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(22,160,133,0.5); } 70% { box-shadow: 0 0 0 6px rgba(22,160,133,0); } 100% { box-shadow: 0 0 0 0 rgba(22,160,133,0); } }
  .gr-hero h1 { font-size: var(--step-2); margin: 0.6rem 0 0.4rem; }
  .gr-hero .lede { font-size: var(--step-0); line-height: 1.55; margin: 0; }
  .gr-upd { font-size: var(--step--2); color: var(--text-muted); margin: 0.5rem 0 0; }

  .gr-stats { margin-top: clamp(1.4rem, 3.5vw, 2.2rem); display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; }
  .stat { padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .stat-num { font-size: var(--step-2); font-weight: 800; font-variant-numeric: tabular-nums; color: var(--text); line-height: 1.1; }
  .stat-num.up { color: var(--brand-deep); }
  .stat-num.down { color: var(--danger); }
  .stat-lbl { font-size: var(--step--2); color: var(--text-muted); line-height: 1.35; }

  .gr-section, .gr-body, .gr-faq { margin-top: clamp(1.8rem, 4vw, 2.8rem); }
  .gr-h2 { font-size: var(--step-1); margin: 0 0 0.9rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .gr-count { font-size: 0.66rem; font-weight: 700; color: var(--brand-deep); background: var(--brand-tint); border-radius: 999px; padding: 0.1rem 0.55rem; }

  .gr-tablewrap { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-card); box-shadow: var(--shadow-xs); }
  .gr-table { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  .gr-table thead th { text-align: left; font-size: var(--step--2); color: var(--text-muted); font-weight: 600; padding: 0.6rem 0.9rem; background: var(--bg-elev); border-bottom: 1px solid var(--border); }
  .gr-table th.r, .gr-table td.r { text-align: right; }
  .gr-table tbody tr { border-bottom: 1px solid var(--border-soft); }
  .gr-table tbody tr:last-child { border-bottom: none; }
  .gr-table td { padding: 0.6rem 0.9rem; vertical-align: middle; }
  .gr-name { color: var(--text); font-weight: 600; }
  .gr-mono { font-variant-numeric: tabular-nums; color: var(--text-soft); }
  .gr-ret { font-weight: 800; font-variant-numeric: tabular-nums; border-radius: 6px; padding: 0.15rem 0.5rem; font-size: var(--step--1); }
  .gr-ret.tone-up { background: var(--brand-tint); color: var(--brand-deep); }
  .gr-ret.tone-down { background: #fbe3e6; color: #a32437; }
  .gr-ret.tone-flat { background: var(--bg-elev); color: var(--text-muted); }
  .gr-tnote { font-size: var(--step--2); color: var(--text-muted); line-height: 1.55; margin: 0.7rem 0 0; max-width: 720px; }

  .gr-body { max-width: 720px; }
  .gr-body p { font-size: var(--step-0); line-height: 1.65; color: var(--text-soft); margin: 0 0 0.9rem; }
  .gr-body a { color: var(--brand); font-weight: 600; }

  .gr-fq { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); margin-bottom: 0.6rem; max-width: 720px; }
  .gr-fq summary { cursor: pointer; padding: 0.8rem 1rem; font-weight: 600; font-size: var(--step-0); color: var(--text); }
  .gr-fq p { padding: 0 1rem 0.9rem; margin: 0; font-size: var(--step--1); line-height: 1.6; color: var(--text-soft); }

  .gr-note { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .gr-note p { font-size: var(--step--2); line-height: 1.6; max-width: 720px; color: var(--text-muted); padding: 0.8rem 1rem; background: var(--bg-elev); border: 1px solid var(--border-soft); border-radius: var(--radius); }

  @media (max-width: 620px) {
    .gr-stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script define:vars={{ built: data.updated }}>
  async function checkUpdate() {
    try {
      const r = await fetch('/altin-getiri.json?_=' + Date.now(), { cache: 'no-store' });
      const d = await r.json();
      if (d && d.updated && d.updated !== built) location.reload();
    } catch { /* yoksay */ }
  }
  setInterval(() => { if (document.visibilityState === 'visible') checkUpdate(); }, 300000);
</script>
