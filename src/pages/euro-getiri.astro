---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import data from '../../data/euro-getiri.json';

type Period = {
  label: string; years?: number;
  eurtry_then: number; eurtry_now: number; return_tl_pct: number;
  usdtry_then: number; usd_return_tl_pct: number;
  eurusd_then: number; eurusd_change_pct: number;
};

const periods = (data.periods ?? []) as Period[];
const ytd = data.ytd as Period;
const all = [ytd, ...periods];
const updated = new Date(data.updated).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const fmt2 = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmt4 = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
const fmt0 = (n: number) => n.toLocaleString('tr-TR', { maximumFractionDigits: 0 });
const fmt1 = (n: number) => n.toLocaleString('tr-TR', { maximumFractionDigits: 1 });
const pct = (n: number) => (n > 0 ? '+' : '') + fmt1(n) + '%';
const toneOf = (n: number) => (n > 0 ? 'up' : n < 0 ? 'down' : 'flat');
const rowLabel = (p: Period) => (p.years ? `Son ${p.label}` : p.label);

const ten = periods.find((p) => p.years === 10) ?? periods[periods.length - 1];
const euroWins = all.filter((p) => p.return_tl_pct > p.usd_return_tl_pct).length;
const tenWinner = ten.return_tl_pct > ten.usd_return_tl_pct ? 'euro' : 'dolar';
const seed = 10000;
const euroValue = seed * (1 + ten.return_tl_pct / 100);
const usdValue = seed * (1 + ten.usd_return_tl_pct / 100);

const faqs = [
  {
    q: `Euro son ${ten.years} yılda TL karşısında ne kadar kazandırdı?`,
    a: `${ten.years} yıl önce 1 euro yaklaşık ${fmt2(ten.eurtry_then)} TL'ydi, bugün ${fmt2(ten.eurtry_now)} TL. Yani euro tutmak TL bazında %${fmt0(ten.return_tl_pct)} getiri sağladı. Bu getirinin tamamı Türk lirasının değer kaybıdır; euronun kendisi "değerlenmedi", TL eridi.`,
  },
  {
    q: 'Euro mu dolar mı daha çok kazandırdı?',
    a: `Son ${ten.years} yılda TL bazında euro %${fmt0(ten.return_tl_pct)}, dolar %${fmt0(ten.usd_return_tl_pct)} kazandırdı — bu dönemin kazananı ${tenWinner}. Tablodaki dönemlerde euro ${euroWins} / ${all.length} kez öne geçti. İkisi arasındaki farkı belirleyen tek şey EUR/USD paritesidir: parite yükseldiyse euro, düştüyse dolar daha çok kazandırır. (Geçmiş getiri gelecek getirinin garantisi değildir.)`,
  },
  {
    q: 'EUR/USD paritesi euro-dolar tercihini nasıl etkiler?',
    a: `EUR/USD bugün yaklaşık ${fmt4(data.eurusd_now)}. Euro TL getirisi ≈ dolar TL getirisi + parite değişimi. ${ten.years} yıl önce parite ${fmt4(ten.eurusd_then)} idi (değişim ${pct(ten.eurusd_change_pct)}). Uzun vadede iki döviz TL karşısında birbirine yakın seyreder; kısa vadede ECB ve Fed faiz farkı pariteyi oynatır. Bu yüzden birikimini bölüştürmek (sepet) parite riskini azaltır.`,
  },
  {
    q: 'Rakamlar kesin kur mu?',
    a: 'Hayır, göstergedir. EUR/TRY ve USD/TRY için Yahoo Finance aylık kapanışları kullanılır; parite bu ikisinden türetilir. Banka ve döviz bürosu alış-satış makası nedeniyle gerçek işlem kuru farklıdır.',
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Euro (EUR/TRY) ve dolar TL bazında tarihsel getiri (1, 3, 5, 10 yıl)',
  description: 'Euroyu ve doları elde tutmanın yıl başından beri ve 1/3/5/10 yıllık TL getirisi ile EUR/USD parite değişimi. Her gün güncellenir.',
  url: 'https://parafomo.com/euro-getiri/',
  dateModified: data.updated,
  isAccessibleForFree: true,
  creator: { '@id': 'https://parafomo.com/#organization' },
  distribution: { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://parafomo.com/euro-getiri.json' },
};
---

<BaseLayout
  image="/og/euro-getiri.png"
  title={`Euro Ne Kadar Kazandırdı? 1, 5, 10 Yıllık Getiri ve Euro mu Dolar mı`}
  description={`Euro son ${ten.years} yılda TL karşısında %${fmt0(ten.return_tl_pct)}, dolar %${fmt0(ten.usd_return_tl_pct)} kazandırdı. Euronun 1, 3, 5, 10 yıllık TL getirisi, dolarla yan yana ve EUR/USD paritesi — her gün güncel.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(datasetLd)} />

  <section class="container gr-hero">
    <span class="eyebrow"><span class="pulse"></span> Özgün veri · Euro getirisi</span>
    <h1>Euro Ne Kadar Kazandırdı?</h1>
    <p class="lede soft">
      Euroyu 1, 3, 5 ve 10 yıl önce alıp tutsaydınız bugün TL bazında ne kazanmış olurdunuz? Aynı
      dönemde dolarla yan yana karşılaştırma ve EUR/USD paritesinin etkisi — her gün güncel.
    </p>
    <p class="gr-upd">Son güncelleme: {updated} · 1 € ≈ {fmt2(data.eurtry_now)} TL · Kaynak: Yahoo Finance</p>
  </section>

  <section class="container gr-stats">
    <div class="stat card">
      <span class={`stat-num ${ten.return_tl_pct >= 0 ? 'up' : 'down'}`}>{pct(ten.return_tl_pct)}</span>
      <span class="stat-lbl">Euro · {ten.years} yıllık TL getiri</span>
    </div>
    <div class="stat card">
      <span class={`stat-num ${ten.usd_return_tl_pct >= 0 ? 'up' : 'down'}`}>{pct(ten.usd_return_tl_pct)}</span>
      <span class="stat-lbl">Dolar · {ten.years} yıllık TL getiri</span>
    </div>
    <div class="stat card">
      <span class={`stat-num ${ytd.return_tl_pct >= 0 ? 'up' : 'down'}`}>{pct(ytd.return_tl_pct)}</span>
      <span class="stat-lbl">Euro · yıl başından beri</span>
    </div>
    <div class="stat card">
      <span class="stat-num">{fmt4(data.eurusd_now)}</span>
      <span class="stat-lbl">EUR/USD paritesi</span>
    </div>
  </section>

  <section class="container gr-section">
    <h2 class="gr-h2">Euro getiri tablosu <span class="gr-count">EUR/TRY</span></h2>
    <div class="gr-tablewrap">
      <table class="gr-table">
        <thead>
          <tr>
            <th>Dönem</th>
            <th class="r">O zaman (1 € = ₺)</th>
            <th class="r">Bugün (1 € = ₺)</th>
            <th class="r">Getiri (TL)</th>
          </tr>
        </thead>
        <tbody>
          {all.map((p) => (
            <tr>
              <td class="gr-co"><span class="gr-name">{rowLabel(p)}</span></td>
              <td class="r gr-mono">{fmt2(p.eurtry_then)}</td>
              <td class="r gr-mono">{fmt2(p.eurtry_now)}</td>
              <td class="r"><span class={`gr-ret tone-${toneOf(p.return_tl_pct)}`}>{pct(p.return_tl_pct)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="gr-tnote">
      Getiri = bugünkü EUR/TRY ÷ o günkü EUR/TRY − 1. TL bazındaki getirinin tamamı Türk lirasının
      euro karşısındaki değer kaybıdır. Göstergedir.
    </p>
  </section>

  <section class="container gr-section">
    <h2 class="gr-h2">Euro mu dolar mı? <span class="gr-count">TL getirisi yan yana</span></h2>
    <div class="gr-tablewrap">
      <table class="gr-table">
        <thead>
          <tr>
            <th>Dönem</th>
            <th class="r">💶 Euro</th>
            <th class="r">💵 Dolar</th>
            <th class="r">EUR/USD değişimi</th>
            <th>Önde</th>
          </tr>
        </thead>
        <tbody>
          {all.map((p) => {
            const eWin = p.return_tl_pct > p.usd_return_tl_pct;
            return (
              <tr>
                <td class="gr-co"><span class="gr-name">{rowLabel(p)}</span></td>
                <td class="r"><span class={`gr-ret tone-${toneOf(p.return_tl_pct)} ${eWin ? 'is-win' : ''}`}>{pct(p.return_tl_pct)}</span></td>
                <td class="r"><span class={`gr-ret tone-${toneOf(p.usd_return_tl_pct)} ${!eWin ? 'is-win' : ''}`}>{pct(p.usd_return_tl_pct)}</span></td>
                <td class="r gr-mono">{pct(p.eurusd_change_pct)}</td>
                <td class="gr-win">{eWin ? '💶 Euro' : '💵 Dolar'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="gr-tnote">
      Önde olan: euro {euroWins} / {all.length} dönem, dolar {all.length - euroWins} / {all.length} dönem.
      EUR/USD yükseldiği dönemde euro, düştüğü dönemde dolar daha çok kazandırır. Dolar verisinin ayrıntısı:
      <a href="/dolar-getiri">dolar getirisi</a>.
    </p>
  </section>

  <section class="container gr-body">
    <h2 class="gr-h2">10.000 TL'yi {ten.years} yıl önce euroya mı dolara mı çevirseydiniz?</h2>
    <p>
      {ten.years} yıl önce 10.000 TL'yi euroya çevirseydiniz bugün yaklaşık <strong>{fmt0(euroValue)} TL</strong>,
      dolara çevirseydiniz <strong>{fmt0(usdValue)} TL</strong> ederdi. Aradaki fark yalnızca EUR/USD
      paritesinin bu dönemde {pct(ten.eurusd_change_pct)} değişmesinden kaynaklanıyor — TL karşısındaki asıl
      hareketi iki döviz birlikte yaptı.
    </p>
    <p>
      Kısa vadede tablo daha oynak: yıl başından beri euro {pct(ytd.return_tl_pct)}, dolar
      {' '}{pct(ytd.usd_return_tl_pct)} getirdi; parite {pct(ytd.eurusd_change_pct)} değişti. Pariteyi en çok
      ECB ile Fed arasındaki faiz farkı ve iki ekonominin büyüme beklentisi oynatır. Döviz birikimi
      yapanların euro ile dolar arasında bölüştürmesi (sepet) bu parite riskini dengelemenin yaygın yoludur.
    </p>
    <p>
      Doların ayrıntılı dökümü için <a href="/dolar-getiri">dolar getirisi</a>, altın ve borsayla
      karşılaştırma için <a href="/altin-dolar-borsa">altın mı dolar mı borsa mı</a> sayfamıza; ECB
      kararlarının euro/TL'ye etkisi için <a href="/blog/ecb-eylul-2026-faiz-karari-euro-tl-etkisi">bu yazıya</a>,
      dövizi bankada tutmanın yolları için <a href="/blog/doviz-hesabi-nedir">döviz hesabı rehberimize</a> bakabilirsiniz.
    </p>
  </section>

  <section class="container gr-faq">
    <h2 class="gr-h2">Sık sorulan sorular</h2>
    {faqs.map((f) => (
      <details class="gr-fq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="container gr-note">
    <p>
      Veri kaynağı: {data.source}. Yöntem: <a href="/metodoloji">metodoloji</a>. Yalnızca bilgilendirme
      amaçlıdır; <strong>yatırım tavsiyesi değildir</strong>. Geçmiş getiri gelecekteki getirinin garantisi değildir.
    </p>
  </section>

  <div class="container"><Newsletter /></div>
</BaseLayout>

<style>
  .gr-hero { padding: clamp(1.6rem, 4vw, 2.6rem) 0 0; max-width: 720px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.45rem; font-size: var(--step--2); font-weight: 600; color: var(--brand); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 0 rgba(22,160,133,0.5); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(22,160,133,0.5); } 70% { box-shadow: 0 0 0 6px rgba(22,160,133,0); } 100% { box-shadow: 0 0 0 0 rgba(22,160,133,0); } }
  .gr-hero h1 { font-size: var(--step-2); margin: 0.6rem 0 0.4rem; }
  .gr-hero .lede { font-size: var(--step-0); line-height: 1.55; margin: 0; }
  .gr-upd { font-size: var(--step--2); color: var(--text-muted); margin: 0.5rem 0 0; }

  .gr-stats { margin-top: clamp(1.4rem, 3.5vw, 2.2rem); display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; }
  .stat { padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .stat-num { font-size: var(--step-2); font-weight: 800; font-variant-numeric: tabular-nums; color: var(--text); line-height: 1.1; }
  .stat-num.up { color: var(--brand-deep); }
  .stat-num.down { color: var(--danger); }
  .stat-lbl { font-size: var(--step--2); color: var(--text-muted); line-height: 1.35; }

  .gr-section, .gr-body, .gr-faq { margin-top: clamp(1.8rem, 4vw, 2.8rem); }
  .gr-h2 { font-size: var(--step-1); margin: 0 0 0.9rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .gr-count { font-size: 0.66rem; font-weight: 700; color: var(--brand-deep); background: var(--brand-tint); border-radius: 999px; padding: 0.1rem 0.55rem; }

  .gr-tablewrap { border: 1px solid var(--border); border-radius: var(--radius); overflow-x: auto; background: var(--bg-card); box-shadow: var(--shadow-xs); }
  .gr-table { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  .gr-table thead th { text-align: left; font-size: var(--step--2); color: var(--text-muted); font-weight: 600; padding: 0.6rem 0.9rem; background: var(--bg-elev); border-bottom: 1px solid var(--border); }
  .gr-table th.r, .gr-table td.r { text-align: right; }
  .gr-table tbody tr { border-bottom: 1px solid var(--border-soft); }
  .gr-table tbody tr:last-child { border-bottom: none; }
  .gr-table td { padding: 0.6rem 0.9rem; vertical-align: middle; }
  .gr-name { color: var(--text); font-weight: 600; }
  .gr-mono { font-variant-numeric: tabular-nums; color: var(--text-soft); }
  .gr-ret { font-weight: 800; font-variant-numeric: tabular-nums; border-radius: 6px; padding: 0.15rem 0.5rem; font-size: var(--step--1); }
  .gr-ret.tone-up { background: var(--brand-tint); color: var(--brand-deep); }
  .gr-ret.tone-down { background: #fbe3e6; color: #a32437; }
  .gr-ret.tone-flat { background: var(--bg-elev); color: var(--text-muted); }
  .gr-ret.is-win { outline: 2px solid var(--brand); outline-offset: 1px; }
  .gr-win { font-weight: 700; color: var(--text-soft); white-space: nowrap; }
  .gr-tnote { font-size: var(--step--2); color: var(--text-muted); line-height: 1.55; margin: 0.7rem 0 0; max-width: 720px; }
  .gr-tnote a { color: var(--brand); font-weight: 600; }

  .gr-body { max-width: 720px; }
  .gr-body p { font-size: var(--step-0); line-height: 1.65; color: var(--text-soft); margin: 0 0 0.9rem; }
  .gr-body a { color: var(--brand); font-weight: 600; }

  .gr-fq { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); margin-bottom: 0.6rem; max-width: 720px; }
  .gr-fq summary { cursor: pointer; padding: 0.8rem 1rem; font-weight: 600; font-size: var(--step-0); color: var(--text); }
  .gr-fq p { padding: 0 1rem 0.9rem; margin: 0; font-size: var(--step--1); line-height: 1.6; color: var(--text-soft); }

  .gr-note { margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .gr-note p { font-size: var(--step--2); line-height: 1.6; max-width: 720px; color: var(--text-muted); padding: 0.8rem 1rem; background: var(--bg-elev); border: 1px solid var(--border-soft); border-radius: var(--radius); }
  .gr-note a { color: var(--brand); }

  @media (max-width: 620px) {
    .gr-stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script define:vars={{ built: data.updated }}>
  async function checkUpdate() {
    try {
      const r = await fetch('/euro-getiri.json?_=' + Date.now(), { cache: 'no-store' });
      const d = await r.json();
      if (d && d.updated && d.updated !== built) location.reload();
    } catch { /* yoksay */ }
  }
  setInterval(() => { if (document.visibilityState === 'visible') checkUpdate(); }, 300000);
</script>
