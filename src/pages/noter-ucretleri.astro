  <script
    is:inline
    define:vars={{
      C: {
        aracBinde: HARC.aracBinde,
        aracMin: HARC.aracMin,
        nispiBinde: HARC.nispiBinde,
        nispiMin: HARC.nispiMin,
        nispiMax: HARC.nispiMax,
        asgari: TARIFE.asgari,
        oran: TARIFE.oran,
        dvKira: DV.kira,
        dvAdi: DV.kiraAdi,
        dvMut: DV.kiraMut,
        dvUst: DV.ust,
      },
    }}
  >
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf2 = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const tl = (n) => '₺' + nf2.format(Math.round(n * 100) / 100);
      function update() {
        const tip = $('in-tip').value;
        const arac = tip === 'arac';
        const galeri = $('in-galeri').checked;
        $('grp-arac').hidden = !arac;
        $('grp-kira').hidden = arac;
        $('row-ruhsat').hidden = !arac || galeri;
        if (arac) {
          const bedel = Math.max(0, +$('in-bedel').value || 0);
          const kasko = Math.max(0, +$('in-kasko').value || 0);
          const harc = galeri ? 0 : Math.max(C.aracMin, (Math.max(bedel, kasko) * C.aracBinde) / 1000);
          $('out-harc').textContent = tl(harc);
          $('out-ucret').textContent = 'Maktu (KTK 20/d)';
          $('out-damga').textContent = 'Yok (istisna)';
          $('out-note').textContent = galeri
            ? 'İkinci el ticaret yetki belgesi olan galeriye yapılan satışta binde 2 harç alınmaz; noterin ücreti ve diğer kalemler makbuzda yer alır.'
            : kasko > bedel
              ? 'Kasko değeri satış bedelinden yüksek olduğu için harç kasko değeri üzerinden hesaplandı.'
              : 'Harç, kasko değerinden düşük olmayan bedelin binde 2’si; noter ayrıca kanundaki maktu ücreti alır.';
        } else {
          const toplam = Math.max(0, +$('in-kira').value || 0) * Math.max(1, Math.round(+$('in-sure').value || 1));
          const kefil = $('in-kefil').value;
          const imza = kefil === 'yok' ? 2 : 3;
          const harc = Math.min(C.nispiMax, Math.max(C.nispiMin, (toplam * C.nispiBinde * imza) / 1000));
          const binde = kefil === 'adi' ? C.dvAdi : kefil === 'mut' ? C.dvMut : C.dvKira;
          $('out-harc').textContent = tl(harc);
          $('out-ucret').textContent = tl(Math.max(C.asgari, harc * C.oran));
          $('out-damga').textContent = tl(Math.min(C.dvUst, (toplam * binde) / 1000));
          $('out-note').textContent =
            'Toplam kira ' + tl(toplam) + ' · ' + imza + ' imza. Yazı ücreti, değerli kağıt ve noterin ücretlerine %20 KDV ayrıca eklenir.';
        }
      }
      ['in-tip', 'in-bedel', 'in-kasko', 'in-galeri', 'in-kira', 'in-sure', 'in-kefil'].forEach((id) => {
        $(id).addEventListener('input', update);
        $(id).addEventListener('change', update);
      });
      update();
    })();
  </script>

