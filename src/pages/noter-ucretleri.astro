---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import yd from '../../data/yeniden-degerleme.json';

// Noter ücretleri 2026 — tüm tutarlar birincil kaynaktan (doğrulama 2026-10-18):
// • 2026 Yılı Noterlik Ücret Tarifesi: RG 30.12.2025/33123 (Çeşitli İlanlar, Adalet Bakanlığı), 01.01.2026’dan
//   itibaren. 11. madde (yol ödeneği) RG 26.08.2026/33352 ile yeniden yazıldı; tutarlar değişmedi.
// • Önceki tarifeler: 2025 → RG 27.12.2024/32765 · 2024 → RG 06.04.2024/32512 · 2023 → RG 08.03.2023/32126.
// • Harçlar: 492 s. Harçlar Kanunu (2) sayılı tarife; 2026 tutarları Harçlar Kanunu Genel Tebliği (Seri No: 98),
//   RG 31.12.2025/33124 (5. Mük.). 2025 tutarları CB Kararı 10783 ile %18,95 artırıldı. Araç satış harcı
//   (binde 2, en az 1.000 TL) 7566 s. Kanun md. 7 ile 1.1.2026’da yürürlüğe girdi.
// • Değerli kağıt: Muhasebat GM Genel Tebliği (Sıra No: 97), RG 24.12.2025/33117.
// • Damga vergisi: DVK Genel Tebliği (Seri No: 71), RG 31.12.2025/33124 (5. Mük.). Kira + kefil oranları ve
//   vekaletname değerli kağıt kuralı: Adalet Bakanlığı Teftiş Kurulu noterlik denetim rehberi (2021).
// • Araç satışı: 2918 s. KTK md. 20/1-d (sözleşmeler damga vergisi ve değerli kağıt bedelinden istisna; tarife
//   yerine maktu ücret); harç muafiyetini 7566 s. K. md. 13 kaldırdı. HK md. 43: taşıt değeri kasko değerinden
//   düşük gösterilemez; kirada matrah sözleşme süresince ödenecek kira toplamı.
// • KDV %20: CB Kararı 7346 (RG 7.7.2023); değerli kağıt teslimi KDV K. md. 17/4-g ile istisna.
// Noterlik ücret tarifesi yeniden değerleme oranını İZLEMİYOR (2024 +%75, 2025 +%47, 2026 +%32) → 2027 tahmini
// yalnız harçlar için verilir (HK mük. 138: maktu harçlar ve alt/üst sınırlar her yıl YD oranında artar).
const BAZ = 2026;
const DOGRULAMA = '2026-10-18';

const TARIFE = { asgari: 58.82, oran: 0.3, yazi: 80.68, cevirme: 667.67, vasiyet: 2661.62 };
const TARIFE_TABLO = [
  { ad: 'Asgari noter ücreti (işlem başına)', y25: 44.56, y26: 58.82 },
  { ad: 'Yazı ücreti (sayfa başına)', y25: 61.12, y26: 80.68 },
  { ad: 'Karşılaştırma ücreti (sayfa başına)', y25: 61.12, y26: 80.68 },
  { ad: 'Çevirme ücreti (sayfa başına)', y25: 505.81, y26: 667.67, not: '10 satır veya daha kısa sayfada yarısı' },
  { ad: 'Vasiyetname ve vakıf senedi düzenleme ücreti', y25: 2016.38, y26: 2661.62 },
  { ad: 'Harçtan muaf işlemlerde imza başına ücret', y25: 51.2, y26: 67.58 },
  { ad: 'Emanet saklama ücreti (yıllık)', y25: 141.18, y26: 186.36 },
  { ad: 'Tescil ücreti (işlem başına)', y25: 19.1, y26: 25.21 },
  { ad: 'Bildirim yazı ücreti (yazı başına)', y25: 19.1, y26: 25.21 },
  { ad: 'Yol ödeneği (daire dışı iş, günlük)', y25: 242.12, y26: 319.6 },
  { ad: 'Elektronik tespit (ilk 1 MB)', y25: 27.27, y26: 36 },
];
const HARC = {
  vekalet: 307.9, // (2) II-3 vekaletnamelerde beher imza
  imza: 233.8, // (2) II-1 belli meblağ içermeyen kağıtlarda beher imza
  ihtar: 411.6, // (2) II-2 muhataba tebliğ edilecek beher nüsha
  suret: 37.8, // (2) II-5-a beher sayfa
  tercume: 104, // (2) II-5-b beher sayfa
  sabit: 1526.2, // (2) II-11 mirasçılık belgesi, ölüme bağlı tasarruf vb.
  nispiBinde: 1.13, // (2) I-1 beher imza
  nispiMin: 1526.2,
  nispiMax: 786596.8,
  aracBinde: 2, // (2) I-5 (7566 s. K.)
  aracMin: 1000,
  defterIsletme: 587.4,
  defterBilanco: 732,
  muhur: 187.4,
};
const DK = { noter: 149, beyanname: 149, vekalet: 298, ruhsat: 1511 };
const DV = { kira: 1.89, kiraAdi: 11.37, kiraMut: 9.48, mukavele: 9.48, ust: 29115961.1 }; // binde; üst sınır TL
const KDV = 20;
const ucret = (harc: number) => Math.max(TARIFE.asgari, harc * TARIFE.oran);

const nf = (n: number, d = 2) => n.toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d });
const tl = (n: number) => nf(n, 2);
const fmt = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));
const pct = (yeni: number, eski: number) => Math.round((yeni / eski - 1) * 100);

// Geçmiş tarifeler (Resmî Gazete metinlerinden) — artış = yazı ücretindeki değişim (tüm kalemler aynı oranda arttı)
type Gecmis = { uygulamaYili: number; oran: number; uygulanan: number | null };
const GECMIS = [
  { yil: 2023, rg: '8 Mart 2023', yazi: 23.76, asgari: 17.32 },
  { yil: 2024, rg: '6 Nisan 2024', yazi: 41.58, asgari: 30.31 },
  { yil: 2025, rg: '27 Aralık 2024', yazi: 61.12, asgari: 44.56 },
  { yil: 2026, rg: '30 Aralık 2025', yazi: 80.68, asgari: 58.82 },
].map((g, i, arr) => ({
  ...g,
  artis: i > 0 ? pct(g.yazi, arr[i - 1].yazi) : null,
  yd: (yd.gecmis as Gecmis[]).find((x) => x.uygulamaYili === g.yil) ?? null,
}));
const artislar = GECMIS.slice(1).map((g) => `%${g.artis}`);
const sonUc = `${artislar.slice(0, -1).join(', ')} ve ${artislar[artislar.length - 1]}`;
const tarifeArtis = pct(TARIFE_TABLO[0].y26, TARIFE_TABLO[0].y25); // 2025→2026: tüm kalemler %32

// 2027 harç tahmini: Cumhurbaşkanı kararı (uygulananOrani) > VUK tebliği > 12 aylık ortalama Yİ-ÜFE
const MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const sonAyAdi = `${MONTHS[+yd.sonAy.slice(5) - 1]} ${yd.sonAy.slice(0, 4)}`;
const HEDEF = yd.hedefYil;
const teblig = yd.tebligOrani as number | null;
const uygulanan = (yd as { uygulananOrani?: number | null }).uygulananOrani ?? null;
const oran = uygulanan ?? teblig ?? yd.onikiAyOrt;
const durum = uygulanan || teblig ? 'teblig' : yd.ekimVerisiGeldi ? 'hesap' : 'tahmin';
const oranLabel = durum === 'tahmin' ? `≈%${nf(oran, 1)}` : `%${nf(oran, 2)}`;
const carpan = 1 + oran / 100;
const tahminGecerli = HEDEF === BAZ + 1; // taban tutarlar 2026; veri dosyası ileri yıla geçerse tahmin gizlenir
const durumMetni = uygulanan
  ? `harçlara Cumhurbaşkanı kararıyla uygulanacak oran %${nf(uygulanan, 2)}`
  : durum === 'teblig'
    ? `yeniden değerleme oranı Resmî Gazete’de %${nf(oran, 2)} olarak ilan edildi`
    : durum === 'hesap'
      ? `Ekim Yİ-ÜFE verisiyle oran hesaben %${nf(oran, 2)} olarak kesinleşti (tebliğ Kasım sonunda)`
      : `${sonAyAdi} Yİ-ÜFE verisine göre oran yaklaşık %${nf(oran, 1)} (tahmin; Ekim verisiyle kesinleşir)`;

const TAHMIN = [
  { ad: 'Vekaletname harcı (imza başına)', t: HARC.vekalet },
  { ad: 'İmza onayı harcı (imza başına)', t: HARC.imza },
  { ad: 'İhtarname harcı (muhatap başına)', t: HARC.ihtar },
  { ad: 'Mirasçılık belgesi ve vasiyetname harcı', t: HARC.sabit },
  { ad: 'Para içeren sözleşmede asgari harç', t: HARC.nispiMin },
  { ad: 'Araç satış harcının alt sınırı', t: HARC.aracMin },
];

// Hesaplayıcı varsayılanı (sunucuda da aynı sonuç basılır)
const D = { bedel: 1000000, kira: 20000, sure: 12 };
const aracHarc = Math.max(HARC.aracMin, (D.bedel * HARC.aracBinde) / 1000);
const kiraToplam = D.kira * D.sure;
const kiraHarc = Math.min(HARC.nispiMax, Math.max(HARC.nispiMin, (kiraToplam * HARC.nispiBinde * 2) / 1000));
const kiraDamga = (kiraToplam * DV.kira) / 1000;

const faq = [
  {
    q: '2026 noter ücretleri ne kadar?',
    a: `Noterde ödenen tutar işleme göre değişir; harç, noter ücreti, yazı ücreti, değerli kağıt bedeli, varsa damga vergisi ve KDV’den oluşur. 2026’da noter ücreti harcın %30’udur ve bir işlemde ${tl(TARIFE.asgari)} TL’den az olamaz; yazı ücreti sayfa başına ${tl(TARIFE.yazi)} TL’dir. Harç vekaletnamede imza başına ${tl(HARC.vekalet)} TL, imza onayında ${tl(HARC.imza)} TL, ihtarnamede muhatap başına ${tl(HARC.ihtar)} TL, mirasçılık belgesinde ${tl(HARC.sabit)} TL’dir. Tutarlar 30 Aralık 2025 tarihli Resmî Gazete’de yayımlanan 2026 Yılı Noterlik Ücret Tarifesi ile Harçlar Kanunu tarifelerine dayanır.`,
  },
  {
    q: 'Araç satışında noter masrafı ne kadar?',
    a: `1 Ocak 2026’dan itibaren ikinci el araç satışında satış bedelinin binde 2’si oranında harç alınır ve bu tutar ${fmt(HARC.aracMin)} TL’den az olamaz; örneğin ${fmt(D.bedel)} TL’lik araçta harç ${fmt(aracHarc)} TL’dir. Bedel, aracın kasko değerinden düşük gösterilemez. Alıcı ikinci el ticaret yetki belgesi olan bir galeriyse harç alınmaz. Satış sözleşmesinden damga vergisi alınmaz; yeni ruhsat için ${fmt(DK.ruhsat)} TL tescil belgesi bedeli ödenir. Noter bu işlemde ücret tarifesi yerine Karayolları Trafik Kanunu’nun 20/d maddesindeki maktu ücreti alır.`,
  },
  {
    q: 'Vekaletname ücreti 2026’da ne kadar?',
    a: `Vekaletnamede harç, vekalet veren kişi başına ${tl(HARC.vekalet)} TL; noter ücreti bunun %30’u olan ${tl(HARC.vekalet * TARIFE.oran)} TL’dir. Buna ${fmt(DK.vekalet)} TL vekaletname değerli kağıdı, noterde kalan nüsha ile size verilen asıl ve örneklerin her sayfası için ${tl(TARIFE.yazi)} TL yazı ücreti ve noterin ücretlerine %${KDV} KDV eklenir; damga vergisi alınmaz. Genel, özel veya avukat vekaletnamesi olması harcı değiştirmez; toplamı sayfa, nüsha ve vekalet veren sayısı belirler.`,
  },
  {
    q: `${BAZ + 1}’de noter ücretleri ne kadar artacak?`,
    a: tahminGecerli
      ? `Harçlar 1 Ocak ${BAZ + 1}’de yeniden değerleme oranında artar; ${durumMetni}. Bu oranla vekaletname harcı yaklaşık ${fmt(HARC.vekalet * carpan)} TL, mirasçılık belgesi harcı yaklaşık ${fmt(HARC.sabit * carpan)} TL olur${durum === 'tahmin' ? ' (tahmin)' : ''}. Cumhurbaşkanı farklı oran belirleyebilir: 2026’da %25,49 yerine %18,95 uygulandı. Noterin kendi ücret tarifesi ise bu orana bağlı değildir; son üç tarifede artış ${sonUc} oldu. Son iki tarife Aralık sonunda Resmî Gazete’de yayımlandı.`
      : `Harçlar her yıl 1 Ocak’ta yeniden değerleme oranında artar; Cumhurbaşkanı farklı oran belirleyebilir. Noterin kendi ücret tarifesi bu orana bağlı değildir; son üç tarifede artış ${sonUc} oldu.`,
  },
  {
    q: 'Noter ücretlerine KDV dahil mi?',
    a: `Hayır, KDV ayrıca eklenir. %${KDV} KDV, noterin kendi ücretleri (noter ücreti, yazı ücreti gibi) üzerinden hesaplanır. Harç ve damga vergisi devlete ödenen vergilerdir, KDV eklenmez; değerli kağıt bedeli de KDV’den istisnadır.`,
  },
  {
    q: 'Kira sözleşmesini noterde onaylatmak ne kadar tutar?',
    a: `Kira sözleşmesinde harç, sözleşme süresince ödenecek toplam kiranın binde 1,13’ü kadar her imza için alınır ve tüm imzalar için ${tl(HARC.nispiMin)} TL’den az olamaz. Noter ücreti harcın %30’udur (en az ${tl(ucret(HARC.nispiMin))} TL). Damga vergisi toplam kiranın binde 1,89’u; adi kefil varsa binde 11,37, müteselsil kefil varsa binde 9,48’dir. Örneğin aylık ${fmt(D.kira)} TL, ${D.sure} aylık kefilsiz sözleşmede harç ${tl(kiraHarc)} TL, noter ücreti ${tl(ucret(kiraHarc))} TL, damga vergisi ${tl(kiraDamga)} TL’dir; yazı ücreti, değerli kağıt ve KDV ayrıca eklenir.`,
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Noter Ücretleri 2026', url: '/noter-ucretleri/' },
];

const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Noter ücretleri 2026: harç, noter ücreti, değerli kağıt ve ${BAZ + 1} harç tahmini`,
  description: `2026 Noterlik Ücret Tarifesi (2025 karşılaştırmalı), Harçlar Kanunu (2) sayılı tarife noter harçları, noter değerli kağıt bedelleri, araç satış harcı ve kira sözleşmesi damga vergisi; ${BAZ + 1} harç tahmini ${oranLabel}.`,
  url: 'https://parafomo.com/noter-ucretleri/',
  dateModified: yd.updated > DOGRULAMA ? yd.updated : DOGRULAMA,
  creator: { '@type': 'Organization', name: 'ParaFOMO', url: 'https://parafomo.com/' },
  isBasedOn: 'https://www.resmigazete.gov.tr',
  license: 'https://creativecommons.org/licenses/by/4.0/',
};
const dogrulamaLabel = new Date(DOGRULAMA + 'T12:00:00').toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={`Noter Ücretleri 2026 ve ${BAZ + 1}: Araç Satışı, Vekaletname Harcı`}
  description={`Noter ücretleri 2026: vekaletname harcı imza başına 307,90 TL, araç satışında binde 2 harç (en az 1.000 TL), yazı ücreti 80,68 TL. ${BAZ + 1} harç tahmini.`}
  faq={faq}
  breadcrumbs={breadcrumbs}
  image="/og/noter-ucretleri.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(dataset)} />
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Harç ve ücretler · {BAZ + 1} zam sezonu</p>
      <h1>Noter Ücretleri 2026: Araç Satışı, Vekaletname ve Diğer İşlemler</h1>
      <p class="lede">
        Notere ödenen tutar; devlete giden <strong>harç</strong>, noterin <strong>ücreti</strong>, yazı ücreti,
        değerli kağıt, varsa damga vergisi ve KDV’den oluşur. 2026 tutarlarının tamamı Resmî Gazete’den;
        {BAZ + 1} için harç tahmini aşağıda.
      </p>
    </header>

    <div class="kpi-row">
      <div class="kpi">
        <span class="kpi-label">Vekaletname harcı</span>
        <span class="kpi-val">₺{tl(HARC.vekalet)}</span>
        <span class="kpi-sub">vekalet veren kişi başına · 2026</span>
      </div>
      <div class="kpi">
        <span class="kpi-label">Araç satış harcı</span>
        <span class="kpi-val">Binde 2</span>
        <span class="kpi-sub">en az ₺{fmt(HARC.aracMin)} · 1 Ocak 2026’dan beri</span>
      </div>
      <div class="kpi">
        <span class="kpi-label">{BAZ + 1} harç artışı {durum === 'tahmin' ? '(tahmin)' : ''}</span>
        <span class="kpi-val">{tahminGecerli ? oranLabel : '—'}</span>
        <span class="kpi-sub">noterin ücret tarifesi bu orana bağlı değil</span>
      </div>
    </div>

    <div class="calc-grid">
      <form class="calc-inputs" id="calc-form" autocomplete="off">
        <label>
          <span>İşlem</span>
          <select id="in-tip">
            <option value="arac" selected>İkinci el araç satışı</option>
            <option value="kira">Kira sözleşmesi (noter onaylı)</option>
          </select>
        </label>
        <div class="grp" id="grp-arac">
          <label>
            <span>Satış bedeli (₺)</span>
            <input type="number" id="in-bedel" value={D.bedel} min="0" step="10000" inputmode="numeric" />
          </label>
          <label>
            <span>Kasko değeri (₺) <em class="hint">— biliyorsanız</em></span>
            <input type="number" id="in-kasko" placeholder="0" min="0" step="10000" inputmode="numeric" />
          </label>
          <label class="check">
            <input type="checkbox" id="in-galeri" />
            <span>Alıcı, ikinci el ticaret yetki belgesi olan galeri</span>
          </label>
        </div>
        <div class="grp" id="grp-kira" hidden>
          <label>
            <span>Aylık kira (₺)</span>
            <input type="number" id="in-kira" value={D.kira} min="0" step="500" inputmode="numeric" />
          </label>
          <label>
            <span>Sözleşme süresi (ay)</span>
            <input type="number" id="in-sure" value={D.sure} min="1" max="120" step="1" inputmode="numeric" />
          </label>
          <label>
            <span>Kefil</span>
            <select id="in-kefil">
              <option value="yok" selected>Kefil yok</option>
              <option value="adi">Adi kefil</option>
              <option value="mut">Müteselsil kefil / müşterek borçlu</option>
            </select>
          </label>
        </div>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label">Harç (devlete ödenen)</span>
          <span class="result-value" id="out-harc">₺{tl(aracHarc)}</span>
        </div>
        <div class="result-split">
          <div class="split-item">
            <span class="split-label">Noter ücreti</span>
            <span class="split-val" id="out-ucret">Maktu (KTK 20/d)</span>
          </div>
          <div class="split-item">
            <span class="split-label">Damga vergisi</span>
            <span class="split-val" id="out-damga">Yok (istisna)</span>
          </div>
          <div class="split-item" id="row-ruhsat">
            <span class="split-label">Ruhsat (tescil belgesi) bedeli</span>
            <span class="split-val">₺{tl(DK.ruhsat)}</span>
          </div>
        </div>
        <p class="result-note" id="out-note">
          Harç, kasko değerinden düşük olmayan bedelin binde 2’si; noter ayrıca kanundaki maktu ücreti alır.
        </p>
      </div>
    </div>

    <p class="disclaimer">
      Hesaplayıcı yalnız değere bağlı kalemleri gösterir, toplam ücret değildir: yazı ücreti (sayfa başına
      ₺{tl(TARIFE.yazi)}), değerli kağıt bedeli ve noterin ücretlerine eklenen %{KDV} KDV belgenin sayfa ve nüsha
      sayısına göre değişir. Kesin tutar noter makbuzundaki dökümdür. Tutarlar {dogrulamaLabel}’de Resmî Gazete
      metinleriyle kontrol edildi.
    </p>

    <section class="table-block">
      <h2>2026 noter ücretleri: işlem bazında harç ve ücretler</h2>
      <div class="table-scroll">
        <table class="rate-table">
          <thead><tr><th>İşlem</th><th>Harç (2026)</th><th>Noter ücreti ve diğer kalemler</th></tr></thead>
          <tbody>
            <tr>
              <td><strong>Vekaletname</strong><span class="row-note">genel, özel, avukat, tapu</span></td>
              <td>₺{tl(HARC.vekalet)}<span class="row-note">vekalet veren kişi başına</span></td>
              <td>Noter ücreti kişi başına ₺{tl(HARC.vekalet * TARIFE.oran)} · vekaletname değerli kağıdı ₺{fmt(DK.vekalet)} · yazı ücreti · KDV<span class="row-note">Damga vergisi alınmaz.</span></td>
            </tr>
            <tr>
              <td><strong>İkinci el araç satışı</strong></td>
              <td>Bedelin binde 2’si<span class="row-note">en az ₺{fmt(HARC.aracMin)}; galeriye satışta alınmaz</span></td>
              <td>Ruhsat (tescil belgesi) bedeli ₺{fmt(DK.ruhsat)} · noterin maktu ücreti (KTK md. 20/d)<span class="row-note">Damga vergisi alınmaz; bedel kasko değerinden düşük gösterilemez.</span></td>
            </tr>
            <tr>
              <td><strong>İmza onayı</strong><span class="row-note">imza beyannamesi, muvafakatname vb.</span></td>
              <td>₺{tl(HARC.imza)}<span class="row-note">imza başına (belge para tutarı içermiyorsa)</span></td>
              <td>Noter ücreti imza başına ₺{tl(HARC.imza * TARIFE.oran)} · yazı veya karşılaştırma ücreti · varsa değerli kağıt · KDV</td>
            </tr>
            <tr>
              <td><strong>İhtarname</strong></td>
