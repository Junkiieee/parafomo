---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import yd from '../../data/yeniden-degerleme.json';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
// Noter sayfası paralel geliştiriliyordu: dosyası yoksa link verilmez (kırık link olmasın)
const hasNoter = existsSync(join(process.cwd(), 'src', 'pages', 'noter-ucretleri.astro'));

// Damga vergisi = kağıttaki tutar × nispi oran (binde) ya da maktu (sabit) tutar — 488 s. DVK + ekli (1) sayılı tablo.
// 2026 oran/tutarları BİRİNCİL kaynaktan okundu (2026-10-18): DVK Genel Tebliği Seri No 71, RG 31.12.2025 sayı 33124
// (5. mük.) — ek (1) sayılı tablo + üst sınır 29.115.961,10 TL. Maktu tutarlar ve üst sınır 10783 s. CB Kararı ile
// %25,49 (YD) yerine %18,95 artırıldı. Nüsha kuralı (md. 5) ve kira istisnaları ((2) s. tablo IV-31/32):
// DVK Genel Tebliği Seri No 60, RG 29.09.2016. 2026’da çıkan 7577 ve 7587 s. Kanunlar DVK’ya dokunmadı.
// 2027: maktu tutarlar + üst sınır 2026 YD oranında artar (md. 14, mük. 30; 10 kuruşa kadar kesir atılır);
// Cumhurbaşkanı farklı oran belirleyebilir → data/yeniden-degerleme.json `uygulananOrani`. Nispi oranlar sabit kalır.
// GÜNCELLEME: Seri No 72 (Aralık 2026 sonu) yayımlanınca BAZ_YIL = 2027 yap, tutarları tebliğden yenile.
const BAZ_YIL = 2026;
const UST_SINIR = 29115961.1; // bir kağıttan alınabilecek azami damga vergisi (TL)
const MIN_BRUT = 33030; // 2026 aylık brüt asgari ücret → damga istisnası 33.030 × binde 7,59 = 250,70 TL
const MIN_DAMGA = Math.round(MIN_BRUT * 0.759) / 100;

const HEDEF = yd.hedefYil;
const teblig = yd.tebligOrani as number | null;
const uygulanan = (yd as { uygulananOrani?: number | null }).uygulananOrani ?? null;
const oran = uygulanan ?? teblig ?? yd.onikiAyOrt; // maktu damga vergisine uygulanacak artış (%)
const durum = uygulanan != null || teblig != null ? 'teblig' : yd.ekimVerisiGeldi ? 'hesap' : 'tahmin';
const showProj = HEDEF === BAZ_YIL + 1; // baz tutarlar yenilenmeden hedef yıl kayarsa tahmini gizle

const MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const monthName = (key: string) => `${MONTHS[+key.slice(5) - 1]} ${key.slice(0, 4)}`;
const sonAyAdi = monthName(yd.sonAy);
const nf = (n: number, d = 1) => n.toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d });
const tl = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const oranLabel = durum === 'tahmin' ? `≈%${nf(oran)}` : `%${nf(oran, 2)}`;
const yaklasik = uygulanan == null ? '≈' : ''; // CB kararı yayımlanana dek gelecek yıl tutarları tahmindir
const p27 = uygulanan == null ? `${HEDEF} tahmini` : `${HEDEF}`;
const p27Baslik = uygulanan == null ? `${HEDEF} Tahmini` : `${HEDEF} Tutarları`;
const sonrakiTarih = new Date(yd.sonrakiAciklama + 'T10:00:00+03:00').toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
// Eylül verisi elimizdeyse sıradaki TÜİK açıklaması Ekim verisidir (oranı kesinleştiren gün).
const ekimTarih = yd.sonAy === `${HEDEF - 1}-09` ? sonrakiTarih : null;
const ekimNe = ekimTarih ? ekimTarih + '’da' : 'Kasım başında';
const updatedLabel = new Date(yd.updated + 'T12:00:00').toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

// Gelecek yıl tutarı: kuruş cinsinden tam sayı aritmetiği, 10 kuruşa kadar kesirler atılır (DVK mük. 30).
const bp = Math.round(oran * 100);
const proj = (t: number) => (Math.floor((Math.round(t * 100) * (10000 + bp)) / 100000) * 10) / 100;

// Hesaplayıcı belge türleri — oranlar/tutarlar Tebliğ 71 ekindeki (1) sayılı tablodan.
type Tip = {
  key: string; label: string; permil?: number; tl?: number; tl27?: number;
  mode?: 'tutar' | 'kira' | 'ucret'; inLabel?: string; istisna?: boolean; taraf?: boolean;
  nusha?: 'tek' | 'her'; beyan?: boolean; not: string;
};
const TIP_LISTE: Tip[] = [
  { key: 'sozlesme', label: 'Sözleşme / taahhütname (bedelli)', permil: 9.48, mode: 'tutar', inLabel: 'Sözleşme bedeli (₺)', taraf: true,
    not: 'Kaç nüsha imzalanırsa imzalansın nispi vergi tek nüsha üzerinden alınır (DVK md. 5). Vergiyi kağıdı imzalayanlar öder; ödenmezse hepsi müteselsilen sorumludur.' },
  { key: 'kira', label: 'Kira sözleşmesi (işyeri vb.)', permil: 1.89, mode: 'kira', taraf: true,
    not: 'Matrah aylık kira değil, sözleşme süresince ödenecek toplam kiradır. Muaf esnaf, muaf serbest meslek erbabı ve basit usul mükelleflerinin işyeri kira sözleşmeleri istisnadır.' },
  { key: 'konut', label: 'Konut kira sözleşmesi (kiracı gerçek kişi)', permil: 1.89, mode: 'kira', istisna: true, taraf: true,
    not: 'Kiracısı gerçek kişi olan ve bir işletmeye dahil olmayan konutun kira sözleşmesi, kefalet şerhleriyle birlikte damga vergisinden istisnadır.' },
  { key: 'arac', label: 'İkinci el araç satış sözleşmesi', permil: 1.89, mode: 'tutar', inLabel: 'Satış bedeli (₺)', taraf: true,
    not: 'Trafikte tescilli ikinci el araçların satış ve devir sözleşmelerinde oran binde 1,89’dur; tek nüsha vergilenir.' },
  { key: 'ucret', label: 'Maaş / ücret (aylık brüt)', permil: 7.59, mode: 'ucret', inLabel: 'Aylık brüt ücret (₺)',
    not: 'Brüt ücretin asgari ücrete kadar olan kısmı istisnadır; aşan kısma binde 7,59 uygulanır. Vergiyi işveren bordrodan keser.' },
  { key: 'kefalet', label: 'Kefalet, teminat, rehin senedi', permil: 9.48, mode: 'tutar', inLabel: 'Teminat tutarı (₺)',
    not: 'Kefalet, teminat ve rehin senetlerinde oran binde 9,48’dir; matrah teminat altına alınan tutardır.' },
  { key: 'ihale', label: 'Kamu ihale kararı', permil: 5.69, mode: 'tutar', inLabel: 'İhale bedeli (₺)',
    not: 'İhale kararında binde 5,69 uygulanır; ihaleden sonra idareyle imzalanan sözleşme ayrı kağıt olarak binde 9,48’e tabidir.' },
  { key: 'gvb', label: 'Yıllık gelir vergisi beyannamesi', tl: 1189.5, nusha: 'tek', beyan: true, not: '' },
  { key: 'kvb', label: 'Kurumlar vergisi beyannamesi', tl: 1605.8, nusha: 'tek', beyan: true, not: '' },
  { key: 'kdv', label: 'KDV beyannamesi', tl: 791, nusha: 'tek', beyan: true, not: '' },
  { key: 'muhtasar', label: 'Muhtasar beyanname', tl: 791, nusha: 'tek', beyan: true, not: '' },
  { key: 'mphb', label: 'Muhtasar ve prim hizmet beyannamesi', tl: 939.7, nusha: 'tek', beyan: true, not: '' },
  { key: 'bilanco', label: 'Bilanço (resmî daire / banka)', tl: 616.3, nusha: 'her', not: '' },
  { key: 'gelirtab', label: 'Gelir tablosu / işletme hesabı özeti', tl: 294.2, nusha: 'her', not: '' },
  { key: 'tahkim', label: 'Tahkimname / sulhname (bedelsiz)', tl: 799.8, nusha: 'her', not: '' },
];
const TIPLER: Tip[] = TIP_LISTE.map((t) => (t.tl != null ? { ...t, tl27: proj(t.tl) } : t));
const NISPI = TIPLER.filter((t) => t.tl == null);
const MAKTU = TIPLER.filter((t) => t.tl != null);

// Varsayılan hesap (JS kapalıyken de doğru görünsün)
const D = { type: 'sozlesme', amount: 1000000, rent: 25000, months: 12 };
const tax0 = Math.round(D.amount * 9.48) / 1000;

// Oran tablosu (nispi)
const ORANLAR: [string, string, string][] = [
  ['Sözleşmeler, taahhütnameler, temliknameler', 'binde 9,48', 'Sözleşme bedeli'],
  ['Kira sözleşmeleri', 'binde 1,89', 'Sözleşme süresince toplam kira'],
  ['Konut kira sözleşmesi (kiracı gerçek kişi, mesken)', 'istisna', 'Taşınmaz bir işletmeye dahil değilse'],
  ['Kefalet, teminat ve rehin senetleri', 'binde 9,48', 'Teminat tutarı'],
  ['İkinci el araç satış ve devir sözleşmeleri', 'binde 1,89', 'Satış bedeli'],
  ['Tüketici sözleşmeleri (taksitli ve mesafeli satış, abonelik, paket tur, devre tatil)', 'binde 9,48', 'Sözleşme bedeli'],
  ['Elektrik ve doğal gaz satış sözleşmeleri', 'binde 9,48', 'Sözleşme bedeli'],
  ['Meclis ve resmî heyet kararları ile hakem kararları (belli parayı içeren)', 'binde 9,48', 'Karardaki tutar'],
  ['Kamu ihale kararları', 'binde 5,69', 'İhale bedeli'],
  ['Maaş, ücret, ikramiye, tazminat vb. ödemeler', 'binde 7,59', 'Brüt tutar (ücrette asgari ücret kısmı istisna)'],
  ['Ödünç para makbuzları ve bu nitelikteki senetler', 'binde 7,59', 'Ödünç alınan tutar'],
  ['Resmî gayrimenkul satış vaadi, ön ödemeli konut satışı, kat karşılığı inşaat ve yapı denetimi sözleşmeleri', 'binde 0', '—'],
];

// Maktu tutarlar (2026) — üst sınır dahil
const MAKTU_TABLO: { ad: string; t: number }[] = [
  { ad: 'Bir kağıt için azami damga vergisi (üst sınır)', t: UST_SINIR },
  { ad: 'Yıllık gelir vergisi beyannamesi', t: 1189.5 },
  { ad: 'Kurumlar vergisi beyannamesi', t: 1605.8 },
  { ad: 'KDV beyannamesi', t: 791 },
  { ad: 'Muhtasar beyanname', t: 791 },
  { ad: 'Muhtasar ve prim hizmet beyannamesi', t: 939.7 },
  { ad: 'Diğer vergi beyannameleri (damga vergisi hariç)', t: 791 },
  { ad: 'Gümrük idarelerine verilen beyannameler', t: 1605.8 },
  { ad: 'Belediye ve il özel idaresi beyannameleri', t: 588.8 },
  { ad: 'SGK sigorta prim bildirgeleri', t: 588.8 },
  { ad: 'Bilanço (resmî daire ve bankalara verilen)', t: 616.3 },
  { ad: 'Gelir tablosu', t: 294.2 },
  { ad: 'İşletme hesabı özeti', t: 294.2 },
  { ad: 'Tahkimname, sulhname, belli parayı içermeyen kararlar', t: 799.8 },
  { ad: 'Turizm işletmesi–acente kontenjan sözleşmeleri', t: 4500.1 },
];

const oranCumle =
  durum === 'tahmin'
    ? `${sonAyAdi} Yİ-ÜFE verisiyle bu oran yaklaşık %${nf(oran)}; kesin oran Ekim verisiyle ${ekimNe} hesaben belli olur, tebliğ Kasım sonunda yayımlanır.`
    : durum === 'hesap'
      ? `Ekim ${HEDEF - 1} verisiyle oran hesaben %${nf(oran, 2)} olarak belli oldu; resmî tebliğ Kasım sonunda yayımlanır.`
      : uygulanan != null
        ? `Damga vergisinde uygulanacak oran Cumhurbaşkanı kararıyla %${nf(oran, 2)} olarak belirlendi.`
        : `Yeniden değerleme oranı %${nf(oran, 2)} olarak ilan edildi; Cumhurbaşkanı kararı henüz yayımlanmadı.`;

const faq = [
  {
    q: 'Damga vergisi nasıl hesaplanır?',
    a: `Damga vergisi iki şekilde alınır. Nispi vergide kağıtta yazılı tutar oranla çarpılır: sözleşme, taahhütname ve kefalette binde 9,48, kira sözleşmesinde binde 1,89, maaş ve ücret ödemelerinde binde 7,59. Örneğin 1.000.000 ₺’lik bir sözleşmenin damga vergisi 1.000.000 × 0,00948 = 9.480 ₺’dir. Maktu vergide ise tutar sabittir: ${BAZ_YIL}’da yıllık gelir vergisi beyannamesi için 1.189,50 ₺, KDV beyannamesi için 791 ₺ ödenir. Bir kağıttan alınabilecek damga vergisi ${BAZ_YIL}’da en fazla ${tl(UST_SINIR)} ₺’dir.`,
  },
  {
    q: 'Kira sözleşmesi damga vergisi ne kadar, kim öder?',
    a: `Kira sözleşmelerinde damga vergisi, sözleşme süresince ödenecek toplam kiranın binde 1,89’udur. Aylık 25.000 ₺ kiralı 1 yıllık bir işyeri sözleşmesinde vergi 300.000 × 0,00189 = 567 ₺, 2 yıllıkta 1.134 ₺ olur; nüsha sayısı sonucu değiştirmez. Kiracısı gerçek kişi olan ve bir işletmeye dahil olmayan konutların kira sözleşmeleri ise kefalet şerhleriyle birlikte damga vergisinden istisnadır. Vergiyi sözleşmeyi imzalayanlar öder; taraflar paylaşımı kendi aralarında kararlaştırabilir, ancak vergi ödenmezse imzalayanların hepsi müteselsilen sorumludur.`,
  },
  {
    q: 'Maaştan ne kadar damga vergisi kesilir?',
    a: `Maaş, ücret, ikramiye ve tazminat gibi ödemelerde damga vergisi binde 7,59’dur ve işveren tarafından bordrodan kesilir. 2022’den beri brüt ücretin asgari ücrete isabet eden kısmı istisnadır; ${BAZ_YIL}’da bu istisna aylık ${tl(MIN_DAMGA)} ₺’dir (33.030 × 0,00759). Örneğin brüt 50.000 ₺ maaştan (50.000 − 33.030) × 0,00759 = 128,80 ₺ damga vergisi kesilir; asgari ücretliden hiç kesilmez.`,
  },
  {
    q: `${HEDEF}’de damga vergisi ne kadar artacak?`,
    a: showProj
      ? `Nispi oranlar (binde 9,48, 1,89, 7,59) her yıl kendiliğinden değişmez. Beyanname tutarları gibi maktu vergiler ve bir kağıt için üst sınır ise 1 Ocak ${HEDEF}’de yeniden değerleme oranında artar. ${oranCumle} Bu oranla yıllık gelir vergisi beyannamesinin damga vergisi 1.189,50 ₺’den ${yaklasik}${tl(proj(1189.5))} ₺’ye, KDV beyannamesininki 791 ₺’den ${yaklasik}${tl(proj(791))} ₺’ye çıkar. ${uygulanan != null ? 'Benzer şekilde 2026’da da' : 'Cumhurbaşkanı farklı oran belirleyebilir: 2026’da'} yeniden değerleme oranı %25,49 olmasına rağmen damga vergisi tutarları %18,95 artırılmıştı.`
      : `Nispi oranlar her yıl kendiliğinden değişmez; maktu tutarlar ve üst sınır ise her yıl 1 Ocak’ta yeniden değerleme oranında (ya da Cumhurbaşkanı’nın belirlediği oranda) artar. Güncel tutarlar Aralık sonunda Resmî Gazete’de yayımlanan damga vergisi genel tebliğiyle ilan edilir.`,
  },
  {
    q: 'Sözleşme birden fazla nüsha imzalanırsa damga vergisi artar mı?',
    a: 'Oranla (nispi) hesaplanan kağıtlarda artmaz: 9 Ağustos 2016’dan beri sözleşme kaç nüsha düzenlenirse düzenlensin vergi yalnızca bir nüsha üzerinden alınır. Maktu vergiye tabi kağıtlarda ise her nüsha ayrı ayrı vergilenir; örneğin üç nüsha sulhname için 3 × 799,80 = 2.399,40 ₺ ödenir. Beyannamelerde yalnızca bir nüsha vergiye tabidir.',
  },
  {
    q: 'Damga vergisi ne zaman ve nasıl ödenir?',
    a: 'Gelir veya kurumlar vergisi mükellefi olmayan kişiler, kağıdın vergisini düzenlendiği tarihi izleyen 15 gün içinde vergi dairesine damga vergisi beyannamesiyle bildirip aynı süre içinde öder. Sürekli damga vergisi mükellefiyeti olan kurum ve işletmeler, bir ay içinde düzenledikleri kağıtların vergisini ertesi ay verdikleri beyannameyle öder. Maaşlardaki damga vergisi ise işveren tarafından bordrodan kesilip beyan edilir.',
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Damga Vergisi Hesaplama', url: '/damga-vergisi-hesaplama/' },
];
---

<BaseLayout
  title={`Damga Vergisi Hesaplama ${BAZ_YIL}: Oranlar, Kira, ${showProj ? `${HEDEF} Tutarları` : 'Beyanname'}`}
  description={`Damga vergisi hesaplama ${BAZ_YIL}: sözleşme binde 9,48, kira binde 1,89, maaş binde 7,59. Beyanname tutarları, üst sınır${showProj ? ` ve ${HEDEF} artışı (${oranLabel})` : ''} tek sayfada.`}
  faq={faq}
  breadcrumbs={breadcrumbs}
  image="/og/damga-vergisi-hesaplama.png"
>
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Hesaplayıcı · Vergi</p>
      <h1>Damga Vergisi Hesaplama {BAZ_YIL}{showProj && <> ve {p27Baslik}</>}</h1>
      <p class="lede">
        Belge türünü seçip tutarı girin; sözleşme, kira, maaş ve beyannamelerin <strong>{BAZ_YIL} damga vergisini</strong>
        {showProj && <> ve maktu tutarların <strong>{HEDEF}’de ne kadar olacağını</strong></>} görün. Kiracısı gerçek kişi
        olan konut kira sözleşmeleri, ev bir işletmeye dahil değilse vergiden istisnadır.
      </p>
    </header>

    <div class="kpi-row">
      <div class="kpi">
        <span class="kpi-label">Sözleşmeler</span>
        <span class="kpi-val">binde 9,48</span>
        <span class="kpi-sub">bedel üzerinden · tek nüsha vergilenir</span>
      </div>
      <div class="kpi">
        <span class="kpi-label">Kira sözleşmesi</span>
        <span class="kpi-val">binde 1,89</span>
        <span class="kpi-sub">toplam kira üzerinden · konut kirasında istisna var</span>
      </div>
      {showProj ? (
        <div class="kpi">
          <span class="kpi-label">{HEDEF} maktu artış{uygulanan == null && ' (tahmini)'}</span>
          <span class="kpi-val">{oranLabel}</span>
          <span class="kpi-sub">
            {durum === 'tahmin' ? `kesinleşme: ${ekimTarih ?? 'Kasım başı'} (Ekim Yİ-ÜFE)` : durum === 'hesap' ? 'tebliğ Kasım sonunda; CB farklı oran belirleyebilir' : uygulanan != null ? 'Cumhurbaşkanı kararıyla kesin' : 'Cumhurbaşkanı kararı bekleniyor'}
          </span>
        </div>
      ) : (
        <div class="kpi">
          <span class="kpi-label">Üst sınır {BAZ_YIL}</span>
          <span class="kpi-val kpi-small">₺{tl(UST_SINIR)}</span>
          <span class="kpi-sub">bir kağıttan alınabilecek en yüksek vergi</span>
        </div>
      )}
    </div>

    <div class="calc-grid">
      <form class="calc-inputs" id="calc-form" autocomplete="off">
        <label>
          <span>Belge türü</span>
          <select id="in-type">
            <optgroup label="Oranla hesaplanan kağıtlar (nispi)">
              {NISPI.map((t) => <option value={t.key} selected={t.key === D.type}>{t.label}</option>)}
            </optgroup>
            <optgroup label="Sabit tutarlı kağıtlar (maktu)">
              {MAKTU.map((t) => <option value={t.key}>{t.label}</option>)}
            </optgroup>
          </select>
        </label>
        <label id="row-amount">
          <span id="lbl-amount">Sözleşme bedeli (₺)</span>
          <input type="number" id="in-amount" value={D.amount} min="0" step="1000" inputmode="decimal" />
        </label>
        <div class="row2" id="row-kira" hidden>
          <label>
            <span>Aylık kira (₺)</span>
            <input type="number" id="in-rent" value={D.rent} min="0" step="500" inputmode="decimal" />
          </label>
          <label>
            <span>Süre (ay)</span>
            <input type="number" id="in-months" value={D.months} min="1" max="600" step="1" inputmode="numeric" />
          </label>
        </div>
        <label id="row-nusha" hidden>
          <span>Nüsha sayısı</span>
          <input type="number" id="in-nusha" value="1" min="1" max="50" step="1" inputmode="numeric" />
        </label>
        <label class="check" id="row-istisna" hidden>
          <input type="checkbox" id="in-istisna" checked />
          <span>Asgari ücret istisnasını uygula ({BAZ_YIL}: aylık {tl(MIN_DAMGA)} ₺)</span>
        </label>
      </form>

      <div class="calc-results" aria-live="polite">
        <div class="result-main">
          <span class="result-label">Ödenecek damga vergisi</span>
          <span class="result-value" id="out-tax">₺{tl(tax0)}</span>
        </div>
        <div class="result-split">
          <div class="split-item">
            <span class="split-label">Oran / tutar</span>
            <span class="split-val" id="out-rate">binde 9,48</span>
          </div>
          <div class="split-item" id="row-base">
            <span class="split-label">Matrah</span>
            <span class="split-val" id="out-base">₺{tl(D.amount)}</span>
          </div>
          <div class="split-item">
            <span class="split-label">Nüsha</span>
            <span class="split-val" id="out-nusha">tek nüsha vergilenir</span>
          </div>
