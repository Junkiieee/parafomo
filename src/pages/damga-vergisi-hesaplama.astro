  <script is:inline define:vars={{ TIPLER, UST_SINIR, MIN_BRUT, YAK: yaklasik }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf2 = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const money = (n) => '₺' + nf2.format(n);
      const r2 = (n) => Math.round(n * 100) / 100;
      const binde = (p) => 'binde ' + String(p).replace('.', ',');
      const num = (id) => Math.max(0, +$(id).value || 0);
      const show = (id, on) => { const el = $(id); if (el) el.hidden = !on; };
      function update() {
        const t = TIPLER.find((x) => x.key === $('in-type').value) || TIPLER[0];
        const maktu = t.tl != null;
        show('row-amount', t.mode === 'tutar' || t.mode === 'ucret');
        show('row-kira', t.mode === 'kira');
        show('row-nusha', maktu && t.nusha === 'her');
        show('row-istisna', t.mode === 'ucret');
        show('row-split', !!t.taraf);
        show('row-base', !maktu);
        if (t.inLabel) $('lbl-amount').textContent = t.inLabel;
        let tax = 0;
        let note = t.not;
        const p27 = $('out-27');
        if (maktu) {
          const n = t.nusha === 'her' ? Math.max(1, Math.floor(num('in-nusha')) || 1) : 1;
          tax = r2(t.tl * n);
          $('out-rate').textContent = 'maktu ' + money(t.tl);
          $('out-nusha').textContent = t.nusha === 'her' ? n + ' × ' + money(t.tl) : 'yalnız 1 nüsha vergilenir';
          note = t.beyan
            ? 'Beyannamelerin yalnız bir nüshası vergilenir; süresi içinde verilen düzeltme beyannamelerinden alınmaz.'
            : 'Maktu vergide her nüsha ayrı ayrı vergilenir; tutar kağıttaki bedelden bağımsızdır.';
          if (p27) p27.textContent = YAK + money(r2(t.tl27 * n));
        } else {
          const base = t.mode === 'kira' ? num('in-rent') * Math.floor(num('in-months')) : num('in-amount');
          let raw = (base * t.permil) / 1000;
          if (t.mode === 'ucret' && $('in-istisna').checked) raw = (Math.max(0, base - MIN_BRUT) * t.permil) / 1000;
          let capped = false;
          if (raw > UST_SINIR) { raw = UST_SINIR; capped = true; }
          const normal = r2(raw);
          tax = t.istisna ? 0 : normal;
          $('out-rate').textContent = t.istisna ? 'istisna' : binde(t.permil);
          $('out-base').textContent = money(base);
          $('out-nusha').textContent = t.istisna ? '—' : t.mode === 'ucret' ? 'her ödemede' : 'tek nüsha vergilenir';
          if (t.istisna) note += ' Şart sağlanmazsa (ör. konut şirkete aitse ya da kiracı şirketse) vergi binde 1,89: ' + money(normal) + '.';
          if (capped && !t.istisna) note += ' Üst sınır (' + money(UST_SINIR) + ') uygulandı.';
          if (p27) p27.textContent = t.mode === 'ucret' ? 'oran aynı, istisna yeni asgari ücretle' : 'oran aynı kalır';
        }
        $('out-tax').textContent = money(tax);
        $('out-split').textContent = money(r2(tax / 2));
        $('out-note').textContent = note;
      }
      $('calc-form').addEventListener('submit', (e) => e.preventDefault());
      ['in-type', 'in-amount', 'in-rent', 'in-months', 'in-nusha', 'in-istisna'].forEach((id) => {
        $(id).addEventListener('input', update);
        $(id).addEventListener('change', update);
      });
      update();
    })();
  </script>

