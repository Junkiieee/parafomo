---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';

// "yüzde hesaplama" (Trends ≈234, "mevduat faizi" = 100) — 4 mod: X'in %Y'si · X, Y'nin yüzde kaçı ·
// yüzde değişim · %Y ekle/çıkar (zam, indirim). Finans bağlamı: zam, enflasyon, getiri, KDV.
const nf = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 }).format(n);

const faq = [
  { q: 'Yüzde nasıl hesaplanır?', a: 'Bir sayının yüzdesini bulmak için sayıyı yüzde oranıyla çarpıp 100\'e bölersiniz: 2.000\'in %15\'i = 2.000 × 15 ÷ 100 = 300. Bir sayının diğerinin yüzde kaçı olduğunu bulmak için ise küçük sayıyı büyüğe bölüp 100 ile çarparsınız: 300, 2.000\'in (300 ÷ 2.000) × 100 = %15\'idir.' },
  { q: 'Yüzde artış (değişim) nasıl hesaplanır?', a: 'Yüzde değişim = (Yeni değer − Eski değer) ÷ Eski değer × 100. Maaşınız 30.000 ₺\'den 36.000 ₺\'ye çıktıysa artış (36.000 − 30.000) ÷ 30.000 × 100 = %20\'dir. Sonuç eksiyse düşüş vardır.' },
  { q: 'Bir sayıya yüzde nasıl eklenir veya çıkarılır?', a: 'Yüzde eklemek için sayıyı (1 + oran/100) ile, çıkarmak için (1 − oran/100) ile çarparsınız. 25.000 ₺ maaşa %30 zam: 25.000 × 1,30 = 32.500 ₺. 1.000 ₺\'lik ürüne %20 indirim: 1.000 × 0,80 = 800 ₺.' },
  { q: '%50 düşen bir şey eski haline gelmek için yüzde kaç artmalı?', a: '%100. Yüzdeler farklı tabanlara uygulandığı için simetrik değildir: 100 → 50 düşüş %50\'dir, ama 50 → 100 dönüşü %100 artış ister. Aynı nedenle %20 artan bir fiyat sonra %20 düşerse başlangıcın %4 altında kalır (1,2 × 0,8 = 0,96).' },
  { q: 'Zam oranı ile enflasyon nasıl karşılaştırılır?', a: 'Reel değişim = (1 + zam oranı) ÷ (1 + enflasyon) − 1. %40 zam ve %30 enflasyonda reel artış 1,40 ÷ 1,30 − 1 ≈ %7,7\'dir; yani zam oranından enflasyonu düz çıkarmak (%10) biraz yanıltır.' },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Yüzde Hesaplama', url: '/yuzde-hesaplama/' },
];
---

<BaseLayout
  title="Yüzde Hesaplama | Yüzdesini Bul, Yüzde Kaç, Yüzde Artış ve İndirim Hesabı"
  description="Ücretsiz yüzde hesaplama aracı: bir sayının yüzdesini bulun, bir sayının diğerinin yüzde kaçı olduğunu hesaplayın, yüzde artış/azalışı ve zam-indirim sonrası tutarı anında görün. Formüller ve örneklerle."
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Hesaplayıcı · Yüzde</p>
      <h1>Yüzde Hesaplama</h1>
      <p class="lede">Dört yaygın yüzde hesabı tek sayfada: <strong>yüzdesini bul, yüzde kaç, yüzde değişim ve
        yüzde ekle/çıkar</strong>. Kutulara yazdıkça sonuç güncellenir.</p>
    </header>

    <div class="cards">
      <section class="card" aria-labelledby="h1c">
        <h2 id="h1c">Bir sayının yüzdesi</h2>
        <div class="line">
          <input type="number" id="a1" value="2000" inputmode="decimal" aria-label="Sayı" />
          <span>sayısının %</span>
          <input type="number" id="b1" value="15" inputmode="decimal" aria-label="Yüzde" />
          <span>'i</span>
        </div>
        <p class="res">= <strong id="r1">{nf(300)}</strong></p>
      </section>

      <section class="card" aria-labelledby="h2c">
        <h2 id="h2c">Yüzde kaç?</h2>
        <div class="line">
          <input type="number" id="a2" value="300" inputmode="decimal" aria-label="Parça" />
          <span>sayısı</span>
          <input type="number" id="b2" value="2000" inputmode="decimal" aria-label="Bütün" />
          <span>sayısının</span>
        </div>
        <p class="res">= <strong id="r2">%{nf(15)}</strong>'i</p>
      </section>

      <section class="card" aria-labelledby="h3c">
        <h2 id="h3c">Yüzde değişim (artış / azalış)</h2>
        <div class="line">
          <span>Eski</span><input type="number" id="a3" value="30000" inputmode="decimal" aria-label="Eski değer" />
          <span>Yeni</span><input type="number" id="b3" value="36000" inputmode="decimal" aria-label="Yeni değer" />
        </div>
        <p class="res">= <strong id="r3">%{nf(20)} artış</strong></p>
      </section>

      <section class="card" aria-labelledby="h4c">
        <h2 id="h4c">Yüzde ekle / çıkar (zam, indirim)</h2>
        <div class="line">
          <input type="number" id="a4" value="25000" inputmode="decimal" aria-label="Tutar" />
          <select id="s4" aria-label="İşlem"><option value="1" selected>+ ekle</option><option value="-1">− çıkar</option></select>
          <span>%</span><input type="number" id="b4" value="30" inputmode="decimal" aria-label="Oran" />
        </div>
        <p class="res">= <strong id="r4">{nf(32500)}</strong> <span class="soft" id="d4">(fark {nf(7500)})</span></p>
      </section>
    </div>

    <section class="table-block">
      <h2>Hızlı yüzde tablosu</h2>
      <table class="rate-table">
        <thead><tr><th>Tutar</th><th>%1</th><th>%5</th><th>%10</th><th>%20</th><th>%25</th><th>%50</th></tr></thead>
        <tbody>
          {[100, 1000, 5000, 10000, 50000, 100000].map((t) => (
            <tr><td><strong>{nf(t)}</strong></td>{[1, 5, 10, 20, 25, 50].map((p) => <td>{nf((t * p) / 100)}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="prose-block">
      <h2>Yüzde formülleri</h2>
      <ul>
        <li><strong>X'in %Y'si</strong> = X × Y ÷ 100</li>
        <li><strong>A, B'nin yüzde kaçı</strong> = A ÷ B × 100</li>
        <li><strong>Yüzde değişim</strong> = (Yeni − Eski) ÷ Eski × 100</li>
        <li><strong>%Y ekle</strong> = X × (1 + Y/100) · <strong>%Y çıkar</strong> = X × (1 − Y/100)</li>
        <li><strong>Yüzde eklenmiş tutardan geri git</strong> = Tutar ÷ (1 + Y/100) — örneğin KDV dahil fiyattan matrah</li>
      </ul>
      <h2>Finansta yüzde: zam, enflasyon ve getiri</h2>
      <p>Maaş zammını, kira artışını ya da yatırım getirisini değerlendirirken yüzdeyi enflasyonla birlikte okuyun:
        reel değişim = (1 + artış) ÷ (1 + enflasyon) − 1. Hazır hesaplayıcılar:
        <a href="/emekli-zammi-hesaplama/">emekli zammı</a>, <a href="/kira-artis-orani-hesaplama/">kira artış oranı</a>,
        <a href="/net-maas-hesaplama/">net maaş</a>, <a href="/kdv-hesaplama/">KDV hesaplama</a>,
        <a href="/faiz-hesaplama/">faiz hesaplama</a> ve <a href="/altin-getiri/">altın getirisi</a>.</p>
    </section>

    <section class="faq-block">
      <h2>Sıkça Sorulan Sorular</h2>
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>
    <Newsletter />
  </div>

  <script is:inline>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 });
      const v = (id) => +$(id).value || 0;
      function up() {
        $('r1').textContent = nf.format((v('a1') * v('b1')) / 100);
        $('r2').textContent = v('b2') ? '%' + nf.format((v('a2') / v('b2')) * 100) : '—';
        if (v('a3')) {
          const d = ((v('b3') - v('a3')) / v('a3')) * 100;
          $('r3').textContent = '%' + nf.format(Math.abs(d)) + (d >= 0 ? ' artış' : ' azalış');
        } else $('r3').textContent = '—';
        const s = +$('s4').value, r = v('a4') * (1 + (s * v('b4')) / 100);
        $('r4').textContent = nf.format(r);
        $('d4').textContent = '(fark ' + nf.format(Math.abs(r - v('a4'))) + ')';
      }
      document.querySelectorAll('.card input, .card select').forEach((el) => el.addEventListener('input', up));
    })();
  </script>

  <style>
    .wrap { max-width: 860px; margin: 0 auto; padding: 2.5rem 1.1rem 4rem; }
    .head { text-align: center; margin-bottom: 1.8rem; }
    .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; font-weight: 700; color: var(--brand-deep); margin: 0 0 0.4rem; }
    .head h1 { font-size: var(--step-4); margin: 0 0 0.6rem; line-height: 1.1; }
    .lede { color: var(--text-soft); font-size: var(--step-1); max-width: 640px; margin: 0 auto; }
    .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.1rem 1.2rem; box-shadow: var(--shadow-soft); }
    .card h2 { font-size: 1rem; margin: 0 0 0.8rem; }
    .line { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }
    .line span { font-size: 0.9rem; color: var(--text-soft); }
    .line input, .line select { font-family: var(--font-sans); font-size: 1.05rem; font-weight: 600; color: var(--text); padding: 0.5rem 0.6rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg); width: 7.5rem; min-width: 0; }
    .line select { width: auto; }
    .line input:focus, .line select:focus { outline: none; border-color: var(--brand-2); box-shadow: 0 0 0 3px var(--brand-soft); }
    .res { margin: 0.9rem 0 0; font-size: 1.05rem; color: var(--text-soft); }
    .res strong { font-family: var(--font-serif); font-size: 1.6rem; color: var(--brand-ink); }
    .soft { font-size: 0.85rem; color: var(--text-muted); }
    .table-block { margin-top: 2.5rem; overflow-x: auto; }
    .table-block h2, .prose-block h2, .faq-block h2 { font-size: var(--step-2); margin: 0 0 0.7rem; }
    .rate-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    .rate-table th, .rate-table td { text-align: left; padding: 0.5rem 0.45rem; border-bottom: 1px solid var(--border); white-space: nowrap; }
    .rate-table th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
    .prose-block, .faq-block { margin-top: 2.5rem; }
    .prose-block p, .prose-block li { color: var(--text-soft); line-height: 1.7; }
    .prose-block h2:not(:first-child) { margin-top: 1.8rem; }
    .faq-block details { border-bottom: 1px solid var(--border); padding: 0.9rem 0; }
    .faq-block summary { font-weight: 600; cursor: pointer; color: var(--text); list-style: none; }
    .faq-block summary::-webkit-details-marker { display: none; }
    .faq-block summary::after { content: '+'; float: right; color: var(--brand-2); font-weight: 700; }
    .faq-block details[open] summary::after { content: '−'; }
    .faq-block details p { color: var(--text-soft); line-height: 1.7; margin: 0.7rem 0 0; }
    @media (max-width: 680px) { .cards { grid-template-columns: 1fr; } .line input { width: 6.5rem; } }
  </style>
</BaseLayout>
