  <script is:inline define:vars={{ NG: kurus(G.net), NY: Y ? kurus(Y.net) : 0, GY: G.yil, YY: Y ? Y.yil : 0 }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const nf0 = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
      const nf2 = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const tl0 = (n) => '₺' + nf0.format(Math.round(n));
      const tl2 = (n) => '₺' + nf2.format(n);
      const int = (id, min, max) => Math.max(min, Math.min(max, Math.round(+$(id).value || 0)));
      function test(netK, gelir, n, yil) {
        const ok = Math.round(gelir * 100) * 3 < netK * 2 * n;
        const kb = gelir / n, s = (netK * 2) / 3 / 100, d = Math.abs(s - kb);
        const ds = d < 1 ? tl2(d) : tl0(d);
        const t = ok ? 'Kişi başı gelir, ' + yil + ' sınırının ' + ds + ' altında.'
          : kb > s ? 'Kişi başı gelir, ' + yil + ' sınırını ' + ds + ' aşıyor.'
          : 'Kişi başı gelir ' + yil + ' sınırına eşit; altında kalmalı.';
        return { ok, t };
      }
      function show(p, r, onEk) {
        const b = $(p + '-b'), t = $(p + '-t');
        if (!b || !t) return;
        b.textContent = r.ok ? 'Uygun' : 'Uygun değil';
        b.className = 'badge ' + (r.ok ? 'ok' : 'no');
        t.textContent = onEk + r.t;
      }
      function update() {
        const gelir = Math.max(0, +$('in-gelir').value || 0);
        const kisi = int('in-kisi', 1, 50);
        const engelli = int('in-engelli', 1, 20);
        const n = kisi + Math.max(0, Math.min(engelli, kisi) - 1);
        $('out-kb').textContent = tl0(gelir / n);
        $('out-n').textContent = String(n);
        $('out-max').textContent = tl2(Math.round((NG * 2 * n) / 3) / 100);
        show('v-g', test(NG, gelir, n, GY), '');
        if (YY) show('v-y', test(NY, gelir, n, YY), '1 Ocak ' + YY + ' itibarıyla: ');
        $('out-note').textContent = engelli > 1
          ? 'Hanedeki her ek bakıma muhtaç engelli iki kişi sayıldığı için hesap ' + n + ' kişi üzerinden yapıldı. Kesin karar heyetin bakım raporuyla verilir.'
          : 'Kesin karar heyetin hane ziyareti ve bakım raporuyla verilir; ikinci konut, araç ve mevduat gibi varlıklar da gelir sayılır.';
      }
      ['in-gelir', 'in-kisi', 'in-engelli'].forEach((id) => $(id).addEventListener('input', update));
      update();
    })();
  </script>

