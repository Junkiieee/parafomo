---
import BaseLayout from '../layouts/BaseLayout.astro';
import { existsSync as __exists } from 'node:fs';
import { join as __join } from 'node:path';
// Engelli maaşı sayfası paralel geliştiriliyordu: dosyası yoksa link verilmez
const hasEngelli = __exists(__join(process.cwd(), 'src', 'pages', 'engelli-maasi.astro'));
import Newsletter from '../components/Newsletter.astro';
import au from '../../data/asgari-ucret.json';
import em from '../../data/emekli-memur.json';
// Ocak zammı tahmini /memur-zammi-hesaplama ile ORTAK modülde (aynı TÜFE, aynı varsayım) — burada tekrar hesaplanmaz.
import { PERIOD, TS_H2_2026, TS_H1_2027, byMonth, knownKeys, cumKnown, remaining, ASSUME, project, memurFrom, memurProj } from '../data/zam2027';

// Evde bakım yardımı ("evde bakım maaşı") — doğrulama 2026-10-18:
// • TUTAR = (10.000) gösterge × memur aylık katsayısı: 2828 s. Sosyal Hizmetler K. ek md. 7/2 (mevzuat.gov.tr metni,
//   7593 s. Kanun’a kadar işlenmiş) + Evde Bakım Yardımı Yönetmeliği md. 5/1 (RG 26.05.2023/32202; değ. RG 16.01.2026/33139).
//   Asgari ücrete BAĞLI DEĞİL: asgari ücret yalnız gelir şartında (hane içi kişi başı gelir < net asgari ücretin 2/3’ü) kullanılır.
// • Katsayı data/emekli-memur.json’dan (HMB genelgesi, her Ocak/Temmuz). Formül Bakanlığın açıkladığı tutarlarla birebir:
//   1,012556 → 10.125 · 1,170211 → 11.702 (ASHB 15.08.2025) · 1,387871 → 13.878 (ASHB 15.02.2026). Temmuz 2026: 1,575512 →
//   15.755,12 (Endeks24 06.07.2026 Bakanlık açıklaması "15 bin 755"; ASHB 16.07.2026 duyurusundaki "15 bin 775" formülle uyuşmuyor).
// • Gelir sınırı data/asgari-ucret.json’dan: guncel.net × 2/3; Aralık’ta `yeni` dolunca 1 Ocak’tan geçerli yeni sınır da gösterilir.
type Yil = { yil: number; brut?: number | null; net?: number | null; aciklanma?: string };

const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const ayAdi = (k: string) => AYLAR[+k.slice(5) - 1];
const ayYil = (k: string) => `${ayAdi(k)} ${k.slice(0, 4)}`;
const donemAd = (k: string) => (+k.slice(5) <= 6 ? `Ocak–Haziran ${k.slice(0, 4)}` : `Temmuz–Aralık ${k.slice(0, 4)}`);
const aralik = (keys: string[]) => (keys.length === 0 ? '' : keys.length === 1 ? ayAdi(keys[0]) : `${ayAdi(keys[0])}–${ayAdi(keys[keys.length - 1])}`);
const sonrakiAy = (k: string) => {
  const y = +k.slice(0, 4), m = +k.slice(5);
  return m === 12 ? `${y + 1}-01` : `${y}-${String(m + 1).padStart(2, '0')}`;
};
const gun = (iso?: string) => {
  if (!iso) return '';
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${AYLAR[m - 1]} ${y}`;
};
const fmt0 = (n: number) => new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(Math.round(n));
const fmt2 = (n: number) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const nf = (n: number, d = 2) => n.toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d });
const kurus = (tl: number) => Math.round(tl * 100);

// ── Yardım tutarı (memur aylık katsayısı) ─────────────────────────────────────────────
const K = em.memurKatsayi;
const DONEM = em.donem;                                   // '2026-07' → Temmuz–Aralık 2026 katsayısı
const DONEM_YIL = +DONEM.slice(0, 4);
const tutarOf = (k: number) => Math.round(10000 * k * 100) / 100;
const TUTAR = tutarOf(K.aylikKatsayi);                    // 15.755,12

// Geçmiş katsayılar (HMB genelgeleri; alomaliye / Av. Kazım Ceylan tabloları). İlk satır yalnız artış hesabının tabanı.
const GECMIS = [
  { donem: '2024-07', k: 0.907796 },
  { donem: '2025-01', k: 1.012556 },
  { donem: '2025-07', k: 1.170211 },
  { donem: '2026-01', k: 1.387871 },
  { donem: '2026-07', k: 1.575512 },
];
const seri = [...GECMIS.filter((g) => g.donem < DONEM), { donem: DONEM, k: K.aylikKatsayi }]
  .map((g, i, a) => ({ donem: g.donem, k: g.k, tutar: tutarOf(g.k), artis: i > 0 ? g.k / a[i - 1].k - 1 : null }))
  .slice(1);
const ONCEKI = seri.length > 1 ? seri[seri.length - 2] : null;
const TARIHCE = [...seri].reverse();

// Bir sonraki dönem tahmini: zam modülü yürürlükteki katsayıdan sonraki zammı hesaplıyorsa (PERIOD[0] === DONEM).
const TAHMIN_VAR = PERIOD[0] === DONEM;
const HEDEF = sonrakiAy(PERIOD[PERIOD.length - 1]);      // '2027-01'
const HEDEF_AD = ayYil(HEDEF);                            // 'Ocak 2027'
const HEDEF_YIL = +HEDEF.slice(0, 4);
const OCAK_HEDEF = TAHMIN_VAR && HEDEF.endsWith('-01');
const KESIN_ZAM = remaining === 0;                         // 6 ayın enflasyonu açıklandı → oran kesin, genelge bekleniyor
const ZAM = memurProj.zam;
const TUTAR_HEDEF = TAHMIN_VAR ? Math.round(TUTAR * (1 + ZAM) * 100) / 100 : 0;
const KAT_HEDEF = K.aylikKatsayi * (1 + ZAM);
const PERIOD_AD = `${aralik(PERIOD)} ${PERIOD[0].slice(0, 4)}`;   // 'Temmuz–Aralık 2026' (enflasyon farkı dönemi)
const BILINEN_AD = aralik(knownKeys);                      // 'Temmuz–Eylül'
const KALAN = PERIOD.filter((k) => !byMonth.has(k));
const KALAN_AD = aralik(KALAN);                           // 'Ekim–Aralık'
const BILINEN_METIN = knownKeys.length ? `${BILINEN_AD} ${knownKeys[0].slice(0, 4)} enflasyonu %${nf(cumKnown * 100)} olarak kesinleşti; ` : '';
const SCEN = TAHMIN_VAR && !KESIN_ZAM
  ? [...new Set([ASSUME, 1, 1.5, 2])].sort((a, b) => a - b).map((x) => {
      const m = memurFrom(project(x));
      return { x, zam: m.zam, tutar: TUTAR * (1 + m.zam), son3: x === ASSUME };
    })
  : [];

// ── Gelir şartı (net asgari ücretin 2/3’ü) ────────────────────────────────────────────
const R = au.oranlar;
// /asgari-ucret-hesaplama ile aynı: net = brüt − yuvarla(brüt×%14) − yuvarla(brüt×%1) (yalnız brüt açıklandıysa)
const netOf = (brut: number) => (kurus(brut) - Math.round((kurus(brut) * R.sgkIsci) / 100) - Math.round((kurus(brut) * R.issizlikIsci) / 100)) / 100;
const netYil = (y: Yil) => (y.net ?? netOf(y.brut as number)) as number;
const G = { yil: au.guncel.yil, net: netYil(au.guncel as Yil) };
const Y = au.yeni ? { yil: (au.yeni as Yil).yil, net: netYil(au.yeni as Yil), aciklanma: (au.yeni as Yil).aciklanma } : null;
const sinirKb = (net: number) => Math.round((kurus(net) * 2) / 3) / 100;          // kişi başı (bu tutarın ALTINDA olmalı)
const sinirHane = (net: number, n: number) => Math.round((kurus(net) * 2 * n) / 3) / 100;
const SINIR = sinirKb(G.net);                             // 2026: 18.717,00
const SINIR_Y = Y ? sinirKb(Y.net) : 0;
const SINIR_2022 = Math.round(kurus(G.net) / 3) / 100;    // 2022 s. Kanun engelli aylığı: net asgari ücretin 1/3’ü
const HANE = [1, 2, 3, 4, 5, 6].map((n) => ({ n, g: sinirHane(G.net, n), y: Y ? sinirHane(Y.net, n) : 0 }));
// Aralık açıklamasından önce (Eylül–Aralık build’lerinde) gelecek yılın sınırı için senaryo — tahmin değil.
const BUILD_AY = new Date().getMonth() + 1;
const SINIR_SENARYO = !Y && BUILD_AY >= 9
  ? [15, 20, 25, 30, 35].map((r) => {
      const net = G.net * (1 + r / 100);
      return { r, net, kb: (net * 2) / 3, h4: (net * 2 * 4) / 3 };
    })
  : [];

// Uygunluk testi (varsayılan değerler — istemci betiğiyle aynı mantık, kuruş cinsinden kesin karşılaştırma)
const D = { gelir: 45000, kisi: 3, engelli: 1 };
const kisiSay = (kisi: number, engelli: number) => kisi + Math.max(0, Math.min(engelli, kisi) - 1);
const testEt = (net: number, gelir: number, n: number, yil: number) => {
  const ok = kurus(gelir) * 3 < kurus(net) * 2 * n;
  const kb = gelir / n, s = (kurus(net) * 2) / 3 / 100;
  const d = Math.abs(s - kb), ds = d < 1 ? `₺${fmt2(d)}` : `₺${fmt0(d)}`;
  return { ok, t: ok ? `Kişi başı gelir, ${yil} sınırının ${ds} altında.` : kb > s ? `Kişi başı gelir, ${yil} sınırını ${ds} aşıyor.` : `Kişi başı gelir ${yil} sınırına eşit; altında kalmalı.` };
};
const D_N = kisiSay(D.kisi, D.engelli);
const D_G = testEt(G.net, D.gelir, D_N, G.yil);
const D_Y = Y ? testEt(Y.net, D.gelir, D_N, Y.yil) : null;

// ── Başlık ve SSS (duruma göre) ───────────────────────────────────────────────────────
let title: string, h1: string, description: string;
const sinirMetin = Y ? `${Y.yil} gelir sınırı kişi başı ${fmt0(SINIR_Y)} TL` : `Gelir sınırı kişi başı ${fmt0(SINIR)} TL`;
if (OCAK_HEDEF && !KESIN_ZAM) {
  title = `Evde Bakım Maaşı ${HEDEF_YIL} Ne Kadar Olacak? Tahmini ${fmt0(TUTAR_HEDEF)} TL | ${DONEM_YIL} Tutarı ve Şartlar`;
  h1 = `Evde Bakım Maaşı ${HEDEF_YIL}: Ne Kadar Olacak?`;
  description = `Evde bakım maaşı ${donemAd(DONEM)} döneminde ${fmt0(TUTAR)} TL; ${HEDEF_AD} tahmini ${fmt0(TUTAR_HEDEF)} TL. ${sinirMetin}: uygunluk testi, şartlar, başvuru.`;
} else if (OCAK_HEDEF) {
  title = `Evde Bakım Maaşı ${HEDEF_YIL}: ${fmt0(TUTAR_HEDEF)} TL Oluyor | Şartlar ve Gelir Sınırı`;
  h1 = `Evde Bakım Maaşı ${HEDEF_YIL}: ${fmt0(TUTAR_HEDEF)} TL Oluyor`;
  description = `Evde bakım maaşı ${HEDEF_AD} itibarıyla ${fmt0(TUTAR_HEDEF)} TL (memur zammı %${nf(ZAM * 100)}). ${sinirMetin}: uygunluk testi, şartlar, başvuru.`;
} else {
  title = `Evde Bakım Maaşı ${DONEM_YIL}: ${fmt2(TUTAR)} TL | Şartlar ve Gelir Sınırı`;
  h1 = `Evde Bakım Maaşı ${DONEM_YIL}: ${fmt2(TUTAR)} TL`;
  description = `Evde bakım maaşı ${donemAd(DONEM)} döneminde ${fmt2(TUTAR)} TL (10.000 × memur katsayısı). ${sinirMetin}: uygunluk testi, şartlar, başvuru.`;
}

const faq = [
  OCAK_HEDEF
    ? {
        q: `Evde bakım maaşı ${HEDEF_YIL} yılında ne kadar olacak?`,
        a: KESIN_ZAM
          ? `Evde bakım maaşı memur maaş katsayısına bağlıdır. ${HEDEF_AD} memur zammı %${nf(ZAM * 100)} olarak kesinleşti; aylık tutar ${fmt2(TUTAR)} TL’den yaklaşık ${fmt0(TUTAR_HEDEF)} TL’ye çıkar. Kuruşu kesin tutar, Hazine ve Maliye Bakanlığı’nın Ocak katsayı genelgesiyle belli olur.`
          : `Evde bakım maaşı memur maaş katsayısına bağlıdır ve ${HEDEF_AD} itibarıyla memur zammı oranında artar. ${BILINEN_METIN}${KALAN_AD} için aylık %${nf(ASSUME)} (son 3 ay ortalaması) varsayımıyla memur zammı yaklaşık %${nf(ZAM * 100)}, evde bakım maaşı yaklaşık ${fmt0(TUTAR_HEDEF)} TL olur (bugün ${fmt2(TUTAR)} TL). Bu bir tahmindir; kesin tutar Aralık enflasyonu açıklanıp Ocak katsayısı ilan edilince belli olur.`,
      }
    : {
        q: `Evde bakım maaşı ${DONEM_YIL} yılında ne kadar?`,
        a: `${donemAd(DONEM)} döneminde evde bakım maaşı aylık ${fmt2(TUTAR)} TL’dir: 10.000 gösterge × memur aylık katsayısı (${nf(K.aylikKatsayi, 6)}).${ONCEKI ? ` Bir önceki dönemde ${fmt2(ONCEKI.tutar)} TL idi.` : ''} Tutar her Ocak ve Temmuz’da memur zammı oranında artar.`,
      },
  {
    q: 'Evde bakım maaşı hane geliri şartı nedir?',
    a: `Hanede yaşayan herkesin aylık net geliri toplanıp hane nüfusuna bölünür; kişi başı tutar net asgari ücretin 2/3’ünden az olmalıdır. ${G.yil} yılında net asgari ücret ${fmt2(G.net)} TL olduğu için sınır kişi başı ${fmt2(SINIR)} TL; örneğin 4 kişilik bir hanenin toplam aylık geliri ${fmt2(sinirHane(G.net, 4))} TL’nin altında kalmalıdır.${Y ? ` ${Y.yil} asgari ücretiyle sınır 1 Ocak ${Y.yil} itibarıyla kişi başı ${fmt2(SINIR_Y)} TL olur.` : ''} Hanedeki ikinci ve sonraki her bakıma muhtaç engelli iki kişi sayılır; bayram ikramiyesi, öğrenim kredisi, doğum yardımı ve staj ücreti gelire katılmaz.`,
  },
  {
    q: 'Evde bakım maaşı ne zaman yatar?',
    a: 'Aile ve Sosyal Hizmetler Bakanlığı, evde bakım yardımının her ayın 15’inde hak sahiplerinin hesaplarına yatırıldığını açıklıyor. Ocak ve Temmuz’daki katsayı artışları bir sonraki ayın ödemesine yansır: 2026’da Ocak artışı Şubat’ta, Temmuz artışı Ağustos’ta hesaplara geçti. Ödemenizi e-Devlet’teki “Engelli Evde Bakım Ödeme Bilgileri Sorgulama” hizmetinden görebilirsiniz.',
  },
  {
    q: 'Evde bakım maaşı için hangi sağlık raporu gerekir?',
    a: 'Erişkinlerde sağlık kurulu raporunda “tam bağımlı” ibaresi, çocuklarda “Çok ileri düzeyde ÖGV”, “Belirgin ÖGV” ve “Özel koşul gereksinimi var (ÖKGV)” ibareli ÇÖZGER raporu aranır; esas alınan, Sağlık Bakanlığı sisteminde kayıtlı son tarihli rapordur. Rapor tek başına yetmez: Bakanlığın heyeti evi ziyaret ederek kişinin günlük işlerini başkasının yardımı olmadan sürdüremediğini bakım raporuyla tespit etmelidir.',
  },
  {
    q: 'Evde bakım maaşına nereden ve nasıl başvurulur?',
    a: 'Engellinin nüfusa kayıtlı olduğu yerdeki Aile ve Sosyal Hizmetler İl Müdürlüğü’ne veya Sosyal Hizmet Merkezi’ne başvurulur; Yönetmelik başvurunun e-Devlet üzerinden de alınabileceğini öngörür. Başvuruyu engelli kişi, bakım vermek isteyen yakını, bir akrabası veya vasisi yapabilir; belgeler başvurudan itibaren 30 gün içinde tamamlanır. Yardıma Bakanlık sistemindeki onay tarihinden itibaren hak kazanılır; ret kararına tebliğden itibaren 30 gün içinde itiraz edilebilir.',
  },
  {
    q: 'Evde bakım maaşı ile engelli maaşı aynı şey mi?',
    a: `Hayır. Evde bakım yardımı 2828 sayılı Kanun’a dayanır, engelliye bakan yakına ödenir ve gelir sınırı net asgari ücretin 2/3’üdür. Engelli aylığı ise 2022 sayılı Kanun’a göre 18 yaşını doldurmuş engellinin kendisine (18 yaşından küçük engellilerde bakımını üstlenen yakınına) bağlanır, başvurusu Sosyal Yardımlaşma ve Dayanışma Vakfı’na yapılır ve gelir sınırı net asgari ücretin 1/3’üdür (${G.yil} yılında kişi başı ${fmt2(SINIR_2022)} TL).`,
  },
];

const breadcrumbs = [
  { name: 'Ana Sayfa', url: '/' },
  { name: 'Hesaplama Araçları', url: '/hesaplama-araclari/' },
  { name: 'Evde Bakım Maaşı', url: '/evde-bakim-maasi/' },
];
---

<BaseLayout title={title} description={description} faq={faq} breadcrumbs={breadcrumbs} image="/og/evde-bakim-maasi.png">
  <div class="calc-wrap">
    <header class="calc-head">
      <p class="eyebrow">Sosyal Yardım · Güncel Tutar</p>
      <h1>{h1}</h1>
      <p class="lede">
        {OCAK_HEDEF && !KESIN_ZAM && (
          <>Evde bakım maaşı (resmî adıyla <strong>evde bakım yardımı</strong>) {donemAd(DONEM)} döneminde aylık
          <strong>{fmt2(TUTAR)} TL</strong>. Tutar memur maaş katsayısına bağlı olduğu için {HEDEF_AD} itibarıyla memur
          zammı kadar artacak; bugünkü enflasyon verisiyle tahmin <strong>≈ {fmt0(TUTAR_HEDEF)} TL</strong>.</>
        )}
        {OCAK_HEDEF && KESIN_ZAM && (
          <>{HEDEF_AD} memur zammı %{nf(ZAM * 100)} olarak kesinleşti; evde bakım maaşı {fmt2(TUTAR)} TL’den yaklaşık
          <strong>{fmt0(TUTAR_HEDEF)} TL</strong>’ye çıkıyor. Kuruşu kesin tutar Hazine ve Maliye Bakanlığı’nın katsayı
          genelgesiyle belli olur.</>
        )}
        {!OCAK_HEDEF && (
          <>Evde bakım maaşı (resmî adıyla <strong>evde bakım yardımı</strong>) {donemAd(DONEM)} döneminde aylık
          <strong>{fmt2(TUTAR)} TL</strong>: 10.000 gösterge × memur aylık katsayısı ({nf(K.aylikKatsayi, 6)}).</>
        )}
        {' '}Hanenizin gelir şartını aşağıda sınayın.
      </p>
    </header>

    {Y && (
      <p class="notice">
        <strong>{Y.yil} asgari ücreti açıklandı</strong>{Y.aciklanma ? ` (${gun(Y.aciklanma)})` : ''}: net {fmt2(Y.net)} TL.
        Evde bakım gelir sınırı 1 Ocak {Y.yil} itibarıyla kişi başı <strong>{fmt2(SINIR_Y)} TL</strong> olur. Yardımın
        tutarı asgari ücrete değil memur katsayısına bağlı olduğundan bu karardan etkilenmez.
      </p>
    )}

    <div class="stats">
      <div class="stat">
        <span class="k">Evde bakım maaşı (aylık)</span>
        <span class="v">₺{fmt2(TUTAR)}</span>
        <span class="s">{donemAd(DONEM)} · 10.000 × {nf(K.aylikKatsayi, 6)}</span>
      </div>
      {TAHMIN_VAR ? (
        <div class="stat">
          <span class="k">{HEDEF_AD} {KESIN_ZAM ? '(kesinleşen zamla)' : 'tahmini'}</span>
          <span class="v">≈ ₺{fmt0(TUTAR_HEDEF)}</span>
          <span class="s">memur zammı {KESIN_ZAM ? '' : '≈'}%{nf(ZAM * 100)} ile{KESIN_ZAM ? '' : ' · tahmin'}</span>
        </div>
      ) : ONCEKI && (
        <div class="stat">
          <span class="k">Önceki dönem</span>
          <span class="v">₺{fmt2(ONCEKI.tutar)}</span>
          <span class="s">{donemAd(ONCEKI.donem)}</span>
        </div>
      )}
      <div class="stat">
        <span class="k">{Y ? `${Y.yil} gelir sınırı (kişi başı)` : 'Gelir sınırı (kişi başı)'}</span>
        <span class="v">₺{fmt0(Y ? SINIR_Y : SINIR)}</span>
        <span class="s">{Y ? `1 Ocak ${Y.yil} itibarıyla · ${G.yil}: ₺${fmt0(SINIR)}` : `${G.yil} · net asgari ücretin 2/3’ü`}</span>
      </div>
    </div>

    {TAHMIN_VAR && (
      <section class="table-block" id="tahmin">
        <h2>{HEDEF_AD} evde bakım maaşı ne kadar olacak?</h2>
        {!KESIN_ZAM ? (
          <p class="table-intro">
            Evde bakım maaşı her Ocak ve Temmuz’da memur maaş zammıyla aynı oranda artar. {HEDEF_AD} memur zammı,
            8. Dönem Toplu Sözleşme’deki %{TS_H1_2027} zam ile {PERIOD_AD} enflasyonunun %{TS_H2_2026} toplu sözleşme
            zammını aşan kısmının (enflasyon farkı) bileşiğidir.
            {knownKeys.length > 0 && <>{BILINEN_AD} enflasyonu <strong>%{nf(cumKnown * 100)}</strong> olarak kesinleşti; </>}
            {KALAN_AD} için aylık %{nf(ASSUME)} (son 3 ayın ortalaması) varsayılırsa memur zammı yaklaşık
            <strong>%{nf(ZAM * 100)}</strong>, evde bakım maaşı yaklaşık <strong>{fmt0(TUTAR_HEDEF)} TL</strong> olur.
          </p>
        ) : (
          <p class="table-intro">
            {PERIOD_AD} enflasyonu açıklandı ve {HEDEF_AD} memur zammı <strong>%{nf(ZAM * 100)}</strong> olarak kesinleşti
            (toplu sözleşme %{TS_H1_2027} + enflasyon farkı %{nf(memurProj.fark * 100)}). Evde bakım maaşı {fmt2(TUTAR)} TL’den
            yaklaşık <strong>{fmt0(TUTAR_HEDEF)} TL</strong>’ye çıkar. Katsayı altı haneye yuvarlandığı için genelgedeki kesin
            tutar birkaç kuruş farklı olabilir.
          </p>
        )}
        {SCEN.length > 0 && (
          <div class="table-scroll">
            <table class="rate-table">
