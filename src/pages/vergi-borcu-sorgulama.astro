  <script is:inline define:vars={{ RATES: RATE_PAIRS, MIN_DATE }}>
    (function () {
      const $ = (id) => document.getElementById(id);
      const DAY = 864e5;
      const toDay = (s) => {
        const p = s.split('-').map(Number);
        return Date.UTC(p[0], p[1] - 1, p[2]) / DAY;
      };
      const R = RATES.map((r) => ({ day: toDay(r[0]), h: r[1] }));
      const rateOn = (day) => {
        let h = R[0].h;
        for (const x of R) if (x.day <= day) h = x.h;
        return h;
      };
      const dailyMicro = (h) => Math.floor((h * 10 + 2) / 3);
      const dim = (y, m0) => new Date(Date.UTC(y, m0 + 1, 0)).getUTCDate();
      function calc(amount, vade, odeme) {
        const v = vade.split('-').map(Number);
        const V = toDay(vade);
        const P = toDay(odeme);
        const eom = v[2] === dim(v[0], v[1] - 1);
        const monthEnd = (k) => {
          const t = v[1] - 1 + k;
          const y = v[0] + Math.floor(t / 12);
          const m0 = ((t % 12) + 12) % 12;
          const n = dim(y, m0);
          return Date.UTC(y, m0, eom ? n : Math.min(v[2], n)) / DAY;
        };
        let months = 0, days = 0, frac = 0;
        const used = new Set();
        if (P > V) {
          let prev = V;
          for (let k = 1; monthEnd(k) <= P; k++) {
            const h = rateOn(prev);
            frac += h / 10000;
            used.add(h);
            months++;
            prev = monthEnd(k);
          }
          let d = prev + 1;
          while (d <= P) {
            const h = rateOn(d);
            let n = 0;
            while (d <= P && rateOn(d) === h) { n++; d++; }
            used.add(h);
            if (n === 30) { frac += h / 10000; months++; } else { frac += (n * dailyMicro(h)) / 1e6; days += n; }
          }
        }
        return { months, days, frac, used: used.size, zam: Math.round(amount * frac * 100 + 1e-7) / 100 };
      }
      const nf2 = (n) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const tl = (n) => '₺' + nf2(n);
      const sure = (m, g) => [m ? m + ' ay' : '', g || !m ? g + ' gün' : ''].filter(Boolean).join(' ');
      const now = new Date();
      const today = new Date(now.getTime() - now.getTimezoneOffset() * 6e4).toISOString().slice(0, 10);
      const odemeIn = $('in-odeme');
      if (odemeIn.value === odemeIn.defaultValue) odemeIn.value = today;
      const re = /^\d{4}-\d{2}-\d{2}$/;
      function update() {
        const amt = Math.max(0, +$('in-amt').value || 0);
        const vade = $('in-vade').value;
        const odeme = odemeIn.value;
        const note = $('out-note');
        if (!re.test(vade) || !re.test(odeme) || vade > '2100-12-31' || odeme > '2100-12-31') {
          ['out-zam', 'out-total', 'out-sure', 'out-oran'].forEach((id) => { $(id).textContent = '—'; });
          note.textContent = 'Vade ve ödeme tarihini girin.';
          return;
        }
        if (vade < MIN_DATE) {
          ['out-zam', 'out-total', 'out-sure', 'out-oran'].forEach((id) => { $(id).textContent = '—'; });
          note.textContent = 'Hesaplayıcı 21.04.2006 ve sonrası vadeler içindir.';
          return;
        }
        const r = calc(amt, vade, odeme);
        let zam = r.zam;
        const notes = [];
        if (odeme <= vade) notes.push('Ödeme vade günü veya öncesinde: gecikme zammı işlemez.');
        else {
          if (zam > 0 && zam < 1) { notes.push('Hesaplanan ' + nf2(zam) + ' TL; kanuni asgari gecikme zammı 1 TL’dir.'); zam = 1; }
          if (r.used > 1) notes.push('Dönemde oran değişikliği var; her dönem kendi oranıyla hesaplandı.');
          if (odeme > today) notes.push('İleri tarih: bugünkü oranın değişmeyeceği varsayıldı.');
          if (!notes.length) notes.push('Tam aylar aylık, kalan günler günlük oranla hesaplandı.');
        }
        $('out-zam').textContent = tl(zam);
        $('out-total').textContent = tl(amt + zam);
        $('out-sure').textContent = sure(r.months, r.days);
        $('out-oran').textContent = '%' + nf2(r.frac * 100);
        note.textContent = notes.join(' ');
      }
      ['in-amt', 'in-vade', 'in-odeme'].forEach((id) => {
        $(id).addEventListener('input', update);
        $(id).addEventListener('change', update);
      });
      update();
    })();
  </script>

