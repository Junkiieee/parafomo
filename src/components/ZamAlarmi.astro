---
// Zam alarmı kaydı (2026-11-17, Kaan: "sitemde asıl istediğim olay kaydolmaları").
// Genel bülten yerine zam sezonunda net bir vaat: resmî rakam açıklandığı gün tek e-posta.
// Aynı API (api.parafomo.com/newsletter, çift onay); kaynak "zam-alarmi:<sayfa>" → onay e-postası ve
// onay sayfası zam alarmına göre, haftalık bülten bu kayıtlara gitmez (backend/app/newsletter_send.py).
const {
  baslik = 'Ocak 2027 zamları açıklandığı gün e-postana gelsin',
  metin = 'Asgari ücret (Aralık sonu), emekli ve memur zammı (Ocak başı): kesin oran ve kendi maaşınla hesaplama bağlantısı. Yalnız açıklama günlerinde, tek e-posta. Bülten ya da reklam yok.',
  bilgi = true,   // açılış sayfasında kendine link verme
} = Astro.props;
---
<section class="zam-alarmi" aria-label="Zam alarmı kaydı">
  <div class="za-ust">
    <span class="za-rozet" aria-hidden="true">🔔</span>
    <div>
      <p class="za-eyebrow">Zam alarmı · ücretsiz</p>
      <h2>{baslik}</h2>
    </div>
  </div>
  <p class="za-metin">{metin}</p>
  <form class="za-form" data-za-form method="post" novalidate>
    <div class="za-satir">
      <input type="email" name="email" required autocomplete="email" placeholder="E-posta adresin" aria-label="E-posta adresi" />
      <button type="submit" class="btn btn-primary">Alarmı kur</button>
    </div>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="za-hp" aria-hidden="true" />
    <label class="za-onay">
      <input type="checkbox" name="consent" required />
      <span>Zam alarmı e-postaları için e-postamın işlenmesine onay veriyorum (<a href="/gizlilik/">Gizlilik</a>). İstediğin an tek tıkla çıkabilirsin.</span>
    </label>
    <p class="za-msg" role="status" aria-live="polite"></p>
    {bilgi && <a class="za-bilgi" href="/zam-alarmi/">Zam alarmı nasıl çalışır?</a>}
  </form>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-za-form]').forEach((form) => {
    const msg = form.querySelector<HTMLElement>('.za-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const API = 'https://api.parafomo.com/newsletter/subscribe';
    const show = (text: string, ok: boolean) => {
      msg.textContent = text;
      msg.dataset.state = ok ? 'ok' : 'err';
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return show('Geçerli bir e-posta adresi yaz.', false);
      if (!fd.get('consent')) return show('Devam etmek için onay kutusunu işaretle.', false);
      btn.disabled = true;
      show('Gönderiliyor…', true);
      try {
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            consent: true,
            source: 'zam-alarmi:' + location.pathname,
            website: String(fd.get('website') || '') || null,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          show(data.message || 'Onay e-postası gönderildi.', true);
          form.reset();
          (window as any).gtag?.('event', 'generate_lead', { method: 'zam_alarmi', page_path: location.pathname });
        } else {
          const d = data.detail;
          show(typeof d === 'string' ? d : 'Geçerli bir e-posta adresi yaz.', false);
        }
      } catch {
        show('Bağlantı kurulamadı. Lütfen biraz sonra tekrar dene.', false);
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .zam-alarmi {
    margin: 2rem 0;
    border: 1px solid var(--brand-2);
    border-radius: var(--radius-lg);
    background: radial-gradient(120% 140% at 100% 0%, rgba(43, 177, 148, 0.16), transparent 60%), var(--bg-card);
    padding: 1.4rem 1.4rem 1.1rem;
    box-shadow: var(--shadow-soft);
  }
  .za-ust { display: flex; gap: 0.8rem; align-items: center; }
  .za-rozet { font-size: 1.9rem; line-height: 1; }
  .za-eyebrow { margin: 0; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.72rem; font-weight: 700; color: var(--brand-deep); }
  .zam-alarmi h2 { margin: 0.15rem 0 0; font-size: var(--step-1); line-height: 1.25; }
  .za-metin { margin: 0.7rem 0 0.9rem; color: var(--text-soft); font-size: var(--step--1); line-height: 1.55; }
  .za-form { display: flex; flex-direction: column; gap: 0.55rem; }
  .za-satir { display: flex; gap: 0.6rem; }
  .za-satir input {
    flex: 1; min-width: 0; background: var(--bg); border: 1px solid var(--border); border-radius: 999px;
    padding: 0.75rem 1.1rem; color: var(--text); font-size: var(--step--1); font-family: inherit;
  }
  .za-satir input:focus { outline: none; border-color: var(--brand); }
  .za-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .za-onay { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.78rem; color: var(--text-soft); line-height: 1.4; cursor: pointer; }
  .za-onay input { margin-top: 0.2rem; accent-color: var(--brand); }
  .za-msg { margin: 0; min-height: 1.2em; font-size: var(--step--1); }
  .za-msg[data-state='ok'] { color: var(--brand); }
  .za-msg[data-state='err'] { color: var(--danger); }
  .za-bilgi { font-size: 0.8rem; color: var(--brand-deep); width: fit-content; }
  @media (max-width: 560px) {
    .za-satir { flex-direction: column; }
    .za-satir button { width: 100%; justify-content: center; }
  }
</style>
