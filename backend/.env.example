# ParaFOMO Portföy API — ortam değişkenleri
# Gerçek değerleri backend/.env'e koy (gitignore'lu). Bu dosya şablondur.

# JWT imzalama sırrı — GÜÇLÜ rastgele bir değerle değiştir:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTFOLIO_JWT_SECRET=change-me-to-a-long-random-secret

# Access token ömrü (dakika)
PORTFOLIO_JWT_EXPIRE_MINUTES=10080

# SQLite veritabanı yolu (mutlak veya çalışma dizinine göreli)
PORTFOLIO_DB_PATH=/root/parafomo-data/portfolio.db

# CORS: yalnızca bu origin'lere izin ver (virgülle ayır)
PORTFOLIO_CORS_ORIGINS=https://parafomo.com,https://www.parafomo.com,http://localhost:4321

# Sitenin herkese açık kök adresi — şifre sıfırlama linki bununla kurulur
PORTFOLIO_FRONTEND_BASE_URL=https://parafomo.com

# Google ile giriş: Google Cloud Console'dan "OAuth 2.0 Web İstemci Kimliği" (Client ID).
# Yetkili JS kaynağı olarak https://parafomo.com eklenmeli. Boşsa Google girişi kapalıdır.
PORTFOLIO_GOOGLE_CLIENT_ID=

# Şifre sıfırlama token ömrü (dakika)
PORTFOLIO_RESET_TOKEN_EXPIRE_MINUTES=60

# E-posta (SMTP) — şifre sıfırlama maili için. Boşsa mail gitmez, link loga yazılır.
PORTFOLIO_SMTP_HOST=
PORTFOLIO_SMTP_PORT=587
PORTFOLIO_SMTP_USER=
PORTFOLIO_SMTP_PASSWORD=
PORTFOLIO_SMTP_FROM=ParaFOMO <no-reply@parafomo.com>
PORTFOLIO_SMTP_STARTTLS=true
