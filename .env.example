# Bu dosyayı .env olarak kopyala ve değerleri doldur (yayında hosting panelinden de girilebilir).

# Google Analytics 4 ölçüm kimliği (örn. G-ABCD1234)
PUBLIC_GA_ID=

# Alternatif: Plausible analytics alan adı (örn. parafomo.com)
PUBLIC_PLAUSIBLE_DOMAIN=

# Google AdSense yayıncı kimliği (örn. ca-pub-1234567890123456). Boşken reklam kodu, doğrulama meta'sı ve /ads.txt
# üretilmez. Doldurup build alınca: meta + /ads.txt + çerez onayından sonra adsbygoogle.js (src/components/Analytics.astro).
PUBLIC_ADSENSE_CLIENT=

# Büyüme Ajanı gece raporu (Gmail App Password)
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Raporun gideceği adres(ler), virgülle; boşsa EMAIL_USER'a gider. (agent/notify.py satır içi yorumu değer sayar.)
EMAIL_TO=
